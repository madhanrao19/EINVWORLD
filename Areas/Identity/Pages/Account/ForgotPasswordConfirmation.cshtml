@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<a href="/" class="einv-auth-form-logo">
    <img src="~/images/einvworld-logo.png" alt="eInvWorld">
</a>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card mt-4 card-bg-fill">
            <div class="card-body p-4 text-center">
                <div class="avatar-lg mx-auto mt-2">
                    <div class="avatar-title bg-light text-success display-5 rounded-circle">
                        <i class="ri-mail-check-line"></i>
                    </div>
                </div>
                <h4 class="mt-4 fw-semibold">Check your Email</h4>
                <p class="text-muted mt-3">
                    Please check your email to reset your password.
                </p>
                <div class="mt-4">
                    <a asp-page="./Login" class="btn btn-primary w-100">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>