@page
@model eInvWorld.Pages.Admin.AiSettingsModel
@{
    ViewData["Title"] = "AI Settings";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">AI Settings</h1>
                <p class="text-muted mb-0">On-prem AI configuration for the E-Invoice Assistant and Document Capture.</p>
            </div>
            <div class="d-flex gap-2">
                @if (Model.Enabled)
                {
                    <span class="einv-badge einv-badge-success"><i class="ri-checkbox-circle-line"></i> Enabled</span>
                }
                else
                {
                    <span class="einv-badge einv-badge-neutral"><i class="ri-pause-circle-line"></i> Disabled</span>
                }
                <a asp-page="/Assistant" class="btn btn-outline-secondary btn-sm">
                    <i class="ri-chat-3-line align-bottom me-1"></i> Open Assistant
                </a>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info">
    <i class="ri-shield-check-line"></i>
    <div>
        AI is <strong>optional</strong> and never required for invoicing — if the AI service is unavailable, invoice
        creation and submission continue to work normally. Settings are configured in <code>appsettings</code> /
        environment variables (the <code>AI</code> section); this page is read-only and lets you verify connectivity.
        No API key is ever shown here.
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header">
        <h3 class="card-title">Current Configuration</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Provider</p>
                <p class="mb-0 fw-semibold">@Model.Provider</p>
            </div>
            <div class="col-md-6 mb-3">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Base URL</p>
                <p class="mb-0"><code>@Model.BaseUrl</code></p>
            </div>
            <div class="col-md-6 mb-3">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Model</p>
                <p class="mb-0"><code>@Model.Model</code></p>
            </div>
            <div class="col-md-6 mb-3">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Timeout</p>
                <p class="mb-0">@Model.TimeoutSeconds s</p>
            </div>
            <div class="col-md-6 mb-3">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Temperature</p>
                <p class="mb-0">@Model.Temperature</p>
            </div>
            <div class="col-md-6 mb-0">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Max Tokens</p>
                <p class="mb-0">@Model.MaxTokens</p>
            </div>
        </div>
    </div>
</div>

@if (!Model.Enabled)
{
    <div class="alert alert-secondary">
        <i class="ri-information-line"></i>
        <div>
            AI is currently <strong>disabled</strong>. To enable it: install the provider (for Ollama, run
            <code>ollama pull @Model.Model</code>), set <code>AI:Enabled=true</code>, then restart the app.
            Recommended local models: <code>gemma3:12b</code>, <code>gemma3:27b</code>, <code>qwen3:32b</code>
            (models are not bundled — pull them separately).
        </div>
    </div>
}
else if (!Model.ProviderReady)
{
    <div class="alert alert-warning">
        <i class="ri-error-warning-line"></i>
        <div>
            AI is enabled but no provider matches "<strong>@Model.Provider</strong>". Check the
            <code>AI:Provider</code> setting.
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header">
        <h3 class="card-title">Connection Test</h3>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="TestConnection" onsubmit="document.getElementById('testBtn').disabled=true;document.getElementById('testSpin').style.display='inline-block';">
            <button type="submit" class="btn btn-primary" id="testBtn">
                <span class="spinner-border spinner-border-sm me-1" id="testSpin" role="status" style="display:none;"></span>
                <i class="ri-pulse-line align-bottom me-1"></i> Test Connection
            </button>
        </form>

        @if (Model.ProbeResult is not null)
        {
            var p = Model.ProbeResult;
            <hr />
            <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                @if (p.Reachable && p.ModelAvailable)
                {
                    <span class="einv-badge einv-badge-success"><i class="ri-checkbox-circle-line"></i> Reachable</span>
                    <span class="einv-badge einv-badge-success"><i class="ri-checkbox-circle-line"></i> Model Ready</span>
                }
                else if (p.Reachable)
                {
                    <span class="einv-badge einv-badge-success"><i class="ri-checkbox-circle-line"></i> Reachable</span>
                    <span class="einv-badge einv-badge-warning"><i class="ri-time-line"></i> Model Not Pulled</span>
                }
                else
                {
                    <span class="einv-badge einv-badge-danger"><i class="ri-error-warning-line"></i> Unreachable</span>
                }
                @if (p.LatencyMs is not null)
                {
                    <span class="text-muted small">@p.LatencyMs ms</span>
                }
            </div>
            <p class="text-muted mb-2">@p.Detail</p>
            @if (p.AvailableModels.Count > 0)
            {
                <details>
                    <summary class="text-muted small">Available models (@p.AvailableModels.Count)</summary>
                    <ul class="mt-2 mb-0">
                        @foreach (var m in p.AvailableModels)
                        {
                            <li><code>@m</code></li>
                        }
                    </ul>
                </details>
            }
        }
    </div>
</div>
