@page
@model eInvWorld.Pages.Admin.AuditLogModel
@{
    ViewData["Title"] = "Audit Trail";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1"><i class="ri-shield-check-line align-bottom me-1"></i> Audit Trail</h1>
                <p class="text-muted mb-0">Append-only, hash-chained. Each row's hash is computed over its contents plus the previous row's hash, so any insert, delete, or edit breaks the chain. Showing the latest 100 entries. Times are UTC.</p>
            </div>
            <form method="post" asp-page-handler="Verify">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="ri-shield-check-line align-bottom me-1"></i> Verify chain integrity
                </button>
            </form>
        </div>
    </div>
</div>

@if (Model.Verification is not null)
{
    <div class="alert @(Model.Verification.Ok ? "alert-success" : "alert-danger") d-flex align-items-center" role="alert">
        <div>
            <i class="@(Model.Verification.Ok ? "ri-checkbox-circle-line" : "ri-error-warning-line") align-bottom me-1"></i>@Model.Verification.Message
            @if (!Model.Verification.Ok && Model.Verification.FirstBrokenId is long brokenId)
            {
                <text> (first broken row: #@brokenId)</text>
            }
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="einv-table-head">
                    <tr>
                        <th>#</th>
                        <th>When (UTC)</th>
                        <th>Action</th>
                        <th>User</th>
                        <th>TIN</th>
                        <th>Invoice / UUID</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Entries.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No audit entries yet.</td></tr>
                    }
                    @foreach (var e in Model.Entries)
                    {
                        <tr>
                            <td>@e.Id</td>
                            <td>@e.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge bg-secondary">@e.Action</span></td>
                            <td><small>@e.UserName</small></td>
                            <td><small>@e.Tin</small></td>
                            <td><small>@(e.InvoiceNo ?? e.Uuid)</small></td>
                            <td><small>@e.IpAddress</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
