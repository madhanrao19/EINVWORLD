@page
@model eInvWorld.Pages.Admin.InvoiceSyncModel
@{
    ViewData["Title"] = "Manual Invoice Sync";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Manual Invoice Status Updater</h1>
                <p class="text-muted mb-0">Trigger an on-demand sync or bulk import against LHDN MyInvois.</p>
            </div>
            <a asp-page="/Admin/SyncJobs" class="btn btn-outline-secondary">
                <i class="ri-list-check-2 align-bottom me-1"></i> View Sync Jobs
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="hstack gap-2 flex-wrap">
            <form method="post" asp-page-handler="FullImportAll" onsubmit="showLoader()">
                <button type="submit" class="btn btn-warning" id="importButton">
                    <i class="ri-download-cloud-2-line align-bottom me-1"></i> Import All Invoices from LHDN
                </button>
            </form>

            <form method="post" asp-page-handler="Run" onsubmit="showLoader()">
                <button type="submit" class="btn btn-primary" id="syncButton">
                    <i class="ri-refresh-line align-bottom me-1"></i> Run Invoice Sync Now
                </button>
            </form>
        </div>

        <div id="loader" class="mt-3 d-flex align-items-center gap-2" style="display:none;">
            <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
            <span class="text-muted">Starting background sync, please wait...</span>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success mt-3 mb-0" role="alert">@TempData["Message"]</div>
        }
        @if (TempData["ResultSummary"] != null)
        {
            <div class="alert alert-info mt-2 mb-0" role="alert">
                @Html.Raw(TempData["ResultSummary"])
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function showLoader() {
            if (document.getElementById('syncButton')) document.getElementById('syncButton').disabled = true;
            if (document.getElementById('importButton')) document.getElementById('importButton').disabled = true;
            document.getElementById('loader').style.display = 'block';
        }

    </script>
}
