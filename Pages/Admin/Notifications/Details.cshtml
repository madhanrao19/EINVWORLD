@page
@model eInvWorld.Pages.Admin.Notifications.DetailsModel

@{
    ViewData["Title"] = "Notification Template Details";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="einv-page-title mb-1">Notification Template Details</h1>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Notification.TemplateName)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Notification.TemplateName)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Notification.Subject)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Notification.Subject)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Notification.Body)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Notification.Body)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Notification.NotificationType)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Notification.NotificationType)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Notification.IsActive)</dt>
            <dd class="col-sm-10">
                <span class="badge @(Model.Notification.IsActive ? "bg-success" : "bg-secondary")">@(Model.Notification.IsActive ? "Active" : "Inactive")</span>
            </dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Notification.CreatedDate)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Notification.CreatedDate)</dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-page="./Edit" asp-route-id="@Model.Notification.Id" class="btn btn-outline-secondary">Edit</a>
    <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
</div>
