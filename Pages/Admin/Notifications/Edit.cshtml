@page
@model eInvWorld.Pages.Admin.Notifications.EditModel

@{
    ViewData["Title"] = "Edit Notification Template";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="einv-page-title mb-1">Edit Notification Template</h1>
        <p class="text-muted mb-0">Update the subject, body, or activation state of this template.</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Notification.Id" />

            <div class="mb-3">
                <label asp-for="Notification.TemplateName" class="form-label"></label>
                <input asp-for="Notification.TemplateName" class="form-control" />
                <span asp-validation-for="Notification.TemplateName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notification.Subject" class="form-label"></label>
                <input asp-for="Notification.Subject" class="form-control" />
                <span asp-validation-for="Notification.Subject" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notification.Body" class="form-label"></label>
                <textarea id="notificationBody" asp-for="Notification.Body" class="form-control" rows="6" placeholder="Enter the notification body here..."></textarea>
                <span asp-validation-for="Notification.Body" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notification.NotificationType" class="form-label"></label>
                <select asp-for="Notification.NotificationType" class="form-select" asp-items="Model.NotificationTypeOptions">
                    <option value="">Select Notification Type</option>
                </select>
                <span asp-validation-for="Notification.NotificationType" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Notification.IsActive" class="form-check-input" />
                <label class="form-check-label">@Html.DisplayNameFor(model => model.Notification.IsActive)</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
