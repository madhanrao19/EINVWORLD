@page
@model eInvWorld.Pages.Admin.Notifications.IndexModel

@{
    ViewData["Title"] = "List of Templates for Notification Emails";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="einv-page-title mb-1">Notification Email Templates</h1>
            <p class="text-muted mb-0">Templates used to compose outbound system notification emails.</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">
            <i class="ri-add-line align-bottom me-1"></i> Create New Template
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table data-einv-table="notifications" data-einv-sort="client" class="table align-middle mb-0" id="dataTable1">
                <thead class="einv-table-head">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Notification[0].TemplateName)</th>
                        <th>@Html.DisplayNameFor(model => model.Notification[0].Subject)</th>
                        <th>@Html.DisplayNameFor(model => model.Notification[0].Body)</th>
                        <th>@Html.DisplayNameFor(model => model.Notification[0].NotificationType)</th>
                        <th>@Html.DisplayNameFor(model => model.Notification[0].IsActive)</th>
                        <th>@Html.DisplayNameFor(model => model.Notification[0].CreatedDate)</th>
                        <th>@Html.DisplayNameFor(model => model.Notification[0].UpdatedDate)</th>
                        <th class="col-action">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Notification.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No notification templates found.</td></tr>
                    }
                    @foreach (var item in Model.Notification)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.TemplateName)</td>
                            <td>@Html.DisplayFor(modelItem => item.Subject)</td>
                            <td class="text-truncate" style="max-width:280px;">@Html.DisplayFor(modelItem => item.Body)</td>
                            <td>@Html.DisplayFor(modelItem => item.NotificationType)</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td data-sort-value="@item.CreatedDate.ToString("o")">@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                            <td data-sort-value="@item.UpdatedDate.ToString("o")">@Html.DisplayFor(modelItem => item.UpdatedDate)</td>
                            <td class="col-action" data-label="Actions">
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm einv-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                        <i class="ri-more-fill align-middle"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a asp-page="./Details" asp-route-id="@item.Id" class="dropdown-item"><i class="ri-eye-fill align-bottom me-2 text-muted"></i> View</a></li>
                                        <li><a asp-page="./Edit" asp-route-id="@item.Id" class="dropdown-item"><i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a asp-page="./Delete" asp-route-id="@item.Id" class="dropdown-item text-danger"><i class="ri-delete-bin-fill align-bottom me-2"></i> Delete</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
