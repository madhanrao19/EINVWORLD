@page
@model EINVWORLD.Pages.Admin.Resources.EditModel
@using EINVWORLD.Models.Public
@{
    ViewData["Title"] = "Edit Resource";
}

@section Styles {
    <link href="~/assets/js/tinymce/skins/ui/oxide/skin.min.css" rel="stylesheet">
    <link href="~/tabler/css/einvworld-resources.css" rel="stylesheet">
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="einv-page-title mb-1">Edit Resource</h1>
    </div>
</div>

<form method="post" enctype="multipart/form-data" class="resource-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Resource.Id" />
    <input type="hidden" asp-for="Resource.ImageUrl" />
    <input type="hidden" asp-for="Resource.ThumbnailUrl" />

    <div class="row g-3">
        <!-- Main column -->
        <div class="col-xl-8">

            <!-- Basic Info -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header fw-semibold">Basic Info</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Resource.Title" class="form-label">Title *</label>
                        <input asp-for="Resource.Title" class="form-control" required />
                        <span asp-validation-for="Resource.Title" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Resource.ResourceTypeCode" class="form-label">Category</label>
                            <select asp-for="Resource.ResourceTypeCode" class="form-select" asp-items="Model.TypeOptions">
                                <option value="">-- Select Type --</option>
                            </select>
                            <span asp-validation-for="Resource.ResourceTypeCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Resource.Slug" class="form-label">
                                URL Slug
                                <a href="#" id="slugResetLink" class="small ms-1 d-none">(reset to auto)</a>
                            </label>
                            <input asp-for="Resource.Slug" class="form-control font-monospace" placeholder="Leave blank to auto-generate" />
                            <span asp-validation-for="Resource.Slug" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-0">
                        <div class="col-md-6">
                            <label asp-for="Resource.Author" class="form-label">Author</label>
                            <input asp-for="Resource.Author" class="form-control" maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Resource.DatePublished" class="form-label">Published Date</label>
                            <input asp-for="Resource.DatePublished" class="form-control" type="date" />
                            <span asp-validation-for="Resource.DatePublished" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cover Image -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header fw-semibold">Cover Image</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="ImageFile">Current Image</label>
                        @if (!string.IsNullOrEmpty(Model.Resource.ImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.Resource.ImageUrl" alt="Current Image" class="img-fluid rounded shadow-sm" style="max-height: 200px;" />
                            </div>
                        }
                        <label class="form-label">Upload New Image (optional)</label>
                        <input type="file" asp-for="ImageFile" class="form-control" accept="image/*" onchange="compressAndPreviewImage(event)" />
                        <img id="imagePreview" class="img-fluid rounded shadow-sm d-none mt-3" style="max-height: 200px;" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Resource.ImageAlt" class="form-label">Alt Text <span class="text-muted small">(for image SEO/accessibility)</span></label>
                        <input asp-for="Resource.ImageAlt" class="form-control" maxlength="200" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Resource.Summary" class="form-label d-flex justify-content-between">
                            <span>Summary</span>
                            <span class="text-muted small" data-char-counter-for="Resource_Summary" data-char-max="160">0 / 160</span>
                        </label>
                        <textarea asp-for="Resource.Summary" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Resource.Summary" class="text-danger"></span>
                    </div>

                    <div class="mb-1">
                        <label asp-for="Resource.Tldr" class="form-label">
                            AI Summary / TL;DR
                            <span class="text-muted small">(1-2 sentence answer-first summary for AI assistants to quote)</span>
                        </label>
                        <textarea asp-for="Resource.Tldr" class="form-control" rows="2" maxlength="400"></textarea>
                    </div>
                </div>
            </div>

            <!-- Full Content -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header fw-semibold">Full Content</div>
                <div class="card-body">
                    <textarea asp-for="Resource.ContentHtml" class="form-control" rows="10"></textarea>
                    <span asp-validation-for="Resource.ContentHtml" class="text-danger"></span>
                </div>
            </div>

            <!-- Structured Data -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header fw-semibold">Structured Data</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Resource.SchemaType" class="form-label">Schema Type</label>
                        <select asp-for="Resource.SchemaType" class="form-select" asp-items="Html.GetEnumSelectList<ResourceSchemaType>()"></select>
                        <div class="form-text">This content feeds structured data / FAQPage schema for search and AI answer engines.</div>
                    </div>

                    <div id="faqBuilderSection" class="d-none">
                        <label class="form-label">FAQ Questions</label>
                        <div id="faqItemsList">
                            @for (var i = 0; i < Model.Resource.FaqItems.Count; i++)
                            {
                                <div class="border rounded p-2 mb-2 faq-item-row">
                                    <div class="mb-2">
                                        <label class="form-label small mb-1">Question</label>
                                        <input type="text" class="form-control form-control-sm" name="Resource.FaqItems[@i].Question" value="@Model.Resource.FaqItems[i].Question" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small mb-1">Answer</label>
                                        <textarea class="form-control form-control-sm" rows="2" name="Resource.FaqItems[@i].Answer">@Model.Resource.FaqItems[i].Answer</textarea>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger faq-remove-btn">Remove</button>
                                </div>
                            }
                        </div>
                        <button type="button" id="addFaqItemBtn" class="btn btn-sm btn-outline-primary">
                            <i class="ri-add-line align-bottom me-1"></i> Add Question
                        </button>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Update</button>
                <a asp-page="/Admin/Resources/Manage" class="btn btn-outline-secondary">Cancel</a>
                <a href="/resources/article/@Model.Resource.Slug" class="btn btn-outline-secondary" target="_blank">
                    Preview Article
                </a>
            </div>
        </div>

        <!-- Right column: Publishing + SEO/GEO -->
        <div class="col-xl-4">
            <div class="einv-resource-sticky">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header fw-semibold">Publishing</div>
                    <div class="card-body">
                        <label asp-for="Resource.Status" class="form-label">Status</label>
                        <select asp-for="Resource.Status" class="form-select">
                            <option value="0">Draft</option>
                            <option value="1">Published</option>
                            <option value="2">Archived</option>
                        </select>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header fw-semibold">AI SEO &amp; Discovery</div>
                    <div class="card-body">
                        <div class="d-flex justify-content-center mb-3">
                            <svg width="100" height="100" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="40" fill="none" stroke="#e6e8eb" stroke-width="8" />
                                <circle id="seoGaugeCircle" cx="50" cy="50" r="40" fill="none" stroke="#10b981" stroke-width="8"
                                        stroke-linecap="round" transform="rotate(-90 50 50)" style="transition: stroke-dashoffset .2s ease;" />
                                <text x="50" y="55" text-anchor="middle" font-size="22" font-weight="700" id="seoGaugeValue">0</text>
                            </svg>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Resource.MetaTitle" class="form-label d-flex justify-content-between">
                                <span>Meta Title</span>
                                <span class="text-muted small" data-char-counter-for="Resource_MetaTitle" data-char-max="60">0 / 60</span>
                            </label>
                            <input asp-for="Resource.MetaTitle" class="form-control" maxlength="60" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Resource.MetaDescription" class="form-label d-flex justify-content-between">
                                <span>Meta Description</span>
                                <span class="text-muted small" data-char-counter-for="Resource_MetaDescription" data-char-max="160">0 / 160</span>
                            </label>
                            <textarea asp-for="Resource.MetaDescription" class="form-control" rows="2" maxlength="160"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Resource.FocusKeyword" class="form-label">Focus Keyword</label>
                            <input asp-for="Resource.FocusKeyword" class="form-control" maxlength="100" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Resource.CanonicalUrl" class="form-label">Canonical URL</label>
                            <input asp-for="Resource.CanonicalUrl" class="form-control font-monospace" maxlength="500" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Resource.OgText" class="form-label">Social Share Text <span class="text-muted small">(OG fallback)</span></label>
                            <textarea asp-for="Resource.OgText" class="form-control" rows="2" maxlength="200"></textarea>
                        </div>

                        <hr />

                        <div id="seoChecklist"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/resource-seo.js"></script>

    <script src="~/assets/js/tinymce/tinymce.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Initializing TinyMCE for Edit page...');

            if (typeof tinymce === 'undefined') {
                console.error('TinyMCE not loaded! Check the script path.');
                return;
            }

            tinymce.init({
                selector: '#Resource_ContentHtml',
                height: 400,
                menubar: false,
                plugins: 'image link code lists autoresize autolink',
                toolbar: 'undo redo | formatselect | bold italic underline | alignleft aligncenter alignright | bullist numlist | link unlink | image | code',
                branding: false,
                resize: true,

                // Enhanced link options
                link_title: false,
                link_assume_external_targets: true,
                link_context_toolbar: true,
                autolink_pattern: /^https?:\/\/\S+$/,

                // Link target options
                target_list: [
                    {title: 'Same window', value: ''},
                    {title: 'New window', value: '_blank'},
                    {title: 'Parent frame', value: '_parent'}
                ],

                // Custom link list for common internal pages
                link_list: [
                    {title: 'Home Page', value: '/'},
                    {title: 'About Us', value: '/about'},
                    {title: 'Contact Us', value: '/contact'},
                    {title: 'Resources', value: '/resources'},
                    {title: 'Invoice List', value: '/Invoices/InvoiceLists'},
                    {title: 'Create Invoice', value: '/Invoices/CreateInvoice'}
                ],

                images_upload_url: '/Admin/Resources/Edit?handler=UploadImage',
                automatic_uploads: true,
                file_picker_types: 'image',
                setup: function (editor) {
                    editor.on('init', function () {
                        console.log('TinyMCE initialized successfully on Edit page!');
                    });
                    editor.on('LoadContent', function () {
                        console.log('TinyMCE content loaded on Edit page');
                    });
                },
                images_upload_handler: function (blobInfo, success, failure) {
                    const formData = new FormData();
                    formData.append('image', blobInfo.blob(), blobInfo.filename());

                    // Add CSRF token
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (token) {
                        formData.append('__RequestVerificationToken', token);
                    }

                    fetch('/Admin/Resources/Edit?handler=UploadImage', {
                        method: 'POST',
                        body: formData
                    })
                        .then(res => {
                            if (!res.ok) {
                                throw new Error('Upload failed with status: ' + res.status);
                            }
                            return res.json();
                        })
                        .then(data => {
                            if (data.location) {
                                success(data.location);
                            } else {
                                failure('Server did not return image location.');
                            }
                        })
                        .catch(err => {
                            console.error('Image upload error:', err);
                            failure('Image upload error: ' + err.message);
                        });
                }
            }).then(function(editors) {
                console.log('TinyMCE editors created on Edit page:', editors.length);
            }).catch(function(error) {
                console.error('TinyMCE initialization failed on Edit page:', error);
            });

            // Form submit handler
            document.querySelector("form").addEventListener("submit", function () {
                console.log('Form submitting, triggering TinyMCE save...');
                tinymce.triggerSave();
            });
        });
    </script>

    <script>
        function compressAndPreviewImage(event) {
            const file = event.target.files[0];
            if (!file || !file.type.startsWith("image/")) return;

            const img = new Image();
            const reader = new FileReader();

            reader.onload = function (e) {
                img.src = e.target.result;
            };

            img.onload = function () {
                const canvas = document.createElement("canvas");
                const maxWidth = 1024;
                const scale = Math.min(maxWidth / img.width, 1);
                canvas.width = img.width * scale;
                canvas.height = img.height * scale;

                const ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                canvas.toBlob(function (blob) {
                    const newFile = new File([blob], file.name, { type: "image/jpeg" });

                    const dt = new DataTransfer();
                    dt.items.add(newFile);
                    event.target.files = dt.files;

                    const preview = document.getElementById("imagePreview");
                    preview.src = URL.createObjectURL(newFile);
                    preview.classList.remove("d-none");
                }, "image/jpeg", 0.75);
            };

            reader.readAsDataURL(file);
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            EinvResourceSeo.initResourceSeoForm();
        });
    </script>
}
