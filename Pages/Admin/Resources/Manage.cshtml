@page
@model EINVWORLD.Pages.Admin.Resources.ManageModel
@using EINVWORLD.Models.Public
@using EINVWORLD.Helpers
@{
    ViewData["Title"] = "Manage Resources | Admin";
}
<div class="row mb-4">
    <div class="col-12">
        <h1 class="einv-page-title mb-1">Manage Resources</h1>
        <p class="text-muted mb-0">Create and publish articles for the public Resources section.</p>
    </div>
</div>


@if (TempData["Message"] != null)
{
    <div id="successMessage" class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ri-check-double-line me-2"></i>
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="row">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <div class="flex-grow-1">
                        <a class="btn btn-primary" asp-page="Create">
                            <i class="ri-add-fill me-1 align-bottom"></i> Add New Resource
                        </a>
                    </div>
                    <a class="btn btn-outline-primary" asp-page="/Admin/Resources/Types/Index">
                        <i class="ri-folder-settings-line me-1"></i> Manage Resource Types
                    </a>

                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addTypeModal">
                        <i class="ri-folder-add-line me-1"></i> Add Resource Type
                    </button>

                    <form method="post" asp-page-handler="BackfillSlugs">
                        <button type="submit" class="btn btn-outline-warning">
                            <i class="ri-tools-line align-bottom me-1"></i> Generate Missing Slugs
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="addTypeModal" tabindex="-1" aria-labelledby="addTypeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-page-handler="AddType">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addTypeModalLabel">Add Resource Type</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="code" class="form-label">Code</label>
                                <input name="Code" id="code" class="form-control" maxlength="50" required />
                            </div>
                            <div class="mb-3">
                                <label for="name" class="form-label">Name</label>
                                <input name="Name" id="name" class="form-control" maxlength="100" required />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Type</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <div class="col-12 d-flex flex-column flex-xl-row gap-3 align-items-start">
        <div class="card border-0 shadow-sm flex-grow-1 w-100">
            <div class="card-header">
                <form method="get">
                    <div class="row g-2 align-items-end">

                        <!-- Title -->
                        <div class="col-md-3">
                            <label class="form-label">Search by Title</label>
                            <input type="text" name="FilterTitle" class="form-control form-control-sm" value="@Model.FilterTitle" />
                        </div>

                        <!-- Type -->
                        <div class="col-md-2">
                            <label class="form-label">Type</label>
                            <select asp-for="FilterType" class="form-select form-select-sm" asp-items="Model.ResourceTypeCodeOptions">
                                <option value="">-- All Types --</option>
                            </select>
                        </div>

                        <!-- Date From -->
                        <div class="col-md-2">
                            <label class="form-label">Date From</label>
                            <input id="filterDateFrom" name="FilterDateFrom" class="form-control form-control-sm"
                                   placeholder="Start Date" value="@Model.FilterDateFrom?.ToString("yyyy-MM-dd")" />
                        </div>

                        <!-- Date To -->
                        <div class="col-md-2">
                            <label class="form-label">Date To</label>
                            <input id="filterDateTo" name="FilterDateTo" class="form-control form-control-sm"
                                   placeholder="End Date" value="@Model.FilterDateTo?.ToString("yyyy-MM-dd")" />
                        </div>

                        <!-- Status -->
                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select name="FilterStatus" class="form-select form-select-sm">
                                <option value="">All</option>
                                <option value="Published" selected="@(Model.FilterStatus == "Published")">Published</option>
                                <option value="Draft" selected="@(Model.FilterStatus == "Draft")">Draft</option>
                                <option value="Archived" selected="@(Model.FilterStatus == "Archived")">Archived</option>
                            </select>
                        </div>

                        <!-- Buttons -->
                        <div class="col-md-auto d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-outline-primary mt-3">
                                <i class="ri-search-line align-bottom me-1"></i> Filter
                            </button>
                            <a href="/Admin/Resources/Manage" class="btn btn-sm btn-outline-secondary mt-3">Reset</a>
                        </div>

                    </div>
                </form>

                <div class="text-muted small mb-2">
                    Showing <strong>@Model.Resources.Count</strong> of <strong>@Model.TotalCount</strong> result(s)
                </div>
            </div>

            <div class="card-body">
                <div class="table-responsive mb-3">
                    <table class="table align-middle mb-0 einv-mobile-stack">
                        <thead class="einv-table-head">
                            <tr>
                                <th>ID</th>
                                <th>Image</th>
                                <th>Title &amp; SEO</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Resources.Any())
                            {
                                foreach (var item in Model.Resources)
                                {
                                    var seoScore = Model.SeoScores.TryGetValue(item.Id, out var s) ? s : 0;
                                    var seoTier = ResourceSeoScorer.Tier(seoScore);
                                    <tr>
                                        <td data-label="ID"><span class="font-monospace">@item.Id</span></td>
                                        <td data-label="Image">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <a href="@item.ImageUrl" target="_blank" title="Click to view full image">
                                                    <img src="@item.ImageUrl" alt="Preview" class="rounded shadow-sm" style="max-height: 60px; cursor: zoom-in;" />
                                                </a>
                                            }
                                        </td>
                                        <td data-label="Title &amp; SEO">
                                            <div class="fw-semibold" style="max-width:320px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@item.Title</div>
                                            <div class="mt-1 d-flex align-items-center gap-2 flex-wrap">
                                                <span class="einv-badge einv-badge-@(seoTier == "success" ? "success" : seoTier == "warning" ? "warning" : "danger")" title="SEO readiness score">
                                                    <i class="ri-@(seoTier == "success" ? "line-chart-line" : seoTier == "warning" ? "error-warning-line" : "close-circle-line")"></i>
                                                    SEO: @seoScore/100
                                                </span>
                                                @if (string.IsNullOrWhiteSpace(item.Slug))
                                                {
                                                    <span class="einv-badge einv-badge-neutral">Missing Slug</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small font-monospace">/@item.Slug</span>
                                                }
                                            </div>
                                        </td>
                                        <td data-label="Type" class="text-capitalize">@item.ResourceType?.Name</td>
                                        <td data-label="Date">@item.DatePublished.ToString("dd MMM yyyy")</td>
                                        <td data-label="Status">
                                            @switch (item.Status)
                                            {
                                                case ResourceStatus.Published:
                                                    <span class="badge bg-success">Published</span>
                                                    break;
                                                case ResourceStatus.Draft:
                                                    <span class="badge bg-warning text-dark">Draft</span>
                                                    break;
                                                case ResourceStatus.Archived:
                                                    <span class="badge bg-secondary">Archived</span>
                                                    break;
                                            }
                                        </td>
                                        <td data-label="Actions" class="col-action">
                                            <a href="/Admin/Resources/Edit?id=@item.Id" class="btn btn-sm btn-outline-secondary me-2">Edit</a>
                                            @if (!string.IsNullOrWhiteSpace(item.Slug))
                                            {
                                                <a href="/resources/article/@item.Slug" target="_blank" class="btn btn-sm btn-outline-primary me-2">Preview</a>
                                            }
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline delete-form">
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(this)">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center">No resources found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Resources pagination" class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="text-muted small">
                            Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount results
                        </div>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Page("Manage", new { PageNumber = Model.PageNumber - 1, FilterTitle = Model.FilterTitle, FilterType = Model.FilterType, FilterStatus = Model.FilterStatus, FilterDateFrom = Model.FilterDateFrom?.ToString("yyyy-MM-dd"), FilterDateTo = Model.FilterDateTo?.ToString("yyyy-MM-dd") })">Previous</a>
                            </li>
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="@Url.Page("Manage", new { PageNumber = p, FilterTitle = Model.FilterTitle, FilterType = Model.FilterType, FilterStatus = Model.FilterStatus, FilterDateFrom = Model.FilterDateFrom?.ToString("yyyy-MM-dd"), FilterDateTo = Model.FilterDateTo?.ToString("yyyy-MM-dd") })">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Page("Manage", new { PageNumber = Model.PageNumber + 1, FilterTitle = Model.FilterTitle, FilterType = Model.FilterType, FilterStatus = Model.FilterStatus, FilterDateFrom = Model.FilterDateFrom?.ToString("yyyy-MM-dd"), FilterDateTo = Model.FilterDateTo?.ToString("yyyy-MM-dd") })">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm flex-shrink-0 w-100" style="max-width: 300px;">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="ri-magic-line text-primary"></i>
                <span class="fw-semibold">AI SEO Assistant</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Global Site Health</span>
                        <span class="fw-semibold">@Model.GlobalSiteHealthPercent%</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-@(ResourceSeoScorer.Tier(Model.GlobalSiteHealthPercent))" role="progressbar"
                             style="width: @(Model.GlobalSiteHealthPercent)%;" aria-valuenow="@Model.GlobalSiteHealthPercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="border rounded p-2 mb-2 small">
                    <div class="fw-semibold mb-1"><i class="ri-lightbulb-line me-1"></i>Suggestion</div>
                    <div class="text-muted">Articles missing a Focus Keyword or Meta Description score lower with AI answer engines. Fill these in on the Create/Edit form's SEO panel.</div>
                </div>

                <div class="border rounded p-2 mb-3 small">
                    <div class="fw-semibold mb-1"><i class="ri-search-eye-line me-1"></i>Keyword Opportunity</div>
                    <div class="text-muted">Consider covering "e-invoice compliance Malaysia" — a high-value topic with limited current coverage.</div>
                </div>

                <button type="button" class="btn btn-outline-primary btn-sm w-100" disabled title="Full report not yet available">
                    Full SEO Report
                </button>
            </div>
        </div>
    </div>

</div>



@section Scripts {
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const message = document.getElementById('successMessage');
            if (message) {
                setTimeout(() => {
                    message.classList.remove('show');
                    setTimeout(() => message.remove(), 300);
                }, 3000);
            }
        });
    </script>

    <script>
        function confirmDelete(button) {
            Swal.fire({
                title: 'Are you sure?',
                text: "This will permanently delete the resource.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                buttonsStyling: false,
                showCloseButton: true,
                customClass: {
                    confirmButton: 'btn btn-danger w-xs me-2 mt-2',
                    cancelButton: 'btn btn-outline-secondary w-xs mt-2'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Find the parent form and submit
                    const form = button.closest('form');
                    if (form) form.submit();
                }
            });
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fromInput = document.querySelector('input[name="FilterDateFrom"]');
            const toInput = document.querySelector('input[name="FilterDateTo"]');

            const fromPicker = flatpickr(fromInput, {
                dateFormat: "Y-m-d",
                onChange: function (selectedDates) {
                    if (selectedDates.length > 0) {
                        toPicker.set('minDate', selectedDates[0]);
                    }
                }
            });

            const toPicker = flatpickr(toInput, {
                dateFormat: "Y-m-d",
                onChange: function (selectedDates) {
                    if (selectedDates.length > 0) {
                        fromPicker.set('maxDate', selectedDates[0]);
                    }
                }
            });

            // If values are already populated (e.g., after filter), sync min/max
            if (fromInput.value) {
                toPicker.set('minDate', fromInput.value);
            }
            if (toInput.value) {
                fromPicker.set('maxDate', toInput.value);
            }
        });
    </script>




}
