@page
@model EINVWORLD.Pages.Admin.Resources.Types.CreateModel

@{
    ViewData["Title"] = "Create Resource Type";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="einv-page-title mb-1">Create Resource Type</h1>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="ResourceType.Code" class="form-label"></label>
                <input asp-for="ResourceType.Code" class="form-control" />
                <span asp-validation-for="ResourceType.Code" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ResourceType.Name" class="form-label"></label>
                <input asp-for="ResourceType.Name" class="form-control" />
                <span asp-validation-for="ResourceType.Name" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
