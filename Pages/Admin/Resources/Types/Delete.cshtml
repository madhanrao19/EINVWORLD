@page
@model EINVWORLD.Pages.Admin.Resources.Types.DeleteModel

@{
    ViewData["Title"] = "Delete Resource Type";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="einv-page-title mb-1">Delete Resource Type</h1>
        <p class="text-muted mb-0">Are you sure you want to delete this resource type? This cannot be undone.</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ResourceType.Name)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.ResourceType.Name)</dd>
        </dl>

        <form method="post" class="mt-3 d-flex gap-2">
            <input type="hidden" asp-for="ResourceType.Code" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
        </form>
    </div>
</div>
