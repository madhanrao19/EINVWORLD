@page
@model EINVWORLD.Pages.Admin.Resources.Types.DetailsModel

@{
    ViewData["Title"] = "Resource Type Details";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="einv-page-title mb-1">Resource Type Details</h1>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ResourceType.Name)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.ResourceType.Name)</dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-page="./Edit" asp-route-id="@Model.ResourceType.Code" class="btn btn-outline-secondary">Edit</a>
    <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
</div>
