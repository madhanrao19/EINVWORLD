@page
@model EINVWORLD.Pages.Admin.Resources.Types.IndexModel

@{
    ViewData["Title"] = "Resource Types";
}

@section Styles {
    <link href="~/tabler/css/einvworld-resources.css" rel="stylesheet">
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="einv-page-title mb-1">Resource Types</h1>
            <p class="text-muted mb-0">Categories used to classify public Resources articles.</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">
            <i class="ri-add-line align-bottom me-1"></i> Add Resource Type
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table data-einv-table="resource-types" data-einv-sort="client" class="table align-middle mb-0">
                <thead class="einv-table-head">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.ResourceType[0].Name)</th>
                        <th>Code</th>
                        <th>SEO Prefix</th>
                        <th class="col-action">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ResourceType.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No resource types found.</td></tr>
                    }
                    @foreach (var item in Model.ResourceType)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td><span class="einv-code-chip">@item.Code</span></td>
                            <td><span class="text-muted font-monospace small">/@item.Code/</span></td>
                            <td class="col-action" data-label="Actions">
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm einv-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                        <i class="ri-more-fill align-middle"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a asp-page="./Details" asp-route-id="@item.Code" class="dropdown-item"><i class="ri-eye-fill align-bottom me-2 text-muted"></i> View</a></li>
                                        <li><a asp-page="./Edit" asp-route-id="@item.Code" class="dropdown-item"><i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a asp-page="./Delete" asp-route-id="@item.Code" class="dropdown-item text-danger"><i class="ri-delete-bin-fill align-bottom me-2"></i> Delete</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
