@page
@model eInvWorld.Pages.Admin.RoleManagementModel
@{
    ViewData["Title"] = "Role Management";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-pretitle">Admin</div>
            <h2 class="page-title">Role Management</h2>
            <p class="text-muted mt-1 mb-0">Choose which modules the Supplier and Buyer roles can access. Admin always has full access.</p>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header">
        <h3 class="card-title">Roles</h3>
        <p class="text-muted small mb-0">The roles assignable to any user via Manage Users &rarr; Change Role.</p>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="einv-table-head">
                    <tr>
                        <th scope="col">Role</th>
                        <th scope="col" class="col-action">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model.AllRoles)
                    {
                        var isCore = new[] { "Admin", "Supplier", "Buyer" }.Contains(role.Name);
                        <tr>
                            <td data-label="Role">
                                @role.Name
                                @if (isCore)
                                {
                                    <span class="einv-badge einv-badge-neutral ms-1">Core</span>
                                }
                            </td>
                            <td class="col-action" data-label="Action">
                                @if (!isCore)
                                {
                                    <form method="post" asp-page-handler="DeleteIdentityRole" onsubmit="return confirm('Delete the &quot;@role.Name&quot; role?');">
                                        <input type="hidden" name="roleId" value="@role.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <hr />
        <form method="post" asp-page-handler="CreateIdentityRole" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">New role name</label>
                <input type="text" name="name" class="form-control form-control-sm" required maxlength="256" placeholder="e.g. Accountant" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Add role</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header">
        <h3 class="card-title">Module Access</h3>
        <p class="text-muted small mb-0">Choose which modules the Supplier and Buyer roles can access. Admin always has full access.</p>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="einv-table-head">
                        <tr>
                            <th scope="col">Module</th>
                            @foreach (var role in eInvWorld.Pages.Admin.RoleManagementModel.ManagedRoles)
                            {
                                <th scope="col" class="text-center">@role</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var module in Model.Modules)
                        {
                            <tr>
                                <td data-label="Module">@module.DisplayName</td>
                                @foreach (var role in eInvWorld.Pages.Admin.RoleManagementModel.ManagedRoles)
                                {
                                    var key = $"{role}|{module.Key}";
                                    <td class="text-center" data-label="@role">
                                        <input class="form-check-input" type="checkbox" name="allowed" value="@key" @(Model.Grid[key] ? "checked" : "") />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button type="submit" class="btn btn-primary mt-3"><i class="ri-save-line me-1"></i> Save</button>
        </form>
    </div>
</div>
