@page
@using EINVWORLD.Services.Assistant
@model eInvWorld.Pages.Assistant.IndexModel
@{
    ViewData["Title"] = "E-Invoice Assistant";
    // Which mode panel to show first: whichever handler just posted back with content, else Ask.
    var activeMode = !string.IsNullOrEmpty(Model.SuggestionJson) ? "suggest"
        : (!string.IsNullOrEmpty(Model.RejectionExplanation) ? "explain" : "ask");
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">
                    E-Invoice Assistant <span class="badge bg-primary-soft text-primary align-middle" style="font-size: 0.65rem;">BETA</span>
                </h1>
                <p class="text-muted mb-0">Get help with Malaysian e-invoicing, draft invoices from plain text, and understand LHDN validation errors.</p>
            </div>
            @if (Model.Enabled)
            {
                <span class="einv-badge einv-badge-success"><i class="ri-checkbox-circle-line"></i> Assistant Enabled</span>
            }
            else
            {
                <span class="einv-badge einv-badge-neutral"><i class="ri-pause-circle-line"></i> Assistant Disabled</span>
            }
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex flex-wrap gap-3 justify-content-center text-muted" style="font-size: 0.8rem;">
                <span><i class="ri-lightbulb-line align-bottom me-1 text-primary"></i>AI Suggestions Only</span>
                <span><i class="ri-forbid-line align-bottom me-1 text-primary"></i>No Automatic Submissions</span>
                <span><i class="ri-user-search-line align-bottom me-1 text-primary"></i>Human Review Required</span>
            </div>
        </div>
    </div>
</div>

@if (!Model.Enabled)
{
    <div class="alert alert-warning">
        <i class="ri-settings-3-line"></i>
        <div>
            The assistant is currently <strong>disabled</strong>. To enable it, install
            <a href="https://ollama.com" target="_blank" rel="noopener">Ollama</a> on the server, pull a model
            (e.g. <code>ollama pull gemma3:12b</code>), then set <code>AI:Enabled = true</code> in configuration.
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorText))
{
    <div class="alert @(Model.IsSoftError ? "alert-warning" : "alert-danger")">@Model.ErrorText</div>
}

<div class="row g-4">
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.05em;">Assistant Mode</p>
                <div class="list-group list-group-flush" id="assistantModeNav">
                    <button type="button" class="list-group-item list-group-item-action border-0 rounded mb-1 assistant-mode-btn" data-mode="ask">
                        <i class="ri-chat-3-line align-bottom me-2 text-primary"></i>Ask a Question
                    </button>
                    <button type="button" class="list-group-item list-group-item-action border-0 rounded mb-1 assistant-mode-btn" data-mode="suggest">
                        <i class="ri-file-text-line align-bottom me-2 text-primary"></i>Create from Description
                    </button>
                    <button type="button" class="list-group-item list-group-item-action border-0 rounded assistant-mode-btn" data-mode="explain">
                        <i class="ri-error-warning-line align-bottom me-2 text-primary"></i>Fix an Error (LHDN)
                    </button>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body p-3">
                <p class="fw-semibold mb-1"><i class="ri-shield-check-line align-bottom me-1 text-primary"></i>Local Processing Guarantee</p>
                <p class="text-muted mb-0" style="font-size: 0.8rem;">
                    The assistant runs on a local, on-prem model — your invoice data never leaves this server, and nothing is ever submitted automatically.
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="card border-0 shadow-sm assistant-panel einv-chat-card" data-panel="ask" style="display: none;">
            <div class="card-header-clean d-flex align-items-center justify-content-between">
                <h5 class="mb-0 fw-bold text-dark"><i class="ri-chat-3-line align-bottom me-1"></i>Ask a Question</h5>
                @if (Model.Conversation.Count > 0)
                {
                    <button type="submit" form="askForm" formaction="?handler=NewChat" class="btn btn-sm btn-outline-secondary"><i class="ri-add-line align-bottom"></i> New chat</button>
                }
            </div>
            <div class="einv-chat-thread">
                @if (Model.Conversation.Count == 0)
                {
                    <div class="einv-chat-empty text-muted text-center">
                        <i class="ri-chat-3-line" style="font-size: 2rem;"></i>
                        <p class="mb-0 mt-2">Ask anything about Malaysian e-invoicing — try "When should I use a Credit Note vs a Refund Note?"</p>
                    </div>
                }
                else
                {
                    @foreach (var turn in Model.Conversation)
                    {
                        var isUser = turn.Role == "user";
                        <div class="einv-chat-msg @(isUser ? "einv-chat-msg-user" : "einv-chat-msg-assistant")">
                            <div class="einv-chat-avatar"><i class="@(isUser ? "ri-user-3-fill" : "ri-robot-2-fill")"></i></div>
                            <div class="einv-chat-bubble">@turn.Content</div>
                        </div>
                    }
                }
            </div>
            <div class="einv-chat-composer">
                <form method="post" asp-page-handler="Ask" id="askForm" class="d-flex align-items-end gap-2">
                    <input type="hidden" name="ChatHistoryJson" value="@Model.ChatHistoryJson" />
                    <textarea name="Question" id="askTextarea" class="form-control einv-chat-input" rows="1"
                              placeholder="Message the assistant..." disabled="@(!Model.Enabled)">@Model.Question</textarea>
                    <button type="submit" class="btn btn-primary einv-chat-send" disabled="@(!Model.Enabled)"><i class="ri-send-plane-2-fill"></i></button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm assistant-panel" data-panel="suggest" style="display: none;">
            <div class="card-header-clean"><h5 class="mb-0 fw-bold text-dark"><i class="ri-file-text-line align-bottom me-1"></i>Create from Description</h5></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Suggest" class="d-flex align-items-end gap-2">
                    <input type="hidden" name="ChatHistoryJson" value="@Model.ChatHistoryJson" />
                    <textarea name="Description" class="form-control einv-chat-input" rows="1"
                              placeholder="e.g. Sold 3 laptops to Acme Sdn Bhd in Penang at RM4500 each, 8% SST." disabled="@(!Model.Enabled)">@Model.Description</textarea>
                    <button type="submit" class="btn btn-primary einv-chat-send" disabled="@(!Model.Enabled)"><i class="ri-send-plane-2-fill"></i></button>
                </form>
                @if (!string.IsNullOrEmpty(Model.SuggestionJson))
                {
                    <hr />
                    @if (Model.Review is not null)
                    {
                        <div class="mb-2">
                            <p class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.7rem; letter-spacing: 0.05em;">Readiness Check</p>
                            <div class="d-flex flex-column gap-1 mb-2">
                                @foreach (var item in Model.Review.Items)
                                {
                                    var badgeClass = item.Severity switch
                                    {
                                        CheckSeverity.Error => "einv-badge-danger",
                                        CheckSeverity.Warning => "einv-badge-warning",
                                        _ => "einv-badge-success"
                                    };
                                    <div><span class="einv-badge @badgeClass">@item.Message</span></div>
                                }
                            </div>
                            @if (Model.Review.HasErrors)
                            {
                                <div class="alert alert-danger py-1 px-2 mb-0"><small><i class="ri-error-warning-line align-bottom me-1"></i>This suggestion has blocking issues — fix the description and regenerate before using it.</small></div>
                            }
                        </div>
                    }
                    <p class="text-muted mb-1"><small>Review the suggestion below. "Use in Create Invoice form" pre-fills the real form — you still pick the supplier/customer and confirm everything before saving. Nothing is submitted automatically.</small></p>
                    <pre id="suggestionJson" class="border rounded p-2 bg-light" style="white-space:pre-wrap;">@Model.SuggestionJson</pre>
                    <button type="button" id="useSuggestionBtn" class="btn btn-outline-primary btn-sm" disabled="@(Model.Review?.HasErrors ?? false)"><i class="ri-edit-line align-bottom me-1"></i>Use in Create Invoice form</button>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm assistant-panel" data-panel="explain" style="display: none;">
            <div class="card-header-clean"><h5 class="mb-0 fw-bold text-dark"><i class="ri-error-warning-line align-bottom me-1"></i>Fix an Error (LHDN)</h5></div>
            <div class="card-body">
                <p class="text-muted mb-2"><small>Paste the rejection / validation error from MyInvois (or from the invoice's status) and get a plain-English explanation plus how to fix it.</small></p>
                <form method="post" asp-page-handler="ExplainRejection" class="d-flex align-items-end gap-2">
                    <input type="hidden" name="ChatHistoryJson" value="@Model.ChatHistoryJson" />
                    <textarea name="RejectionText" class="form-control einv-chat-input" rows="1"
                              placeholder="e.g. CF321 - The TIN does not match the registered taxpayer for the supplied registration number." disabled="@(!Model.Enabled)">@Model.RejectionText</textarea>
                    <button type="submit" class="btn btn-primary einv-chat-send" disabled="@(!Model.Enabled)"><i class="ri-send-plane-2-fill"></i></button>
                </form>
                @if (!string.IsNullOrEmpty(Model.RejectionExplanation))
                {
                    <hr />
                    <div class="border rounded p-2 bg-light" style="white-space:pre-wrap;">@Model.RejectionExplanation</div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .assistant-mode-btn.active {
        background-color: var(--primary-soft, #e9f5ee);
        color: var(--primary-text, #0c5434);
        font-weight: 600;
    }

    /* Chat-style thread (Ask panel): scrolling message list + sticky bottom composer, like Gemini/ChatGPT. */
    .einv-chat-card {
        display: flex;
        flex-direction: column;
        height: 70vh;
        min-height: 420px;
    }

    .einv-chat-thread {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .einv-chat-empty {
        margin: auto;
        max-width: 360px;
    }

    .einv-chat-msg {
        display: flex;
        gap: 0.6rem;
        max-width: 85%;
    }

    .einv-chat-msg-user {
        flex-direction: row-reverse;
        align-self: flex-end;
        text-align: right;
    }

    .einv-chat-avatar {
        flex: 0 0 auto;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-soft, #e9f5ee);
        color: var(--primary-text, #0c5434);
    }

    .einv-chat-bubble {
        white-space: pre-wrap;
        padding: 0.65rem 0.9rem;
        border-radius: 0.9rem;
        background: #f4f6f8;
    }

    .einv-chat-msg-user .einv-chat-bubble {
        background: var(--primary-soft, #e9f5ee);
        color: var(--primary-text, #0c5434);
    }

    .einv-chat-composer {
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        padding: 0.75rem 1rem;
    }

    .einv-chat-input {
        resize: none;
        max-height: 160px;
        overflow-y: auto;
    }

    .einv-chat-send {
        flex: 0 0 auto;
        width: 2.5rem;
        height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        padding: 0;
    }
</style>

@section Scripts {
    <script>
        (function () {
            var buttons = document.querySelectorAll('.assistant-mode-btn');
            var panels = document.querySelectorAll('.assistant-panel');
            function activate(mode) {
                buttons.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-mode') === mode); });
                panels.forEach(function (p) { p.style.display = p.getAttribute('data-panel') === mode ? '' : 'none'; });
            }
            buttons.forEach(function (b) {
                b.addEventListener('click', function () { activate(b.getAttribute('data-mode')); });
            });
            activate('@activeMode');
        })();

        // Auto-resize every chat composer textarea, and let Enter submit (Shift+Enter = newline),
        // like Gemini/ChatGPT's message box.
        document.querySelectorAll('.einv-chat-input').forEach(function (ta) {
            function resize() { ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 160) + 'px'; }
            ta.addEventListener('input', resize);
            resize();
            ta.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    ta.form.requestSubmit();
                }
            });
        });

        // Keep the conversation scrolled to the latest message.
        var thread = document.querySelector('.einv-chat-thread');
        if (thread) thread.scrollTop = thread.scrollHeight;

        var btn = document.getElementById('useSuggestionBtn');
        if (btn) {
            btn.addEventListener('click', function () {
                try {
                    var pre = document.getElementById('suggestionJson');
                    if (!pre) return;
                    var parsed = JSON.parse(pre.textContent.trim());
                    sessionStorage.setItem('einv_prefill', JSON.stringify(parsed));
                    window.location.href = '/Invoices/CreateInvoice?prefill=1';
                } catch (e) {
                    alert('The suggestion is not valid JSON, so it cannot be loaded into the form. Try regenerating it.');
                }
            });
        }
    </script>
}
