@page
@model eInvWorld.Pages.Assistant.ProcessingHistoryModel

@{
    ViewData["Title"] = "AI Processing History";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="einv-page-title mb-1">Processing History</h1>
        <p class="text-muted mb-0">
            @(Model.IsAdmin ? "Every user's" : "Your") recent AI-assisted activity — invoice suggestions and document captures.
            All processing runs locally; nothing here is sent to a third party.
        </p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header">
        <h3 class="card-title">Invoice Suggestions</h3>
    </div>
    <div class="card-body">
        @if (Model.AssistantActivity.Any())
        {
            <div class="table-responsive einv-table-scroll-x">
                <table class="table align-middle mb-0 einv-mobile-stack" id="assistantHistoryTable">
                    <thead class="einv-table-head">
                        <tr>
                            <th scope="col">When</th>
                            @if (Model.IsAdmin)
                            {
                                <th scope="col">User</th>
                            }
                            <th scope="col">Summary</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.AssistantActivity)
                        {
                            <tr>
                                <td data-label="When">@entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                @if (Model.IsAdmin)
                                {
                                    <td data-label="User">@entry.UserName</td>
                                }
                                <td data-label="Summary" class="truncate" title="@entry.Data">@entry.Data</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted text-center py-4 mb-0">
                <i class="ri-robot-line fs-24 d-block mb-2"></i>
                No invoice suggestions generated yet — try the <a asp-page="/Assistant/Index">AI Assistant</a>.
            </p>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header">
        <h3 class="card-title">Document Captures</h3>
    </div>
    <div class="card-body">
        @if (Model.DocumentCaptures.Any())
        {
            <div class="table-responsive einv-table-scroll-x">
                <table class="table align-middle mb-0 einv-mobile-stack" id="captureHistoryTable">
                    <thead class="einv-table-head">
                        <tr>
                            <th scope="col">When</th>
                            @if (Model.IsAdmin)
                            {
                                <th scope="col">User</th>
                            }
                            <th scope="col">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.DocumentCaptures)
                        {
                            <tr>
                                <td data-label="When">@entry.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                @if (Model.IsAdmin)
                                {
                                    <td data-label="User">@(entry.UserName ?? "—")</td>
                                }
                                <td data-label="Details" class="truncate" title="@entry.NewValueJson">@entry.NewValueJson</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted text-center py-4 mb-0">
                <i class="ri-file-text-line fs-24 d-block mb-2"></i>
                No documents captured yet — try <a asp-page="/Invoices/CreateFromFile">AI Document Capture</a>.
            </p>
        }
    </div>
</div>
