@page
@model eInvWorld.Pages.Invoices.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutTabler";
    var hour = DateTime.Now.Hour;
    var timeGreeting = hour < 12 ? "Good morning" : (hour < 18 ? "Good afternoon" : "Good evening");
    var isSupplier = Model.UserType == "Supplier";
}
@* Ledger 3c: layout from the approved mockup — KPI band, ruled panels, quiet tiles. Components live in
   einvworld-tokens.css ("Ledger 3c"); ids used by dashboard.js (filter, charts, insight panels, aging
   drafts, recent-invoices export) are unchanged. *@

<div class="einv-ph">
    <div class="einv-ph-text">
        <h1 class="einv-page-title mb-1">
            @timeGreeting@(string.IsNullOrWhiteSpace(Model.DisplayName) ? "" : $", {Model.DisplayName.Split(' ')[0]}")
        </h1>
        <p class="text-muted mb-0">
            @if (Model.FilterType == "Month" && Model.UserType != "Buyer")
            {
                @($"{Model.TotalInvoices} invoice{(Model.TotalInvoices == 1 ? "" : "s")} this month. ")
            }
            Here is what's happening with your invoices.
        </p>
    </div>
    <div class="einv-ph-actions">
        <form method="get" id="filterForm" class="einv-period" aria-label="Period">
            <label for="filterType" class="visually-hidden">Period type</label>
            <select name="FilterType" id="filterType" class="form-select form-select-sm">
                <option value="Day" selected="@(Model.FilterType == "Day")">Specific day</option>
                <option value="Month" selected="@(Model.FilterType == "Month")">Full month</option>
                <option value="Year" selected="@(Model.FilterType == "Year")">Full year</option>
            </select>
            <label for="filterDate" class="visually-hidden">Date</label>
            <input id="filterDate"
                   type="@(Model.FilterType == "Month" ? "month" : "date")"
                   class="form-control form-control-sm"
                   value="@(Model.FilterType == "Month" ? Model.FilterDate?.ToString("yyyy-MM") : Model.FilterDate?.ToString("yyyy-MM-dd"))"
                   data-default-date="@(Model.FilterDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))"
                   onkeydown="return false;" />
            @* display:none is toggled by dashboard.js (Year mode) *@
            <select id="filterYear" class="form-select form-select-sm" aria-label="Year" style="display: none;">
                @for (int i = 2020; i <= DateTime.Now.Year + 5; i++)
                {
                    <option value="@i-01-01" selected="@(Model.FilterDate?.Year == i)">@i</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
        </form>
        @if (isSupplier)
        {
            <a href="/Invoices/CreateInvoice" class="btn btn-sm btn-primary einv-ph-new"><i class="ri-add-line" aria-hidden="true"></i>New invoice</a>
        }
    </div>
</div>

@if (Model.UserType == "Admin")
{
    <div class="einv-kpis">
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l">Total invoices</div>
            <div class="einv-kpi-v">@Model.TotalInvoices</div>
            <div class="einv-kpi-d">Submitted, rejected, valid, invalid and cancelled</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l">Companies</div>
            <div class="einv-kpi-v">@Model.TotalCompaniesCount</div>
            <div class="einv-kpi-d">Registered suppliers</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l">Users</div>
            <div class="einv-kpi-v">@Model.TotalUsersCount</div>
            <div class="einv-kpi-d">Active users</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l">Buyers</div>
            <div class="einv-kpi-v">@Model.TotalBuyerCount</div>
            <div class="einv-kpi-d">Registered buyers</div>
        </div>
    </div>

    <section class="einv-panel mb-4">
        <div class="einv-panel-h"><h2>Quick actions</h2><span class="einv-panel-sub">Common administrative tasks</span></div>
        <div class="einv-panel-b">
            <div class="einv-tiles">
                <a asp-page="/Suppliers/Index" class="einv-tile"><span class="einv-tile-ico"><i class="ri-building-line" aria-hidden="true"></i></span><span class="einv-tile-text"><b>Manage companies</b></span></a>
                <a asp-page="/Admin/Users/ManageUser" class="einv-tile"><span class="einv-tile-ico"><i class="ri-user-settings-line" aria-hidden="true"></i></span><span class="einv-tile-text"><b>Manage users</b></span></a>
                <a asp-page="/Admin/InvoiceSync" class="einv-tile"><span class="einv-tile-ico"><i class="ri-refresh-line" aria-hidden="true"></i></span><span class="einv-tile-text"><b>Invoice sync</b></span></a>
                <a asp-page="/Admin/Logs/Index" class="einv-tile"><span class="einv-tile-ico"><i class="ri-file-list-3-line" aria-hidden="true"></i></span><span class="einv-tile-text"><b>System audit</b></span></a>
            </div>
        </div>
    </section>
}
else if (isSupplier)
{
    // --- Generate bulletproof Start and End dates for the Invoice List ---
    DateTime baseDate = Model.FilterDate ?? DateTime.Now;
    DateTime start, end;

    if (Model.FilterType == "Day")
    {
        start = baseDate.Date;
        end = baseDate.Date.AddDays(1).AddTicks(-1);
    }
    else if (Model.FilterType == "Year")
    {
        start = new DateTime(baseDate.Year, 1, 1);
        end = new DateTime(baseDate.Year, 12, 31, 23, 59, 59);
    }
    else
    {
        start = new DateTime(baseDate.Year, baseDate.Month, 1);
        end = start.AddMonths(1).AddTicks(-1);
    }

    string dateParams = $"&submissionDateFrom={start:s}&submissionDateTo={end:s}";

    @* Needs Attention (Phase 1D): a distinct-invoice headline (never a sum of the badges, since one
       invoice can match more than one condition) that deep-links into the Invoice List's same
       "Needs Attention" filter — one filtering mechanism, not two. *@
    @if (Model.NeedsAttentionCount > 0)
    {
        <a href="/Invoices/InvoiceLists?invoiceDirection=All&internalStatus=NeedsAttention" class="einv-attn">
            <span class="einv-tile-ico"><i class="ri-error-warning-line" aria-hidden="true"></i></span>
            <span class="einv-attn-text">
                <b>@Model.NeedsAttentionCount invoice@(Model.NeedsAttentionCount == 1 ? "" : "s") need@(Model.NeedsAttentionCount == 1 ? "s" : "") attention</b>
                <span>Invalid, failed transmission, rejected, or drafts stuck more than 3 days</span>
            </span>
            <span class="einv-attn-pills">
                @if (Model.NeedsAttentionInvalidCount > 0)
                {
                    <span class="einv-badge einv-badge-danger">@Model.NeedsAttentionInvalidCount invalid</span>
                }
                @if (Model.NeedsAttentionTransmissionErrorCount > 0)
                {
                    <span class="einv-badge einv-badge-warning">@Model.NeedsAttentionTransmissionErrorCount transmission error@(Model.NeedsAttentionTransmissionErrorCount == 1 ? "" : "s")</span>
                }
                @if (Model.NeedsAttentionRejectedCount > 0)
                {
                    <span class="einv-badge einv-badge-warning">@Model.NeedsAttentionRejectedCount rejected</span>
                }
                @if (Model.NeedsAttentionAgingDraftsCount > 0)
                {
                    <span class="einv-badge einv-badge-neutral">@Model.NeedsAttentionAgingDraftsCount aging draft@(Model.NeedsAttentionAgingDraftsCount == 1 ? "" : "s")</span>
                }
            </span>
        </a>
    }

    <div class="einv-kpis">
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l">Total invoices</div>
            <div class="einv-kpi-v">@Model.TotalInvoices</div>
            <div class="einv-kpi-d">Submitted, rejected, valid, invalid and cancelled</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l">Users</div>
            <div class="einv-kpi-v">@Model.TotalUsersCount</div>
            <div class="einv-kpi-d">Assigned to your company</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l">Buyers</div>
            <div class="einv-kpi-v">@Model.TotalBuyerCount</div>
            <div class="einv-kpi-d">Your active buyer list</div>
        </div>
    </div>

    <div class="einv-kpis" role="group" aria-label="Invoices by status">
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-draft"></span>Draft</div>
            <div class="einv-kpi-v">@Model.DraftInvoices</div>
            <div class="einv-kpi-d">Not yet submitted</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-submitted"></span>Submitted</div>
            <div class="einv-kpi-v">@Model.SubmittedInvoices</div>
            <div class="einv-kpi-d">RM @Model.SubmittedAmount.ToString("N2")</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-valid"></span>Valid</div>
            <div class="einv-kpi-v">@Model.ValidInvoices</div>
            <div class="einv-kpi-d">RM @Model.TotalValidAmount.ToString("N2")</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-rejected"></span>Rejected</div>
            <div class="einv-kpi-v">@Model.RejectRequestInvoices</div>
            <div class="einv-kpi-d">RM @Model.RejectRequestAmount.ToString("N2")</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-invalid"></span>Invalid</div>
            <div class="einv-kpi-v">@Model.InvalidInvoices</div>
            <div class="einv-kpi-d">RM @Model.InvalidAmount.ToString("N2")</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-cancelled"></span>Cancelled</div>
            <div class="einv-kpi-v">@Model.CancelledInvoices</div>
            <div class="einv-kpi-d">RM @Model.CancelledAmount.ToString("N2")</div>
        </div>
    </div>

    <section class="einv-panel mb-4">
        <div class="einv-panel-h"><h2>Action center</h2><span class="einv-panel-sub">Common tasks and items that need you</span></div>
        <div class="einv-panel-b">
            <div class="einv-tiles">
                <a asp-page="/Invoices/CreateInvoice" class="einv-tile"><span class="einv-tile-ico"><i class="ri-add-box-line" aria-hidden="true"></i></span><span class="einv-tile-text"><b>Create invoice</b><small>Start a new e-invoice</small></span></a>
                <a href="/PublicCustomer/List" class="einv-tile"><span class="einv-tile-ico"><i class="ri-user-add-line" aria-hidden="true"></i></span><span class="einv-tile-text"><b>Manage buyers</b><small>View and add buyers</small></span></a>
                <a href="/Suppliers/Details?id=@Model.PrimaryCompanyId" class="einv-tile"><span class="einv-tile-ico"><i class="ri-building-line" aria-hidden="true"></i></span><span class="einv-tile-text"><b>My company</b><small>Update your profile</small></span></a>
                @* Alert tiles only render when there's something to act on (a 0-count alert implied a problem that wasn't there). *@
                @if (Model.ActionInvalidCount > 0)
                {
                    <a href="/Invoices/InvoiceLists?invoiceDirection=Sent&LHDNStatus=Invalid&status=Invalid@(dateParams)" class="einv-tile einv-tile-danger">
                        <span class="einv-tile-ico"><i class="ri-error-warning-line" aria-hidden="true"></i></span>
                        <span class="einv-tile-text"><b>LHDN invalid</b><small>Fix and resubmit</small></span>
                        <span class="einv-badge einv-badge-danger">@Model.ActionInvalidCount</span>
                    </a>
                }
                @if (Model.ActionTransmissionErrorCount > 0)
                {
                    <a href="/Invoices/InvoiceLists?invoiceDirection=Sent&InternalStatus=TransmissionError" class="einv-tile einv-tile-warning">
                        <span class="einv-tile-ico"><i class="ri-wifi-off-line" aria-hidden="true"></i></span>
                        <span class="einv-tile-text"><b>Connection failed</b><small>LHDN didn't respond. Try again later.</small></span>
                        <span class="einv-badge einv-badge-warning">@Model.ActionTransmissionErrorCount</span>
                    </a>
                }
            </div>
        </div>
    </section>

    <div class="row g-3 g-lg-4 mb-4">
        <div class="col-lg-8">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Invoice trends</h2><span class="einv-panel-sub" id="selectedYearText">(Year)</span></div>
                <div class="einv-panel-b"><div class="einv-chart einv-chart-lg"><canvas id="invoiceTypesMonthlyChart"></canvas></div></div>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Status breakdown</h2></div>
                <div class="einv-panel-b"><div class="einv-chart"><canvas id="statusChart"></canvas></div></div>
            </section>
        </div>
    </div>

    <div class="row g-3 g-lg-4 mb-4">
        <div class="col-lg-6">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Customer share</h2></div>
                <div class="einv-panel-b"><div class="einv-chart einv-chart-sm"><canvas id="customerChart"></canvas></div></div>
            </section>
        </div>
        <div class="col-lg-6">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Invoice types</h2></div>
                <div class="einv-panel-b"><div class="einv-chart einv-chart-sm"><canvas id="invoiceTypesChart"></canvas></div></div>
            </section>
        </div>
    </div>

    <div class="row g-3 g-lg-4 mb-4">
        <div class="col-lg-5">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Rejections and cancellations</h2></div>
                <div class="einv-panel-b"><div class="einv-chart einv-chart-lg"><canvas id="rejectedReasonsChart"></canvas></div></div>
            </section>
        </div>
        <div class="col-lg-7">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Suggested fixes</h2></div>
                <div class="einv-panel-b einv-scroll"><div id="rejectionFixesTable"></div></div>
            </section>
        </div>
    </div>

    <div class="row g-3 g-lg-4 mb-4">
        <div class="col-lg-6">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Buyers by rejection rate</h2></div>
                <div class="einv-panel-b">
                    <div id="buyerRejectionTable"><div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Loading</span></div></div></div>
                </div>
            </section>
        </div>
        <div class="col-lg-6">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Internal errors by user</h2></div>
                <div class="einv-panel-b">
                    <div id="internalErrorsTable"><div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Loading</span></div></div></div>
                </div>
            </section>
        </div>
    </div>

    <section class="einv-panel mb-4">
        <div class="einv-panel-h">
            <h2>Recent invoices</h2>
            <span class="einv-panel-sub">Latest 5</span>
            <div data-einv-columns-for="dash-recent"></div>
            <a href="/Invoices/ImportCsv" class="btn btn-sm btn-outline-secondary"><i class="ri-upload-cloud-2-line" aria-hidden="true"></i>Bulk import</a>
            <button type="button" onclick="exportRecentInvoices()" class="btn btn-sm btn-outline-secondary"><i class="ri-download-2-line" aria-hidden="true"></i>Export</button>
        </div>
        <div class="table-responsive einv-table-scroll-x">
            <table data-einv-table="dash-recent" class="table table-hover align-middle einv-mobile-stack" id="recentInvoicesTable">
                <thead class="einv-table-head">
                    <tr>
                        <th class="ps-4">Invoice</th>
                        <th>Customer / buyer</th>
                        <th>UUID</th>
                        <th class="text-end">Total (MYR)</th>
                        <th>Status</th>
                        <th>Last updated</th>
                        <th>Error / reason</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentInvoices)
                    {
                        var buyerName = item.Customer?.CompanyName ?? item.PublicCustomer?.CompanyName ?? "Unknown Buyer";
                        <tr>
                            <td data-label="Invoice" class="ps-4 fw-semibold">@item.InvoiceNo</td>
                            <td data-label="Customer" class="truncate" title="@buyerName">@buyerName</td>
                            <td data-label="UUID" class="text-muted font-monospace small">@(string.IsNullOrEmpty(item.UUID) ? "-" : (item.UUID.Length > 8 ? item.UUID.Substring(0, 8) + "..." : item.UUID))</td>
                            <td data-label="Total (MYR)" class="text-end einv-num">@item.TotalAmountIncTax?.ToString("N2")</td>
                            <td data-label="Status">@eInvWorld.Helpers.InvoiceStatusBadge.Render(item.LHDNStatusId)</td>
                            <td data-label="Last updated" class="text-muted small">@item.CreatedDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td data-label="Error / reason" class="truncate small @(string.IsNullOrEmpty(item.RejectedReason) ? "text-muted" : "text-danger")" title="@item.RejectedReason">@(string.IsNullOrEmpty(item.RejectedReason) ? "-" : item.RejectedReason)</td>
                            <td class="text-end pe-4 col-action">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Action</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/Invoices/InvoiceDetails2/@(string.IsNullOrEmpty(item.UUID) ? item.InvoiceNo : item.UUID)"><i class="ri-eye-line me-2" aria-hidden="true"></i>View document</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/Invoices/CreateInvoice?refId=@item.InvoiceNo&type=CreditNote"><i class="ri-file-damage-line me-2" aria-hidden="true"></i>Issue CN / DN</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="einv-panel mb-4">
        <div class="einv-panel-h">
            <h2>Aging drafts</h2>
            <span class="einv-badge einv-badge-warning">Older than 3 days</span>
            <div data-einv-columns-for="dash-aging-drafts"></div>
        </div>
        <div class="table-responsive einv-table-scroll-x">
            <table data-einv-table="dash-aging-drafts" class="table table-hover align-middle einv-mobile-stack">
                <thead class="einv-table-head">
                    <tr>
                        <th class="ps-4">Invoice</th>
                        <th>Buyer</th>
                        <th>Created</th>
                        <th>Days stuck</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody id="agingDraftsTableBody">
                    <tr><td colspan="5" class="text-center py-4"><div class="spinner-border spinner-border-sm text-warning" role="status"><span class="visually-hidden">Loading</span></div></td></tr>
                </tbody>
            </table>
        </div>
    </section>
}
else if (Model.UserType == "Buyer")
{
    // --- DATE CALCULATION FOR BUYER LINKS ---
    DateTime baseDate = Model.FilterDate ?? DateTime.Now;
    DateTime start, end;
    if (Model.FilterType == "Day") { start = baseDate.Date; end = baseDate.Date.AddDays(1).AddTicks(-1); }
    else if (Model.FilterType == "Year") { start = new DateTime(baseDate.Year, 1, 1); end = new DateTime(baseDate.Year, 12, 31, 23, 59, 59); }
    else { start = new DateTime(baseDate.Year, baseDate.Month, 1); end = start.AddMonths(1).AddTicks(-1); }
    string dateParams = $"&submissionDateFrom={start:s}&submissionDateTo={end:s}";

    <div class="einv-kpis" role="group" aria-label="Received invoices">
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-submitted"></span>Total received</div>
            <div class="einv-kpi-v">@Model.BuyerTotalReceivedCount</div>
            <div class="einv-kpi-d">RM @Model.BuyerTotalReceivedAmount.ToString("N2")</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-valid"></span>Valid / payable</div>
            <div class="einv-kpi-v">@Model.BuyerValidCount</div>
            <div class="einv-kpi-d">RM @Model.BuyerValidAmount.ToString("N2")</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-rejected"></span>Rejected</div>
            <div class="einv-kpi-v">@Model.BuyerRequestRejectCount</div>
            <div class="einv-kpi-d">RM @Model.BuyerRequestRejectAmount.ToString("N2")</div>
        </div>
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l"><span class="einv-dot einv-dot-cancelled"></span>Cancelled</div>
            <div class="einv-kpi-v">@Model.BuyerCancelledCount</div>
            <div class="einv-kpi-d">RM @Model.BuyerCancelledAmount.ToString("N2")</div>
        </div>
    </div>

    <section class="einv-panel mb-4">
        <div class="einv-panel-h"><h2>Purchasing action center</h2><span class="einv-panel-sub">Incoming invoices and disputes</span></div>
        <div class="einv-panel-b">
            <div class="einv-tiles">
                <a href="/Invoices/InvoiceLists?invoiceDirection=Received&LHDNStatus=Valid@(dateParams)" class="einv-tile">
                    <span class="einv-tile-ico"><i class="ri-checkbox-circle-line" aria-hidden="true"></i></span>
                    <span class="einv-tile-text"><b>Review valid invoices</b><small>Ready for processing</small></span>
                </a>
                <a href="/Invoices/InvoiceLists?invoiceDirection=Received&InternalStatus=RequestReject@(dateParams)" class="einv-tile einv-tile-danger">
                    <span class="einv-tile-ico"><i class="ri-error-warning-line" aria-hidden="true"></i></span>
                    <span class="einv-tile-text"><b>Review rejections</b><small>Rejected by you</small></span>
                    @if (Model.BuyerRequestRejectCount > 0)
                    {
                        <span class="einv-badge einv-badge-danger">@Model.BuyerRequestRejectCount</span>
                    }
                </a>
            </div>
        </div>
    </section>

    <section class="einv-panel mb-4">
        <div class="einv-panel-h"><h2>Spend trends</h2><span class="einv-panel-sub">(Year)</span></div>
        <div class="einv-panel-b"><div class="einv-chart"><canvas id="invoiceTypesMonthlyChart"></canvas></div></div>
    </section>

    <div class="row g-3 g-lg-4 mb-4">
        <div class="col-lg-6">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Top suppliers by spend</h2></div>
                <div class="einv-panel-b"><div class="einv-chart"><canvas id="buyerTopSuppliersChart"></canvas></div></div>
            </section>
        </div>
        <div class="col-lg-6">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Supplier quality</h2><span class="einv-panel-sub">Invoices with issues</span></div>
                <div class="einv-panel-b einv-scroll">
                    <div id="supplierRejectionTable"><div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Loading</span></div></div></div>
                </div>
            </section>
        </div>
    </div>

    <section class="einv-panel mb-4">
        <div class="einv-panel-h">
            <h2>Recent incoming invoices</h2>
            <span class="einv-panel-sub">Latest 5</span>
            <div data-einv-columns-for="dash-buyer-recent"></div>
            <a href="/Invoices/InvoiceLists?invoiceDirection=Received" class="btn btn-sm btn-outline-secondary">View all</a>
        </div>
        <div class="table-responsive einv-table-scroll-x">
            <table data-einv-table="dash-buyer-recent" class="table table-hover align-middle einv-mobile-stack">
                <thead class="einv-table-head">
                    <tr>
                        <th class="ps-4">Invoice</th>
                        <th>Supplier</th>
                        <th class="text-end">Total (MYR)</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentInvoices != null && Model.RecentInvoices.Count > 0)
                    {
                        @foreach (var item in Model.RecentInvoices)
                        {
                            bool isHighRisk = item.InternalStatusId == "RequestReject" || item.LHDNStatusId == "Invalid";
                            var supplierName = item.Supplier?.CompanyName ?? "Unknown Supplier";
                            <tr class="@(isHighRisk ? "einv-row-risk" : "")">
                                <td data-label="Invoice" class="ps-4 fw-semibold">
                                    @if (isHighRisk)
                                    {
                                        <i class="ri-error-warning-fill text-danger me-1" title="Requires attention" aria-label="Requires attention"></i>
                                    }
                                    @item.InvoiceNo
                                </td>
                                <td data-label="Supplier" class="truncate" title="@supplierName">@supplierName</td>
                                <td data-label="Total (MYR)" class="text-end einv-num">@item.TotalAmountIncTax?.ToString("N2")</td>
                                <td data-label="Status">
                                    @eInvWorld.Helpers.InvoiceStatusBadge.Render(item.LHDNStatusId)
                                    @if (item.InternalStatusId == "RequestReject")
                                    {
                                        <span class="einv-badge einv-badge-danger ms-1"><i class="ri-alert-line" aria-hidden="true"></i>Rejected</span>
                                    }
                                    else if (item.LHDNStatusId == "Invalid")
                                    {
                                        <span class="einv-badge einv-badge-danger ms-1"><i class="ri-error-warning-line" aria-hidden="true"></i>Action needed</span>
                                    }
                                </td>
                                <td data-label="Date" class="text-muted small">@item.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end pe-4 col-action">
                                    <a class="btn btn-sm @(isHighRisk ? "btn-danger" : "btn-outline-secondary")" href="/Invoices/InvoiceDetails2/@(string.IsNullOrEmpty(item.UUID) ? item.InvoiceNo : item.UUID)">
                                        @(isHighRisk ? "View issue" : "Review")
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6"><div class="einv-empty"><span class="einv-empty-icon" aria-hidden="true"><i class="ri-inbox-line"></i></span><p class="einv-empty-title">No invoices for this period</p><p class="einv-empty-text">Choose another period above to see received invoices.</p></div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (isSupplier)
{
    @* Floating create action for phones (the header's New invoice button covers wider screens).
       Plain link to the existing page — authorization is enforced by the CreateInvoice page itself. *@
    <a href="/Invoices/CreateInvoice" class="einv-fab" aria-label="Create e-Invoice" title="Create e-Invoice">
        <i class="ri-add-line" aria-hidden="true"></i>
    </a>
}
@section Scripts {
    <script src="/assets/libs/chart.js/chart.umd.js"></script>
    <script src="/assets/libs/chartjs-plugin-zoom/chartjs-plugin-zoom.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
