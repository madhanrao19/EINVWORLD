@page "{code:int?}"
@model ErrorModel
@{
    Layout = null;
}
@* Ledger mockup "Error pages": one page for every error code. wwwroot/js/status-pages.js renders the card
   (EN/BM) into #ew; the noscript block keeps a readable message without JavaScript. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="request-id" content="@Model.RequestId" />
    <title>Error @Model.Code · EinvWorld</title>
    <partial name="_Favicons" />
    <link rel="stylesheet" href="~/css/status-pages.css" asp-append-version="true" />
</head>
<body>
    <template id="ew-logo"><img class="logo-l" src="~/images/einvworld-logo.png" alt="EinvWorld"><img class="logo-d" src="~/images/einvworld-logo-light.png" alt="EinvWorld"></template>
    <div class="ew" id="ew" data-code="@Model.Code">
        <noscript>
            <div class="ew-card">
                <span class="ew-eyebrow">Error @Model.Code</span>
                <h1 class="ew-h">Something went wrong</h1>
                <p class="ew-lead">Go back and try again, or <a href="/">go to the dashboard</a>. Reference: <b class="ew-mono">@Model.RequestId</b></p>
            </div>
        </noscript>
    </div>
    <script src="~/js/status-pages.js" asp-append-version="true"></script>
</body>
</html>
