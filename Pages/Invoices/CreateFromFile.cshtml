@page
@using EINVWORLD.Services.Assistant
@model eInvWorld.Pages.Invoices.CreateFromFileModel
@{
    ViewData["Title"] = "Create Invoice from File";
    var currentStep = !string.IsNullOrEmpty(Model.SuggestionJson) ? 3 : (!string.IsNullOrEmpty(Model.ExtractedText) ? 2 : 1);
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">
                    AI Document Capture <span class="badge bg-primary-soft text-primary align-middle" style="font-size: 0.65rem;">BETA</span>
                </h1>
                <p class="text-muted mb-0">Upload an invoice PDF and turn it into a suggested invoice you can review, then load into the Create Invoice form.</p>
            </div>
            @if (Model.Enabled)
            {
                <span class="badge bg-success-subtle text-success px-3 py-2"><i class="ri-checkbox-circle-line align-bottom me-1"></i>Capture Enabled</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary px-3 py-2"><i class="ri-pause-circle-line align-bottom me-1"></i>Capture Disabled</span>
            }
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex align-items-center justify-content-center gap-2 gap-md-4 flex-wrap">
                @{
                    var steps = new[] { (1, "Upload"), (2, "Extract & Suggest"), (3, "Review") };
                }
                @foreach (var (num, label) in steps)
                {
                    var isActive = num == currentStep;
                    var isDone = num < currentStep;
                    <div class="d-flex align-items-center">
                        <span class="d-flex align-items-center justify-content-center rounded-circle @(isDone ? "bg-primary text-white" : (isActive ? "bg-primary text-white" : "bg-light text-muted border"))" style="width: 28px; height: 28px; font-size: 0.8rem; font-weight: 600;">
                            @(isDone ? "✓" : num.ToString())
                        </span>
                        <span class="ms-2 @(isActive ? "fw-bold text-dark" : "text-muted")" style="font-size: 0.85rem;">@label</span>
                    </div>
                    if (num < steps.Length)
                    {
                        <div class="flex-grow-1" style="height: 1px; background: #dee2e6; min-width: 24px; max-width: 60px;"></div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (!Model.Enabled)
{
    <div class="alert alert-warning">
        <i class="ri-settings-3-line"></i>
        <div>
            AI Document Capture is <strong>disabled</strong>. Set <code>DocumentCapture:Enabled = true</code> and
            enable AI (<code>AI:Enabled = true</code> with Ollama running) in configuration.
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorText))
{
    <div class="alert alert-danger">@Model.ErrorText</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <form method="post" enctype="multipart/form-data">
                    <label for="captureUpload" class="d-block border border-2 border-dashed rounded-3 p-4 text-center mb-3" style="border-color: var(--einv-border) !important; cursor: pointer;" id="einvCaptureDropzone">
                        <i class="ri-upload-cloud-2-line fs-24 d-block mb-2 text-primary"></i>
                        <span class="fw-semibold d-block">Click to choose a PDF invoice, or drag it here</span>
                        <span class="text-muted small" id="einvCaptureDropzoneFile">No file selected</span>
                        <input type="file" id="captureUpload" name="Upload" accept="application/pdf,.pdf" class="d-none"
                               onchange="document.getElementById('einvCaptureDropzoneFile').textContent = this.files.length ? this.files[0].name : 'No file selected';" />
                    </label>
                    <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
                        <span class="einv-badge einv-badge-neutral"><i class="ri-file-pdf-2-line"></i>PDF Only</span>
                        <span class="einv-badge einv-badge-neutral"><i class="ri-database-2-line"></i>Max @Model.MaxFileSizeMb MB</span>
                        @if (Model.OcrAvailable)
                        {
                            <span class="einv-badge einv-badge-neutral"><i class="ri-scan-line"></i>Scanned PDF OCR On</span>
                        }
                        else
                        {
                            <span class="einv-badge einv-badge-neutral"><i class="ri-scan-line"></i>Digital PDF Only</span>
                        }
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary" disabled="@(!Model.Enabled)">
                            <i class="ri-magic-line align-bottom me-1"></i> Extract &amp; Suggest
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ExtractedText))
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header-clean">
                    <button class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#extractedText">
                        <i class="ri-file-text-line align-bottom me-1"></i>Show extracted text (@Model.FileName)
                    </button>
                </div>
                <div id="extractedText" class="collapse">
                    <pre class="p-3 mb-0" style="white-space:pre-wrap; max-height:300px; overflow:auto; font-size: 0.8rem;">@Model.ExtractedText</pre>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                    <i class="ri-shield-check-line align-bottom me-1 text-primary"></i>Trust &amp; Security
                </p>
                <ul class="list-unstyled mb-0" style="font-size: 0.85rem;">
                    <li class="mb-2"><i class="ri-server-line align-bottom me-2 text-primary"></i>Processed locally — the file never leaves this server.</li>
                    <li class="mb-2"><i class="ri-user-search-line align-bottom me-2 text-primary"></i>Every extracted field must be manually reviewed before use.</li>
                    <li class="mb-0"><i class="ri-forbid-line align-bottom me-2 text-primary"></i>Never auto-submits — creates a form pre-fill only, after you confirm.</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        @if (!string.IsNullOrEmpty(Model.SuggestionJson))
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header-clean"><h5 class="mb-0 fw-bold text-dark"><i class="ri-file-list-3-line align-bottom me-1"></i>Suggested Invoice — Review Before Using</h5></div>
                <div class="card-body">
                    @if (Model.Review is not null)
                    {
                        <ul class="list-unstyled mb-2 d-flex flex-column gap-2">
                            @foreach (var item in Model.Review.Items)
                            {
                                var badgeClass = item.Severity switch
                                {
                                    CheckSeverity.Error => "einv-badge-danger",
                                    CheckSeverity.Warning => "einv-badge-warning",
                                    _ => "einv-badge-success"
                                };
                                var icon = item.Severity switch
                                {
                                    CheckSeverity.Error => "ri-close-circle-line",
                                    CheckSeverity.Warning => "ri-alert-line",
                                    _ => "ri-checkbox-circle-line"
                                };
                                <li>
                                    <span class="einv-badge @badgeClass"><i class="@icon"></i>@item.Message</span>
                                </li>
                            }
                        </ul>
                        @if (Model.Review.HasErrors)
                        {
                            <div class="alert alert-danger py-2 mb-2"><small>Fix the errors above before loading this into the form.</small></div>
                        }
                    }

                    <p class="text-muted mb-1"><small>"Use in Create Invoice form" pre-fills the real form — you still pick the supplier/customer and confirm everything before saving. Nothing is submitted automatically.</small></p>
                    <pre id="suggestionJson" class="border rounded p-2 bg-light" style="white-space:pre-wrap;">@Model.SuggestionJson</pre>
                    <button type="button" id="useSuggestionBtn" class="btn btn-outline-primary btn-sm" disabled="@(Model.Review?.HasErrors ?? false)"><i class="ri-edit-line align-bottom me-1"></i>Use in Create Invoice form</button>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5 text-muted">
                    <i class="ri-file-search-line fs-1 mb-2"></i>
                    <p class="mb-0">Upload a PDF to see the suggested invoice here.</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var dropzone = document.getElementById("einvCaptureDropzone");
            if (dropzone) {
                dropzone.addEventListener("dragover", function (e) { e.preventDefault(); dropzone.classList.add("border-primary"); });
                dropzone.addEventListener("dragleave", function () { dropzone.classList.remove("border-primary"); });
                dropzone.addEventListener("drop", function () { dropzone.classList.remove("border-primary"); });
            }
        })();
        (function () {
            var btn = document.getElementById('useSuggestionBtn');
            if (!btn) return;
            btn.addEventListener('click', function () {
                try {
                    var pre = document.getElementById('suggestionJson');
                    if (!pre) return;
                    var parsed = JSON.parse(pre.textContent.trim());
                    sessionStorage.setItem('einv_prefill', JSON.stringify(parsed));
                    window.location.href = '/Invoices/CreateInvoice?prefill=1';
                } catch (e) {
                    alert('The suggestion is not valid JSON, so it cannot be loaded into the form. Try regenerating it.');
                }
            });
        })();
    </script>
}
