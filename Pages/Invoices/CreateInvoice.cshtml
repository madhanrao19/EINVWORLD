<!-- Validation Errors -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-danger border-0">
                <div class="d-flex align-items-center">
                    <i class="ri-error-warning-line fs-5 me-2"></i>
                    <div>
                        <strong>Please fix the following errors:</strong>
                        <ul class="mb-0 mt-2">
