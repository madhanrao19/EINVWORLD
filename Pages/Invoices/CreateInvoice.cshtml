@section Scripts {
    <script>
        window.isEditMode = @(Model.Invoice?.InvoiceNo != null ? "true" : "false");
        window.primaryCompanyId = '@Model.PrimaryCompanyId';
        // Track the currently selected supplier TIN (used for self-billed classification rules)
        window.currentSupplierTIN = null;

        // Classification options HTML for dynamic item creation
        window.classificationOptionsHtml = `
            @foreach (var c in Model.ClassificationCodes)
            {
                    <option value="@c.Value">@c.Text</option>
            }
        `;

        // Unit options HTML for dynamic item creation (grouped to match the initial row's
        // asp-items-rendered <optgroup>s so newly-added rows look identical)
        window.unitOptionsHtml = `
            @foreach (var unitGroup in Model.UnitOptions.GroupBy(u => u.Group?.Name ?? ""))
            {
                    <optgroup label="@unitGroup.Key">
                    @foreach (var unit in unitGroup)
                    {
                            <option value="@unit.Value">@unit.Text</option>
                    }
                    </optgroup>
            }
        `;

        // Tax category options HTML for dynamic item creation
        window.taxCategoryOptionsHtml = `
            @foreach (var tax in Model.TaxCategoryOptions)
            {
                    <option value="@tax.Value">@tax.Text</option>
            }
        `;

        // Country of Origin options HTML for dynamic item creation (line-level Additional Information)
        window.countryOptionsHtml = `
            @foreach (var c in Model.CountryOptions)
            {
                    <option value="@c.Value">@c.Text</option>
            }
        `;

        // Saved-item dropdown options HTML for dynamic item creation
        window.savedItemsOptionsHtml = `
            @if (Model.SavedItems != null && Model.SavedItems.Any())
            {
                        foreach (var item in Model.SavedItems)
                        {
                                    <option value="@(item.Value?.Replace("\\", "\\\\").Replace("`", "\\`"))">@(item.Text?.Replace("`", "\\`"))</option>
                        }
            }
        `;

        // Server-side values read by create-invoice.js for RefUUID document-type detection.
        // create-invoice.js cannot contain Razor syntax, so these are bridged via window.*.
        window.invoiceCreateServerData = {
            modelDocTypeCode: '@Model.Invoice?.DocTypeCode',
            urlTypeParam: '@Request.Query["type"]',
            modelRefUUID: '@Model.Invoice?.RefUUID'
        };
    </script>
    <script src="~/js/invoices/invoice-debug-helpers.js" asp-append-version="true"></script>
    <script src="~/js/invoices/create-invoice.js" asp-append-version="true"></script>

    @* ── AI Assistant prefill ───────────────────────────────────────────────────
       When the user comes from the E-Invoice Assistant with ?prefill=1, populate the
       form from the suggestion stashed in sessionStorage. Fully defensive + wrapped in
       try/catch so it can never break normal Create Invoice behaviour. *@
    <script>
        (function () {
            try {
                var params = new URLSearchParams(window.location.search);
                if (params.get('prefill') !== '1') return;

                var raw = sessionStorage.getItem('einv_prefill');
                if (!raw) return;
                sessionStorage.removeItem('einv_prefill'); // one-shot; survive refreshes cleanly

                var s = JSON.parse(raw);

                function fire(el, type) { try { el.dispatchEvent(new Event(type, { bubbles: true })); } catch (e) { } }

                function applyPrefill() {
                    try {
                        // 1) Document type (select2-aware)
                        if (s.documentType) {
                            var dt = document.getElementById('docTypeCode');
                            if (dt && Array.from(dt.options).some(o => o.value === String(s.documentType))) {
                                dt.value = String(s.documentType);
                                if (window.jQuery && jQuery.fn.select2) { jQuery(dt).trigger('change'); } else { fire(dt, 'change'); }
                            }
                        }

                        // 2) Line items — make sure there are enough rows, then fill them
                        var items = Array.isArray(s.lineItems) ? s.lineItems : [];
                        var tbody = document.getElementById('lineItems');
                        var addBtn = document.getElementById('addItemBtn');
                        if (tbody && items.length) {
                            var existing = tbody.querySelectorAll('.item-row, tr').length;
                            for (var k = existing; k < items.length && addBtn; k++) { addBtn.click(); }

                            var rows = tbody.querySelectorAll('.item-row');
                            for (var r = 0; r < items.length && r < rows.length; r++) {
                                var row = rows[r], it = items[r] || {};
                                var desc = row.querySelector('.item-description');
                                var qty = row.querySelector('.quantity-input');
                                var price = row.querySelector('.price-input');
                                var cls = row.querySelector('.item-classification');
                                if (desc && it.description) { desc.value = it.description; fire(desc, 'input'); }
                                if (qty && (it.quantity || it.quantity === 0)) { qty.value = it.quantity; fire(qty, 'input'); }
                                if (price && (it.unitPrice || it.unitPrice === 0)) { price.value = it.unitPrice; fire(price, 'input'); }
                                if (cls && it.classificationCode && Array.from(cls.options).some(o => o.value === String(it.classificationCode))) {
                                    cls.value = String(it.classificationCode);
                                    if (window.jQuery && jQuery.fn.select2) { jQuery(cls).trigger('change'); } else { fire(cls, 'change'); }
                                }
                            }
                        }

                        var note = [s.buyerName ? ('Buyer: ' + s.buyerName) : '', s.buyerTin ? ('TIN: ' + s.buyerTin) : '', s.notes || '']
                            .filter(Boolean).join(' | ');
                        if (note) {
                            console.info('[AI prefill] Review the suggested values. ' + note);
                            try {
                                var banner = document.createElement('div');
                                banner.className = 'alert alert-info';
                                banner.textContent = '🤖 Prefilled from AI suggestion — review every field (especially supplier/customer, tax and classification) before saving. ' + note;
                                var form = document.querySelector('form');
                                if (form && form.parentNode) form.parentNode.insertBefore(banner, form);
                            } catch (e) { }
                        }
                    } catch (e) { console.error('[AI prefill] failed', e); }
                }

                // Run after the page's own scripts (select2, row handlers) have initialised.
                if (window.jQuery) { jQuery(function () { setTimeout(applyPrefill, 800); }); }
                else { window.addEventListener('load', function () { setTimeout(applyPrefill, 800); }); }
            } catch (e) { console.error('[AI prefill] init failed', e); }
        })();
    </script>

    <script type="module" src="~/js/template-invoice.js"></script>
}
