@page
@model EINVWORLD.Pages.Invoices.CreateInvoiceModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using eInvWorld.Helpers
@{
    Layout = "_LayoutTabler";
    ViewData["IsEditMode"] = false;
}

<style>
    /* Success Dialog Styling - Ensure consistent UUID/Submission UID display */
    .swal-submission-success .detail-item code.text-primary {
        background-color: rgba(58, 165, 100, 0.1) !important;  /* eInvWorld brand primary green background */
        color: #006948 !important;  /* eInvWorld brand primary green text */
        border: 1px solid rgba(58, 165, 100, 0.3) !important;
        border-radius: 0.25rem !important;
        padding: 0.25rem 0.5rem !important;
        font-weight: 600 !important;
        display: inline-block !important;
        font-size: 0.875rem !important;
    }
    
    .swal-submission-success .detail-item code.text-info {
        background-color: rgba(41, 156, 219, 0.1) !important;  /* Light blue background for UUID */
        color: #299cdb !important;  /* Bootstrap info color */
        border: 1px solid rgba(41, 156, 219, 0.3) !important;
        border-radius: 0.25rem !important;
        padding: 0.25rem 0.5rem !important;
        font-weight: 600 !important;
        display: inline-block !important;
        font-size: 0.875rem !important;
    }

    /* Responsive design for 1280x720 screens */
    @@media (max-width: 1366px) {
        .container-fluid {
            padding-left: 10px;
            padding-right: 10px;
        }

        .card {
            margin-bottom: 1rem;
        }

        .card-body {
            padding: 1rem;
        }

        .form-floating {
            margin-bottom: 0.75rem;
        }

        .table-responsive {
            font-size: 0.875rem;
        }

        .table th, .table td {
            padding: 0.5rem 0.25rem;
        }

        .btn {
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }

        .page-title-box {
            padding: 0.75rem !important;
        }

            .page-title-box h4 {
                font-size: 1.25rem;
            }

            .page-title-box p {
                font-size: 0.875rem;
            }

        .breadcrumb {
            font-size: 0.75rem;
        }

        .alert {
            padding: 0.75rem;
            font-size: 0.875rem;
        }

        .progress {
            height: 6px;
        }

            .progress + .d-flex small {
                font-size: 0.75rem;
            }
    }

    /* Compact form layout for smaller screens */
    @@media (max-width: 1280px) {
        .col-md-6 {
            margin-bottom: 0.5rem;
        }

        .col-md-4 {
            margin-bottom: 0.5rem;
        }

        .form-floating {
            margin-bottom: 0.5rem;
        }

        .card-header {
            padding: 0.75rem;
        }

            .card-header h5 {
                font-size: 1.1rem;
            }

            .card-header small {
                font-size: 0.8rem;
            }

        .avatar-sm {
            width: 2rem;
            height: 2rem;
        }

            .avatar-sm span {
                font-size: 0.875rem;
            }

        .table-responsive {
            font-size: 0.8rem;
        }

        .table th, .table td {
            padding: 0.375rem 0.25rem;
        }

        .form-control-sm, .form-select-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
        }

        .tax-row {
            padding: 0.5rem !important;
        }

            .tax-row .row {
                margin: 0;
            }

            .tax-row .col-6, .tax-row .col-3 {
                padding: 0.25rem;
            }
    }

    /* Ultra-compact for very small screens */
    @@media (max-width: 1024px) {
        .container-fluid {
            padding-left: 5px;
            padding-right: 5px;
        }

        .card-body {
            padding: 0.75rem;
        }

        .table-responsive {
            font-size: 0.75rem;
        }

        .form-control-sm, .form-select-sm {
            font-size: 0.75rem;
        }

        .btn-sm {
            font-size: 0.75rem;
        }
    }

    /* Ensure Select2 dropdowns match form-floating height and styling */
    .form-floating .select2-container {
        height: 58px; /* Match form-floating height */
    }

        .form-floating .select2-container .select2-selection {
            height: 58px;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
        }

        .form-floating .select2-container .select2-selection--single {
            display: flex;
            align-items: center;
            padding: 0.75rem 0.75rem;
        }

        .form-floating .select2-container .select2-selection__rendered {
            padding: 0;
            line-height: 1.5;
            color: #212529;
        }

        .form-floating .select2-container .select2-selection__placeholder {
            color: #6c757d;
        }

        .form-floating .select2-container .select2-selection__arrow {
            height: 56px;
            right: 0.75rem;
        }

    .form-floating .select2-container--bootstrap-5 .select2-selection {
        border-color: #dee2e6;
    }

    .form-floating .select2-container--bootstrap-5.select2-container--focus .select2-selection {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Ensure consistent spacing */
    .form-floating .select2-container {
        margin-bottom: 0;
    }

    /* Make table form fields match form-floating appearance */
    .invoice-table .form-control,
    .invoice-table .form-control-sm,
    .invoice-table .form-select {
        /* height: 48px !important; */
        padding: 0.75rem 0.75rem !important;
        border: 1px solid #dee2e6 !important;
        border-radius: 0.375rem !important;
        font-size: 1rem !important;
        /* line-height: 1.5 !important; */
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .invoice-table .form-control:focus,
        .invoice-table .form-control-sm:focus,
        .invoice-table .form-select:focus {
            border-color: #86b7fe !important;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
            outline: 0 !important;
        }

    


    /* Style Select2 dropdowns in table to match form-floating */
    .invoice-table .select2-container .select2-selection {
        height: 48px !important;
        border: 1px solid #dee2e6 !important;
        border-radius: 0.375rem !important;
        padding: 0.75rem 0.75rem !important;
    }

    .invoice-table .select2-container .select2-selection--single {
        display: flex !important;
        align-items: center !important;
        padding: 0.75rem 0.75rem !important;
    }

    .invoice-table .select2-container .select2-selection__rendered {
        padding: 0 !important;
        /* line-height: 1.5 !important; */
        color: #212529 !important;
    }

    .invoice-table .select2-container .select2-selection__arrow {
        height: 46px !important;
        right: 0.75rem !important;
    }

    .invoice-table .select2-container--bootstrap-5.select2-container--focus .select2-selection {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }

    /* Also apply to dynamically created elements */
    .tax-row .form-control,
    .tax-row .form-control-sm,
    .tax-row .form-select {
        height: 42px !important;
        padding: 0.5rem 0.75rem !important;
        border: 1px solid #dee2e6 !important;
        border-radius: 0.375rem !important;
        font-size: 0.9rem !important;
        line-height: 1.4 !important;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .tax-row .form-control:focus,
        .tax-row .form-control-sm:focus,
        .tax-row .form-select:focus {
            border-color: #86b7fe !important;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
            outline: 0 !important;
        }

    /* Fix Select2 + form-floating label overlap */
    .form-floating .select2-container--bootstrap-5 .select2-selection--single {
        padding-top: 1.6rem !important; /* Adjust as needed for your label size */
        padding-left: 0.75rem;
        padding-bottom: 0.375rem;
        min-height: 58px;
        display: flex;
        align-items: flex-end;
    }

    .form-floating .select2-container--bootstrap-5 .select2-selection__rendered {
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-top: 0 !important;
    }

    .form-floating > label {
        z-index: 10;
        pointer-events: none;
    }

    /* Loading spinner and indicator styles */
    .loading-spinner {
        z-index: 20;
    }

    .auto-populated-indicator {
        z-index: 20;
    }

    .form-control.is-valid {
        border-color: var(--einv-success);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2310b981' d='m2.3 6.73.94-.94 2.89 2.89 2.89-2.89.94.94L6.12 9.62z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

        .form-control.is-valid:focus {
            border-color: var(--einv-success);
            box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.25);
        }

    /* Debug panel styles */
    #debugPanel {
        font-size: 0.875rem;
    }

        #debugPanel small {
            font-size: 0.75rem;
        }

    /* Test button styles */
    .btn-outline-info:hover {
        background-color: #0dcaf0;
        border-color: #0dcaf0;
        color: #000;
    }

    /* SweetAlert customization for wider popup */
    .swal-wide {
        width: 500px !important;
        max-width: 95vw !important;
    }

    .swal-submission-success .swal2-html-container {
        margin: 0 !important;
        padding: 10px !important;
        text-align: left !important;
    }

    .swal-submission-success .submission-details {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
        margin-top: 10px;
    }

    .swal-submission-success .detail-item {
        margin-bottom: 12px;
        padding: 8px;
        background: white;
        border-radius: 5px;
        border-left: 3px solid #006948;  /* eInvWorld brand primary green */
    }

        .swal-submission-success .detail-item:last-child {
            margin-bottom: 0;
        }
        
        /* Specific border colors for different detail item types */
        .swal-submission-success .detail-item:has(code.text-primary) {
            border-left-color: #006948 !important;  /* Green for Submission UID */
        }
        
        .swal-submission-success .detail-item:has(code.text-info) {
            border-left-color: #299cdb !important;  /* Blue for UUID */
        }
        
        /* Ensure text alignment matches CreateInvoice template */
        .swal-submission-success .detail-item {
            text-align: left !important;
        }
        
        .swal-submission-success .detail-item strong {
            text-align: left !important;
            display: block !important;
            margin-bottom: 4px !important;
        }

    .swal-submission-success code {
        display: inline-block;
        background: #f1f3f4;
        padding: 4px 8px;
        border-radius: 4px;
        font-family: inherit;
        font-size: 14px;
        word-break: break-all;
        margin-top: 5px;
        width: 100%;
        border: 1px solid #dee2e6;
    }

    .swal-submission-success h6 {
        color: #6c757d !important;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .swal-submission-success .copy-btn {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 2px 6px;
        color: #6c757d;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: -2px;
    }

        .swal-submission-success .copy-btn:hover {
            background: #e9ecef;
            color: #495057;
            border-color: #adb5bd;
        }

        .swal-submission-success .copy-btn.copied {
            background: #d1edff;
            color: #0c63e4;
            border-color: #0c63e4;
        }

            .swal-submission-success .copy-btn.copied i:before {
                content: "\eb7a"; /* ri-check-line */
            }

   
    /* Optimizations for 1280x720 resolution using system fonts */
    @@media (max-width: 1280px) {
       

        .tax-row {
            margin-bottom: 0.2rem !important;
            padding: 0.15rem !important;
        }

        .tax-section .btn-sm {
            padding: 0.1rem 0.2rem;
        }
       
        /* Responsive tax section */
        .tax-category-wrapper {
            flex: 1 1 auto;
        }

        .tax-percentage-wrapper {
            flex: 0 0 50px;
        }

        .tax-action-wrapper {
            flex: 0 0 auto;
        }
    }

    /* Responsive breakpoints for tax section */
    @@media (max-width: 1200px) {
        .tax-row .d-flex.flex-wrap {
            flex-direction: column;
            gap: 0.25rem !important;
        }

        .tax-category-wrapper,
        .tax-percentage-wrapper {
            flex: none;
            width: 100%;
        }

        .tax-percentage-wrapper {
            max-width: 80px;
        }

        .tax-action-wrapper {
            width: auto;
            align-self: flex-end;
        }
    }

    /* Extra responsive for very narrow tax columns */
    @@media (max-width: 768px) {
        .tax-row .d-flex.flex-wrap {
            flex-direction: column;
        }

        .tax-category-wrapper,
        .tax-percentage-wrapper,
        .tax-action-wrapper {
            width: 100%;
            max-width: none;
        }

        .tax-action-wrapper {
            align-self: flex-start;
        }
    }

    /* Copy toast animation */
    @@keyframes fadeInOut {
        0% {
            opacity: 0;
            transform: translateY(-10px);
        }

        20% {
            opacity: 1;
            transform: translateY(0);
        }

        80% {
            opacity: 1;
            transform: translateY(0);
        }

        100% {
            opacity: 0;
            transform: translateY(-10px);
        }
    }

    /* Action buttons styling */
    .item-row .d-flex.gap-1 {
        flex-wrap: nowrap;
    }

    .btn-outline-success:hover {
        background-color: var(--einv-success);
        border-color: var(--einv-success);
        color: white;
    }

    .btn-outline-danger:hover {
        background-color: var(--einv-error);
        border-color: var(--einv-error);
        color: white;
    }

    /* Tooltip styling for action buttons */
    .btn[title]:hover::after {
        content: attr(title);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        white-space: nowrap;
        z-index: 1000;
        margin-bottom: 4px;
    }

    /* Icon button styling for actions */
    .ri-file-copy-line,
    .ri-delete-bin-line {
        border-radius: 3px;
    }

    /* Error/success styling is driven exclusively by the .is-invalid/.is-valid classes that
       validateField()/validateRow()/updateFieldStyling() already toggle on blur, on input (once a
       field has been touched), and on a failed Next/Review/Submit attempt. Deliberately NOT keyed
       off the native :invalid/:valid pseudo-classes (removed here) — those fire from raw HTML5
       constraint validation the instant the page renders, independent of any user interaction, which
       is what caused every empty required field to render red on first load. */
    .form-control.is-invalid,
    .form-select.is-invalid {
        background-image: none !important;
        border-color: var(--einv-error) !important;
        box-shadow: 0 0 0 0.2rem rgba(239, 68, 68, 0.25) !important;
    }

    .form-control.is-valid,
    .form-select.is-valid {
        background-image: none !important;
        border-color: var(--einv-success) !important;
        box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.25) !important;
    }

    /* select2-bootstrap-5-theme already colors a Select2 box red/green when the underlying <select>
       carries .is-invalid/.is-valid (via `.is-invalid + .select2-container--bootstrap-5 ...`), but
       this page's own `.form-floating .select2-container--bootstrap-5 .select2-selection` border
       override above (needed for layout) has equal specificity and comes later in the cascade, so it
       silently wins and the Select2 box never visibly changes color. Restated here, scoped to match,
       so a Select2 field's error state is actually visible instead of only affecting its hidden
       native <select>. */
    .is-invalid + .select2-container--bootstrap-5 .select2-selection,
    .form-floating .is-invalid + .select2-container--bootstrap-5 .select2-selection,
    #lineItemsTable .is-invalid + .select2-container--bootstrap-5 .select2-selection,
    .tax-row .is-invalid + .select2-container--bootstrap-5 .select2-selection {
        border-color: var(--einv-error) !important;
        box-shadow: 0 0 0 0.2rem rgba(239, 68, 68, 0.25) !important;
    }

    /* Deliberately excludes #lineItemsTable/.tax-row: that table already suppresses blanket
       .is-valid green styling below (by design, to avoid an unexplained all-green item grid), so its
       Select2 fields stay consistent with its plain inputs and don't turn green either. */
    .is-valid + .select2-container--bootstrap-5 .select2-selection,
    .form-floating .is-valid + .select2-container--bootstrap-5 .select2-selection {
        border-color: var(--einv-success) !important;
        box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.25) !important;
    }

    /* Override CSS validation for fields with values - force normal appearance */
    #lineItemsTable input[required]:valid,
    #lineItemsTable select[required]:valid,
    #lineItemsTable textarea[required]:valid,
    #lineItemsTable input[required]:not(.is-invalid),
    #lineItemsTable select[required]:not(.is-invalid),
    #lineItemsTable textarea[required]:not(.is-invalid),
    #lineItemsTable .form-control:valid,
    #lineItemsTable .form-control.is-valid,
    #lineItemsTable .form-select:valid,
    #lineItemsTable .form-select.is-valid {
        border-color: var(--einv-border) !important;
        box-shadow: none !important;
        background-image: none !important;
    }

    /* Specifically override Bootstrap's valid state styling */
    #lineItemsTable .is-valid,
    #lineItemsTable .was-validated .form-control:valid,
    #lineItemsTable .was-validated .form-select:valid {
        border-color: var(--einv-border) !important;
        box-shadow: none !important;
        background-image: none !important;
    }

    /* Force normal borders for all filled fields in invoice table */
    #lineItemsTable .form-control[value]:not([value=""]):not(.is-invalid),
    #lineItemsTable .form-select[value]:not([value=""]):not(.is-invalid),
    #lineItemsTable textarea:not(:placeholder-shown):not(.is-invalid) {
        border-color: var(--einv-border) !important;
        box-shadow: none !important;
        background-image: none !important;
    }

        /* Improve Textarea usability */
        #lineItemsTable textarea {
            resize: vertical;
            min-height: 70px;
            white-space: pre-wrap !important;
        }

    /* Enhanced card styling for form sections */
    .page-title-box {
        border: 1px solid var(--einv-border);
        box-shadow: 0 2px 4px rgba(0, 0, 0, .02);
        border-radius: 0.5rem;
    }

    /* Card styling for form groups */
    .form-group-card {
        border: 1px solid var(--einv-border);
        border-radius: 0.375rem;
        padding: 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 2px 4px rgba(0, 0, 0, .02);
    }

    /* Normal card styling for all sections — border/shadow match the app-wide .card treatment
       (wwwroot/tabler/css/einvworld-tokens.css) instead of the flat Bootstrap defaults this page
       had before the "EinvWorld Professional" rebrand, so cards here look consistent with the rest
       of the app instead of losing their soft ambient shadow. */
    .card,
    .card-body {
        border: 1px solid var(--einv-border);
        border-radius: 0.375rem;
        box-shadow: 0 2px 4px rgba(0, 0, 0, .02);
    }

    /* Standard table styling */
    .table-responsive {
        border: 1px solid var(--einv-border);
        border-radius: 0.375rem;
        box-shadow: 0 2px 4px rgba(0, 0, 0, .02);
        overflow: hidden;
    }

    /* Tax row card styling */
    .tax-row {
        background: var(--einv-page-bg);
        border: 1px solid var(--einv-border) !important;
        border-radius: 0.375rem !important;
    }

    /* Item row card styling */
    .item-row {
        background: #fff;
    }

    /* Phase 2D: dense accounting-grid layout for item rows on desktop (>=992px). */
    .irow-head {
        display: none;
    }
    @@media (min-width: 992px) {
        .irow-head {
            display: flex;
            gap: .5rem;
            padding: .35rem .75rem;
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--einv-muted, #6c757d);
            border-bottom: 1px solid var(--einv-border, #e9ecef);
            margin-bottom: .25rem;
        }
        .irow {
            display: flex;
            flex-wrap: nowrap;
            align-items: flex-start;
            gap: .5rem;
        }
    }
    .irow {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: .5rem;
        padding: .5rem .75rem;
    }
    .irow-num,
    .irow-head-num { flex: 0 0 24px; padding-top: .4rem; color: var(--einv-muted, #6c757d); font-size: .8rem; }
    .irow-desc,
    .irow-head-desc { flex: 1 1 280px; min-width: 260px; }
    .irow-qty,
    .irow-head-qty { flex: 0 0 70px; }
    .irow-price,
    .irow-head-price { flex: 0 0 100px; }
    .irow-total,
    .irow-head-total { flex: 0 0 110px; }
    .irow-actions,
    .irow-head-actions { flex: 0 0 60px; text-align: right; }
    .irow-mlabel {
        font-size: .65rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: var(--einv-muted, #6c757d);
        margin-bottom: .15rem;
    }
    @@media (min-width: 992px) {
        .irow .irow-mlabel { display: none; }
    }
    /* Item Code has no desktop column header of its own (nested inside .irow-desc) - unlike
       Classification/Unit/Qty/Price, its label must stay visible at every width. */
    .irow-desc .irow-mlabel-always {
        font-size: .65rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: var(--einv-muted, #6c757d);
        margin-bottom: .15rem;
    }
    .irow-desc .item-code { margin-top: .25rem; }
    .irow-num-val {
        text-align: right;
        font-weight: 600;
        padding: .25rem 0;
    }
    .irow-num-val.irow-total-val { color: var(--einv-primary, #006948); }

    /* Phase 4: purpose-built mobile layout for item rows (<992px) — was previously just the dense
       grid's fields wrapping at their desktop pixel widths (cramped, unevenly sized on a phone).
       CSS-only change, same markup/classes as desktop — a 2-up field grid instead of independent-width
       wrapping, full-width Item/Service + Subtotal/Total + Actions, larger tap targets. */
    @@media (max-width: 991.98px) {
        .irow {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .6rem .75rem;
            padding: .85rem .75rem;
        }
        .irow-num {
            grid-column: 1 / -1;
            font-weight: 600;
            font-size: .75rem;
            color: var(--einv-primary, #006948);
            padding-top: 0;
        }
        .irow-num::before { content: "Item #"; }
        .irow-desc {
            grid-column: 1 / -1;
        }
        .irow-total {
            grid-column: 1 / -1;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: .25rem .75rem;
            background: var(--einv-page-bg, #f8f9fa);
            border-radius: .375rem;
            padding: .5rem .65rem;
        }
        .irow-total .irow-mlabel { margin-bottom: 0; }
        .irow-actions {
            grid-column: 1 / -1;
            display: flex;
            justify-content: flex-end;
            gap: 1.25rem;
            padding-top: .35rem;
            border-top: 1px dashed var(--einv-border, #e9ecef);
        }
        .irow-actions .btn {
            padding: .35rem .5rem;
            font-size: 1.05rem;
        }
    }

    /* Phase C: optional, progressive line-level sections (Discount / Fee-Charge / Taxes /
       Additional Information) — collapsed by default, toggled by a small pill button row below
       the dense grid. Not permanently expanded, per the redesign spec. */
    .irow-extras {
        padding: 0 .75rem .5rem;
        border-top: 1px dashed var(--einv-border, #e9ecef);
        margin-top: .25rem;
    }
    .irow-extras-toggles {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        padding-top: .5rem;
    }
    .irow-extras-toggle {
        border: 1px solid var(--einv-border, #e9ecef);
        background: var(--einv-page-bg, #f8f9fa);
        color: var(--einv-muted, #6c757d);
        border-radius: 999px;
        font-size: .72rem;
        padding: .2rem .65rem;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
    }
    .irow-extras-toggle i { font-size: .85rem; }
    .irow-extras-toggle:not(.collapsed) {
        border-color: var(--einv-primary, #006948);
        color: var(--einv-primary, #006948);
        background: rgba(0, 105, 72, .06);
    }
    .irow-extras-panel {
        padding: .6rem 0 .1rem;
    }
    .irow-extras-panel .tax-row {
        max-width: 480px;
    }

    /* Progress bar card styling */
    .progress {
        background: var(--einv-border);
        border-radius: 0.5rem;
        box-shadow: inset 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    /* Standard button styling */
    .btn {
        border-radius: 0.375rem;
        box-shadow: none;
    }

    /* Enhanced RefUUID dropdown styles */
    .select2-dropdown-custom .select2-results__option--highlighted {
        background-color: #f8f9fa !important;
        border-left: 3px solid #006948 !important;
    }

    .select2-dropdown-custom .select2-results__option {
        border-bottom: 1px solid #eee;
        transition: all 0.2s ease;
    }

        .select2-dropdown-custom .select2-results__option:hover {
            background-color: #f0f8f4 !important;
        }

    /* RefUUID select container styling */
    #refUUIDSelect + .select2-container .select2-selection--single {
        height: calc(3.5rem + 2px) !important;
        padding: 1rem 0.75rem !important;
        border: 1px solid var(--einv-border) !important;
        border-radius: 0.375rem !important;
    }

    #refUUIDSelect + .select2-container .select2-selection__rendered {
        /* Reserve room on the right for the clear ("x") and dropdown-arrow icons — without it, a
           long reference UUID runs text right up against/under them with no breathing room. */
        padding: 0 42px 0 0 !important;
        height: auto !important;
        line-height: 1.5 !important;
        color: #495057 !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    #refUUIDSelect + .select2-container .select2-selection__placeholder {
        color: #6c757d !important;
    }

    /* Highlighting for existing vs new RefUUIDs */
    .select2-dropdown-custom .select2-results__option:hover {
        background-color: #f8f9fa !important;
    }

        /* Enhanced hover effects for highlighted entries */
        .select2-dropdown-custom .select2-results__option:hover div[style*="background-color: #f0f8f4"] {
            background-color: #e8f5ea !important;
        }

        .select2-dropdown-custom .select2-results__option:hover div[style*="background-color: #fff8f0"] {
            background-color: #fef3e2 !important;
        }

    #lineItemsTable select.saved-item-select,
    #lineItemsTable select.saved-item-select:valid,
    #lineItemsTable select.saved-item-select:focus {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right 0.75rem center !important;
        background-size: 16px 12px !important;
        padding-right: 2.25rem !important;
        appearance: none !important;
    }
</style>

<!-- Page Header -->
<div class="row mb-3">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent rounded-3 p-2">
            <div class="d-flex align-items-center">
                <div class="avatar-sm bg-primary rounded-circle d-flex align-items-center justify-content-center me-2">
                    <i class="ri-file-text-line text-white fs-5"></i>
                </div>
                <div>
                    <h5 class="mb-0">Create e-Invoice</h5>
                    <p class="text-muted mb-0 small">Fill in the details below to create your electronic invoice</p>
                </div>
            </div>
            <div class="page-title-right d-flex align-items-center">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Invoice Management</a></li>
                    <li class="breadcrumb-item active">Create e-Invoice</li>
                </ol>
            </div>
        </div>
