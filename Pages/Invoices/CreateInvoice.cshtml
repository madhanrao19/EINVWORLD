</div>

<!-- Step Indicator (Stitch-style 3-step) -->
<div class="mb-4">
    <div class="ci-stepper">
        <div class="ci-step-node is-active" data-step="1">
            <div class="ci-step-circle">1</div>
            <div class="ci-step-label">Basic Information</div>
        </div>
        <div class="ci-step-node" data-step="2">
            <div class="ci-step-circle">2</div>
            <div class="ci-step-label">Invoice Items</div>
        </div>
        <div class="ci-step-node" data-step="3">
            <div class="ci-step-circle">3</div>
            <div class="ci-step-label">Review &amp; Submit</div>
        </div>
        <div class="ci-step-track"><div class="ci-step-fill" id="formProgress"></div></div>
    </div>
</div>
<style>
.ci-stepper{position:relative;display:flex;justify-content:space-between;padding:0 8px;}
.ci-step-node{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:.5rem;text-align:center;flex:0 0 auto;}
.ci-step-circle{width:2rem;height:2rem;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:.875rem;background:#e9efe9;color:#3d4a42;border:2px solid #e9efe9;}
.ci-step-node.is-active .ci-step-circle{background:var(--einv-primary,#006948);color:#fff;border-color:var(--einv-primary,#006948);}
.ci-step-node.is-complete .ci-step-circle{background:#0069481a;color:var(--einv-primary,#006948);border-color:var(--einv-primary,#006948);}
.ci-step-label{font-size:.75rem;font-weight:600;letter-spacing:.03em;text-transform:uppercase;color:#6d7a72;}
.ci-step-node.is-active .ci-step-label{color:var(--einv-primary,#006948);}
.ci-step-track{position:absolute;top:1rem;left:8%;right:8%;height:2px;background:#e9efe9;z-index:1;transform:translateY(-50%);}
.ci-step-fill{height:100%;width:33%;background:var(--einv-primary,#006948);transition:width .3s ease;}
.ci-summary-row{display:flex;justify-content:space-between;gap:1rem;padding:.4rem 0;border-bottom:1px solid #eef1f4;font-size:.875rem;color:#3d4a42;}
.ci-summary-row:last-child{border-bottom:0;}
.ci-summary-row strong{font-weight:600;text-align:right;}
.ci-summary-total{font-size:1rem;}
.ci-summary-total strong{color:var(--einv-primary,#006948);}
</style>

<!-- SVDP Notice (Stitch-style info banner; gated on config) -->
@if (Configuration.GetValue<bool>("LHDNApiConfig:SvdpEnabled", false))
{
    <div class="mb-4 d-flex align-items-start gap-3 p-3 rounded border bg-light-info" style="border-color:#cfe8ff;">
        <i class="ri-information-line fs-5 text-info mt-1"></i>
        <div>
            <div class="text-uppercase fw-semibold text-info" style="font-size:.75rem;letter-spacing:.05em;">Notice</div>
            <div class="text-secondary small">
                Taxpayers under the e-Invoice Special Voluntary Disclosure Programme (SVDP) must use document version
                SVDP 1.3 to rectify inaccuracies and regularise compliance with e-Invoice requirements.
            </div>
        </div>
    </div>
}

<!-- Template Alert -->
@if (!string.IsNullOrEmpty(Model.TemplateName))
{
    <div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-info border-0 bg-light-info">
                <div class="d-flex align-items-center">
                    <i class="ri-file-copy-line fs-5 me-2"></i>
                    <div>
                        <strong>Using Template:</strong> @Model.TemplateName
                        <br><small class="text-muted">You can modify any fields below as needed</small>
