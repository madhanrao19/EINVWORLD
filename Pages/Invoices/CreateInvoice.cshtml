}

<!-- Main Form -->
<div class="row">
    <div class="col-lg-12">
        <form asp-page="/Invoices/CreateInvoice" method="post" id="invoice_form" class="needs-validation" novalidate>
            <input type="hidden" name="action" id="invoiceAction" />
            <input type="hidden" name="TemplateName" id="templateNameInput" />
            <input type="hidden" name="handler" id="handler" />
            <input type="hidden" asp-for="Invoice.InvoiceNo" id="invoiceNo" />

            <!-- Hidden fields for totals -->
            <input type="hidden" asp-for="Invoice.TotalAmountExclTax" id="totalAmountExclTax" />
            <input type="hidden" asp-for="Invoice.TotalTaxAmount" id="totalTaxAmount" />
            <input type="hidden" asp-for="Invoice.TotalAmountIncTax" id="totalAmountIncTax" />
            <input type="hidden" asp-for="Invoice.TotalDiscountAmount" id="totalDiscountAmount" />
            <input type="hidden" asp-for="Invoice.TotalPayableAmount" id="totalPayableAmount" />
            <input type="hidden" asp-for="Invoice.TotalNetAmount" id="totalNetAmount" />

            <!-- Hidden field for ForeignCurrency (auto-set to same as Currency) -->
            <input type="hidden" asp-for="Invoice.ForeignCurrency" id="foreignCurrency" />

            <!-- Step 1: Basic Information -->
            @await Html.PartialAsync("~/Pages/Invoices/_CreateInvoice_Step1BasicInfo.cshtml")

            <!-- Step 2: Invoice Items -->
            @await Html.PartialAsync("~/Pages/Invoices/_CreateInvoice_Step2Items.cshtml")
        </form>
        <!-- Step 3: Review & Submit -->
        @await Html.PartialAsync("~/Pages/Invoices/_CreateInvoice_Step3Review.cshtml")


        <!-- Save As Template Modal -->
        @await Html.PartialAsync("~/Pages/Templates/_SaveTemplateModal.cshtml")
    </div>
</div>



<!-- Success/Error Messages -->
@if (Model.GeneratedJson != null)
{
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Generated JSON</h6>
                </div>
                <div class="card-body">
                    <pre class="bg-light p-3 rounded">@Model.GeneratedJson</pre>
                </div>
            </div>
        </div>
    </div>
}

@if (ViewData["Message"] != null)
{
    var msg = ViewData["Message"]?.ToString() ?? string.Empty;
    var title = msg.Contains("Template") ? "Template Saved Successfully!" : "Draft Saved Successfully!";
    <script>
        Swal.fire({
            icon: 'success',
            title: '@title',
            text: '@msg',
            confirmButtonColor: '#006948',  // eInvWorld brand primary green
            timer: 2500,
            timerProgressBar: true
        });
        // If template was saved, highlight the Submit to LHDN button
        if (@(msg.Contains("Template").ToString().ToLower())) {
            setTimeout(function() {
                var btn = document.getElementById('sa-success-submit-lhdn');
                if (btn) {
                    btn.classList.add('btn-success');
                    btn.classList.remove('btn-danger');
                    btn.style.boxShadow = '0 0 0 0.25rem rgba(40, 167, 69, 0.5)';
                    setTimeout(function() {
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-danger');
                        btn.style.boxShadow = '';
                    }, 2000);
                }
            }, 2600);
        }
    </script>
}

@if ((ViewData["ShowReviewTab"] as bool?) == true)
{
    <script>
        setTimeout(function() {
            // Hide all steps
            document.querySelectorAll('.card.mb-4').forEach(card => card.classList.add('d-none'));
            // Show step 3
            document.getElementById('step3').classList.remove('d-none');
            // Set currentStep and update progress bar if needed
            if (typeof currentStep !== 'undefined') {
                currentStep = 3;
                if (typeof updateProgress === 'function') updateProgress();
            }
        }, 2600); // Wait for SweetAlert2 to close
    </script>
}

@if (!string.IsNullOrEmpty(Model.Message))
{
