@page
@model EINVWORLD.Pages.Invoices.CreateSBCNModel

@{
    Layout = "_LayoutTabler";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Create Self-Billed Credit Note</h1>
                <p class="text-muted mb-0">Document Type 12 — reduce the value of a self-billed invoice you previously issued.</p>
            </div>
            <a href="/Invoices/InvoiceLists" class="btn btn-outline-secondary">
                <i class="ri-arrow-left-line align-bottom me-1"></i> Back to Invoice Lists
            </a>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <div>
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    </div>
}

<div class="row">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm">
            <form class="needs-validation" novalidate id="invoice_form" method="post" asp-page-handler="SubmitDocuments">
                <div class="card-header">
                    <h5 class="card-title mb-0">General Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div>
                                <label for="invoiceNo">e-Invoice Number</label>
                                <input type="text" asp-for="Invoice.InvoiceNo" class="form-control" id="invoiceNo" hidden />
                                <small class="form-text text-muted">This number is auto-generated.</small>

                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label for="refDocumentNo">Reference Document Number</label>
                                <input type="text" asp-for="Invoice.RefDocumentNo" class="form-control" id="refDocumentNo" />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label for="uuid">Reference UUID (Original e-Invoice)</label>
                                <input type="text" asp-for="Invoice.RefUUID" class="form-control" id="refUUID" readonly />
                                <small class="text-muted">UUID of the original invoice. Auto-filled.</small>
                            </div>
                        </div>

                        <!-- Document Type Code Field -->
                        <div class="col-lg-6">
                            <div>
                                <label for="docTypeCode">Document Type Code <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.DocTypeCode" class="form-control" id="docTypeCode" required>
                                    <option value="">Select Document Type</option>
                                    @if (Model.EInvoiceTypes != null && Model.EInvoiceTypes.Any())
                                    {
                                        @foreach (var docType in Model.EInvoiceTypes)
                                        {
                                            <option value="@docType.Code">@docType.Description</option>
                                        }
                                    }
                                    else
                                    {
                                        <option disabled>No Document Types Available</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Currency Field -->
                        <div class="col-lg-6">
                            <div>
                                <label for="currency">Currency Code <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.Currency" class="form-control" id="currency" required onchange="updateExchangeRate()">
                                    <option value="">Select Currency</option>
                                    @if (Model.CurrencyCodes != null && Model.CurrencyCodes.Any())
                                    {
                                        @foreach (var currency in Model.CurrencyCodes)
                                        {
                                            <option value="@currency.Value">@currency.Text</option>
                                        }
                                    }
                                    else
                                    {
                                        <option disabled>No Currency Codes Available</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Foreign Currency Field -->
                        <div class="col-lg-6 d-none">
                            <div>
                                <label for="foreignCurrency">Foreign Currency</label>
                                <select asp-for="Invoice.ForeignCurrency" class="form-control" id="foreignCurrency" onchange="updateExchangeRate()">
                                    <option value="">Select Foreign Currency</option>
                                    @if (Model.CurrencyCodes != null && Model.CurrencyCodes.Any())
                                    {
                                        @foreach (var currency in Model.CurrencyCodes)
                                        {
                                            <option value="@currency.Value">@currency.Text</option>
                                        }
                                    }
                                    else
                                    {
                                        <option disabled>No Currency Codes Available</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Exchange Rate Field -->
                        <div class="col-lg-6">
                            <div>
                                <label for="exchangeRate">Exchange Rate</label>
                                <input type="number" asp-for="Invoice.ExchangeRate" class="form-control" id="exchangeRate" step="0.01" />
                            </div>
                        </div>

                        @* <div class="col-lg-6">
                        <div>
                        <label for="supplierSelect">Supplier Name <span class="text-danger">*</span></label>
                        <select asp-for="Invoice.SupplierId" class="form-control" id="supplierSelect" name="Invoice.SupplierId">
                        <option value="">-- Select Supplier --</option>
                        @if (Model.Suppliers != null && Model.Suppliers.Any())
                        {
                        @foreach (var supplier in Model.Suppliers)
                        {
                        var isSelected = supplier.Value == Model.Invoice.SupplierId.ToString();
                        var isPrimary = supplier.Value == Model.PrimarySupplierId?.ToString();
                        var isGeneralTIN = supplier.Text.Contains("General TIN");

                        <option value="@supplier.Value" data-tin="@(isGeneralTIN ? "General TIN" : "")" selected="@(isSelected ? "selected" : null)">
                        @(isPrimary ? "⭐ " + supplier.Text + " (Primary)" : supplier.Text)
                        </option>
                        }
                        }
                        </select>

                        <span asp-validation-for="Invoice.SupplierId" class="text-danger"></span>
                        </div>
                        </div>




                        <div class="col-lg-6">
                        <div>
                        <label for="buyerSelect">Buyer Name <span class="text-danger">*</span></label>
                        <select asp-for="Invoice.CustomerId" asp-items="Model.Customers" class="form-control">
                        <option value="">-- Select Assigned Buyer --</option>
                        </select>
                        <span asp-validation-for="Invoice.CustomerId" class="text-danger"></span>
                        </div>
                        </div> *@

                        <div class="col-lg-6">
                            <div>
                                <label for="supplierSelect">Supplier Name <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.SupplierId" class="form-control" id="supplierSelect" name="Invoice.SupplierId">
                                    <option value="">-- Select Supplier --</option>
                                    @if (Model.Suppliers != null)
                                    {
                                        @foreach (var supplier in Model.Suppliers)
                                        {
                                            var isPrimary = supplier.Value == Model.PrimarySupplierId?.ToString();

                                            <option value="@supplier.Value"
                                                    selected="@(isPrimary ? "selected" : null)">
                                                @supplier.Text
                                            </option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="">No Suppliers Available</option>
                                    }
                                </select>
                                <span asp-validation-for="Invoice.SupplierId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label for="buyerSelect">Buyer Name <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.CustomerId" class="form-control" id="buyerSelect">
                                    <option value="">-- Select Assigned Buyer --</option>
                                    @if (Model.Customers != null)
                                    {


                                        @foreach (var buyer in Model.Customers)
                                        {
                                            var isGeneralTIN = buyer.Text.Contains("TIN") || buyer.Text.Contains("General"); // Detect General TIN

                                            <option value="@buyer.Value"
                                                    data-tin="@(isGeneralTIN ? "General TIN" : "")">
                                                @buyer.Text
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Invoice.CustomerId" class="text-danger"></span>
                            </div>
                        </div>



                        <div class="col-lg-6">
                            <div>
                                <label for="issueDate">Issue Date <span class="text-danger">*</span></label>
                                <input type="datetime" asp-for="Invoice.IssueDate" class="form-control" id="issueDate" data-provider="flatpickr" data-date-format="Y-m-d H:i" required />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label for="startDate">Start Date</label>
                                <input type="date" asp-for="Invoice.StartDate" class="form-control" id="startDate" data-provider="flatpickr" data-date-format="Y-m-d" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <label for="endDate">End Date</label>
                                <input type="text" asp-for="Invoice.EndDate" class="form-control" id="endDate" data-provider="flatpickr" data-date-format="Y-m-d" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <label for="invoicePeriodEnum">Frequency Billing <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.InvoicePeriod" asp-items="Model.InvoicePeriodEnum" class="form-control" required>
                                    <option value="">Select Frequency</option> <!-- Optional default option -->
                                </select>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-body">
                    <h5 class="fw-bold">Invoice Items</h5>
                    <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="einv-table-head">
                            <tr>
                                <th>Classification Code</th>
                                <th>Item Code</th>
                                <th>Item Description</th>
                                <th>Quantity</th>
                                <th>Unit Measurement</th>
                                <th>Unit Price</th>
                                <th>Subtotal</th>
                                <th>Tax</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="lineItems">
                            @for (int i = 0; i < Model.Invoice.InvoiceLines.Count; i++)
                            {
                                <tr data-item-index="@i">
                                    <td>
                                        <input asp-for="Invoice.InvoiceLines[i].ClassificationCode" class="form-control" />
                                        <span asp-validation-for="Invoice.InvoiceLines[i].ClassificationCode" class="text-danger"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Invoice.InvoiceLines[i].ItemCode" class="form-control" />
                                    </td>
                                    <td><input asp-for="Invoice.InvoiceLines[i].ItemDescription" class="form-control" /></td>
                                    <td><input asp-for="Invoice.InvoiceLines[i].Quantity" type="number" step="any" class="form-control line-qty" /></td>
                                    <td>
                                        <input asp-for="Invoice.InvoiceLines[i].UnitOfMeasure" class="form-control" />
                                        <span asp-validation-for="Invoice.InvoiceLines[i].UnitOfMeasure" class="text-danger"></span>
                                    </td>
                                    <td><input asp-for="Invoice.InvoiceLines[i].UnitPrice" type="number" step="any" class="form-control line-price" /></td>
                                    <td><span id="subtotal-@i" class="subtotal">@((Model.Invoice.InvoiceLines[i].Quantity * Model.Invoice.InvoiceLines[i].UnitPrice)?.ToString("N2") ?? "0.00")</span></td>
                                    <td>
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Tax Category</th>
                                                    <th>Tax Percentage</th>
                                                    <th>Tax Amount</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="taxes-@i">
                                                @for (int j = 0; j < Model.Invoice.InvoiceLines[i].Taxes.Count; j++)
                                                {
                                                    <tr>
                                                        <td><input asp-for="Invoice.InvoiceLines[i].Taxes[j].TaxCategory" class="form-control" /></td>
                                                        <td><input asp-for="Invoice.InvoiceLines[i].Taxes[j].TaxPercentage" type="number" step="any" class="form-control tax-percentage" /></td>
                                                        <td><input asp-for="Invoice.InvoiceLines[i].Taxes[j].TaxAmount" type="number" step="any" class="form-control tax-amount" /></td>
                                                        <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeTax(this)"><i class="ri-delete-bin-line align-bottom"></i> Remove</button></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <button type="button" class="btn btn-secondary btn-sm" onclick="addTax(@i)"><i class="ri-add-line align-bottom"></i> Add Tax</button>
                                    </td>
                                    <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeItem(this)"><i class="ri-delete-bin-line align-bottom"></i> Remove</button></td>
                                </tr>
                            }
                        </tbody>

                    </table>
                    </div>
                    <input type="hidden" id="itemCount" name="Invoice.InvoiceLines.Count" value="@Model.Invoice.InvoiceLines.Count" />

                    <button type="button" class="btn btn-secondary" id="addItemBtn"><i class="ri-add-line align-bottom me-1"></i>Add Item</button>
                </div>

                <!-- Totals Section -->
                <div class="card-body">
                    <h5>Invoice Totals</h5>
                    <div class="row">
                        <div class="col-lg-6">
                            <label for="totalAmountExclTax">Total Amount (Excl. Tax)</label>
                            <input type="number" asp-for="Invoice.TotalAmountExclTax" class="form-control bg-light border-0" id="totalAmountExclTax" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalTaxAmount">Total Tax Amount</label>
                            <input type="number" asp-for="Invoice.TotalTaxAmount" class="form-control bg-light border-0" id="totalTaxAmount" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalAmountIncTax">Total Amount (Incl. Tax)</label>
                            <input type="number" asp-for="Invoice.TotalAmountIncTax" class="form-control bg-light border-0" id="totalAmountIncTax" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalDiscountAmount">Total Discount Amount</label>
                            <input type="number" asp-for="Invoice.TotalDiscountAmount" class="form-control bg-light border-0" id="totalDiscountAmount" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalPayableAmount">Total Payable Amount</label>
                            <input type="number" asp-for="Invoice.TotalPayableAmount" class="form-control bg-light border-0" id="totalPayableAmount" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalNetAmount">Total Net Amount</label>
                            <input type="number" asp-for="Invoice.TotalNetAmount" class="form-control bg-light border-0" id="totalNetAmount" />
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="hstack justify-content-end gap-2">
                        <input type="hidden" name="invoiceNo" value="@Model.Invoice.InvoiceNo" />

                        <!-- Buttons -->
                        <button type="submit" name="action" value="saveDraft" class="btn btn-outline-secondary">
                            <i class="ri-save-3-line align-bottom me-1"></i> Save as Draft
                        </button>
                        <button type="submit" name="action" value="submitDocuments" class="btn btn-primary" id="sa-success-submit-lhdn">
                            <i class="ri-send-plane-fill align-bottom me-1"></i> Submit to LHDN
                        </button>
                        <input type="hidden" id="draftFilePath" value="@ViewData["DraftFilePath"]" />

                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@if (Model.GeneratedJson != null)
{
    <h4>Generated JSON:</h4>
    <pre>@Model.GeneratedJson</pre>
}
<p>@Model.Message</p>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/invoice-line-items.js"></script>

}