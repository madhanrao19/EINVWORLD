@page
@model EINVWORLD.Pages.Invoices.CreateSBIModel

@{
    Layout = "_LayoutTabler";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Create Self-Billed Invoice</h1>
                <p class="text-muted mb-0">Document Type 11 — record a purchase where you issue the e-Invoice on the supplier's behalf.</p>
            </div>
            <a href="/Invoices/InvoiceLists" class="btn btn-outline-secondary">
                <i class="ri-arrow-left-line align-bottom me-1"></i> Back to Invoice Lists
            </a>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <div>
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    </div>
}

<div class="row">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm">
            <form class="needs-validation" novalidate id="invoice_form" method="post" asp-page-handler="SubmitDocuments">
                <div class="card-header">
                    <h5 class="card-title mb-0">General Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div>
                                <label for="invoiceNo">e-Invoice Number</label>
                                <input type="text" asp-for="Invoice.InvoiceNo" class="form-control" id="invoiceNo" hidden />
                                <small class="form-text text-muted">This number is auto-generated.</small>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label for="refDocumentNo">Reference Document Number</label>
                                <input type="text" asp-for="Invoice.RefDocumentNo" class="form-control" id="refDocumentNo" />
                            </div>
                        </div>

                        <!-- Document Type Code -->
                        <div class="col-lg-6">
                            <div>
                                <label for="docTypeCode">Document Type Code <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.DocTypeCode" class="form-control" id="docTypeCode" required>
                                    <option value="11">Self-Billed Invoice</option>
                                </select>
                            </div>
                        </div>

                        <!-- Currency Field -->
                        <div class="col-lg-6">
                            <div>
                                <label for="currency">Currency Code <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.Currency" class="form-control" id="currency" required onchange="updateExchangeRate()">
                                    <option value="">Select Currency</option>
                                    @if (Model.CurrencyCodes != null && Model.CurrencyCodes.Any())
                                    {
                                        @foreach (var currency in Model.CurrencyCodes)
                                        {
                                            <option value="@currency.Value">@currency.Text</option>
                                        }
                                    }
                                    else
                                    {
                                        <option disabled>No Currency Codes Available</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Foreign Currency Field -->
                        <div class="col-lg-6 d-none">
                            <div>
                                <label for="foreignCurrency">Foreign Currency</label>
                                <select asp-for="Invoice.ForeignCurrency" class="form-control" id="foreignCurrency" onchange="updateExchangeRate()">
                                    <option value="">Select Foreign Currency</option>
                                    @if (Model.CurrencyCodes != null && Model.CurrencyCodes.Any())
                                    {
                                        @foreach (var currency in Model.CurrencyCodes)
                                        {
                                            <option value="@currency.Value">@currency.Text</option>
                                        }
                                    }
                                    else
                                    {
                                        <option disabled>No Currency Codes Available</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Exchange Rate Field -->
                        <div class="col-lg-6">
                            <div>
                                <label for="exchangeRate">Exchange Rate</label>
                                <input type="number" asp-for="Invoice.ExchangeRate" class="form-control" id="exchangeRate" step="0.01" />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label for="supplierSelect">Supplier Name <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.SupplierId" class="form-control" id="supplierSelect" name="Invoice.SupplierId">
                                    <option value="">-- Select Supplier --</option>
                                    @if (Model.Suppliers != null)
                                    {
                                        @foreach (var supplier in Model.Suppliers)
                                        {
                                            var isGeneralTIN = supplier.Text.Contains("TIN") || supplier.Text.Contains("General"); // Detect General TIN

                                            <option value="@supplier.Value"
                                                    data-tin="@(isGeneralTIN ? "General TIN" : "")">
                                                @supplier.Text
                                            </option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="">No Suppliers Available</option>
                                    }
                                </select>
                                <span asp-validation-for="Invoice.SupplierId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label for="buyerSelect">Buyer Name <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.CustomerId" class="form-control" id="buyerSelect"
                                        disabled="@((Model.Invoice.DocTypeCode == "11" || Model.Invoice.DocTypeCode == "12" || Model.Invoice.DocTypeCode == "13" || Model.Invoice.DocTypeCode == "14") ? "disabled" : null)">
                                    <option value="">-- Select Assigned Buyer --</option>
                                    @if (Model.Customers != null)
                                    {
                                        @foreach (var buyer in Model.Customers)
                                        {
                                            var isPrimary = buyer.Value == Model.PrimaryCompanyId?.ToString();

                                            <option value="@buyer.Value"
                                                    selected="@(isPrimary ? "selected" : null)">
                                                @buyer.Text
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Invoice.CustomerId" class="text-danger"></span>
                            </div>
                        </div>


                        <div class="col-lg-6">
                            <div>
                                <label for="issueDate">Issue Date <span class="text-danger">*</span></label>
                                <input type="text" asp-for="Invoice.IssueDate" class="form-control" id="issueDate" data-provider="flatpickr" data-date-format="Y-m-d H:i" required />
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label for="startDate">Start Date</label>
                                <input type="text" asp-for="Invoice.StartDate" class="form-control" id="startDate" data-provider="flatpickr" data-date-format="d M, Y" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <label for="endDate">End Date</label>
                                <input type="text" asp-for="Invoice.EndDate" class="form-control" id="endDate" data-provider="flatpickr" data-date-format="d M, Y" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <label for="invoicePeriodEnum">Frequency Billing <span class="text-danger">*</span></label>
                                <select asp-for="Invoice.InvoicePeriod" asp-items="Model.InvoicePeriodEnum" class="form-control" required>
                                    <option value="">Select Frequency</option> <!-- Optional default option -->
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <h5 class="fw-bold">Invoice Items</h5>
                    <div id="lineItems">
                        @for (int i = 0; i < Model.Invoice.InvoiceLines.Count; i++)
                        {
                            <div class="item-row card mb-3" style="border-left: 4px solid var(--einv-primary, #006948);" data-item-index="@i">
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <label class="text-uppercase text-muted small mb-1">Classification Code</label>
                                            <input asp-for="Invoice.InvoiceLines[i].ClassificationCode" class="form-control form-control-sm" />
                                            <span asp-validation-for="Invoice.InvoiceLines[i].ClassificationCode" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="text-uppercase text-muted small mb-1">Item Code</label>
                                            <input asp-for="Invoice.InvoiceLines[i].ItemCode" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="text-uppercase text-muted small mb-1">Item Description</label>
                                            <input asp-for="Invoice.InvoiceLines[i].ItemDescription" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="text-uppercase text-muted small mb-1">Quantity</label>
                                            <input asp-for="Invoice.InvoiceLines[i].Quantity" type="number" step="any" class="form-control form-control-sm line-qty" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="text-uppercase text-muted small mb-1">Unit Measurement</label>
                                            <select asp-for="Invoice.InvoiceLines[i].UnitOfMeasure" asp-items="Model.UnitOptions" class="form-control form-control-sm unit-select select2"></select>
                                            <span asp-validation-for="Invoice.InvoiceLines[i].UnitOfMeasure" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="text-uppercase text-muted small mb-1">Unit Price</label>
                                            <input asp-for="Invoice.InvoiceLines[i].UnitPrice" type="number" step="any" class="form-control form-control-sm line-price" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="text-uppercase text-muted small mb-1">Subtotal</label>
                                            <div class="p-2 rounded bg-light text-end fw-bold subtotal" id="subtotal-@i">@((Model.Invoice.InvoiceLines[i].Quantity * Model.Invoice.InvoiceLines[i].UnitPrice)?.ToString("N2") ?? "0.00")</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="text-uppercase text-muted small mb-1">Tax</label>
                                            <div class="tax-section" id="taxes-@i">
                                                @for (int j = 0; j < Model.Invoice.InvoiceLines[i].Taxes.Count; j++)
                                                {
                                                    <div class="tax-row mb-2 p-2 border rounded">
                                                        <div class="d-flex flex-wrap gap-1 align-items-start">
                                                            <div class="flex-fill" style="min-width: 100px;">
                                                                <input asp-for="Invoice.InvoiceLines[i].Taxes[j].TaxCategory" class="form-control form-control-sm tax-category" placeholder="Tax Category" />
                                                            </div>
                                                            <div style="min-width: 65px; flex: 0 0 70px;">
                                                                <input asp-for="Invoice.InvoiceLines[i].Taxes[j].TaxPercentage" type="number" step="any" class="form-control form-control-sm tax-percentage" placeholder="%" />
                                                            </div>
                                                            <div style="min-width: 85px; flex: 0 0 90px;">
                                                                <input asp-for="Invoice.InvoiceLines[i].Taxes[j].TaxAmount" type="number" step="any" class="form-control form-control-sm tax-amount" placeholder="Amount" />
                                                            </div>
                                                            <div style="flex: 0 0 auto;">
                                                                <i class="ri-close-circle-line text-danger" onclick="removeTax(this)" title="Remove Tax" style="cursor: pointer; font-size: 16px; padding: 2px;"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <button type="button" class="btn btn-sm btn-primary mt-1" onclick="addTax(@i)"><i class="ri-add-line align-bottom"></i> Add Tax</button>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end mt-3 pt-3 border-top">
                                        <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0" onclick="removeItem(this)"><i class="ri-delete-bin-line me-1"></i>Remove</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <input type="hidden" id="itemCount" name="Invoice.InvoiceLines.Count" value="@Model.Invoice.InvoiceLines.Count" />

                    <button type="button" class="btn btn-outline-primary" id="addItemBtn"><i class="ri-add-line align-bottom me-1"></i>Add Item</button>
                </div>

                <!-- Totals Section -->
                <div class="card-body">
                    <h5>Invoice Totals</h5>
                    <div class="row">
                        <div class="col-lg-6">
                            <label for="totalAmountExclTax">Total Amount (Excl. Tax)</label>
                            <input type="number" asp-for="Invoice.TotalAmountExclTax" class="form-control bg-light border-0" id="totalAmountExclTax" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalTaxAmount">Total Tax Amount</label>
                            <input type="number" asp-for="Invoice.TotalTaxAmount" class="form-control bg-light border-0" id="totalTaxAmount" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalAmountIncTax">Total Amount (Incl. Tax)</label>
                            <input type="number" asp-for="Invoice.TotalAmountIncTax" class="form-control bg-light border-0" id="totalAmountIncTax" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalDiscountAmount">Total Discount Amount</label>
                            <input type="number" asp-for="Invoice.TotalDiscountAmount" class="form-control bg-light border-0" id="totalDiscountAmount" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalPayableAmount">Total Payable Amount</label>
                            <input type="number" asp-for="Invoice.TotalPayableAmount" class="form-control bg-light border-0" id="totalPayableAmount" />
                        </div>
                        <div class="col-lg-6">
                            <label for="totalNetAmount">Total Net Amount</label>
                            <input type="number" asp-for="Invoice.TotalNetAmount" class="form-control bg-light border-0" id="totalNetAmount" />
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="hstack justify-content-end gap-2">
                        <input type="hidden" name="invoiceNo" value="@Model.Invoice.InvoiceNo" />

                        <!-- Buttons -->
                        <button type="submit" name="action" value="saveDraft" class="btn btn-outline-secondary">
                            <i class="ri-save-3-line align-bottom me-1"></i> Save as Draft
                        </button>
                        <button type="submit" name="action" value="submitDocuments" class="btn btn-primary" id="sa-success-submit-lhdn">
                            <i class="ri-send-plane-fill align-bottom me-1"></i> Submit to LHDN
                        </button>
                        <input type="hidden" id="draftFilePath" value="@ViewData["DraftFilePath"]" />

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.GeneratedJson != null)
{
    <h4>Generated JSON:</h4>
    <pre>@Model.GeneratedJson</pre>
}
<p>@Model.Message</p>


@section Scripts {
    <script>
        // Grouped Unit options for rows added dynamically by invoice-line-items.js
        window.unitOptionsHtml = `
            @foreach (var unitGroup in Model.UnitOptions.GroupBy(u => u.Group?.Name ?? ""))
            {
                    <optgroup label="@unitGroup.Key">
                    @foreach (var unit in unitGroup)
                    {
                            <option value="@unit.Value">@unit.Text</option>
                    }
                    </optgroup>
            }
        `;
    </script>
    <script src="~/js/invoice-line-items.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var docTypeCode = "@Model.Invoice.DocTypeCode";

            if (docTypeCode === "11" || docTypeCode === "12" || docTypeCode === "13" || docTypeCode === "14") {
                document.getElementById("buyerSelect").setAttribute("disabled", "disabled");
            }
        });
    </script>
}
