@page
@model EINVWORLD.Pages.Invoices.ImportCSVModel
@{
    ViewData["Title"] = "Import Invoices";
    var backUrl = "/Invoices/InvoiceLists";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Bulk Invoice Import</h1>
                <p class="text-muted mb-0">Create multiple draft invoices from one CSV or Excel file.</p>
            </div>
            <a href="@backUrl" class="btn btn-outline-secondary">
                <i class="ri-arrow-left-line align-bottom me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="mb-2 d-flex align-items-center justify-content-center rounded-3" style="width: 40px; height: 40px; background: var(--primary-soft, #e9f5ee); color: var(--primary-text, #0c5434);">
                <i class="ri-download-2-line fs-5"></i>
            </div>
            <h6 class="fw-bold mb-1">1. Download Template</h6>
            <p class="text-muted small mb-3">Get the structured file with the exact column headers this importer reads.</p>
            <div class="d-flex flex-column gap-2">
                <a href="?handler=Template" class="btn btn-primary btn-sm"><i class="ri-file-excel-2-line align-bottom me-1"></i>Download Excel</a>
                <a href="~/samplecsv/Invoice_sample.csv" class="btn btn-outline-secondary btn-sm" download><i class="ri-file-text-line align-bottom me-1"></i>Download Sample CSV</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="mb-2 d-flex align-items-center justify-content-center rounded-3" style="width: 40px; height: 40px; background: var(--primary-soft, #e9f5ee); color: var(--primary-text, #0c5434);">
                <i class="ri-file-edit-line fs-5"></i>
            </div>
            <h6 class="fw-bold mb-1">2. Complete Data</h6>
            <p class="text-muted small mb-3">One row per invoice line — multiple rows sharing the same Invoice No become one invoice.</p>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#fieldGuide">
                <i class="ri-information-line align-bottom me-1"></i>View Field Guide
            </button>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="mb-2 d-flex align-items-center justify-content-center rounded-3" style="width: 40px; height: 40px; background: var(--primary-soft, #e9f5ee); color: var(--primary-text, #0c5434);">
                <i class="ri-qr-code-line fs-5"></i>
            </div>
            <h6 class="fw-bold mb-1">3. Reference Codes</h6>
            <p class="text-muted small mb-3">Look up classification, tax, currency, unit and other LHDN codes.</p>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle w-100" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ri-file-list-3-line align-bottom me-1"></i>Open Codes
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="?handler=DownloadReference&type=ClassificationCodes">Classification Codes</a></li>
                    <li><a class="dropdown-item" href="?handler=DownloadReference&type=CountryCodes">Country Codes</a></li>
                    <li><a class="dropdown-item" href="?handler=DownloadReference&type=CurrencyCodes">Currency Codes</a></li>
                    <li><a class="dropdown-item" href="?handler=DownloadReference&type=EInvoiceTypes">E-Invoice Types</a></li>
                    <li><a class="dropdown-item" href="?handler=DownloadReference&type=MSICSubCategoryCodes">MSIC Sub-Category Codes</a></li>
                    <li><a class="dropdown-item" href="?handler=DownloadReference&type=PaymentMethods">Payment Methods</a></li>
                    <li><a class="dropdown-item" href="?handler=DownloadReference&type=StateCodes">State Codes</a></li>
                    <li><a class="dropdown-item" href="?handler=DownloadReference&type=TaxTypes">Tax Types</a></li>
                    <li><a class="dropdown-item" href="?handler=DownloadReference&type=UnitTypes">Unit Types</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div id="fieldGuide" class="collapse mb-4">
    <div class="alert alert-info mb-0">
        <strong>CSV / Excel Format:</strong> exact headers below (case-sensitive). <strong>One row = one invoice line.</strong><br />
        <code>InvoiceNo, IssueDate, PoDoNo, DocTypeCode, Currency, ExchangeRate, BillingFrequency, StartDate, EndDate, BankAccountNumber, BankName, AttentionTo, PaymentTerms, CounterpartyTIN, ItemDescription, Quantity, UnitPrice, DiscountAmount, UnitOfMeasure, ClassificationCode, TaxCategory, TaxPercentage</code>
        <ul class="mb-0 mt-2">
            <li><strong>InvoiceNo:</strong> Your custom Invoice/Reference Number (e.g., INV-001). This groups lines together.</li>
            <li><strong>BillingFrequency:</strong> Optional. Can be <code>Monthly</code>, <code>Annually</code>, etc.</li>
            <li><strong>Dates &amp; Codes:</strong> Format dates (IssueDate, StartDate, EndDate) as <code>yyyy-MM-dd</code>. Ensure codes like <code>DocTypeCode</code> (01, 11), <code>UnitOfMeasure</code> (XUN), and <code>TaxCategory</code> (01, 06, E) match LHDN standards.</li>
            <li><strong>Text Format:</strong> Please ensure every field's format is set to Text in Excel.</li>
            <li><em>Note:</em> If your Tax Category is 'E', the system will automatically fill in the exemption reason for you.</li>
        </ul>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
            <div class="text-center p-4 border border-2 rounded-3 mb-3" style="border-style: dashed !important;">
                <div class="mx-auto mb-2 d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background: var(--primary-soft, #e9f5ee); color: var(--primary-text, #0c5434);">
                    <i class="ri-upload-cloud-2-line fs-3"></i>
                </div>
                <p class="fw-semibold mb-1">Select a CSV or Excel file</p>
                <p class="text-muted small mb-3">.csv, .xlsx — one row per invoice line</p>
                <input type="file" asp-for="UploadFile" class="form-control mx-auto" style="max-width: 400px;" accept=".csv,.xlsx" required />
                <span asp-validation-for="UploadFile" class="text-danger d-block mt-2"></span>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-primary">
                    <i class="ri-refresh-line align-bottom me-1"></i> Preview &amp; Validate
                </button>
                <a href="@backUrl" class="btn btn-light">Cancel</a>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger mt-2 text-center"></div>
        </form>
    </div>
</div>

@if (Model.PreviewRecords.Any())
{
    var validCount = Model.PreviewRecords.Count(r => r.IsValid);
    var invalidCount = Model.PreviewRecords.Count(r => !r.IsValid);
    var validTotal = Model.PreviewRecords.Where(r => r.IsValid).Sum(r => r.TotalAmount);

    <div class="row g-3 mb-3" id="previewSection">
        <div class="col-md-3">
            <div class="card p-3 h-100 border-0 shadow-sm">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total Found</p>
                <h3 class="fw-bold mb-0">@Model.PreviewRecords.Count</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 h-100 border-0 shadow-sm border-start border-success border-4">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Valid</p>
                <h3 class="fw-bold mb-0 text-success">@validCount</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 h-100 border-0 shadow-sm @(invalidCount > 0 ? "border-start border-danger border-4" : "")">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Invalid</p>
                <h3 class="fw-bold mb-0 @(invalidCount > 0 ? "text-danger" : "")">@invalidCount</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 h-100 border-0 shadow-sm">
                <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Valid Total</p>
                <h3 class="fw-bold mb-0">@validTotal.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header-clean"><h5 class="mb-0 fw-bold text-dark">Validation Results</h5></div>
        <div class="card-body">
            <div style="max-height: 400px; overflow: auto; border: 1px solid #dee2e6; border-radius: 0.5rem;">
                <table class="table align-middle mb-0" style="width: 100%; min-width: 800px;">
                    <thead class="table-light text-muted" style="position: sticky; top: 0; z-index: 10; font-size: 0.75rem; text-transform: uppercase;">
                        <tr>
                            <th style="width: 15%">Your Invoice No (Ref)</th>
                            <th style="width: 15%">Counterparty TIN</th>
                            <th style="width: 10%">Type / Lines</th>
                            <th style="width: 15%">Total (Incl Tax)</th>
                            <th style="width: 10%">Status</th>
                            <th style="width: 35%">Details / Errors</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.PreviewRecords)
                        {
                            <tr>
                                <td>
                                    <strong>@record.InvoiceNo</strong><br />
                                    <small class="text-muted">@record.IssueDate.ToString("yyyy-MM-dd")</small>
                                    @if (!string.IsNullOrEmpty(record.PoDoNo))
                                    {
                                        <br />
                                        <small class="text-info">PO: @record.PoDoNo</small>
                                    }
                                </td>
                                <td>@record.CounterpartyTIN</td>
                                <td>Doc: @record.DocTypeCode<br /><small class="text-muted">@record.LineCount lines</small></td>
                                <td>@record.Currency @record.TotalAmount.ToString("N2")</td>
                                <td>
                                    @if (record.IsValid)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success"><i class="ri-check-line"></i> Valid</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger"><i class="ri-close-line"></i> Invalid</span>
                                    }
                                </td>
                                <td>
                                    @if (!record.IsValid)
                                    {
                                        <ul class="text-danger mb-0 ps-3">
                                            @foreach (var error in record.Errors)
                                            {
                                                <li>@error</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Ready to import and generate JSON</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-4 d-flex justify-content-between align-items-center">
                <div>
                    @if (invalidCount > 0)
                    {
                        <p class="text-muted mb-0"><i class="ri-information-line text-info"></i> Invalid invoices will be skipped.</p>
                    }
                </div>

                <form method="post" asp-page-handler="Confirm">
                    <input type="hidden" asp-for="ValidRecordsJson" />
                    @if (validCount > 0)
                    {
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="ri-save-3-line align-bottom me-1"></i> Import @validCount Invoices as Drafts
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-lg" disabled>
                            <i class="ri-save-3-line align-bottom me-1"></i> No Valid Invoices
                        </button>
                    }
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var previewBlock = document.getElementById("previewSection");
            if (previewBlock) {
                previewBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    </script>
}
