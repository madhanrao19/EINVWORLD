<script>
    // PDF-viewer zoom for the A4 preview: starts at "fit to width" (never above 100%), re-fits on
    // resize until the user zooms manually, -/+ step 10% between 25% and 200%.
    (function () {
        const stage = document.getElementById('einvPdfStage');
        const page = document.getElementById('einvPdfPage');
        const level = document.getElementById('einvPdfZoomLevel');
        const zoomIn = document.getElementById('einvPdfZoomIn');
        const zoomOut = document.getElementById('einvPdfZoomOut');
        const fitBtn = document.getElementById('einvPdfFit');
        if (!stage || !page) return;

        const A4_PX = 210 * 96 / 25.4; // 210mm at CSS 96dpi
        const MIN = 0.25, MAX = 2;
        let zoom = 1, fit = true;

        function fitZoom() {
            const cs = getComputedStyle(stage);
            const avail = stage.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
            return Math.max(MIN, Math.min(1, avail / A4_PX));
        }
        function apply(z) {
            zoom = Math.max(MIN, Math.min(MAX, Math.round(z * 100) / 100));
            page.style.zoom = zoom;
            level.textContent = Math.round(zoom * 100) + '%';
            zoomOut.disabled = zoom <= MIN;
            zoomIn.disabled = zoom >= MAX;
            fitBtn.setAttribute('aria-pressed', String(fit));
        }
        zoomIn.addEventListener('click', () => { fit = false; apply(zoom + 0.1); });
        zoomOut.addEventListener('click', () => { fit = false; apply(zoom - 0.1); });
        fitBtn.addEventListener('click', () => { fit = true; apply(fitZoom()); });
        new ResizeObserver(() => { if (fit) apply(fitZoom()); }).observe(stage);
        apply(fitZoom());
    })();

    // Activity log filter functionality
    document.addEventListener('DOMContentLoaded', function() {
        const actionFilter = document.getElementById('actionFilter');
        
        if (actionFilter) {
            actionFilter.addEventListener('change', function () {
                const value = this.value;
                console.log('Filter value:', value);
                
                // Target the activity log table specifically
                const activityTable = document.querySelector('#activityLogTable tbody');
                if (activityTable) {
                    const rows = activityTable.querySelectorAll('tr');
                    console.log('Found rows:', rows.length);
                    
                    rows.forEach(row => {
                        const actionCell = row.querySelector('td[data-label="Action"]'); // columns can be reordered
                        if (actionCell) {
                            const actionText = actionCell.innerText.trim();
                            
                            // Show/hide row based on filter
                            if (value === '' || actionText.includes(value)) {
                                row.style.display = '';
                            } else {
                                row.style.display = 'none';
                            }
                        }
                    });
                } else {
                    console.log('Activity table not found');
                }
            });
        }
    });
