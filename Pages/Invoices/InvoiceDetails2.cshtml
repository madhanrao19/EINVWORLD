@page "{uuid}"
@using eInvWorld.Helpers
@using System.Security.Claims
@using Microsoft.AspNetCore.Html
@model EINVWORLD.Pages.Invoices.InvoiceDetails2Model
@{
    var isAdmin = User.IsInRole("Admin");

    var rejectionReasons = eInvWorld.Models.Document.RejectDocumentInput.GetReasons();
    var isOver72Hours = Model.InvoiceDetail?.DateTimeValidated.HasValue == true &&
                       Model.InvoiceDetail.DateTimeValidated!.Value.AddHours(72) < DateTime.UtcNow;

    var invoice = Model?.InvoiceDetail ?? new eInvWorld.Models.InputModel.InvoiceHeader();
    var items = Model?.InvoiceLines ?? new List<eInvWorld.Models.InputModel.InvoiceLine>();
    int rowsPerPage = 14; 
    var itemChunks = new List<List<eInvWorld.Models.InputModel.InvoiceLine>>();
    var chunk = new List<eInvWorld.Models.InputModel.InvoiceLine>();
    int currentRows = 0;
    foreach (var item in items)
    {
        int count = 1 + (item.InvoiceTaxes?.Count() ?? 0);
        if (currentRows + count > rowsPerPage && chunk.Count > 0)
        {
            itemChunks.Add(chunk);
            chunk = new List<eInvWorld.Models.InputModel.InvoiceLine>();
            currentRows = 0;
        }
        chunk.Add(item);
        currentRows += count;
    }
    if (chunk.Count > 0) itemChunks.Add(chunk);
}


<style>
    /* ── Web Container wrapper to mimic an A4 piece of paper ── */
    .invoice-web-container {
        width: 210mm; /* A4: fixed like a PDF page; the viewer zoom scales it to the screen */
        min-height: 297mm;
        box-sizing: border-box;
        margin: 0 auto;
        padding: 12mm 10mm; /* Exact margins from PDF */
        background: #fff;
        color: #000;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 10pt;
        border-radius: 0;
        box-shadow: 0 1px 3px rgba(0,0,0,.3), 0 4px 16px rgba(0,0,0,.25);
    }

    #invoiceWrapper {
        box-sizing: border-box;
        width: 100%;
    }

    /* PDF-viewer chrome (colours match the browser's built-in PDF viewer). The A4 sheet below is a
     * fixed-size facsimile of the generated PDF — never reflowed; it is zoomed (CSS zoom, so layout
     * size follows) to fit the stage width, and scrolls sideways only when zoomed past it. */
    .einv-pdf-card { overflow: hidden; }
    .einv-pdf-viewer { background: #525659; }
    [data-bs-theme="dark"] .einv-pdf-viewer { background: #2b2d31; }
    .einv-pdf-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .5rem;
        padding: .35rem .75rem;
        background: #323639;
        color: #f1f3f4;
        box-shadow: 0 1px 4px rgba(0,0,0,.35);
        position: relative;
        z-index: 1;
    }
    .einv-pdf-title { flex: 1 1 auto; min-width: 0; font-weight: 600; font-size: .9rem; }
    .einv-pdf-zoom, .einv-pdf-actions { display: flex; align-items: center; gap: .15rem; flex-shrink: 0; }
    .einv-pdf-actions { padding-left: .5rem; border-left: 1px solid rgba(255,255,255,.18); }
    .einv-pdf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: #f1f3f4;
        font-size: 1.15rem;
        text-decoration: none;
    }
    .einv-pdf-btn:hover, .einv-pdf-btn[aria-pressed="true"] { background: rgba(255,255,255,.12); color: #fff; }
    .einv-pdf-btn:focus-visible { outline: 2px solid #8ab4f8; outline-offset: 1px; }
    .einv-pdf-btn:disabled { opacity: .4; }
    .einv-pdf-zoom-level {
        min-width: 3.25rem;
        padding: .15rem .35rem;
        border-radius: .25rem;
        background: rgba(0,0,0,.3);
        text-align: center;
        font-size: .8rem;
        font-variant-numeric: tabular-nums;
    }
    .einv-pdf-stage { overflow: auto; padding: 1.25rem; -webkit-overflow-scrolling: touch; }
    @@media (max-width: 575.98px) {
        .einv-pdf-toolbar { padding: .25rem .5rem; gap: .25rem; }
        .einv-pdf-title { font-size: .8rem; }
        .einv-pdf-stage { padding: .75rem; }
    }
    @@media (pointer: coarse) {
        .einv-pdf-btn { width: 44px; height: 44px; }
    }
    @@media print {
        .einv-pdf-viewer, [data-bs-theme="dark"] .einv-pdf-viewer { background: none; }
        .einv-pdf-stage { overflow: visible; padding: 0; }
        .einv-pdf-page { zoom: 1 !important; width: auto; min-height: 0; }
    }

        #invoiceWrapper h4 {
            font-size: 12pt !important;
            font-weight: bold !important;
            margin: 0 0 8px 0 !important;
        }

    /* ── Supplier Header ── */
    .supplier-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 8px;
    }

    .supplier-name {
        font-size: 15pt;
        font-weight: bold;
        letter-spacing: 0.07em;
        line-height: 1.2;
        display: inline;
        white-space: nowrap;
    }

    .supplier-meta {
        font-size: 10pt;
        font-weight: normal;
        letter-spacing: 0.01em;
        line-height: 1.2;
        display: inline;
        margin-left: 10px;
        white-space: nowrap;
    }

    .supplier-subline {
        font-size: 10pt !important;
        line-height: 1.2;
        margin-top: 4px;
    }

    /* ── Bill To / Invoice Info ── */
    .info-grid {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 12px;
        font-size: 10pt;
    }

        .info-grid td {
            vertical-align: top;
            border: none;
            background: none;
            padding: 2px 0;
        }

    .billto-address p {
        margin: 0;
        padding: 0;
        line-height: 1.3;
    }

    .billto-address {
        margin-bottom: 0;
    }

    .meta-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10pt;
    }

        .meta-table td {
            border: none;
            white-space: nowrap;
            padding: 2px 0;
            text-align: left;
        }

    .meta-label {
        width: 27%;
        font-weight: bold;
    }

    .meta-sep {
        width: 3%;
        text-align: left;
    }

    .meta-value {
        width: 70%;
        word-break: break-all;
    }

    /* ── Items Table ── */
    .invoice-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
        page-break-inside: auto;
        padding-top: 10px;
    }

        .invoice-table thead {
            display: table-header-group;
        }

        .invoice-table tbody {
            display: table-row-group;
        }

        .invoice-table tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        .invoice-table th, .invoice-table td {
            border-right: none;
            border-left: 1px solid #000;
            border-top: none;
            border-bottom: none;
            font-size: 10pt;
            padding: 6px 4px;
            vertical-align: top;
            word-wrap: break-word;
        }

            .invoice-table th:last-child, .invoice-table td:last-child {
                border-right: 1px solid #000;
            }

        .invoice-table th {
            border-top: 1px solid #000;
            border-bottom: 1px solid #000;
            font-weight: bold;
            text-align: center;
            white-space: nowrap;
        }

    .col-itemno {
        width: 8.5%;
        text-align: center;
    }

    .col-desc {
        width: 46.5%;
        text-align: left;
    }

    .col-qty {
        width: 12.5%;
        text-align: center;
    }

    .col-unit {
        width: 14.5%;
        text-align: right;
    }

    .col-total {
        width: 18%;
        text-align: right;
    }

    .invoice-table td:nth-child(2) {
        white-space: normal !important;
        text-align: left !important;
    }

    /* Filler rows */
    .filler-row td {
        height: 18px;
        line-height: 18px;
    }

    .repeat-footer {
        display: table-footer-group;
    }

        .repeat-footer td {
            border-top: 1px solid #000 !important;
            border-bottom: none !important;
            border-left: none !important;
            border-right: none !important;
            padding: 0 !important;
            height: 1px !important;
        }

    /* ── Total Row ── */
    .invoice-table .total-row td {
        border-top: 1px solid #000 !important;
        border-bottom: none !important;
        border-left: none !important;
        border-right: none !important;
        padding: 4px 4px;
        background-color: rgba(58, 165, 100, 0.1) !important;
        -webkit-print-color-adjust: exact;
        color-adjust: exact;
    }

        .invoice-table .total-row td.total-label {
            border-left: 1px solid #000 !important;
            text-align: left;
            font-weight: bold;
        }

        .invoice-table .total-row td.total-amount {
            border-left: 1px solid #000 !important;
            border-right: 1px solid #000 !important;
            text-align: right;
            font-weight: bold;
        }

        .invoice-table .total-row td.total-right {
            border-right: none !important;
            border-left: none !important;
            text-align: right !important;
            font-weight: bold;
        }

    /* ── Footer ── */
    .footer-note-table,
    .footer-note-table tr,
    .footer-note-table td {
        border: none !important;
    }

    #invoiceFooter {
        margin-top: 8px;
        page-break-inside: avoid;
    }

    .footer-outer {
        width: 100%;
        border-collapse: collapse;
    }

        .footer-outer td {
            border: none;
            vertical-align: top;
            padding: 0;
        }

    .payment-block {
        font-size: 10pt;
        line-height: 1.2;
    }

    .summary-box {
        width: 100%;
        border-collapse: collapse;
        font-size: 10pt;
    }

        .summary-box td {
            border: 1px solid #000;
            padding: 3px 6px;
            text-align: right;
        }

    .summary-label {
        width: 60%;
        text-align: right;
    }

    .total-payable-cell {
        font-weight: bold;
    }

    .signoff-table {
        width: 100%;
        margin-top: 8px;
        border-collapse: collapse;
    }

        .signoff-table td {
            border: none;
            vertical-align: middle;
            padding: 0;
        }

    .signoff {
        font-size: 10pt;
        line-height: 1.5;
    }

    /* Print Overrides */
    @@media print {
        header, #page-topbar, .navbar, .topbar, .app-menu, .vertical-menu, .d-print-none

    {
        display: none !important;
    }

    .main-content, .page-content, body {
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        background: #fff !important;
    }

    .invoice-web-container {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
    }

    .card {
        border: none !important;
        box-shadow: none !important;
        margin: 0 !important;
    }

    }
</style>

@functions {
    public IHtmlContent GetActionIcon(string action)
    {
        return action switch
        {
            "StatusChanged" => new HtmlString("<i class='ri-checkbox-blank-circle-fill text-success me-1' aria-hidden='true'></i>"),
            "EmailSent" => new HtmlString("<i class='ri-mail-line me-1' aria-hidden='true'></i>"),
            "PDFGenerated" => new HtmlString("<i class='ri-file-pdf-2-line me-1' aria-hidden='true'></i>"),
            "DateTimeReceived" => new HtmlString("<i class='ri-inbox-line me-1' aria-hidden='true'></i>"),
            "DateTimeValidated" => new HtmlString("<i class='ri-checkbox-circle-line text-success me-1' aria-hidden='true'></i>"),
            "Cancelled" => new HtmlString("<i class='ri-close-circle-line text-danger me-1' aria-hidden='true'></i>"),
            "RequestReject" => new HtmlString("<i class='ri-forbid-line text-warning me-1' aria-hidden='true'></i>"),
            "LongIdUpdated" => new HtmlString("<i class='ri-link me-1' aria-hidden='true'></i>"),
            _ => HtmlString.Empty
        };
    }


}

@{
    var displayStatus = Model!.DisplayStatusName != "" ? Model!.DisplayStatusName : "Unknown";
    bool canCancel = (User.IsInRole("Supplier") || isAdmin) && displayStatus == "Valid" && !isOver72Hours;
    bool canReject = (User.IsInRole("Buyer") || isAdmin) && displayStatus == "Valid" && !isOver72Hours;
}
@* Ledger 3d-2 (mockup "Details"): the A4 viewer on the left and the status/actions panels beside it on
   wide screens, stacked on narrow ones. The A4 sheet itself is the frozen PdfTemplate layout. *@
<div class="einv-ph d-print-none">
    <div class="einv-ph-text">
        <h1 class="einv-page-title mb-1">Invoice @invoice.InvoiceNo</h1>
        <p class="text-muted mb-0">e-Invoice details, as issued and as validated by LHDN</p>
    </div>
    <div class="einv-ph-actions">
        <a href="/Invoices/InvoiceLists" class="btn btn-outline-secondary"><i class="ri-arrow-left-line" aria-hidden="true"></i>Back to invoices</a>
    </div>
</div>

<div class="einv-det-grid">
    <div class="einv-det-main">
        <div class="einv-panel einv-pdf-card">
                @* PDF-viewer-style preview: dark surround + toolbar, the A4 sheet zoomed to fit like a
                   browser PDF viewer (fit width, -/+ zoom). The sheet is "paper" in both themes. *@
                <div class="einv-pdf-viewer" id="einvPdfViewer">
                    <div class="einv-pdf-toolbar d-print-none" role="toolbar" aria-label="Invoice preview">
                        @* Phones: no room beside the zoom controls; the invoice number is in the page header. *@
                        <span class="einv-pdf-title text-truncate d-none d-sm-block">
                            <i class="ri-file-pdf-2-line me-1" aria-hidden="true"></i>Invoice @invoice.InvoiceNo
                        </span>
                        <div class="einv-pdf-zoom" role="group" aria-label="Zoom">
                            <button type="button" class="einv-pdf-btn" id="einvPdfZoomOut" aria-label="Zoom out" title="Zoom out"><i class="ri-subtract-line" aria-hidden="true"></i></button>
                            <output class="einv-pdf-zoom-level" id="einvPdfZoomLevel" aria-live="polite">100%</output>
                            <button type="button" class="einv-pdf-btn" id="einvPdfZoomIn" aria-label="Zoom in" title="Zoom in"><i class="ri-add-line" aria-hidden="true"></i></button>
                            <button type="button" class="einv-pdf-btn" id="einvPdfFit" aria-label="Fit to width" title="Fit to width" aria-pressed="true"><i class="ri-aspect-ratio-line" aria-hidden="true"></i></button>
                        </div>
                        <div class="einv-pdf-actions">
                            <button type="button" class="einv-pdf-btn" onclick="window.print()" aria-label="Print" title="Print"><i class="ri-printer-line" aria-hidden="true"></i></button>
                            <a class="einv-pdf-btn" href="?handler=DownloadPdf&invoiceNo=@Model.InvoiceDetail?.InvoiceNo" aria-label="Download PDF" title="Download PDF"><i class="ri-download-2-line" aria-hidden="true"></i></a>
                        </div>
                    </div>
                    <div class="einv-pdf-stage d-print-block" id="einvPdfStage">
                    <div class="invoice-web-container einv-pdf-page" id="einvPdfPage" data-bs-theme="light">
                        <div id="invoiceWrapper">

                            <table class="supplier-table">
                                <tr>
                                    <td style="width:15%; vertical-align:top;padding-left:20px;">
                                        @if (!string.IsNullOrEmpty(invoice.Supplier?.LogoPath))
                                        {
                                            <img src="@invoice.Supplier.LogoPath"
                                                 alt="@invoice.Supplier?.CompanyName Logo"
                                                 style="width:90px; height:96px; object-fit:contain; display:block;" />
                                        }
                                    </td>
                                    <td style="width:85%; vertical-align:top; padding-left:20px;">
                                        <div style="margin-bottom:2px;">
                                            <span class="supplier-name">@invoice.Supplier?.CompanyName</span>
                                            @if (invoice.Supplier?.CompanyName != "General Public" && invoice.Supplier?.CompanyName != "Foreign Supplier")
                                            {
                                                <span class="supplier-meta">
                                                    &nbsp;&nbsp;@invoice.Supplier?.RegNo
                                                    @if (!string.IsNullOrWhiteSpace(invoice.Supplier?.OldRegNo))
                                                    {
                                                        <text> (@invoice.Supplier?.OldRegNo)</text>
                                                    }
                                                </span>
                                            }
                                        </div>

                                        @if (invoice.Supplier?.CompanyName != "General Public" && invoice.Supplier?.CompanyName != "Foreign Supplier")
                                        {
                                            <div class="supplier-subline">
                                                @(invoice.Supplier?.Addr1)<br />
                                                @{
                                                    var suppCountry = invoice.Supplier?.Country?.Country ?? "";
                                                    var suppCountryTitle = string.IsNullOrEmpty(suppCountry) ? "" : System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(suppCountry.ToLower());
                                                }
                                                @invoice.Supplier?.PostalCode @invoice.Supplier?.CityName, @invoice.Supplier?.State?.State, @suppCountryTitle.
                                            </div>
                                            <div class="supplier-subline">
                                                Tel: @invoice.Supplier?.PhoneNo
                                                @if (!string.IsNullOrEmpty(invoice.Supplier?.FaxNo))
                                                {
                                                    <text> | Fax: @invoice.Supplier?.FaxNo</text>
                                                }
                                            </div>
                                            <div class="supplier-subline">
                                                SST: @invoice.Supplier?.SST
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="supplier-subline">
                                                <strong>TIN:</strong> @invoice.Supplier?.TIN
                                            </div>
                                        }
                                    </td>
                                </tr>
                            </table>

                            <div style="text-align:center; margin:10px 0;">
                                <span style="font-size:18pt; font-weight:bold; text-transform:uppercase;">
                                    @Model.InvoiceTypeDescription
                                </span>
                            </div>

                            <table class="info-grid">
                                <tr>
                                    <td style="width:50%; vertical-align:top; padding-left:2.5%;">
                                        <h4 style="margin:0 0 8px 0; font-weight:bold; font-size:14pt;">Bill To</h4>
                                        <div class="billto-address">
                                            @{
                                                var buyerName = invoice.Customer != null ? invoice.Customer.CompanyName : invoice.PublicCustomer?.CompanyName;
                                                var buyerAddr1 = invoice.Customer != null ? invoice.Customer.Addr1 : invoice.PublicCustomer?.Addr1;
                                                var buyerPostalCode = invoice.Customer != null ? invoice.Customer.PostalCode : invoice.PublicCustomer?.PostalCode;
                                                var buyerCity = invoice.Customer != null ? invoice.Customer.CityName : invoice.PublicCustomer?.CityName;
                                                var buyerTIN = invoice.Customer != null ? invoice.Customer.TIN : invoice.PublicCustomer?.TIN;
                                                var buyerAttention = invoice.Customer != null ? invoice.Customer.Attention : invoice.PublicCustomer?.Attention;
                                                var buyerState = invoice.Customer != null ? invoice.Customer.State?.State : invoice.PublicCustomer != null ? Model.DropdownHelper.GetStateName(invoice.PublicCustomer.StateCode) : null;
                                                var buyerCountry = invoice.Customer != null ? invoice.Customer.Country?.Country : invoice.PublicCustomer?.Country?.Country;
                                                var buyerCountryTitle = string.IsNullOrEmpty(buyerCountry) ? "" : System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(buyerCountry.ToLower());
                                            }
                                            <p>@buyerName</p>
                                            @if (buyerName != "General Public" && buyerName != "Foreign Buyer / Shipping Recipient" && buyerName != "Government and Related Entities")
                                            {
                                                <p>@Html.Raw(System.Net.WebUtility.HtmlEncode(buyerAddr1 ?? "").Replace("\n", "<br/>").Replace("\r", ""))</p>
                                                <p>@buyerPostalCode @buyerCity@(!string.IsNullOrEmpty(buyerState) || !string.IsNullOrEmpty(buyerCountryTitle) ? "," : "")</p>
                                                @if (!string.IsNullOrEmpty(buyerState) || !string.IsNullOrEmpty(buyerCountryTitle))
                                                {
                                                    <p>@buyerState@(!string.IsNullOrEmpty(buyerState) && !string.IsNullOrEmpty(buyerCountryTitle) ? ", " : "")@buyerCountryTitle.</p>
                                                }
                                            }
                                            else
                                            {
                                                <br />
                                                <p><strong>TIN:</strong> @buyerTIN</p>
                                            }
                                            @if (!string.IsNullOrEmpty(buyerAttention))
                                            {
                                                <p style="padding-top:12px">Attention: @buyerAttention</p>
                                            }
                                        </div>
                                    </td>

                                    <td style="width:50%; vertical-align:top;">
                                        <table class="meta-table">
                                            <tr>
                                                <td class="meta-label">Date</td>
                                                <td class="meta-sep">:</td>
                                                <td class="meta-value">@invoice.OriginalInvoiceDate?.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                            <tr>
                                                <td class="meta-label">Invoice No.</td>
                                                <td class="meta-sep">:</td>
                                                <td class="meta-value">@invoice.RefDocumentNo</td>
                                            </tr>
                                            <tr>
                                                <td class="meta-label">PO/DO No.</td>
                                                <td class="meta-sep">:</td>
                                                <td class="meta-value">@invoice.PoDoNo</td>
                                            </tr>
                                            <tr><td colspan="3" style="height:4px;"></td></tr>
                                            <tr>
                                                <td class="meta-label">E-Invoice No</td>
                                                <td class="meta-sep">:</td>
                                                <td class="meta-value">@invoice.InvoiceNo</td>
                                            </tr>
                                            <tr>
                                                <td class="meta-label">E-Invoice Date</td>
                                                <td class="meta-sep">:</td>
                                                <td class="meta-value">@invoice.IssueDate?.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                            <tr>
                                                <td class="meta-label">UUID</td>
                                                <td class="meta-sep">:</td>
                                                <td class="meta-value" style="word-break:break-all; white-space:normal;">@invoice.UUID</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <table class="invoice-table">
                                <thead>
                                    <tr>
                                        <th class="col-itemno">ITEM</th>
                                        <th class="col-desc">DESCRIPTION</th>
                                        <th class="col-qty">QUANTITY</th>
                                        <th class="col-unit">UNIT PRICE</th>
                                        <th class="col-total">TOTAL AMOUNT</th>
                                    </tr>
                                </thead>

                                <tfoot class="repeat-footer">
                                    <tr>
                                        <td colspan="5"></td>
                                    </tr>
                                </tfoot>

                                <tbody>
                                    @for (int i = 0; i < items.Count; i++)
                                    {
                                        var item = items[i];
                                        <tr>
                                            <td class="col-itemno" style="text-align:center; font-weight:bold;">@(i + 1)</td>
                                            <td class="col-desc" style="white-space:pre-wrap; text-align:left;">
                                                @Html.Raw(System.Net.WebUtility.HtmlEncode(item.ItemDescription ?? "").Replace("\n", "<br/>"))
                                            </td>
                                            <td class="col-qty" style="text-align:center;">@item.Quantity?.ToString("N2")</td>
                                            <td class="col-unit" style="text-align:right;">@item.UnitPrice?.ToString("N2")</td>
                                            <td class="col-total" style="text-align:right;">@((item.Quantity * item.UnitPrice)?.ToString("N2"))</td>
                                        </tr>
                                        @if (item.InvoiceTaxes != null)
                                        {
                                            foreach (var tax in item.InvoiceTaxes)
                                            {
                                                <tr>
                                                    <td class="col-itemno"></td>
                                                    <td class="col-desc">
                                                        @if (tax.TaxCategoryDescription == "Not Applicable")
                                                        {
                                                            @:Tax Rate @tax.TaxPercentage?.ToString("N2")%
                                                        }
                                                        else
                                                        {
                                                            @($"{tax.TaxCategoryDescription} Rate {tax.TaxPercentage?.ToString("N2")}%")
                                                        }
                                                    </td>
                                                    <td class="col-qty"></td>
                                                    <td class="col-unit" style="text-align:right;">@tax.TaxAmount?.ToString("N2")</td>
                                                    <td class="col-total" style="text-align:right;">@tax.TaxAmount?.ToString("N2")</td>
                                                </tr>
                                            }
                                        }
                                    }

                                    <tr class="total-row">
                                        <td colspan="3" class="total-label">
                                            <strong>@(Model.FullCurrencyName):</strong><br />
                                            <span style="font-weight:normal;">
                                                @EINVWORLD.Helpers.AmountInWordsHelper.ToWordsEnglish(invoice.TotalAmountIncTax ?? 0)
                                            </span>
                                        </td>
                                        <td class="total-right">Total (@(invoice.Currency ?? "MYR")):</td>
                                        <td class="total-amount">@invoice.TotalAmountIncTax?.ToString("N2")</td>
                                    </tr>
                                </tbody>
                            </table>

                            <div id="invoiceFooter">

                                <table class="footer-outer" style="margin-top:15px;">
                                    <tr>
                                        <td style="width:55%; vertical-align:top; padding-right: 15px;">
                                            <div class="payment-block">
                                                <strong>PAYMENT TERMS:</strong> @(invoice.PaymentTerms ?? "")<br /><br />
                                                <strong>Bank Acc.No.:</strong> @(invoice.BankAccountNo ?? "")<br />
                                                <strong>Bank Name:</strong> @(invoice.BankName ?? "")
                                            </div>
                                        </td>

                                        <td style="width:45%; vertical-align:top;">
                                            <table class="summary-box">
                                                <tr>
                                                    <td class="summary-label">Subtotal (@(invoice.Currency ?? "")):</td>
                                                    <td style="width:40%;">@(Model.InvoiceDetail?.TotalAmountExclTax?.ToString("N2"))</td>
                                                </tr>
                                                <tr>
                                                    <td class="summary-label">Total Excluding Tax (@(invoice.Currency ?? "")):</td>
                                                    <td>@(Model.InvoiceDetail?.TotalAmountExclTax?.ToString("N2"))</td>
                                                </tr>
                                                <tr>
                                                    <td class="summary-label">Tax Amount (@(invoice.Currency ?? "")):</td>
                                                    <td>@invoice.TotalTaxAmount?.ToString("N2")</td>
                                                </tr>
                                                <tr>
                                                    <td class="summary-label">Total Including Tax (@(invoice.Currency ?? "")):</td>
                                                    <td>@invoice.TotalAmountIncTax?.ToString("N2")</td>
                                                </tr>
                                                <tr class="total-payable-cell">
                                                    <td class="summary-label total-payable-cell">Total Payable (@(invoice.Currency ?? "")):</td>
                                                    <td class="total-payable-cell">@invoice.TotalPayableAmount?.ToString("N2")</td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <table class="signoff-table">
                                    <tr>
                                        <td style="width:55%; vertical-align:middle;">
                                            <div class="signoff">
                                                <strong>For and on Behalf of</strong><br />
                                                <strong style="font-size:12pt;">@invoice.Supplier?.CompanyName</strong><br />
                                                <em>This is computer generated document.</em><br />
                                                <em>No signature is required.</em>
                                            </div>
                                        </td>
                                        <td style="width:45%; vertical-align:top;">
                                            @if (!string.IsNullOrEmpty(Model.QRCodeBase64))
                                            {
                                                <img src="data:image/png;base64,@Model.QRCodeBase64"
                                                     style="width:75px; height:75px;"
                                                     alt="Invoice QR Code" />
                                            }
                                        </td>
                                    </tr>
                                </table>

                            </div>
                        </div><span id="invoiceNumber" hidden>@invoice.InvoiceNo</span>
                    </div>
                    </div>
                </div>
        </div>
    </div>

    <aside class="einv-det-side d-print-none" aria-label="Status and actions">
        <section class="einv-panel">
            <div class="einv-panel-h"><h2>LHDN status</h2></div>
            <div class="einv-panel-b einv-det-status">
                @if (displayStatus == "Valid" && invoice.DateTimeValidated.HasValue)
                {
                    <partial name="_LhdnSeal" model="invoice.DateTimeValidated.Value" />
                }
                <div class="einv-badge-lg @InvoiceStatusBadge.CssClass(Model!.DisplayStatusName)">
                    @if (InvoiceStatusBadge.Icon(Model!.DisplayStatusName) is string statusIcon)
                    {
                        <i class="@statusIcon" aria-hidden="true"></i>
                    }
                    @displayStatus
                </div>
            </div>
        </section>

        <section class="einv-panel">
            <div class="einv-panel-h"><h2>Summary</h2></div>
            <dl class="einv-kv einv-panel-b">
                <dt>Total payable</dt>
                <dd class="einv-num fw-semibold">@invoice.Currency @(invoice.TotalPayableAmount?.ToString("N2") ?? invoice.TotalAmountIncTax?.ToString("N2") ?? "0.00")</dd>
                @if (!string.IsNullOrEmpty(invoice.UUID))
                {
                    <dt>UUID</dt>
                    <dd class="font-monospace small">@invoice.UUID</dd>
                }
                @if (invoice.DateTimeValidated.HasValue)
                {
                    <dt>Validated</dt>
                    <dd class="einv-num">@invoice.DateTimeValidated.Value.ToString("dd MMM yyyy, HH:mm")</dd>
                }
            </dl>
        </section>

        @if (canReject || canCancel)
        {
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Actions</h2><span class="einv-panel-sub">Within 72 hours of validation</span></div>
                <div class="einv-panel-b d-grid gap-2">
                    @if (canReject)
                    {
                        var rejectTin = invoice.Customer?.TIN ?? invoice.PublicCustomer?.TIN ?? "";
                        <button type="button" id="rejectInvoiceBtn" class="btn btn-outline-warning"
                                data-invoiceno="@invoice.InvoiceNo" data-uuid="@invoice.UUID" data-tin="@rejectTin">
                            <i class="ri-forbid-line" aria-hidden="true"></i>Request rejection
                        </button>
                    }
                    @if (canCancel)
                    {
                        var cancelTin = invoice.Supplier?.TIN ?? "";
                        <button type="button" id="cancelInvoiceBtn" class="btn btn-outline-danger"
                                data-invoiceno="@invoice.InvoiceNo" data-uuid="@invoice.UUID" data-tin="@cancelTin">
                            <i class="ri-close-circle-line" aria-hidden="true"></i>Cancel invoice
                        </button>
                    }
                </div>
            </section>
        }
    </aside>
</div>

        <section class="einv-panel d-print-none mt-4">
            <div class="einv-panel-h">
                <h2>e-Invoice activity log</h2>
                <label for="actionFilter" class="visually-hidden">Filter by action</label>
                <select id="actionFilter" class="form-select form-select-sm w-auto">
                    <option value="">All actions</option>
                    <option value="EmailSent">Email sent</option>
                    <option value="PDFGenerated">PDF generated</option>
                    <option value="StatusChanged">Status changed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <div data-einv-columns-for="invoice-activity"></div>
                <a href="?handler=ExportHistory&invoiceNo=@Model.InvoiceDetail?.InvoiceNo" class="btn btn-sm btn-outline-secondary"><i class="ri-download-2-line" aria-hidden="true"></i>Export CSV</a>
            </div>
            <div class="einv-panel-b p-0">
                @if (Model.InvoiceHistories != null && Model.InvoiceHistories.Any())
                {
                    <div class="table-responsive einv-table-scroll-x">
                        <table data-einv-table="invoice-activity" id="activityLogTable" class="table align-middle mb-0 einv-mobile-stack">
                            <thead class="einv-table-head">
                                <tr>
                                    <th>#</th>
                                    <th>Timestamp</th>
                                    <th data-col-data>Action</th>
                                    <th>Performed By</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.InvoiceHistories.Count; i++)
                                {
                                    var h = Model.InvoiceHistories[i];

                                    // Hide from non-admins
                                    if (h.Action == "FileMoved" && !isAdmin)
                                    {
                                        continue;
                                    }

                                    <tr class="@(h.Action == "FileMoved" ? "table-warning" : "")">
                                        <td data-label="#">@(i + 1)</td>
                                        <td data-label="Timestamp" class="text-muted small">@h.Timestamp.ToString("yyyy-MM-dd hh:mm:ss tt")</td>
                                        <td data-label="Action"><span>@GetActionIcon(h.Action) @h.Action</span></td>
                                        <td data-label="Performed By"><span class="text-break">@h.PerformedBy</span></td>
                                        <td data-label="Remarks" title="@h.Remarks"><span class="text-break">@h.Remarks</span></td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="einv-empty"><span class="einv-empty-icon" aria-hidden="true"><i class="ri-history-line"></i></span><p class="einv-empty-title">No activity yet</p><p class="einv-empty-text">Status changes, emails and PDFs for this invoice will be listed here.</p></div>
                }
            </div>
        </section>

