@section Scripts {
    <script src="~/js/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script type="module" src="~/js/submit-invoice.js" asp-append-version="true"></script>

    <script src="~/js/bulk-submit-invoice.js" asp-append-version="true"></script>
    <script src="~/js/bulk-validate-invoice.js" asp-append-version="true"></script>
    <script src="~/js/bulk-send-to-buyers.js" asp-append-version="true"></script>
    <script type="module" src="~/js/delete-invoice.js" asp-append-version="true"></script>
    <script type="module" src="~/js/date-picker.js" asp-append-version="true"></script>
    
    <script>
    // The download endpoint sends Content-Disposition: attachment, so opening it directly in a
    // tab just downloads the file instead of rendering it for print. Fetch it as a blob instead —
    // blob URLs render inline regardless of the original response's disposition header.
    function printInvoicePdf(invoiceNo) {
        fetch('?handler=DownloadPdf&invoiceNo=' + encodeURIComponent(invoiceNo))
            .then(res => res.blob())
            .then(blob => {
                const url = URL.createObjectURL(blob);
                const iframe = document.createElement('iframe');
                iframe.style.display = 'none';
                iframe.src = url;
                document.body.appendChild(iframe);
                iframe.onload = () => {
                    iframe.contentWindow.print();
                    setTimeout(() => { iframe.remove(); URL.revokeObjectURL(url); }, 60000);
                };
            })
            .catch(() => alert('Unable to load the PDF for printing.'));
    }

    function changePageSize(pageSize) {
        const url = new URL(window.location.href);
        url.searchParams.set('pageSize', pageSize);
        url.searchParams.set('pageNo', '1'); // Reset to first page when changing page size
        window.location.href = url.toString();
    }
    </script>
    <script type="module" src="~/js/tableRowSelection.js" asp-append-version="true"></script>
    <script type="module" src="~/js/request-rejection.js" asp-append-version="true"></script>
    <script type="module" src="~/js/cancel-invoice.js" asp-append-version="true"></script>
    <script type="module" src="~/js/export-invoice.js" asp-append-version="true"></script>
    <script src="~/js/enhanced-table-scroll.js" asp-append-version="true"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        initDoubleClickToCopy();
    });
    function initDoubleClickToCopy() {
        const table = document.getElementById('invoiceTable');
        if (!table) return;

        table.addEventListener('dblclick', function(e) {
            // 1. Ignore if the user clicked a link, button, input, or the column resizer
            if (e.target.closest('a') || e.target.closest('button') || e.target.closest('input')) {
                return; 
            }

            // 2. Find the closest table cell (td) that was clicked
            const td = e.target.closest('td');
            
            // 3. IGNORE if it's not a cell OR if it is the Action column
            if (!td || td.classList.contains('col-action')) {
                return;
            }

            // 4. Get the text content and clean up any extra whitespace/newlines
            const textToCopy = td.textContent.trim().replace(/\s+/g, ' ');
            if (!textToCopy) return;

            // 5. Copy the text to the clipboard
            navigator.clipboard.writeText(textToCopy).then(() => {
                // Show a tiny toast notification using SweetAlert2
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        toast: true,
                        position: 'top-end', 
                        icon: 'success',
                        title: 'Copied: ' + (textToCopy.length > 30 ? textToCopy.substring(0, 30) + '...' : textToCopy),
                        showConfirmButton: false,
                        timer: 1500,
                        timerProgressBar: true,
                        customClass: {
                            popup: 'colored-toast'
                        }
                    });
                }
            }).catch(err => {
                console.error('Failed to copy text: ', err);
            });
        });
    }
    // Columns: the shared Columns menu (einvworld-table.js) now saves show/hide + order to the account.
    // Once per user, adopt the choice saved by the old Customize panel (its handlers stay read-only for
    // this). The old load handler answers with the direction defaults when nothing was saved, so those
    // aren't copied over.
    (function adoptOldColumnChoice() {
        const table = document.getElementById('invoiceTable');
        if (!table) return;
        const direction = @Json.Serialize(invoiceDirection);
        const defaultHidden = Array.from(table.querySelectorAll('th[data-col-default="hidden"]')).map(th => th.dataset.colId).sort().join(',');
        // Users who never customised get null below; remember that so the old handlers aren't asked again.
        const checkedKey = 'einv-cols-legacy-checked:' + (document.querySelector('meta[name="einv-uid"]')?.content || '') + ':' + table.dataset.einvTable;
        try { if (localStorage.getItem(checkedKey)) return; } catch (e) { /* storage blocked: just check again */ }
        table.einvLegacyColumns = async function () {
            const q = 'invoiceDirection=' + encodeURIComponent(direction);
            const [vis, ord] = await Promise.all([
                fetch('?handler=LoadColumnPreferences&' + q).then(r => r.json()),
                fetch('?handler=LoadColumnOrder&' + q).then(r => r.json())
            ]);
            const settings = (vis && vis.success && vis.data) || {};
            const order = (ord && ord.success && Array.isArray(ord.data)) ? ord.data : [];
            const hidden = Object.keys(settings).filter(k => settings[k] === false);
            const present = id => !!table.querySelector('th[data-col-id="' + CSS.escape(String(id)) + '"]');
            if (!order.length && hidden.filter(present).sort().join(',') === defaultHidden) {
                try { localStorage.setItem(checkedKey, '1'); } catch (e) { }
                return null; // nothing was customised
            }
            return { hidden: hidden, order: order };
        };
    })();

    // Saved Views: capture the current URL's filter params (excluding direction/sort/paging — those
    // come from the tab and live state, not the saved preset) and let the user name+save them.
    (function initSavedViews() {
        const saveBtn = document.getElementById('saveCurrentViewBtn');
        if (saveBtn) {
            saveBtn.addEventListener('click', async () => {
                const params = new URLSearchParams(window.location.search);
                ['invoiceDirection', 'sortBy', 'sortOrder', 'pageNo'].forEach(k => params.delete(k));
                const queryString = params.toString();

                const { value: name } = await Swal.fire({
                    title: 'Save Current View',
                    input: 'text',
                    inputLabel: 'Name this view (e.g. "High Value", "Failed Validation")',
                    inputPlaceholder: 'My View',
                    showCancelButton: true,
                    confirmButtonText: 'Save',
                    inputValidator: (value) => !value ? 'Please enter a name.' : undefined
                });
                if (!name) return;

                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]');
                const headers = { 'Content-Type': 'application/json' };
                if (csrfToken) headers['RequestVerificationToken'] = csrfToken.value;

                try {
                    const response = await fetch('?handler=SaveView', {
                        method: 'POST',
                        headers: headers,
                        body: JSON.stringify({ invoiceDirection: '@invoiceDirection', name: name, queryString: queryString })
                    });
                    const result = await response.json();
                    if (result.success) {
                        location.reload();
                    } else {
                        Swal.fire('Could Not Save', result.message || 'Please try again.', 'warning');
                    }
                } catch (error) {
                    console.error('Save view error:', error);
                    Swal.fire('Error', 'A network error occurred. Please try again.', 'error');
                }
            });
        }

        document.querySelectorAll('.delete-saved-view').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.preventDefault();
                const id = btn.dataset.id;
                const confirmed = await Swal.fire({
                    title: 'Delete this saved view?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete',
                    cancelButtonText: 'Cancel'
                });
                if (!confirmed.isConfirmed) return;

                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]');
                const headers = {};
                if (csrfToken) headers['RequestVerificationToken'] = csrfToken.value;

                try {
                    const response = await fetch(`?handler=DeleteSavedView&id=${encodeURIComponent(id)}`, {
                        method: 'POST',
                        headers: headers
                    });
                    const result = await response.json();
                    if (result.success) {
                        btn.closest('.saved-view-pill')?.remove();
                    } else {
                        Swal.fire('Could Not Delete', result.message || 'Please try again.', 'warning');
                    }
                } catch (error) {
                    console.error('Delete saved view error:', error);
                }
            });
        });
    })();


    // LHDN error text echoes submitted values, so always escape it. Since SDK 25 Sep 2026 errors may
    // reference an SDK error page ("Please refer to https://sdk.myinvois.hasil.gov.my/...") — only
    // those links are made clickable, after escaping.
    function lhdnErrorHtml(value) {
        const div = document.createElement('div');
        div.textContent = value == null ? '' : String(value);
        return div.innerHTML.replace(/https:\/\/sdk\.myinvois\.hasil\.gov\.my\/[\w\-.\/#%?=]*/g,
            url => `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`);
    }

    function showInvalidReason(btn) {
        const invoiceNo = btn.getAttribute('data-invoiceno');
        const uuid = btn.getAttribute('data-uuid');
        const submissionId = btn.getAttribute('data-submissionid');
        const tin = btn.getAttribute('data-tin');
        const generalReason = btn.getAttribute('data-reason');

        document.getElementById('invalidInvoiceNo').innerText = invoiceNo;
        document.getElementById('invalidUuid').innerText = uuid || "N/A";
        document.getElementById('invalidGeneralReason').innerText = generalReason || "Validation failed during processing.";
        
        document.getElementById('validationDetailsContainer').innerHTML = `
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Fetching technical validation steps from LHDN...</p>
            </div>`;
            
        var modal = new bootstrap.Modal(document.getElementById('invalidReasonModal'));
        modal.show();
        
        // Bypass API fetch if no LHDN tracking IDs exist
        if (!uuid && !submissionId) {
            document.getElementById('validationDetailsContainer').innerHTML = `
                <div class="alert alert-info border-0 shadow-sm"><i class="ri-information-line me-2"></i> No advanced LHDN tracking IDs available to fetch detailed technical steps.</div>`;
            return;
        }

        fetch(`?handler=ValidationDetails&uuid=${encodeURIComponent(uuid || '')}&submissionId=${encodeURIComponent(submissionId || '')}&tin=${encodeURIComponent(tin || '')}&invoiceNo=${encodeURIComponent(invoiceNo || '')}`)
            .then(response => response.json())
            .then(data => {
                let html = '';
                if (data.success && data.errors && data.errors.length > 0) {
                    html += '<div class="list-group gap-2">';
                    data.errors.forEach(err => {
                        html += `
                        <div class="list-group-item list-group-item-danger border border-danger border-opacity-25 rounded shadow-sm">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 text-danger fw-bold"><i class="ri-close-circle-line me-1"></i> Error Code: ${lhdnErrorHtml(err.errorCode || 'N/A')}</h6>
                            </div>
                            <p class="mb-2"><strong>Error:</strong> ${lhdnErrorHtml(err.error || 'Validation error')}</p>
                            ${err.propertyPath ? `<p class="mb-2 text-muted fs-13"><i class="ri-map-pin-line me-1"></i> <strong>Location:</strong> <code class="bg-white border px-1 rounded text-danger">${lhdnErrorHtml(err.propertyPath)}</code></p>` : ''}
                            ${err.innerErrors && err.innerErrors.length > 0 ? `<div class="bg-white border border-danger border-opacity-10 p-2 rounded mb-2 fs-13"><strong class="d-block mb-1 text-danger">Inner Errors:</strong><ul class="mb-0 text-muted" style="padding-left: 20px;">` + err.innerErrors.map(ie => `<li><b>${lhdnErrorHtml(ie.propertyName)}</b>: ${lhdnErrorHtml(ie.error)}</li>`).join('') + `</ul></div>` : ''}

                        </div>`;
                    });
                    html += '</div>';
                } else {
                    html = `<div class="alert alert-info border-0 shadow-sm"><i class="ri-information-line me-2"></i> No additional technical validation steps were provided by LHDN for this document. <br><br><b>Tip:</b> Review the general reason above and verify your input against LHDN MyInvois guidelines.</div>`;
                }
                document.getElementById('validationDetailsContainer').innerHTML = html;
            })
            .catch(error => {
                console.error("Popup Error:", error);
                document.getElementById('validationDetailsContainer').innerHTML = `
                    <div class="alert alert-danger border-0 shadow-sm"><i class="ri-error-warning-line me-2"></i> Failed to load detailed errors from the server.</div>`;
            });
    }
    document.addEventListener("DOMContentLoaded", function () {
        
        // --- DROPDOWN OVERFLOW FIX ---
        const tableContainer = document.querySelector('.table-scroll .inner');
        if (tableContainer) {
            // 1. When the user clicks the 3 dots to open the menu
            tableContainer.addEventListener('show.bs.dropdown', function (e) {
                const dropdownBtn = e.target;
                const dropdownMenu = dropdownBtn.nextElementSibling;
                
                if (!dropdownMenu || !dropdownMenu.classList.contains('dropdown-menu')) return;

                // Move the dropdown to the body to escape the table's clipping boundaries
                document.body.appendChild(dropdownMenu);
                
                // Force it to block briefly so we can calculate its width
                dropdownMenu.style.display = 'block';

                // Get exact coordinates of the button on the screen
                const btnRect = dropdownBtn.getBoundingClientRect();

                // Force the menu to float exactly under the button as a fixed element
                dropdownMenu.style.position = 'fixed';
                dropdownMenu.style.top = btnRect.bottom + 'px';
                // Align the right edge of the menu with the right edge of the button
                dropdownMenu.style.left = (btnRect.right - dropdownMenu.offsetWidth) + 'px'; 
                dropdownMenu.style.zIndex = '99999';

                // Save the button's ID so we know where to return the menu when it closes
                dropdownMenu.dataset.returnId = dropdownBtn.id || (dropdownBtn.id = 'btn-' + Math.random().toString(36).substr(2, 9));
            });

            // 2. When the user closes the menu
            tableContainer.addEventListener('hide.bs.dropdown', function (e) {
                const dropdownBtn = e.target;
                const dropdownMenu = document.querySelector('.dropdown-menu[data-return-id="' + dropdownBtn.id + '"]');
                
                if (dropdownMenu) {
                    // Put it back in the table next to its original button
                    dropdownBtn.parentNode.appendChild(dropdownMenu);
                    
                    // Clear the manual floating styles
                    dropdownMenu.style.position = '';
                    dropdownMenu.style.top = '';
                    dropdownMenu.style.left = '';
                    dropdownMenu.style.zIndex = '';
                    dropdownMenu.style.display = '';
                }
            });

            // 3. Auto-close floating dropdowns if the user scrolls the table or the window
            const closeFloatingDropdowns = function () {
                const openBtn = document.querySelector('.table-scroll .inner [data-bs-toggle="dropdown"][aria-expanded="true"]');
                if (openBtn) {
                    const bsDropdown = bootstrap.Dropdown.getInstance(openBtn);
                    if (bsDropdown) bsDropdown.hide();
                }
            };
            
            tableContainer.addEventListener('scroll', closeFloatingDropdowns);
            window.addEventListener('scroll', closeFloatingDropdowns);
        }
    });
</script>
<script>
    $(document).ready(function () {
        // Guard so interval ticks never stack: a rate-limited sync can take minutes server-side,
        // and firing another request on top multiplies the LHDN polling load.
        let sessionSyncInFlight = false;

        // Runs every 30 seconds
        setInterval(function () {
            // Stop running if the user switches to another browser tab (Saves API calls!)
            if (document.hidden) return;

            // Skip this tick if the previous sync request hasn't finished yet
            if (sessionSyncInFlight) return;

            // Gather the Invoice Numbers currently visible on the table. Read from the rows
            // (not the checkboxes) so tabs without row selection — e.g. All — still auto-sync.
            let visibleInvoices = [];
            $('#invoiceTable tbody tr[data-invoiceno]').each(function () {
                let invoiceNo = $(this).data('invoiceno');
                if (invoiceNo) {
                    visibleInvoices.push(invoiceNo);
                }
            });

            if (visibleInvoices.length > 0) {
                sessionSyncInFlight = true;
                $.ajax({
                    url: '?handler=SyncActiveSession',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify(visibleInvoices),
                    success: function (response) {
                        // If the backend found updates (e.g., a buyer rejected it!), reload the page to show it.
                        if (response.success && response.updatedCount > 0) {
                            console.log("Updates found from LHDN! Refreshing data...");
                            location.reload();
                        }
                    },
                    complete: function () {
                        sessionSyncInFlight = false;
                    }
                });
            }
        }, 30000); // 30,000 milliseconds = 30 seconds
    });
</script>
<script>
    // Bulk-action UX (presentational only — bulk handlers still read `.invoice-checkbox:checked`).
    //  1) Keep the Delete/Cancel/Reject bulk buttons hidden until at least one row is selected.
    //  2) Make the header "select all" checkbox actually select/deselect every row + reflect an
    //     indeterminate state. No PageModel/query/permission/API change.
    (function () {
        var bulkIds = ['bulkSubmitBtn', 'bulkDeleteBtn', 'bulkCancelBtn', 'bulkRejectBtn', 'bulkValidateBtn', 'bulkSendToBuyersBtn'];

        function rowCheckboxes() { return Array.prototype.slice.call(document.querySelectorAll('.invoice-checkbox')); }

        function refreshBulkVisibility() {
            var checkedBoxes = document.querySelectorAll('.invoice-checkbox:checked');
            var checked = checkedBoxes.length;
            bulkIds.forEach(function (id) {
                var btn = document.getElementById(id);
                if (btn) { btn.classList.toggle('d-none', checked === 0); }
            });
            var bar = document.getElementById('bulkActionBar');
            if (bar) { bar.classList.toggle('d-none', checked === 0); }
            var count = document.getElementById('bulkSelectedCount');
            if (count) { count.textContent = checked + ' Selected'; }
            var totalEl = document.getElementById('bulkSelectedTotal');
            if (totalEl) {
                var sum = Array.from(checkedBoxes).reduce(function (acc, cb) {
                    return acc + (parseFloat(cb.dataset.amount) || 0);
                }, 0);
                totalEl.textContent = checked > 0 ? ('Total: ' + sum.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })) : '';
            }
            var selectAll = document.getElementById('selectAll');
            if (selectAll) {
                var total = rowCheckboxes().length;
                selectAll.checked = total > 0 && checked === total;
                selectAll.indeterminate = checked > 0 && checked < total;
            }
        }

        document.addEventListener('change', function (e) {
            var t = e.target;
            if (!t) return;
            if (t.id === 'selectAll') {
                rowCheckboxes().forEach(function (cb) { cb.checked = t.checked; });
                refreshBulkVisibility();
            } else if (t.classList && t.classList.contains('invoice-checkbox')) {
                refreshBulkVisibility();
            }
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', refreshBulkVisibility);
        } else {
            refreshBulkVisibility();
        }
    })();
</script>
