@page
@using eInvWorld.Models.InputModel
@using Microsoft.AspNetCore.Html
@using eInvWorld.Helpers
@model eInvWorld.Pages.Invoices.InvoiceListsModel
@{
    ViewData["Title"] = "Invoice List";
    Layout = "_LayoutTabler";

    var invoiceDirection = string.IsNullOrEmpty(Request.Query["invoiceDirection"]) ? "Sent" : Request.Query["invoiceDirection"].ToString();
    if (Model.UserType == "Buyer")
    {
        invoiceDirection = "Received";
    }

    var rejectionReasons = eInvWorld.Models.Document.RejectDocumentInput.GetReasons();
    var invoiceStatus = string.IsNullOrEmpty(Request.Query["LHDNStatus"]) ? "" : Request.Query["LHDNStatus"].ToString();

    // Whether any Advanced Filters field is active — expands the panel and shows the active-dot indicator.
    var hasAdvancedFilters = !string.IsNullOrEmpty(Request.Query["submissionReceivedFrom"])
                           || !string.IsNullOrEmpty(Request.Query["submissionReceivedTo"])
                           || !string.IsNullOrEmpty(Request.Query["createdBy"])
                           || !string.IsNullOrEmpty(Request.Query["supplierFilter"])
                           || !string.IsNullOrEmpty(Request.Query["buyerFilter"])
                           || !string.IsNullOrEmpty(Request.Query["amountMin"])
                           || !string.IsNullOrEmpty(Request.Query["amountMax"])
                           || !string.IsNullOrEmpty(Request.Query["currencyFilter"]);

    // Single Stitch-style tab row: All / Draft / Sent / Received (Buyers see only Received).
    var mainTabs = new List<(string Key, string Label)>();

    if (Model.UserType == "Buyer")
    {
        mainTabs.Add(("Received", "Received"));
    }
    else
    {
        mainTabs = new List<(string Key, string Label)>
        {
            ("All", "All Invoices"),
            ("Draft", "Draft"),
            ("Sent", "Sent"),
            ("Received", "Received")
        };
    }

    // LHDN statuses that make sense as a filter for the current tab — used to validate the
    // LHDNStatus query value carried across tab switches (the filter itself lives in the filter card).
    var validStatuses = invoiceDirection switch
    {
        "Sent" => new[] { "Submitted", "Valid", "Invalid", "Cancelled" },
        "All" => new[] { "Submitted", "Valid", "Invalid", "Cancelled" },
        "Received" => new[] { "Valid", "Cancelled" },
        _ => Array.Empty<string>()
    };

    // Ensure status is valid for the selected invoiceDirection
    if (!validStatuses.Contains(invoiceStatus))
    {
        invoiceStatus = null; // Remove it from the query parameters
    }

    @functions {
        string? GetEditUrl(string docTypeCode, string invoiceNo)
        {
            // Return null if invoiceNo is null to avoid CS8603
            if (invoiceNo == null)
                return null;
            return Url.Page("/Invoices/InvoiceEdit", new { id = invoiceNo });
        }

        string GetEditLabel(string docTypeCode)
        {
            return docTypeCode switch
            {
                "01" => "Edit Invoice",
                "02" => "Edit CN",
                "03" => "Edit DN",
                "04" => "Edit RN",
                "11" => "Edit Self-billed Invoice",
                "12" => "Edit Self-billed CN",
                "13" => "Edit Self-billed DN",
                "14" => "Edit Self-billed RN",
                _ => "Edit Document"
            };
        }

        // Sort link that preserves every active filter (direction, search, dates, doc types,
        // statuses, page size) and resets to page 1 — clicking a header no longer drops filters.
        string SortUrl(string column)
        {
            var sb = new System.Text.StringBuilder("./InvoiceLists");
            var sep = '?';
            void Add(string key, string? value)
            {
                if (string.IsNullOrEmpty(value)) return;
                sb.Append(sep).Append(Uri.EscapeDataString(key)).Append('=').Append(Uri.EscapeDataString(value));
                sep = '&';
            }
            Add("invoiceDirection", Request.Query["invoiceDirection"]);
            Add("searchQuery", Request.Query["searchQuery"]);
            Add("submissionDateFrom", Request.Query["submissionDateFrom"]);
            Add("submissionDateTo", Request.Query["submissionDateTo"]);
            foreach (var docType in Request.Query["documentType"]) { Add("documentType", docType); }
            Add("LHDNStatus", Request.Query["LHDNStatus"]);
            Add("InternalStatus", Request.Query["InternalStatus"]);
            Add("status", Request.Query["status"]);
            Add("submissionReceivedFrom", Request.Query["submissionReceivedFrom"]);
            Add("submissionReceivedTo", Request.Query["submissionReceivedTo"]);
            Add("createdBy", Request.Query["createdBy"]);
            Add("supplierFilter", Request.Query["supplierFilter"]);
            Add("buyerFilter", Request.Query["buyerFilter"]);
            Add("amountMin", Request.Query["amountMin"]);
            Add("amountMax", Request.Query["amountMax"]);
            Add("currencyFilter", Request.Query["currencyFilter"]);
            Add("pageSize", Request.Query["pageSize"]);
            Add("pageNo", "1");
            Add("sortBy", column);
            Add("sortOrder", Model.SortBy == column && Model.SortOrder == "asc" ? "desc" : "asc");
            return sb.ToString();
        }

        // Pager link that preserves every active filter and the current sort.
        string PageUrl(int pageNo)
        {
            var sb = new System.Text.StringBuilder("./InvoiceLists");
            var sep = '?';
            void Add(string key, string? value)
            {
                if (string.IsNullOrEmpty(value)) return;
                sb.Append(sep).Append(Uri.EscapeDataString(key)).Append('=').Append(Uri.EscapeDataString(value));
                sep = '&';
            }
            Add("invoiceDirection", Request.Query["invoiceDirection"]);
            Add("searchQuery", Request.Query["searchQuery"]);
            Add("submissionDateFrom", Request.Query["submissionDateFrom"]);
            Add("submissionDateTo", Request.Query["submissionDateTo"]);
            foreach (var docType in Request.Query["documentType"]) { Add("documentType", docType); }
            Add("LHDNStatus", Request.Query["LHDNStatus"]);
            Add("InternalStatus", Request.Query["InternalStatus"]);
            Add("status", Request.Query["status"]);
            Add("submissionReceivedFrom", Request.Query["submissionReceivedFrom"]);
            Add("submissionReceivedTo", Request.Query["submissionReceivedTo"]);
            Add("createdBy", Request.Query["createdBy"]);
            Add("supplierFilter", Request.Query["supplierFilter"]);
            Add("buyerFilter", Request.Query["buyerFilter"]);
            Add("amountMin", Request.Query["amountMin"]);
            Add("amountMax", Request.Query["amountMax"]);
            Add("currencyFilter", Request.Query["currencyFilter"]);
            Add("sortBy", Request.Query["sortBy"]);
            Add("sortOrder", Request.Query["sortOrder"]);
            Add("pageSize", Request.Query["pageSize"]);
            Add("pageNo", pageNo.ToString());
            return sb.ToString();
        }

        string SortIcon(string column)
        {
            if (Model.SortBy == column)
            {
                return Model.SortOrder == "asc" ? "ri-arrow-up-s-line" : "ri-arrow-down-s-line";
            }
            return "ri-arrow-up-down-line";
        }

    }
@if (TempData["DeleteMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    icon: 'success',
                    title: 'Deleted!',
                    text: @Json.Serialize(TempData["DeleteMessage"]),
                    timer: 2000,
                    showConfirmButton: false
                });
            });
        </script>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    icon: 'success',
                    title: 'Sync Complete',
                    text: @Json.Serialize(TempData["SuccessMessage"]),
                    timer: 4000,
                    showConfirmButton: false
                });
            });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    icon: 'warning',
                    title: 'Notice',
                    text: @Json.Serialize(TempData["ErrorMessage"]),
                    showConfirmButton: true,
                    confirmButtonColor: '#006948'
                });
            });
        </script>
    }
}


<div id="submitLoadingOverlay" class="loading-overlay" style="display:none;">
    <div class="spinner-border text-light" role="status"></div>
    <p>Submitting invoice to LHDN...</p>
</div>
<div id="refreshApiOverlay" class="loading-overlay" style="display:none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999; justify-content: center; align-items: center; flex-direction: column; color: white;">
    <div class="spinner-border text-success" role="status" style="width: 4rem; height: 4rem;"></div>
    <h4 class="mt-3 text-white">Syncing with LHDN API...</h4>
    <p>Please wait while we fetch the latest updates. Do not close this page.</p>
</div>

@{
    var pageTitle = invoiceDirection switch
    {
        "Draft" => "Draft Invoices",
        "Sent" => "Sent Invoices",
        "Received" => "Received Invoices",
        _ => "All Invoices"
    };
    var pageDescription = invoiceDirection switch
    {
        "Draft" => "Manage, validate and submit your pending documents.",
        "Sent" => "Manage and track your outgoing documents delivered to buyers.",
        "Received" => "Manage and track incoming documents from your suppliers.",
        _ => "Track every document across drafts, sent and received in one place."
    };
    // Page actions per tab (Stitch): Refresh syncs from LHDN, so it is not shown on the
    // local-only Draft tab; Create Invoice appears where new documents are started (All/Draft).
    var showRefreshAction = invoiceDirection != "Draft";
    var showCreateAction = Model.UserType == "Supplier" && !Model.IsViewOnly
                           && (invoiceDirection == "All" || invoiceDirection == "Draft");
    // Row selection exists where bulk actions exist (Draft/Sent/Received). The mixed-status All
    // tab has no bulk actions, so it renders without the checkbox column.
    var showSelection = !Model.IsViewOnly
                        && (invoiceDirection == "Draft" || invoiceDirection == "Sent" || invoiceDirection == "Received");
    // Shared Columns menu (einvworld-table.js), saved to the account. Received shows the Supplier and
    // the other tabs the Buyer, so they keep separate column sets (as the old Customize panel did).
    var isReceivedTab = invoiceDirection == "Received";
    var columnsKey = isReceivedTab ? "invoices-received" : "invoices";
}

<!-- Stitch page header: breadcrumb + title + description left, page actions right -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box mb-3 d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb m-0 mb-1">
                        <li class="breadcrumb-item"><a href="/Dashboard/Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a asp-page="./InvoiceLists">Invoices</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
                    </ol>
                </nav>
                <h1 class="einv-page-title mb-1">@pageTitle</h1>
                <p class="text-muted mb-0">@pageDescription</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <!-- Filter Button (collapses/expands the inline filter card) -->
                <button class="btn btn-outline-secondary d-flex align-items-center gap-1" data-bs-toggle="collapse"
                        data-bs-target="#filterOffcanvas" aria-expanded="true" aria-controls="filterOffcanvas">
                    <i class="ri-filter-line"></i> Filter
                </button>

                @if (showRefreshAction)
                {
                    <a asp-page="./InvoiceLists"
                       asp-route-status="@Request.Query["status"]"
                       asp-route-invoiceDirection="@Model.invoiceDirection"
                       asp-route-submissionDateFrom="@Request.Query["submissionDateFrom"]"
                       asp-route-submissionDateTo="@Request.Query["submissionDateTo"]"
                       asp-route-refresh="true"
                       class="btn btn-outline-secondary d-flex align-items-center gap-1"
                       title="Refresh invoices from LHDN API"
                       onclick="document.getElementById('refreshApiOverlay').style.display='flex';">
                        <i class="ri-refresh-line"></i> Refresh from API
                    </a>
                }

                <a class="btn btn-outline-secondary d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#exportModal">
                    <i class="ri-file-download-line"></i> Export
                </a>

                <div data-einv-columns-for="@columnsKey" data-einv-columns-size="md"></div>

                @if (showCreateAction)
                {
                    <a href="/Invoices/CreateInvoice" class="btn btn-primary d-flex align-items-center gap-1">
                        <i class="ri-add-line align-bottom"></i> Create Invoice
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@{
    var showCndnIntentBanner = string.Equals(Request.Query["intent"], "cndn", StringComparison.OrdinalIgnoreCase);
}
@if (showCndnIntentBanner)
{
    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
        <i class="ri-information-line fs-5"></i>
        <div>To issue a Credit, Debit or Refund Note, find the original invoice below (status <strong>Valid</strong>) and use its <strong>Create CN / Create DN / Create RN</strong> action.</div>
    </div>
}

@{
    // Top KPI strip (Stitch): direction-scoped, real counts/totals already computed server-side
    // (same tab-wide, pre-filter scope as the sort/filter query below) — no placeholder figures.
    var kpiCounts = Model.InvoiceSummaryByStatus ?? new Dictionary<string, int>();
    var kpiTotal = kpiCounts.Values.Sum();
    var kpiValid = kpiCounts.TryGetValue("Valid", out var kpiValidCount) ? kpiValidCount : 0;
    var kpiPending = kpiCounts.TryGetValue("Submitted", out var kpiPendingCount) ? kpiPendingCount : 0;
    var kpiRejected = kpiCounts.TryGetValue("Invalid", out var kpiInvalidCount) ? kpiInvalidCount : 0;
    var kpiTotalLabel = invoiceDirection switch
    {
        "Draft" => "Total drafts",
        "Received" => "Total received",
        "All" => "Total documents",
        _ => "Total sent"
    };
}
@if (kpiTotal > 0)
{
    <div class="einv-kpis" role="group" aria-label="Summary for this tab">
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l">@kpiTotalLabel</div>
            <div class="einv-kpi-v">@kpiTotal.ToString("N0")</div>
        </div>
        @if (invoiceDirection != "Draft")
        {
            <div class="einv-kpi-cell">
                <div class="einv-kpi-l"><span class="einv-dot einv-dot-valid"></span>Validated by LHDN</div>
                <div class="einv-kpi-v">@kpiValid.ToString("N0")</div>
            </div>
        }
        <div class="einv-kpi-cell">
            <div class="einv-kpi-l">Total value</div>
            <div class="einv-kpi-v"><small>RM</small>@Model.TabTotalAmount.ToString("N0")</div>
        </div>
        @if (invoiceDirection != "Draft")
        {
            <div class="einv-kpi-cell">
                <div class="einv-kpi-l"><span class="einv-dot einv-dot-submitted"></span>Pending</div>
                <div class="einv-kpi-v">@kpiPending.ToString("N0")</div>
            </div>
            @if (kpiRejected > 0)
            {
                <div class="einv-kpi-cell">
                    <div class="einv-kpi-l"><span class="einv-dot einv-dot-invalid"></span>Rejected</div>
                    <div class="einv-kpi-v">@kpiRejected.ToString("N0")</div>
                </div>
            }
        }
    </div>
}

<!-- Main invoice tabs — single Stitch underline row (green underline on the active tab) -->
@{
    var tabCounts = new Dictionary<string, int>
    {
        ["All"] = Model.TotalAllInvoices,
        ["Draft"] = Model.TotalDraftInvoices,
        ["Sent"] = Model.TotalSentInvoices,
        ["Received"] = Model.TotalReceivedInvoices
    };
}
@if (Model.TotalNeedsAttentionInvoices > 0)
{
    var isAttentionActive = string.Equals(Request.Query["internalStatus"].ToString(), "NeedsAttention", StringComparison.OrdinalIgnoreCase);
    <div class="mb-2">
        <a asp-page="./InvoiceLists"
           asp-route-invoiceDirection="All"
           asp-route-internalStatus="NeedsAttention"
           class="btn btn-sm @(isAttentionActive ? "btn-danger" : "btn-outline-danger") rounded-pill d-inline-flex align-items-center gap-2 fw-semibold"
           title="Invoices that are Invalid, failed transmission, rejected, or drafts stuck more than 3 days">
            <i class="ri-error-warning-line"></i> Needs Attention
            <span class="badge rounded-pill @(isAttentionActive ? "bg-white text-danger" : "bg-danger text-white")">@Model.TotalNeedsAttentionInvoices.ToString("N0")</span>
        </a>
    </div>
}
<ul class="nav nav-tabs einv-invoice-tabs mb-3">
    @foreach (var tab in mainTabs)
    {
        var isTabActive = invoiceDirection == tab.Key;
        <li class="nav-item">
            <a class="nav-link fw-semibold d-flex align-items-center gap-2 @(isTabActive ? "active" : "")"
               asp-page="./InvoiceLists"
               asp-route-invoiceDirection="@tab.Key"
               asp-route-LHDNStatus="@(tab.Key == "Draft" ? null : (validStatuses.Contains(invoiceStatus) ? invoiceStatus : null))"
               asp-route-status="@(tab.Key == "Draft" ? null : (validStatuses.Contains(invoiceStatus) ? invoiceStatus : null))">
                @tab.Label
                <span class="badge rounded-pill @(isTabActive ? "bg-primary" : "bg-secondary-subtle text-secondary-emphasis")">@tabCounts[tab.Key].ToString("N0")</span>
            </a>
        </li>
    }
</ul>

<!-- Saved Views (Stitch): named filter presets for this tab. Each stores the filter form's own
     query string, so applying one is a plain navigation — no separate filter-serialization logic. -->
<div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="savedViewsRow">
    @foreach (var view in Model.SavedViews)
    {
        <span class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill border saved-view-pill">
            <a href="./InvoiceLists?invoiceDirection=@invoiceDirection&@view.QueryString" class="text-decoration-none fw-semibold small">@view.Name</a>
            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1 delete-saved-view" data-id="@view.Id" title="Delete this saved view" style="line-height:1;">
                <i class="ri-close-line"></i>
            </button>
        </span>
    }
    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" id="saveCurrentViewBtn" title="Save the current filters as a named view">
        <i class="ri-add-line"></i> Save View
    </button>
</div>

<div class="row">
    <div class="col-lg-12">
        <div id="documentList">
            <!-- Inline filter card (Stitch design) — same GET form + field names/ids the previous
                 offcanvas carried (date-picker.js keys on #submissionDateRange), rendered as an
                 always-visible card that the header Filter button collapses/expands. -->
            <div class="collapse show" id="filterOffcanvas">
                <div class="card mb-3">
                    <div class="card-body pb-2">
                        <form method="get" action="./InvoiceLists">
                            <input type="hidden" name="invoiceDirection" value="@invoiceDirection" />
                            @* No hidden status/lhdnStatus inputs here: the LHDNStatus select below is the
                               single source for that filter — a duplicate hidden field bound first and
                               silently discarded the selected value. *@
                            <input type="hidden" id="submissionDateFrom" name="submissionDateFrom" value="@Request.Query["submissionDateFrom"]">
                            <input type="hidden" id="submissionDateTo" name="submissionDateTo" value="@Request.Query["submissionDateTo"]">
                            @* Column-header links drive sorting; carry the current sort through the filter form. *@
                            <input type="hidden" id="sortBy" name="sortBy" value="@Model.SortBy" />
                            <input type="hidden" id="sortOrder" name="sortOrder" value="@Model.SortOrder" />

                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-md-6 col-xl-3">
                                    <label for="searchQuery" class="form-label mb-1">Search</label>
                                    <input type="text" id="searchQuery" name="searchQuery" class="form-control"
                                           placeholder="Invoice No, Supplier, Buyer, UUID..."
                                           value="@Model.SearchInput?.searchQuery">
                                </div>
                                <div class="col-12 col-md-6 col-xl-2">
                                    <label for="submissionDateRange" class="form-label mb-1">Date Range</label>
                                    <input type="text" id="submissionDateRange" class="form-control" placeholder="Select date range" readonly>
                                </div>
                                <div class="col-6 col-md-4 col-xl-2">
                                    <label class="form-label mb-1 d-block">Document Type</label>
                                    <div class="dropdown w-100">
                                        <button class="btn btn-outline-secondary w-100 text-start dropdown-toggle" type="button"
                                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                            @(Request.Query["documentType"].Count > 0 ? $"{Request.Query["documentType"].Count} selected" : "All Types")
                                        </button>
                                        <div class="dropdown-menu p-3" style="min-width: 260px;">
                                            @foreach (var documentType in Enum.GetValues(typeof(EInvoiceDocumentType)).Cast<EInvoiceDocumentType>())
                                            {
                                                var docTypeValue = ((int)documentType).ToString("D2");
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="docType_@docTypeValue" name="documentType" value="@docTypeValue"
                                                    @(Request.Query["documentType"].Contains(docTypeValue) ? "checked" : "")>
                                                    <label class="form-check-label" for="docType_@docTypeValue">
                                                        @DocumentTypeDisplay.GetDisplayNames()[documentType]
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-xl-2">
                                    <label for="LHDNStatusFilter" class="form-label mb-1">LHDN Status</label>
                                    <select id="LHDNStatusFilter" name="LHDNStatus" class="form-select">
                                        @{ var lhdnSel = Request.Query["LHDNStatus"].ToString(); }
                                        <option value="">All</option>
                                        <option value="Valid" selected="@(lhdnSel == "Valid")">Valid</option>
                                        <option value="Cancelled" selected="@(lhdnSel == "Cancelled")">Cancelled</option>
                                        <option value="Invalid" selected="@(lhdnSel == "Invalid")">Invalid</option>
                                        <option value="Submitted" selected="@(lhdnSel == "Submitted")">Submitted</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-4 col-xl-2">
                                    <label for="InternalStatusFilter" class="form-label mb-1">Internal Status</label>
                                    <select id="InternalStatusFilter" name="InternalStatus" class="form-select">
                                        @{ var internalSel = Request.Query["InternalStatus"].ToString(); }
                                        <option value="">All</option>
                                        <option value="Valid" selected="@(internalSel == "Valid")">Valid</option>
                                        <option value="Completed" selected="@(internalSel == "Completed")">Completed</option>
                                        <option value="Draft" selected="@(internalSel == "Draft")">Draft</option>
                                        <option value="TransmissionError" selected="@(internalSel == "TransmissionError")">Connection Failed</option>
                                        <option value="RequestReject" selected="@(internalSel == "RequestReject")">Request Reject</option>
                                        <option value="CancelledInternal" selected="@(internalSel == "CancelledInternal")">Cancelled</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-4 col-xl-1 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary flex-fill">
                                        <i class="ri-search-line"></i> Apply
                                    </button>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-link btn-sm text-decoration-none px-0 d-flex align-items-center gap-1" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#advancedFiltersPanel" aria-expanded="@(hasAdvancedFilters ? "true" : "false")">
                                        <i class="ri-equalizer-line"></i> Advanced Filters
                                        @if (hasAdvancedFilters)
                                        {
                                            <span class="einv-dot einv-dot-brand" aria-label="Advanced filters in use"></span>
                                        }
                                        <i class="ri-arrow-down-s-line"></i>
                                    </button>
                                </div>
                                <div class="col-12 collapse @(hasAdvancedFilters ? "show" : "")" id="advancedFiltersPanel">
                                    <div class="row g-3 pt-2 border-top mt-2">
                                        <div class="col-6 col-md-3">
                                            <p class="einv-filter-group">Submission date</p>
                                            <label for="submissionReceivedFrom" class="form-label mb-1 small">From</label>
                                            <input type="date" id="submissionReceivedFrom" name="submissionReceivedFrom" class="form-control form-control-sm mb-2" value="@Request.Query["submissionReceivedFrom"]" />
                                            <label for="submissionReceivedTo" class="form-label mb-1 small">To</label>
                                            <input type="date" id="submissionReceivedTo" name="submissionReceivedTo" class="form-control form-control-sm" value="@Request.Query["submissionReceivedTo"]" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <p class="einv-filter-group">Invoice details</p>
                                            <label for="createdByFilter" class="form-label mb-1 small">Created By</label>
                                            <input type="text" id="createdByFilter" name="createdBy" class="form-control form-control-sm" placeholder="Username" value="@Request.Query["createdBy"]" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <p class="einv-filter-group">Parties</p>
                                            <label for="supplierFilterInput" class="form-label mb-1 small">Supplier Name/TIN</label>
                                            <input type="text" id="supplierFilterInput" name="supplierFilter" class="form-control form-control-sm mb-2" value="@Request.Query["supplierFilter"]" />
                                            <label for="buyerFilterInput" class="form-label mb-1 small">Buyer Name/TIN</label>
                                            <input type="text" id="buyerFilterInput" name="buyerFilter" class="form-control form-control-sm" value="@Request.Query["buyerFilter"]" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <p class="einv-filter-group">Amount</p>
                                            <div class="d-flex gap-2 mb-2">
                                                <input type="number" step="0.01" name="amountMin" class="form-control form-control-sm" placeholder="Min" value="@Request.Query["amountMin"]" />
                                                <input type="number" step="0.01" name="amountMax" class="form-control form-control-sm" placeholder="Max" value="@Request.Query["amountMax"]" />
                                            </div>
                                            <select name="currencyFilter" class="form-select form-select-sm">
                                                @{ var currencySel = Request.Query["currencyFilter"].ToString(); }
                                                <option value="">Any Currency</option>
                                                <option value="MYR" selected="@(currencySel == "MYR")">MYR</option>
                                                <option value="USD" selected="@(currencySel == "USD")">USD</option>
                                                <option value="SGD" selected="@(currencySel == "SGD")">SGD</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 text-end">
                                    <a class="small fw-semibold text-decoration-none" href="./InvoiceLists?invoiceDirection=@invoiceDirection">Clear all filters</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <input type="hidden" id="rejectionReasons" value='@Json.Serialize(rejectionReasons)' />

                @* Bulk actions: floating dark bar shown while rows are selected (Stitch). The button
                   ids are unchanged — all existing bulk handlers keep working; visibility is driven
                   by the same refreshBulkVisibility() script as before. *@
                @if (!Model.IsViewOnly && (Model.invoiceDirection == "Draft" || Model.invoiceDirection == "Sent" || Model.invoiceDirection == "Received"))
                {
                    <div id="bulkActionBar" class="einv-bulk-bar d-none" role="toolbar" aria-label="Bulk actions for selected invoices">
                        <span class="einv-bulk-count" id="bulkSelectedCount">0 Selected</span>
                        <span class="einv-bulk-hint d-none d-sm-inline" id="bulkSelectedTotal"></span>
                        @if (Model.invoiceDirection == "Draft")
                        {
                            <button id="bulkSubmitBtn" class="btn btn-primary btn-sm d-none" title="Submit the selected draft invoices to LHDN">
                                <i class="ri-send-plane-fill"></i> Submit to LHDN
                            </button>
                            <button id="bulkDeleteBtn" class="btn btn-danger btn-sm d-none">
                                <i class="ri-delete-bin-5-fill"></i> Delete e-Invoice
                            </button>
                        }
                        @if (Model.invoiceDirection == "Sent")
                        {
                            <button id="bulkValidateBtn" class="btn btn-outline-primary btn-sm d-none" title="Re-check LHDN validation status for the selected invoices">
                                <i class="ri-refresh-line"></i> Bulk Validate
                            </button>
                            <button id="bulkSendToBuyersBtn" class="btn btn-outline-primary btn-sm d-none" title="Resend the validated invoice email to each buyer">
                                <i class="ri-mail-send-line"></i> Send to Buyers
                            </button>
                            <button id="bulkCancelBtn" class="btn btn-warning btn-sm d-none">
                                <i class="ri-close-circle-line"></i> Cancel e-Invoice
                            </button>
                        }
                        @if (Model.invoiceDirection == "Received")
                        {
                            <button id="bulkRejectBtn" class="btn btn-danger btn-sm d-none">
                                <i class="ri-close-circle-line"></i> Request Reject e-Invoice
                            </button>
                        }
                    </div>
                }

            <div>
                <div>
                        <div class="card mb-3">
                        <div class="tab-content">
                            <!-- All Tab Content -->
                            <div class="tab-pane fade show active" id="allTab" role="tabpanel">

                                
                                
                                <!-- Enhanced Scrollable Table Container -->
                                <div class="table-scroll at-left">
                                    <div class="inner" style="overflow-x: auto; width: 100%;">
                                        <table class="table table-nowrap align-middle table-hover mb-0" id="invoiceTable" data-einv-table="@columnsKey">
                                        <thead class="einv-table-head">
                                        <tr>
                                            @if (showSelection)
                                            {
                                                <th class="col-checkbox"><input type="checkbox" class="form-check-input" id="selectAll" aria-label="Select all invoices" /></th>
                                            }

                                            <th class="col-invoice-no" data-col-id="col-invoice-no" data-col-lock>
                                                <a href="@SortUrl("InvoiceNo")" class="@(Model.SortBy == "InvoiceNo" ? "text-primary fw-semibold" : "")">
                                                    Invoice # <i class="@SortIcon("InvoiceNo") sort-indicator"></i>
                                                </a>
                                            </th>

                                            <th class="col-document-type" data-col-id="col-document-type">
                                                <a href="@SortUrl("DocumentType")" class="@(Model.SortBy == "DocumentType" ? "text-primary fw-semibold" : "")">
                                                    Type <i class="@SortIcon("DocumentType") sort-indicator"></i>
                                                </a>
                                            </th>

                                            <th class="col-supplier" data-col-id="col-supplier" data-col-default="@(!isReceivedTab ? "hidden" : null)">
                                                <a href="@SortUrl("SupplierName")" class="@(Model.SortBy == "SupplierName" ? "text-primary fw-semibold" : "")">
                                                    Supplier <i class="@SortIcon("SupplierName") sort-indicator"></i>
                                                </a>
                                            </th>

                                            <th class="col-buyer" data-col-id="col-buyer" data-col-default="@(isReceivedTab ? "hidden" : null)">
                                                <a href="@SortUrl("CustomerName")" class="@(Model.SortBy == "CustomerName" ? "text-primary fw-semibold" : "")">
                                                    Buyer <i class="@SortIcon("CustomerName") sort-indicator"></i>
                                                </a>
                                            </th>

                                            <th class="col-submitted-date" data-col-id="col-submitted-date">
                                                <a href="@SortUrl("IssueDate")" class="@(Model.SortBy == "IssueDate" ? "text-primary fw-semibold" : "")">
                                                    Date <i class="@SortIcon("IssueDate") sort-indicator"></i>
                                                </a>
                                            </th>

                                            <th class="col-total-amount text-end" data-col-id="col-total-amount">
                                                <a href="@SortUrl("TotalAmount")" class="@(Model.SortBy == "TotalAmount" ? "text-primary fw-semibold" : "")">
                                                    Total <i class="@SortIcon("TotalAmount") sort-indicator"></i>
                                                </a>
                                            </th>

                                            <th class="col-internal-status" data-col-id="col-internal-status">
                                                <a href="@SortUrl("InternalStatus")" class="@(Model.SortBy == "InternalStatus" ? "text-primary fw-semibold" : "")">
                                                    Internal Status <i class="@SortIcon("InternalStatus") sort-indicator"></i>
                                                </a>
                                            </th>

                                            <th class="col-lhdn-status" data-col-id="col-lhdn-status">
                                                <a href="@SortUrl("LHDNStatus")" class="@(Model.SortBy == "LHDNStatus" ? "text-primary fw-semibold" : "")">
                                                    LHDN Status <i class="@SortIcon("LHDNStatus") sort-indicator"></i>
                                                </a>
                                            </th>

                                            <th class="col-created-by" data-col-id="col-created-by" data-col-default="@(isReceivedTab ? "hidden" : null)">Created By</th>

                                            @if (invoiceDirection != "Draft")
                                            {
                                                @* Technical metadata — hidden by default, available via Customize *@
                                                <th class="col-uuid" data-col-id="col-uuid" data-col-default="hidden">
                                                    <a href="@SortUrl("UUID")" class="@(Model.SortBy == "UUID" ? "text-primary fw-semibold" : "")">
                                                        UUID <i class="@SortIcon("UUID") sort-indicator"></i>
                                                    </a>
                                                </th>
                                                <th class="col-submission-id" data-col-id="col-submission-id" data-col-default="hidden">
                                                    <a href="@SortUrl("SubmissionId")" class="@(Model.SortBy == "SubmissionId" ? "text-primary fw-semibold" : "")">
                                                        Submission ID <i class="@SortIcon("SubmissionId") sort-indicator"></i>
                                                    </a>
                                                </th>
                                            }

                                            <th class="col-rejected-date" data-col-id="col-rejected-date" data-col-default="hidden">
                                                <a href="@SortUrl("RejectedDate")" class="@(Model.SortBy == "RejectedDate" ? "text-primary fw-semibold" : "")">
                                                    Rejected Date <i class="@SortIcon("RejectedDate") sort-indicator"></i>
                                                </a>
                                            </th>

                                            <th class="col-last-updated" data-col-id="col-last-updated" data-col-default="hidden">
                                                <a href="@SortUrl("UpdatedDate")" class="@(Model.SortBy == "UpdatedDate" ? "text-primary fw-semibold" : "")">
                                                    Last Updated <i class="@SortIcon("UpdatedDate") sort-indicator"></i>
                                                </a>
                                            </th>

                                            @if (!Model.IsViewOnly)
                                            {
                                                <th class="col-action text-end">Actions</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Invoices != null && Model.Invoices.Count > 0)
                                        {
                                            @foreach (var invoice in Model.Invoices.Where(i => Model.invoiceDirection != "Sent" || i.InternalStatusId != "Draft"))
                                            {
                                                // NEW LOGIC: Determine the correct TIN for the API call
                                                var isSelfBilled = new[] { "11", "12", "13", "14" }.Contains(invoice.DocTypeCode);
                                                var submittingTin = isSelfBilled 
                                                    ? (invoice.Customer?.TIN ?? invoice.PublicCustomer?.TIN) 
                                                    : (Model.invoiceDirection == "Received" 
                                                        ? (invoice.Customer?.TIN ?? invoice.PublicCustomer?.TIN) 
                                                        : invoice.Supplier?.TIN);

                                                <tr id="row-@invoice.InvoiceNo" data-invoiceno="@invoice.InvoiceNo">
                                                    @if (showSelection)
                                                    {
                                                        <td class="col-checkbox">
                                                            <input type="checkbox" class="form-check-input invoice-checkbox" value="@invoice.UUID" data-invoiceno="@invoice.InvoiceNo" data-tin="@submittingTin" data-amount="@invoice.TotalAmountIncTax" aria-label="Select invoice @invoice.InvoiceNo">
                                                        </td>
                                                    }
                                                    <td class="col-invoice-no" data-label="Invoice #">
                                                        <a asp-page="./InvoiceDetails2"
                                                           asp-route-uuid="@(invoiceDirection == "Draft" ? invoice.InvoiceNo : invoice.UUID)"
                                                           class="fw-semibold link-primary">
                                                            @invoice.InvoiceNo
                                                        </a>
                                                    </td>
                                                    <td class="col-document-type" data-label="Type">
                                                        @(DocumentTypeDisplay.GetDisplayNames()
                                                            .FirstOrDefault(x => ((int)x.Key).ToString("D2") == invoice.DocTypeCode).Value ?? invoice.DocTypeCode)
                                                    </td>
                                                    <td class="col-supplier truncate" data-label="Supplier" title="@(invoice.Supplier != null ? invoice.Supplier.CompanyName : "N/A")">@(invoice.Supplier != null ? invoice.Supplier.CompanyName : "N/A")</td>
                                                    <td class="col-buyer truncate" data-label="Buyer"
                                                        title="@(invoice.Customer != null
                                                                    ? invoice.Customer.CompanyName
                                                                    : invoice.PublicCustomer != null
                                                                        ? invoice.PublicCustomer.CompanyName
                                                                        : "N/A")">
                                                        @(invoice.Customer != null
                                                            ? invoice.Customer.CompanyName
                                                            : invoice.PublicCustomer != null
                                                                ? invoice.PublicCustomer.CompanyName
                                                                : "N/A")
                                                    </td>
                                                    <td class="col-submitted-date" data-label="Date">@invoice.IssueDate?.ToString("yyyy-MM-dd") <small class="text-muted">@invoice.IssueDate?.ToString("hh:mm tt")</small></td>
                                                    <td class="col-total-amount text-end fw-semibold" data-label="Total">
                                                        @invoice.TotalAmountIncTax?.ToString("N2") <small class="text-muted fw-normal">@invoice.Currency</small>
                                                    </td>
                                                    <td class="col-internal-status" data-label="Internal Status">
                                                        @if (invoice.InternalStatusId == "Invalid" || invoice.InternalStatusId == "RequestReject")
                                                        {
                                                            <button type="button" class="@InvoiceStatusBadge.CssClass(invoice.InternalStatusId) border-0"
                                                                    data-invoiceno="@invoice.InvoiceNo"
                                                                    data-uuid="@invoice.UUID"
                                                                    data-submissionid="@invoice.SubmissionID"
                                                                    data-tin="@submittingTin"
                                                                    data-reason="@invoice.RejectedReason"
                                                                    onclick="showInvalidReason(this)"
                                                                    title="Click to view details">
                                                                <i class="ri-error-warning-line"></i>
                                                                @(Enum.TryParse<eInvWorld.Models.StatusCodes>(invoice.InternalStatusId, out var internalStatusRej) ? EnumHelper.GetEnumDescription(internalStatusRej) : invoice.InternalStatusId)
                                                            </button>
                                                            @if (invoice.AttentionResolvedAt != null)
                                                            {
                                                                <small class="text-muted d-block mt-1" title="Marked as resolved by @invoice.AttentionResolvedBy on @invoice.AttentionResolvedAt?.ToString("yyyy-MM-dd hh:mm tt")"><i class="ri-check-double-line"></i> Resolved</small>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(invoice.RejectedReason))
                                                            {
                                                                <div class="small text-danger mt-1 text-truncate einv-reason" title="@invoice.RejectedReason">@invoice.RejectedReason</div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @InvoiceStatusBadge.Render(invoice.InternalStatusId)
                                                        }
                                                    </td>
                                                    <td class="col-lhdn-status" data-label="LHDN Status">
                                                        @if (invoice.LHDNStatusId == "Invalid")
                                                        {
                                                            <button type="button" class="@InvoiceStatusBadge.CssClass("Invalid") border-0"
                                                                    data-invoiceno="@invoice.InvoiceNo"
                                                                    data-uuid="@invoice.UUID"
                                                                    data-submissionid="@invoice.SubmissionID"
                                                                    data-tin="@submittingTin"
                                                                    data-reason="@invoice.RejectedReason"
                                                                    onclick="showInvalidReason(this)"
                                                                    title="Click to view Invalid Reason & Suggested Fix">
                                                                <i class="ri-error-warning-line"></i> Invalid
                                                            </button>
                                                        }
                                                        else if (string.IsNullOrEmpty(invoice.LHDNStatusId))
                                                        {
                                                            @* Drafts have no LHDN status yet — show a quiet dash, not an empty pill. *@
                                                            <span class="text-muted" aria-label="No LHDN status yet">&mdash;</span>
                                                        }
                                                        else
                                                        {
                                                            @InvoiceStatusBadge.Render(invoice.LHDNStatusId)
                                                        }
                                                    </td>
                                                    <td class="col-created-by truncate" data-label="Created By" title="@invoice.CreatedBy">@invoice.CreatedBy</td>
                                                    @if (invoiceDirection != "Draft")
                                                    {
                                                        <td class="col-uuid truncate" data-label="UUID" title="@invoice.UUID"><a asp-page="./InvoiceDetails2" asp-route-uuid="@invoice.UUID" class="fw-medium link-primary">@invoice.UUID</a></td>
                                                        <td class="col-submission-id truncate" data-label="Submission ID" title="@invoice.SubmissionID">@invoice.SubmissionID</td>
                                                    }
                                                    <td class="col-rejected-date" data-label="Rejected Date">
                                                        @if (invoice.RejectedTimestamp.HasValue)
                                                        {
                                                            @invoice.RejectedTimestamp?.ToString("yyyy-MM-dd") <small class="text-muted">@invoice.RejectedTimestamp?.ToString("hh:mm tt")</small>
                                                        }
                                                    </td>
                                                    <td class="col-last-updated" data-label="Last Updated">
                                                        @if (invoice.LastUpdated.HasValue)
                                                        {
                                                            @invoice.LastUpdated?.ToString("yyyy-MM-dd") <small class="text-muted">@invoice.LastUpdated?.ToString("hh:mm tt")</small>
                                                        }
                                                    </td>
                                                    @if (!Model.IsViewOnly)
                                                    {
                                                    <td class="col-action text-end">
                                                        <div class="dropdown">
                                                            <button class="btn btn-sm einv-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Invoice actions">
                                                                <i class="ri-more-fill align-middle"></i>
                                                            </button>
                                                            <ul class="dropdown-menu shadow-lg">
                                                                <!-- View Invoice (Always Available) -->
                                                                <li>
                                                                    <a class="dropdown-item" asp-page="./InvoiceDetails2"
                                                                       asp-route-uuid="@(invoiceDirection == "Draft" ? invoice.InvoiceNo : invoice.UUID)"
                                                                       class="fw-medium link-primary">
                                                                        <i class="ri-eye-fill me-1"></i> View
                                                                    </a>
                                                                </li>
                                                                @if (invoiceDirection != "Received" && (invoice.InternalStatusId == "Draft" || invoice.LHDNStatusId == "Valid" || invoice.LHDNStatusId == "Invalid" || invoice.LHDNStatusId == "Cancelled"))
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item text-info" asp-page="./CreateInvoice" asp-route-cloneId="@invoice.InvoiceNo">
                                                                            <i class="ri-file-copy-2-line me-1"></i> Resend
                                                                        </a>
                                                                    </li>
                                                                }
                                                                @* Needs Attention: resolve/reopen an Invalid or reject-requested invoice (display-only; posts via #attentionForm). *@
                                                                @if (EINVWORLD.Helpers.InvoiceNeedsAttentionFilter.CanResolve(invoice))
                                                                {
                                                                    <li>
                                                                        @if (invoice.AttentionResolvedAt == null)
                                                                        {
                                                                            <button type="submit" form="attentionForm" formaction="?handler=ResolveAttention" name="invoiceNo" value="@invoice.InvoiceNo" class="dropdown-item" title="Remove from Needs Attention (e.g. already re-issued). The LHDN status is unchanged.">
                                                                                <i class="ri-check-double-line me-1"></i> Mark as resolved
                                                                            </button>
                                                                        }
                                                                        else
                                                                        {
                                                                            <button type="submit" form="attentionForm" formaction="?handler=ReopenAttention" name="invoiceNo" value="@invoice.InvoiceNo" class="dropdown-item">
                                                                                <i class="ri-arrow-go-back-line me-1"></i> Reopen (Needs Attention)
                                                                            </button>
                                                                        }
                                                                    </li>
                                                                }
                                                                @if (invoice.InternalStatusId == "Draft" || invoice.InternalStatusId == "TransmissionError")
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" href="@GetEditUrl(invoice.DocTypeCode, invoice.InvoiceNo)">
                                                                            <i class="ri-edit-box-fill me-1"></i> @GetEditLabel(invoice.DocTypeCode)
                                                                        </a>
                                                                    </li>

                                                                    <!-- Submit Invoice -->
                                                                    <li>
                                                                        <a href="#" class="dropdown-item text-success"
                                                                           onclick="submitFromListnew('@invoice.InvoiceNo')">
                                                                            <i class="ri-send-plane-fill me-1"></i> Submit to LHDN
                                                                        </a>
                                                                    </li>

                                                                    <!-- Delete Invoice -->
                                                                    <li>
                                                                        <a class="dropdown-item text-danger" href="#" onclick="window.confirmDelete('@invoice.InvoiceNo', event)">
                                                                            <i class="ri-delete-bin-5-fill me-1"></i> Delete
                                                                        </a>
                                                                    </li>
                                                                }

                                                                else if (invoice.LHDNStatusId == "Valid")
                                                                {
                                                                    @if (invoiceDirection != "Received" && !string.IsNullOrEmpty(invoice.UUID) && !string.IsNullOrEmpty(invoice.InvoiceNo))
                                                                    {
                                                                        @if (invoice.DocTypeCode == "01" || invoice.DocTypeCode == "Invoice") // Standard Invoice
                                                                        {
                                                                            <li>
                                                                                <a class="dropdown-item" href="/Invoices/CreateInvoice?invoiceNo=@invoice.InvoiceNo&uuid=@invoice.UUID&type=CN">
                                                                                    <i class="ri-file-copy-fill me-1"></i> Create CN
                                                                                </a>
                                                                            </li>
                                                                            <li>
                                                                                <a class="dropdown-item" href="/Invoices/CreateInvoice?invoiceNo=@invoice.InvoiceNo&uuid=@invoice.UUID&type=DN">
                                                                                    <i class="ri-file-add-fill me-1"></i> Create DN
                                                                                </a>
                                                                            </li>
                                                                            <li>
                                                                                <a class="dropdown-item" href="/Invoices/CreateInvoice?invoiceNo=@invoice.InvoiceNo&uuid=@invoice.UUID&type=RN">
                                                                                    <i class="ri-refund-fill me-1"></i> Create RN
                                                                                </a>
                                                                            </li>
                                                                        }
                                                                        
                                                                        else if (invoice.DocTypeCode == "11") // Self-billed Invoice
                                                                        {
                                                                            <li>
                                                                                <a class="dropdown-item" href="/Invoices/CreateInvoice?invoiceNo=@invoice.InvoiceNo&uuid=@invoice.UUID&type=SELF-CN">
                                                                                    <i class="ri-file-copy-fill me-1"></i> Create Self-billed CN
                                                                                </a>
                                                                            </li>
                                                                            <li>
                                                                                <a class="dropdown-item" href="/Invoices/CreateInvoice?invoiceNo=@invoice.InvoiceNo&uuid=@invoice.UUID&type=SELF-DN">
                                                                                    <i class="ri-file-add-fill me-1"></i> Create Self-billed DN
                                                                                </a>
                                                                            </li>
                                                                            <li>
                                                                                <a class="dropdown-item" href="/Invoices/CreateInvoice?invoiceNo=@invoice.InvoiceNo&uuid=@invoice.UUID&type=SELF-RN">
                                                                                    <i class="ri-refund-fill me-1"></i> Create Self-billed RN
                                                                                </a>
                                                                            </li>
                                                                        }

                                                                    }
                                                                    @if (invoice.LHDNStatusId == "Valid" &&
                                                                         invoice.InternalStatusId != "RequestReject" &&
                                                                         !string.IsNullOrEmpty(invoice.Customer?.TIN ?? invoice.PublicCustomer?.TIN) &&
                                                                         Model.UserTINs.Contains(invoice.Customer?.TIN ?? invoice.PublicCustomer?.TIN ?? ""))
                                                                    {
                                                                        <li>
                                                                            <a href="#"
                                                                               class="dropdown-item reject-btn"
                                                                               data-uuid="@invoice.UUID"
                                                                               data-invoiceno="@invoice.InvoiceNo"
                                                                               data-tin="@(invoice.Customer?.TIN ?? invoice.PublicCustomer?.TIN)">
                                                                                <i class="ri-error-warning-fill me-1"></i>
                                                                                Request Reject e-Invoice
                                                                            </a>
                                                                        </li>
                                                                    }

                                                                    <!-- Cancel Invoice Button - Only for SUPPLIERS of this invoice -->
                                                                    @if (invoice.LHDNStatusId == "Valid" && invoice.LHDNStatusId != "Cancelled" && 
                                                                         !string.IsNullOrEmpty(invoice.Supplier?.TIN) && Model.UserTINs.Contains(invoice.Supplier.TIN))
                                                                    {
                                                                        <li>
                                                                            <a href="#" class="dropdown-item cancel-btn" data-uuid="@invoice.UUID" data-invoiceno="@invoice.InvoiceNo" data-tin="@invoice.Supplier.TIN">
                                                                                <i class="ri-close-circle-fill me-1"></i> Cancel e-Invoice
                                                                            </a>
                                                                        </li>
                                                                    }

                                                                    @if (invoiceDirection == "Received")
                                                                    {
                                                                        <!-- Print Invoice -->
                                                                        <li>
                                                                            <a href="#" class="dropdown-item print-item-btn" onclick="printInvoicePdf('@invoice.InvoiceNo'); return false;">
                                                                                <i class="ri-printer-line me-1 fs-16"></i> Print
                                                                            </a>
                                                                        </li>
                                                                    }

                                                                    <!-- Download Invoice -->
                                                                    <li class="dropdown-item" data-bs-toggle="tooltip" data-bs-trigger="hover"
                                                                        data-bs-placement="top" title="Download Invoice">
                                                                        <a href="?handler=DownloadPdf&invoiceNo=@invoice.InvoiceNo"
                                                                           class="text-secondary d-inline-block download-item-btn">
                                                                            <i class="ri-download-2-line me-1 fs-16"></i> Download e-Invoice PDF
                                                                        </a>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="14" class="text-center py-5 text-muted">
                                                    <i class="ri-file-list-3-line d-block mb-2 fs-1" aria-hidden="true"></i>
                                                    No e-invoices found for the current filters.
                                                </td>
                                            </tr>
                                        }
