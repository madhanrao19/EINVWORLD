@page
@using eInvWorld.Models.SmartCapture
@model eInvWorld.Pages.Invoices.SmartCaptureModel
@{
    ViewData["Title"] = "Smart Capture";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">
                    Smart Capture <span class="badge bg-primary-soft text-primary align-middle" style="font-size: 0.65rem;">BETA</span>
                </h1>
                <p class="text-muted mb-0">Upload a supplier invoice — it's processed in the background, then you review and confirm before a draft is created.</p>
            </div>
            @if (Model.Enabled)
            {
                <span class="badge bg-success-subtle text-success px-3 py-2"><i class="ri-checkbox-circle-line align-bottom me-1"></i>Smart Capture Enabled</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary px-3 py-2"><i class="ri-pause-circle-line align-bottom me-1"></i>Smart Capture Disabled</span>
            }
        </div>
    </div>
</div>

@if (!Model.Enabled)
{
    <div class="alert alert-warning">
        <i class="ri-settings-3-line"></i>
        <div>Smart Capture is <strong>disabled</strong>. Set <code>SmartCapture:Enabled = true</code> in configuration (also requires DocumentCapture and AI to be enabled).</div>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorText))
{
    <div class="alert alert-danger">@Model.ErrorText</div>
}
@if (!string.IsNullOrEmpty(Model.SuccessText))
{
    <div class="alert alert-success">@Model.SuccessText</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Company</label>
                        <select asp-for="CompanyPartyInfoId" class="form-select" required>
                            @foreach (var c in Model.MemberCompanies)
                            {
                                <option value="@c.PartyInfoId">@c.Name</option>
                            }
                        </select>
                    </div>
                    <label for="scUpload" class="d-block border border-2 border-dashed rounded-3 p-4 text-center mb-3" style="border-color: var(--einv-border) !important; cursor: pointer;" id="einvScDropzone">
                        <i class="ri-upload-cloud-2-line fs-24 d-block mb-2 text-primary"></i>
                        <span class="fw-semibold d-block">Click to choose a file, or drag it here</span>
                        <span class="text-muted small" id="einvScDropzoneFile">No file selected</span>
                        <input type="file" id="scUpload" name="Upload" accept=".pdf,.jpg,.jpeg,.png" class="d-none"
                               onchange="document.getElementById('einvScDropzoneFile').textContent = this.files.length ? this.files[0].name : 'No file selected';" />
                    </label>
                    <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
                        <span class="einv-badge einv-badge-neutral"><i class="ri-file-list-3-line"></i>@string.Join(", ", Model.AllowedExtensions).ToUpperInvariant()</span>
                        <span class="einv-badge einv-badge-neutral"><i class="ri-database-2-line"></i>Max @Model.MaxFileSizeMb MB</span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" id="scUploadSubmit" class="btn btn-primary" disabled="@(!Model.Enabled)">
                            <i class="ri-upload-cloud-2-line align-bottom me-1"></i> Upload
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                    <i class="ri-shield-check-line align-bottom me-1 text-primary"></i>Trust &amp; Security
                </p>
                <ul class="list-unstyled mb-0" style="font-size: 0.85rem;">
                    <li class="mb-2"><i class="ri-server-line align-bottom me-2 text-primary"></i>Processed locally — the file never leaves this server.</li>
                    <li class="mb-2"><i class="ri-shield-check-line align-bottom me-2 text-primary"></i>Scanned for malware before storage.</li>
                    <li class="mb-2"><i class="ri-user-search-line align-bottom me-2 text-primary"></i>You review and confirm every field — nothing is submitted automatically.</li>
                    <li class="mb-0"><i class="ri-time-line align-bottom me-2 text-primary"></i>Documents are retained per policy, then automatically deleted.</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header-clean"><h5 class="mb-0 fw-bold text-dark"><i class="ri-file-list-3-line align-bottom me-1"></i>Your Uploads</h5></div>
            <div class="card-body p-0">
                @if (Model.Documents.Count == 0)
                {
                    <div class="text-center text-muted py-5">
                        <i class="ri-file-search-line fs-1 mb-2 d-block"></i>
                        <p class="mb-0">No documents uploaded yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>File</th>
                                    <th>Uploaded</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Documents)
                                {
                                    var (badgeClass, label) = d.Status switch
                                    {
                                        SmartCaptureDocumentStatus.Uploaded or SmartCaptureDocumentStatus.Queued => ("einv-badge-neutral", "Queued"),
                                        SmartCaptureDocumentStatus.Processing => ("einv-badge-warning", "Processing"),
                                        SmartCaptureDocumentStatus.ReviewRequired => ("einv-badge-warning", "Review Required"),
                                        SmartCaptureDocumentStatus.ValidationFailed => ("einv-badge-danger", "Needs Correction"),
                                        SmartCaptureDocumentStatus.DraftCreated => ("einv-badge-success", "Draft Created"),
                                        SmartCaptureDocumentStatus.Failed => ("einv-badge-danger", "Failed"),
                                        _ => ("einv-badge-neutral", d.Status)
                                    };
                                    <tr>
                                        <td>@d.OriginalFileName</td>
                                        <td><small class="text-muted">@d.CreatedAtUtc.ToLocalTime().ToString("g")</small></td>
                                        <td><span class="einv-badge @badgeClass">@label</span></td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary" asp-page="SmartCaptureReview" asp-route-id="@d.Id">
                                                <i class="ri-eye-line align-bottom me-1"></i>Open
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var dropzone = document.getElementById("einvScDropzone");
            if (dropzone) {
                dropzone.addEventListener("dragover", function (e) { e.preventDefault(); dropzone.classList.add("border-primary"); });
                dropzone.addEventListener("dragleave", function () { dropzone.classList.remove("border-primary"); });
                dropzone.addEventListener("drop", function () { dropzone.classList.remove("border-primary"); });
            }
        })();
    </script>
}
