@page
@using eInvWorld.Models.SmartCapture
@model eInvWorld.Pages.Invoices.SmartCaptureModel
@{
    ViewData["Title"] = "Create from document";
}

<div class="einv-ph">
    <div class="einv-ph-text">
        <h1 class="einv-page-title mb-1">Create from document <span class="einv-badge einv-badge-neutral einv-badge-beta">Beta</span></h1>
        <p class="text-muted mb-0">Smart Capture: upload a supplier invoice. It's read in the background; you review and confirm before a draft is created.</p>
    </div>
    <div class="einv-ph-actions">
        @if (Model.Enabled)
        {
            <span class="einv-badge einv-badge-success"><i class="ri-checkbox-circle-line" aria-hidden="true"></i>Smart Capture is on</span>
        }
        else
        {
            <span class="einv-badge einv-badge-neutral"><i class="ri-pause-circle-line" aria-hidden="true"></i>Smart Capture is off</span>
        }
    </div>
</div>

@if (!Model.Enabled)
{
    <div class="alert alert-warning">
        <i class="ri-settings-3-line" aria-hidden="true"></i>
        <div>Smart Capture is <strong>off</strong>. Set <code>SmartCapture:Enabled = true</code> in configuration (it also needs DocumentCapture and AI to be on).</div>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorText))
{
    <div class="alert alert-danger">@Model.ErrorText</div>
}
@if (!string.IsNullOrEmpty(Model.SuccessText))
{
    <div class="alert alert-success">@Model.SuccessText</div>
}
@if (Model.BatchFailures.Count > 0)
{
    <div class="alert alert-warning">
        <strong>@Model.BatchFailures.Count file(s) could not be uploaded:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var f in Model.BatchFailures)
            {
                <li>@f</li>
            }
        </ul>
    </div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <section class="einv-panel mb-4">
            <div class="einv-panel-h"><h2>Upload</h2></div>
            <div class="einv-panel-b">
                <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label" for="CompanyPartyInfoId">Company</label>
                        <select asp-for="CompanyPartyInfoId" class="form-select" required>
                            @foreach (var c in Model.MemberCompanies)
                            {
                                <option value="@c.PartyInfoId">@c.Name</option>
                            }
                        </select>
                    </div>
                    <label for="scUpload" class="einv-dropzone mb-3" id="einvScDropzone">
                        <i class="ri-upload-cloud-2-line" aria-hidden="true"></i>
                        <span class="einv-dropzone-title">Choose files, or drag them here</span>
                        <span class="einv-dropzone-file" id="einvScDropzoneFile">No files selected</span>
                        <input type="file" id="scUpload" name="Uploads" accept=".pdf,.jpg,.jpeg,.png" class="visually-hidden" multiple
                               onchange="document.getElementById('einvScDropzoneFile').textContent = this.files.length ? (this.files.length === 1 ? this.files[0].name : this.files.length + ' files selected') : 'No files selected';" />
                    </label>
                    <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
                        <span class="einv-badge einv-badge-neutral"><i class="ri-file-list-3-line" aria-hidden="true"></i>@string.Join(", ", Model.AllowedExtensions).ToUpperInvariant()</span>
                        <span class="einv-badge einv-badge-neutral"><i class="ri-database-2-line" aria-hidden="true"></i>Max @Model.MaxFileSizeMb MB each</span>
                        <span class="einv-badge einv-badge-neutral"><i class="ri-stack-line" aria-hidden="true"></i>Up to @Model.MaxFilesPerBulkUpload at once</span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" id="scUploadSubmit" class="btn btn-primary" disabled="@(!Model.Enabled)">
                            <i class="ri-upload-cloud-2-line" aria-hidden="true"></i>Upload
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <section class="einv-panel">
            <div class="einv-panel-h"><h2>Privacy and checks</h2></div>
            <ul class="einv-panel-b einv-checklist">
                <li><i class="ri-server-line" aria-hidden="true"></i>Read on this server: the file never leaves it.</li>
                <li><i class="ri-shield-check-line" aria-hidden="true"></i>File type and content signature are checked before storage.</li>
                <li><i class="ri-user-search-line" aria-hidden="true"></i>You review and confirm every field before a draft is created.</li>
                <li><i class="ri-time-line" aria-hidden="true"></i>Documents are kept for the retention period, then deleted automatically.</li>
            </ul>
        </section>
    </div>

    <div class="col-lg-7">
        <section class="einv-panel">
            <div class="einv-panel-h">
                <h2>Your uploads</h2>
                <div data-einv-columns-for="smart-capture"></div>
            </div>
            @if (Model.Documents.Count == 0)
            {
                <div class="einv-empty">
                    <span class="einv-empty-icon" aria-hidden="true"><i class="ri-file-search-line"></i></span>
                    <p class="einv-empty-title">No documents yet</p>
                    <p class="einv-empty-text">Upload a supplier invoice on the left to start.</p>
                </div>
            }
            else
            {
                <div class="table-responsive einv-table-scroll-x">
                    <table data-einv-table="smart-capture" data-einv-sort="client" class="table table-hover align-middle mb-0 einv-mobile-stack">
                        <thead class="einv-table-head">
                            <tr>
                                <th>File</th>
                                <th>Uploaded</th>
                                <th>Status</th>
                                <th class="col-action"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Documents)
                            {
                                var (badgeClass, label) = d.Status switch
                                {
                                    SmartCaptureDocumentStatus.Uploaded or SmartCaptureDocumentStatus.Queued => ("einv-badge-neutral", "Queued"),
                                    SmartCaptureDocumentStatus.Processing => ("einv-badge-warning", "Processing"),
                                    SmartCaptureDocumentStatus.ReviewRequired => ("einv-badge-warning", "Review required"),
                                    SmartCaptureDocumentStatus.ValidationFailed => ("einv-badge-danger", "Needs correction"),
                                    SmartCaptureDocumentStatus.DraftCreated => ("einv-badge-success", "Draft created"),
                                    SmartCaptureDocumentStatus.Failed => ("einv-badge-danger", "Failed"),
                                    _ => ("einv-badge-neutral", d.Status)
                                };
                                var pendingAutoSubmit = Model.PendingAutoSubmitRunAtUtc.TryGetValue(d.Id, out var runAtUtc);
                                <tr>
                                    <td data-label="File" class="truncate" title="@d.OriginalFileName">@d.OriginalFileName</td>
                                    <td data-label="Uploaded" data-sort-value="@d.CreatedAtUtc.ToString("o")" class="text-muted small">@d.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                    <td data-label="Status">
                                        <span class="einv-badge @badgeClass">@label</span>
                                        @if (pendingAutoSubmit)
                                        {
                                            <span class="einv-badge einv-badge-warning ms-1" title="Scheduled to submit automatically unless cancelled">
                                                <i class="ri-time-line" aria-hidden="true"></i>Auto-submit @runAtUtc.ToLocalTime().ToString("t")
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end col-action">
                                        @if (pendingAutoSubmit)
                                        {
                                            <form method="post" asp-page-handler="CancelAutoSubmit" asp-route-documentId="@d.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-warning me-1"><i class="ri-close-circle-line" aria-hidden="true"></i>Cancel auto-submit</button>
                                            </form>
                                        }
                                        <a class="btn btn-sm btn-outline-secondary" asp-page="SmartCaptureReview" asp-route-id="@d.Id">
                                            <i class="ri-eye-line" aria-hidden="true"></i>Open
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var dropzone = document.getElementById("einvScDropzone");
            if (dropzone) {
                dropzone.addEventListener("dragover", function (e) { e.preventDefault(); dropzone.classList.add("is-dragover"); });
                dropzone.addEventListener("dragleave", function () { dropzone.classList.remove("is-dragover"); });
                dropzone.addEventListener("drop", function () { dropzone.classList.remove("is-dragover"); });
            }
        })();
    </script>
}
