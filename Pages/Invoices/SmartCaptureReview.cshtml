@page "{id:int}"
@using eInvWorld.Models.SmartCapture
@model eInvWorld.Pages.Invoices.SmartCaptureReviewModel
@{
    ViewData["Title"] = "Review captured document";
    var doc = Model.Document!;
    var stillProcessing = doc.Status is SmartCaptureDocumentStatus.Uploaded or SmartCaptureDocumentStatus.Queued or SmartCaptureDocumentStatus.Processing;
}

<div class="einv-ph">
    <div class="einv-ph-text">
        <h1 class="einv-page-title mb-1 text-break">Review: @doc.OriginalFileName</h1>
        <p class="text-muted mb-0">Uploaded @doc.CreatedAtUtc.ToLocalTime().ToString("g")</p>
    </div>
    <div class="einv-ph-actions">
        <a class="btn btn-outline-secondary" asp-page="SmartCapture"><i class="ri-arrow-left-line" aria-hidden="true"></i>Back to uploads</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorText))
{
    <div class="alert alert-danger">@Model.ErrorText</div>
}

@if (stillProcessing)
{
    <section class="einv-panel">
        <div class="einv-empty">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Processing</span></div>
            <p class="einv-empty-title">Reading this document</p>
            <p class="einv-empty-text">It's processed in the background; this page refreshes by itself.</p>
        </div>
    </section>
    <script>setTimeout(function () { window.location.reload(); }, 4000);</script>
}
else if (doc.Status == SmartCaptureDocumentStatus.Failed)
{
    <div class="alert alert-danger">
        <strong>Extraction failed.</strong> @doc.UserSafeFailureMessage
    </div>
    <a class="btn btn-outline-secondary" asp-page="SmartCaptureReview" asp-page-handler="Download" asp-route-id="@doc.Id"><i class="ri-download-2-line" aria-hidden="true"></i>Download original file</a>
}
else if (doc.Status == SmartCaptureDocumentStatus.DraftCreated)
{
    <div class="alert alert-success">
        A draft invoice (<strong>@doc.RelatedInvoiceHeaderInvoiceNo</strong>) was created from this document.
        <a asp-page="/Invoices/InvoiceEdit" asp-route-id="@doc.RelatedInvoiceHeaderInvoiceNo">Open it in the invoice editor</a>.
    </div>
}
else
{
    var isCondensed = doc.Status != SmartCaptureDocumentStatus.ValidationFailed && Model.IsFullyClean;
    if (isCondensed)
    {
        <div class="alert alert-success py-2 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span><i class="ri-checkbox-circle-line" aria-hidden="true"></i> <strong>All checks passed</strong>: @(Model.Suggestion?.LineItems.Count ?? 0) line item(s) read, no issues found.</span>
            <a class="fw-semibold" data-bs-toggle="collapse" href="#einvScDetails" role="button" aria-expanded="false" aria-controls="einvScDetails">Show extraction details</a>
        </div>
    }
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="@(isCondensed ? "collapse" : "")" id="einvScDetails">
                <section class="einv-panel mb-4">
                    <div class="einv-panel-h"><h2>Review checklist</h2></div>
                    <ul class="einv-panel-b list-unstyled mb-0 d-flex flex-column gap-2">
                        @foreach (var item in Model.ReviewItems)
                        {
                            var (badgeClass, icon) = item.Severity switch
                            {
                                "Error" => ("einv-badge-danger", "ri-close-circle-line"),
                                "Warning" => ("einv-badge-warning", "ri-alert-line"),
                                _ => ("einv-badge-success", "ri-checkbox-circle-line")
                            };
                            <li><span class="einv-badge @badgeClass einv-badge-wrap"><i class="@icon" aria-hidden="true"></i>@item.Message</span></li>
                        }
                    </ul>
                </section>

                <section class="einv-panel">
                    <div class="einv-panel-h"><h2>Extracted suggestion</h2></div>
                    <div class="einv-panel-b">
                        <pre class="einv-code mb-0">@(Model.Suggestion is null ? "(could not parse)" : System.Text.Json.JsonSerializer.Serialize(Model.Suggestion, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }))</pre>
                    </div>
                </section>
            </div>
        </div>

        <div class="col-lg-6">
            <section class="einv-panel">
                <div class="einv-panel-h"><h2>Confirm and create draft</h2></div>
                <div class="einv-panel-b">
                    @if (doc.Status == SmartCaptureDocumentStatus.ValidationFailed)
                    {
                        <div class="alert alert-warning py-2 mb-0">This document has blocking errors (see the checklist), so a draft can't be created. Re-upload a corrected file if needed.</div>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Confirm" asp-route-id="@doc.Id">
                            <div class="mb-3">
                                <label class="form-label" for="confirmedDocTypeCode">LHDN document type <span class="text-danger">*</span></label>
                                <select name="confirmedDocTypeCode" id="confirmedDocTypeCode" class="form-select" required aria-describedby="confirmedDocTypeHelp">
                                    <option value="">Confirm the document type</option>
                                    @foreach (var code in Model.ValidDocumentTypes)
                                    {
                                        var selected = Model.Suggestion?.DocumentType?.Trim() == code;
                                        <option value="@code" selected="@selected">@code @(Model.Suggestion?.DocumentType?.Trim() == code ? "(suggested: " + Model.Suggestion.DocumentTypeName + ")" : "")</option>
                                    }
                                </select>
                                <small class="text-muted" id="confirmedDocTypeHelp">Never assumed from the scan: you confirm it here.</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="selectedBuyerPartyInfoId">Buyer <span class="text-danger">*</span></label>
                                <select name="selectedBuyerPartyInfoId" id="selectedBuyerPartyInfoId" class="form-select" required aria-describedby="selectedBuyerHelp">
                                    <option value="">Select a registered buyer</option>
                                    @foreach (var b in Model.KnownBuyers)
                                    {
                                        var suggestedMatch = Model.Suggestion?.BuyerTin?.Trim() == b.Tin;
                                        <option value="@b.PartyInfoId" selected="@suggestedMatch">@b.Name (@b.Tin) @(suggestedMatch ? "(suggested match)" : "")</option>
                                    }
                                </select>
                                <small class="text-muted" id="selectedBuyerHelp">Only this company's registered buyers are listed; a new buyer is never created automatically.</small>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary"><i class="ri-file-add-line" aria-hidden="true"></i>Create draft and open in editor</button>
                            </div>
                            <p class="text-muted mt-2 mb-0"><small>The draft opens in the normal invoice editor, where you can correct any field before submitting to MyInvois.</small></p>
                        </form>
                    }
                </div>
            </section>
        </div>
    </div>
}
