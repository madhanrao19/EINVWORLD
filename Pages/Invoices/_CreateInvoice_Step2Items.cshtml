@model EINVWORLD.Pages.Invoices.CreateInvoiceModel
@using eInvWorld.Helpers
<div class="card mb-3 d-none" id="step2">
                <div class="card-header bg-success bg-opacity-10 border-0 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="ri-list-check-2 fs-4 text-success me-2"></i>
                        <div>
                            <h6 class="card-title mb-0">Invoice Items</h6>
                            <small class="text-muted">Add products or services to your invoice</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row gap-4">
                    <div class="flex-grow-1" style="min-width:0;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div class="text-muted small">Add products or services to your invoice</div>
                        <button type="button" class="btn btn-outline-primary" id="addItemBtn">
                            <i class="ri-add-line me-1"></i>Add Item
                        </button>
                    </div>

                    <div id="lineItemsTable">
                        <div class="irow-head">
                            <div class="irow-head-num">#</div>
                            <div class="irow-head-desc">Item / Service <span class="text-danger">*</span></div>
                            <div class="irow-head-classification">Classification <span class="text-danger">*</span></div>
                            <div class="irow-head-unit">Unit <span class="text-danger">*</span></div>
                            <div class="irow-head-qty text-center">Qty <span class="text-danger">*</span></div>
                            <div class="irow-head-price text-end">Price <span class="text-danger">*</span></div>
                            <div class="irow-head-total text-end">Subtotal / Total</div>
                            <div class="irow-head-actions"></div>
                        </div>
                        <div id="lineItems">
                            @for (int i = 0; i < (Model.Invoice?.InvoiceLines.Count ?? 0); i++)
                            {
                                <div data-item-index="@i" class="item-row" style="border-left: 4px solid var(--einv-primary, #006948); border-bottom: 1px solid var(--einv-border, #e9ecef);">
                                    <div class="irow">
                                        <div class="irow-num">@(i + 1)</div>
                                        <div class="irow-desc">
                                            <select class="form-select form-select-sm saved-item-select bg-light border-primary mb-2" onchange="autoFillItem(this, @i)">
                                                <option value="">-- Select Saved Item --</option>
                                                @if (Model.SavedItems != null && Model.SavedItems.Any())
                                                {
                                                    foreach (var item in Model.SavedItems)
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            </select>
                                            <div class="irow-mlabel-always">Item Code</div>
                                            <input asp-for="Invoice.InvoiceLines[i].ItemCode" class="form-control form-control-sm item-code mb-2" placeholder="Item Code" />
                                            <textarea asp-for="Invoice.InvoiceLines[i].ItemDescription" class="form-control form-control-sm item-description" rows="1" placeholder="Enter comprehensive item description..." required></textarea>
                                        </div>
                                        <div class="irow-classification">
                                            <div class="irow-mlabel">Classification <span class="text-danger">*</span></div>
                                            <select asp-for="Invoice.InvoiceLines[i].ClassificationCode" asp-items="Model.ClassificationCodes" class="form-select form-select-sm item-classification" required>
                                                <option value="">Select Classification</option>
                                            </select>
                                        </div>
                                        <div class="irow-unit">
                                            <div class="irow-mlabel">Unit <span class="text-danger">*</span></div>
                                            <select asp-for="Invoice.InvoiceLines[i].UnitOfMeasure" asp-items="Model.UnitOptions" class="form-control form-control-sm" required>
                                                <option value="">Unit</option>
                                            </select>
                                        </div>
                                        <div class="irow-qty">
                                            <div class="irow-mlabel">Qty <span class="text-danger">*</span></div>
                                            <input asp-for="Invoice.InvoiceLines[i].Quantity" value="@InvoiceFormatting.Fmt2(Model.Invoice?.InvoiceLines[i].Quantity)" type="number" class="form-control form-control-sm quantity-input text-center" step="0.01" min="0" required placeholder="0" />
                                        </div>
                                        <div class="irow-price">
                                            <div class="irow-mlabel">Unit Price <span class="text-danger">*</span></div>
                                            <input asp-for="Invoice.InvoiceLines[i].UnitPrice" value="@InvoiceFormatting.Fmt2(Model.Invoice?.InvoiceLines[i].UnitPrice)" type="number" class="form-control form-control-sm price-input text-end" step="0.01" min="0" required placeholder="0.00" />
                                        </div>
                                        <div class="irow-total">
                                            <div class="irow-mlabel">Subtotal</div>
                                            <div class="irow-num-val" id="subtotal-@i">0.00</div>
                                            <div class="irow-mlabel">Row Total</div>
                                            <div class="irow-num-val irow-total-val" id="rowtotal-@i">0.00</div>
                                        </div>
                                        <div class="irow-actions">
                                            <button type="button" class="btn btn-sm btn-link text-success p-0" onclick="duplicateItem(this)" title="Duplicate">
                                                <i class="ri-file-copy-line"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="removeItem(this)" title="Remove">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Optional, progressive line-level sections: collapsed by default -->
                                    <div class="irow-extras">
                                        <div class="irow-extras-toggles">
                                            <button type="button" class="irow-extras-toggle" data-bs-toggle="collapse" data-bs-target="#discount-@i">
                                                <i class="ri-price-tag-3-line"></i>Discount
                                            </button>
                                            <button type="button" class="irow-extras-toggle" data-bs-toggle="collapse" data-bs-target="#fee-@i">
                                                <i class="ri-add-circle-line"></i>Fee / Charge
                                            </button>
                                            <button type="button" class="irow-extras-toggle" data-bs-toggle="collapse" data-bs-target="#taxesCollapse-@i">
                                                <i class="ri-percent-line"></i>Taxes
                                            </button>
                                            <button type="button" class="irow-extras-toggle" data-bs-toggle="collapse" data-bs-target="#lineinfo-@i">
                                                <i class="ri-information-line"></i>Additional Information
                                            </button>
                                        </div>

                                        <!-- Discount -->
                                        <div class="collapse irow-extras-panel" id="discount-@i">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-6 col-md-2">
                                                    <label class="irow-mlabel">Rate</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="number" class="form-control discount-rate" step="0.01" placeholder="0" data-discount-target="#discount-amount-@i" data-item-index="@i" />
                                                        <span class="input-group-text">%</span>
                                                    </div>
                                                </div>
                                                <div class="col-6 col-md-3">
                                                    <label class="irow-mlabel">Amount</label>
                                                    <input asp-for="Invoice.InvoiceLines[i].DiscountAmount" id="discount-amount-@i" type="number" class="form-control form-control-sm discount-amount-input" step="0.01" placeholder="0.00" />
                                                </div>
                                                <div class="col-12 col-md-7">
                                                    <label class="irow-mlabel">Description / Reason</label>
                                                    <input asp-for="Invoice.InvoiceLines[i].DiscountReason" class="form-control form-control-sm" maxlength="200" placeholder="Reason for this discount" />
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Fee / Charge -->
                                        <div class="collapse irow-extras-panel" id="fee-@i">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-6 col-md-2">
                                                    <label class="irow-mlabel">Rate</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="number" class="form-control fee-rate" step="0.01" placeholder="0" data-fee-target="#fee-amount-@i" data-item-index="@i" />
                                                        <span class="input-group-text">%</span>
                                                    </div>
                                                </div>
                                                <div class="col-6 col-md-3">
                                                    <label class="irow-mlabel">Amount</label>
                                                    <input asp-for="Invoice.InvoiceLines[i].FeeChargeAmount" id="fee-amount-@i" type="number" class="form-control form-control-sm fee-amount-input" step="0.01" placeholder="0.00" />
                                                </div>
                                                <div class="col-12 col-md-7">
                                                    <label class="irow-mlabel">Description / Reason</label>
                                                    <input asp-for="Invoice.InvoiceLines[i].FeeChargeReason" class="form-control form-control-sm" maxlength="200" placeholder="Reason for this fee/charge" />
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Taxes -->
                                        <div class="collapse irow-extras-panel" id="taxesCollapse-@i">
                                            <div class="tax-section" id="taxes-@i">
                                                @if (Model.Invoice?.InvoiceLines[i].Taxes != null)
                                                {
                                                    for (int j = 0; j < (Model.Invoice?.InvoiceLines[i].Taxes?.Count ?? 0); j++)
                                                    {
                                                        <div class="tax-row mb-2 p-2 border rounded">
                                                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                                                <div class="flex-fill tax-category-wrapper" style="min-width: 160px;">
                                                                    <label class="irow-mlabel">Tax Type</label>
                                                                    <select asp-for="Invoice.InvoiceLines[i].Taxes[j].TaxCategory" asp-items="Model.TaxCategoryOptions" class="form-select form-select-sm tax-category">
                                                                        <option value="">Tax Category</option>
                                                                    </select>
                                                                </div>
                                                                <div class="tax-percentage-wrapper" style="flex: 0 0 100px;">
                                                                    <label class="irow-mlabel">Tax Rate</label>
                                                                    <input asp-for="Invoice.InvoiceLines[i].Taxes[j].TaxPercentage" value="@InvoiceFormatting.Fmt2(Model.Invoice?.InvoiceLines[i].Taxes?[j].TaxPercentage)" type="number" class="form-control form-control-sm" placeholder="%" step="0.01" required />
                                                                </div>
                                                                <div class="tax-action-wrapper" style="flex: 0 0 auto;">
                                                                    <i class="ri-close-circle-line text-danger" onclick="removeTaxRow(this)" title="Remove Tax" style="cursor: pointer; font-size: 16px; padding: 2px;"></i>
                                                                </div>
                                                            </div>
                                                            <div class="mt-2 tax-exemption-reason" style="display: none;">
                                                                <label class="irow-mlabel">Tax Exemption Reason</label>
                                                                <input asp-for="Invoice.InvoiceLines[i].Taxes[j].TaxExemptionReason" class="form-control form-control-sm" placeholder="Exemption Reason (Required)" />
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-primary mt-1" onclick="addTaxRow(@i)">
                                                <i class="ri-add-line me-1"></i>Tax
                                            </button>
                                        </div>

                                        <!-- Additional Information (line-level: only fields that genuinely belong to this line) -->
                                        <div class="collapse irow-extras-panel" id="lineinfo-@i">
                                            <div class="row g-2">
                                                <div class="col-6 col-md-4">
                                                    <label class="irow-mlabel">Product Tariff Code</label>
                                                    <input asp-for="Invoice.InvoiceLines[i].ProductTariffCode" class="form-control form-control-sm" maxlength="50" placeholder="Primarily for goods" />
                                                </div>
                                                <div class="col-6 col-md-4">
                                                    <label class="irow-mlabel">Country of Origin</label>
                                                    <select asp-for="Invoice.InvoiceLines[i].CountryOfOrigin" asp-items="Model.CountryOptions" class="form-select form-select-sm">
                                                        <option value="">-- Select --</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- 🔧 Required for model binding -->
                        <input type="hidden" id="itemCount" name="Invoice.InvoiceLines.Count" value="@(Model.Invoice?.InvoiceLines.Count ?? 0)" />
                    </div>
                    </div>
                    <!-- /main column -->

                    <!-- Sticky right panel: Invoice Summary + Validation Checklist (matches Step 1/Step 3) -->
                    <div class="flex-shrink-0" style="width:100%; max-width:320px;">
                    <div style="position:sticky; top:1rem;">
                        <div class="card bg-primary text-white mb-3">
                            <div class="card-body">
                                <h6 class="text-uppercase mb-3 opacity-75" style="font-size:.7rem;letter-spacing:.05em;">Invoice Summary</h6>
                                <div class="d-flex justify-content-between mb-2"><span>Subtotal</span><strong id="step2SummarySubtotal">0.00</strong></div>
                                <div class="d-flex justify-content-between mb-2"><span>Tax Amount</span><strong id="step2SummaryTaxAmount">0.00</strong></div>
                                <hr class="border-white opacity-25" />
                                <div class="d-flex justify-content-between align-items-end">
                                    <span class="text-uppercase opacity-75" style="font-size:.7rem;">Total Payable</span>
                                    <span class="fs-3 fw-bold" id="step2SummaryTotalAmount">0.00</span>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-body">
                                <h6 class="text-uppercase text-muted mb-3" style="font-size:.7rem;letter-spacing:.05em;">Validation Checklist</h6>
                                <ul class="list-unstyled mb-0">
                                    <li class="d-flex align-items-start gap-2 mb-3">
                                        <i class="ri-error-warning-fill text-danger" id="chkLineItemsIcon"></i>
                                        <div>
                                            <div class="fw-bold" id="chkLineItemsText">No Items</div>
                                            <div class="text-muted" style="font-size:.7rem;">At least one line item is required.</div>
                                        </div>
                                    </li>
                                    <li class="d-flex align-items-start gap-2 mb-3">
                                        <i class="ri-error-warning-fill text-danger" id="chkLineFieldsIcon"></i>
                                        <div>
                                            <div class="fw-bold" id="chkLineFieldsText">Classification / Unit Incomplete</div>
                                            <div class="text-muted" style="font-size:.7rem;">Every line needs a Classification and Unit.</div>
                                        </div>
                                    </li>
                                    <li class="d-flex align-items-start gap-2">
                                        <i class="ri-error-warning-fill text-danger" id="chkQtyPriceIcon"></i>
                                        <div>
                                            <div class="fw-bold" id="chkQtyPriceText">Quantity / Price Incomplete</div>
                                            <div class="text-muted" style="font-size:.7rem;">Every line needs a Quantity and Unit Price greater than 0.</div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    </div>
                    <!-- /sticky right panel -->
                    </div>
                    <!-- /two-column layout -->
                </div>

                <!-- Tax Management Section -->
                @* <div class="card border-warning mt-3">
                    <div class="card-header bg-warning bg-opacity-10">
                        <h6 class="mb-0"><i class="ri-taxi-line me-2"></i>Item & Tax Validation <small class="text-muted">(All fields must be filled including taxes)</small></h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-outline-warning" onclick="validateItemRequirements()">
                                <i class="ri-check-line me-1"></i>Check Item Requirements
                            </button>
                            <button type="button" class="btn btn-outline-success" onclick="addTaxToAllItems()">
                                <i class="ri-add-line me-1"></i>Add Taxes to All Items
                            </button>

                        </div>
                    </div>
                </div> *@

                <!-- Step Navigation -->
                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary" onclick="prevStep()">
                        <i class="ri-arrow-left-line me-1"></i>Previous
                    </button>
                    <button type="button" class="btn btn-primary" onclick="nextStep()">
                        Next: Review & Submit <i class="ri-arrow-right-line ms-1"></i>
                    </button>
                </div>
            </div>
