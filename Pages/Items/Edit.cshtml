@page
@model eInvWorld.Pages.Items.EditModel
@{
    ViewData["Title"] = "Edit Item";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Edit Item</h1>
                <p class="text-muted mb-0">Update this reusable item code in your invoice catalogue.</p>
            </div>
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="ri-arrow-left-line align-bottom me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="ItemDescription.Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ItemDescription.ItemCode" class="form-label fw-semibold">Item Code</label>
                        <input asp-for="ItemDescription.ItemCode" class="form-control" required />
                        <span asp-validation-for="ItemDescription.ItemCode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ItemDescription.ClassificationCode" class="form-label fw-semibold">Classification Code</label>
                        <select asp-for="ItemDescription.ClassificationCode" asp-items="Model.ClassificationCodes" class="form-select select2" required>
                            <option value="">Select Classification Code</option>
                        </select>
                        <span asp-validation-for="ItemDescription.ClassificationCode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ItemDescription.Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="ItemDescription.Description" class="form-control" rows="3" required></textarea>
                        <span asp-validation-for="ItemDescription.Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ItemDescription.UnitCode" class="form-label fw-semibold">Unit</label>
                            <select asp-for="ItemDescription.UnitCode" asp-items="Model.UnitOptions" class="form-select select2">
                                <option value="">-- No default unit --</option>
                            </select>
                            <span asp-validation-for="ItemDescription.UnitCode" class="text-danger"></span>
                            <div class="form-text">LHDN unit-of-measure code — optional, prefills the invoice line's Unit.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ItemDescription.UnitPrice" class="form-label fw-semibold">Unit Price (MYR)</label>
                            <div class="input-group">
                                <span class="input-group-text">RM</span>
                                <input asp-for="ItemDescription.UnitPrice" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="ItemDescription.UnitPrice" class="text-danger"></span>
                            <div class="form-text">Optional default price — prefills a new invoice line, doesn't change past invoices.</div>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-4" dir="ltr">
                        <input asp-for="ItemDescription.IsActive" class="form-check-input" />
                        <label class="form-check-label fw-semibold ms-2" asp-for="ItemDescription.IsActive">Active</label>
                    </div>

                    <div class="text-end">
                        <a asp-page="./Index" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <p class="text-uppercase text-muted fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                    <i class="ri-information-line align-bottom me-1 text-primary"></i>How This Is Used
                </p>
                <ul class="list-unstyled mb-0" style="font-size: 0.85rem;">
                    <li class="mb-2"><i class="ri-price-tag-3-line align-bottom me-2 text-primary"></i>The Item Code and Description prefill an invoice line when you pick this item during Create e-Invoice.</li>
                    <li class="mb-2"><i class="ri-government-line align-bottom me-2 text-primary"></i>The Classification Code is LHDN's official item classification — it's submitted as-is on every invoice line using this item.</li>
                    <li class="mb-0"><i class="ri-scales-3-line align-bottom me-2 text-primary"></i>Unit and Unit Price are optional catalogue defaults — they prefill a new invoice line but never change an invoice you've already created or submitted.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
