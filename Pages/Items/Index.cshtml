@page
@model eInvWorld.Pages.Items.IndexModel
@{
    ViewData["Title"] = "Saved Items";
    // Tabler migration PILOT page (Phase 3). Opts into the parallel Tabler layout; all other pages
    // stay on Velzon. Markup below uses only classes that render correctly under BOTH themes, so
    // reverting this one line restores the Velzon look with no other change.
    Layout = "_LayoutTabler";

    //Updated to include CurrentPage so sorting doesn't reset the page
    string GetSortUrl(string column)
    {
        string newSortOrder = (Model.SortBy == column && Model.SortOrder == "asc") ? "desc" : "asc";
        return Url.Page("./Index", new { SortBy = column, SortOrder = newSortOrder, SearchTerm = Model.SearchTerm, StatusFilter = Model.StatusFilter, CurrentPage = Model.CurrentPage }) ?? "#";
    }

    Microsoft.AspNetCore.Html.IHtmlContent GetSortIcon(string column)
    {
        if (Model.SortBy == column)
        {
            return Html.Raw(Model.SortOrder == "asc" ? "<i class='ri-arrow-up-s-fill ms-1'></i>" : "<i class='ri-arrow-down-s-fill ms-1'></i>");
        }
        return Html.Raw("");
    }
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Items &amp; Services</h1>
                <p class="text-muted mb-0">Manage reusable item codes for faster, more consistent invoice creation.</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" asp-page="Import">
                    <i class="ri-upload-cloud-2-fill align-bottom me-1"></i> Import CSV
                </a>
                <a asp-page="Create" class="btn btn-primary">
                    <i class="ri-add-line align-bottom me-1"></i> Add Item
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 h-100 border-0 shadow-sm">
            <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total Items</p>
            <h3 class="fw-bold mb-0">@Model.TotalItemsCount</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 border-0 shadow-sm">
            <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Active</p>
            <h3 class="fw-bold mb-0 text-success">@Model.ActiveItemsCount</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 border-0 shadow-sm">
            <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Inactive</p>
            <h3 class="fw-bold mb-0 text-secondary">@Model.InactiveItemsCount</h3>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">

        <form method="get" class="mb-4">
            <input type="hidden" name="SortBy" value="@Model.SortBy" />
            <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <input type="text" asp-for="SearchTerm" class="form-control" placeholder="Search items, codes, or descriptions..." />
                </div>
                <div class="col-md-3">
                    <select asp-for="StatusFilter" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <button type="submit" class="btn btn-primary"><i class="ri-search-line align-bottom me-1"></i> Filter</button>
                    <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light text-muted" style="font-size: 0.75rem; text-transform: uppercase;">
                    <tr>
                        <th>
                            <a href="@GetSortUrl("itemcode")" class="text-dark text-decoration-none">
                                Item Code @GetSortIcon("itemcode")
                            </a>
                        </th>
                        <th>
                            <a href="@GetSortUrl("classification")" class="text-dark text-decoration-none">
                                Classification Code @GetSortIcon("classification")
                            </a>
                        </th>
                        <th>
                            <a href="@GetSortUrl("description")" class="text-dark text-decoration-none">
                                Description @GetSortIcon("description")
                            </a>
                        </th>
                        @if (Model.IsAdmin)
                        {
                            <th>
                                <a href="@GetSortUrl("company")" class="text-dark text-decoration-none">
                                    Company Name @GetSortIcon("company")
                                </a>
                            </th>
                        }

                        <th>Updated By</th>
                        <th>
                            <a href="@GetSortUrl("updated")" class="text-dark text-decoration-none">
                                Updated Date @GetSortIcon("updated")
                            </a>
                        </th>

                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ItemViewModels.Any())
                    {
                        @foreach (var wrapper in Model.ItemViewModels)
                        {
                            <tr>
                                <td class="fw-semibold">@wrapper.Item.ItemCode</td>
                                <td>
                                    <span class="badge bg-light text-body border">@wrapper.Item.ClassificationCode</span>
                                </td>

                                <td class="text-truncate" style="max-width: 300px;" title="@wrapper.Item.Description">
                                    @wrapper.Item.Description
                                </td>

                                @if (Model.IsAdmin)
                                {
                                    <td>@wrapper.CompanyName</td>
                                }

                                <td>@(string.IsNullOrEmpty(wrapper.Item.UpdatedBy) ? "-" : wrapper.Item.UpdatedBy)</td>
                                <td class="text-muted small">@(wrapper.Item.UpdatedDate.HasValue? wrapper.Item.UpdatedDate.Value.ToString("dd MMM yyyy HH:mm") : "-")</td>

                                <td>
                                    @if (wrapper.Item.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-page="./Edit" asp-route-id="@wrapper.Item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        <a asp-page="./Delete" asp-route-id="@wrapper.Item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(Model.IsAdmin ? "8" : "7")" class="text-center py-4 text-muted">
                                <i class="ri-price-tag-3-line fs-24 d-block mb-2"></i>
                                No items found matching your filter criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="row mt-3 align-items-center">
                <div class="col-sm">
                    <div class="text-muted">
                        Showing <span class="fw-semibold">@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</span> to
                        <span class="fw-semibold">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</span> of
                        <span class="fw-semibold">@Model.TotalRecords</span> entries
                    </div>
                </div>
                <div class="col-sm-auto">
                    <ul class="pagination pagination-separated pagination-sm justify-content-center justify-content-sm-start mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Page("./Index", new { CurrentPage = Model.CurrentPage - 1, SortBy = Model.SortBy, SortOrder = Model.SortOrder, SearchTerm = Model.SearchTerm, StatusFilter = Model.StatusFilter })">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Page("./Index", new { CurrentPage = i, SortBy = Model.SortBy, SortOrder = Model.SortOrder, SearchTerm = Model.SearchTerm, StatusFilter = Model.StatusFilter })">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Page("./Index", new { CurrentPage = Model.CurrentPage + 1, SortBy = Model.SortBy, SortOrder = Model.SortOrder, SearchTerm = Model.SearchTerm, StatusFilter = Model.StatusFilter })">Next</a>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>
</div>