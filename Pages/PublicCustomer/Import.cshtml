@page
@model eInvWorld.Pages.PublicCustomer.ImportModel
@{
    ViewData["Title"] = "Import Buyers";
    var backUrl = "/PublicCustomer/List";
    bool showPreview = Model.PreviewRecords != null && Model.PreviewRecords.Any();
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Buyer Data Import</h1>
                <p class="text-muted mb-0">Bulk-add buyers from a CSV file, validated against LHDN before saving.</p>
            </div>
            <a href="@backUrl" class="btn btn-outline-secondary"><i class="ri-arrow-left-line align-bottom me-1"></i> Back to List</a>
        </div>
    </div>
</div>

<!-- Step indicator -->
<div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
    <span class="einv-badge @(showPreview ? "einv-badge-success" : "einv-badge-neutral")">
        <i class="ri-checkbox-circle-line"></i> 1. Upload &amp; Validate
    </span>
    <i class="ri-arrow-right-s-line text-muted"></i>
    <span class="einv-badge @(showPreview ? "einv-badge-neutral" : "einv-badge-neutral")">
        <i class="ri-file-list-3-line"></i> 2. Review Results
    </span>
    <i class="ri-arrow-right-s-line text-muted"></i>
    <span class="einv-badge einv-badge-neutral"><i class="ri-save-3-line"></i> 3. Confirm Import</span>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent">
                <h5 class="card-title mb-0">Step 1: Upload &amp; Validate CSV File</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <strong>CSV Format Instructions:</strong><br />
                    Please ensure your CSV file has the following headers (case-sensitive):<br />
                    <code>CompanyName, TIN, RegTypeCode, RegNo, OldRegNo, Email, PhoneNo, FaxNo, Address, PostalCode, CityName, StateCode, CountryCode, MSIC, BizDescription, SST, TTX, BankAccountNo, BankName, Attention, PaymentTerms, Remarks</code>
                    <br /><br />
                    <ul class="mb-0">
                        <li><strong>Text Format:</strong> Please ensure every field's format is set to Text.</li>
                        <li><strong>No Scientific Notation:</strong> Ensure the content is not automatically converted or folded into scientific notation (e.g., 12300000000000 should remain 12300000000000, not 1.23E+13).</li>
                        <li><strong>RegTypeCode, StateCode, CountryCode:</strong> Must match LHDN codes (e.g., BRN, 14, MYS).</li>
                        <li><strong>PhoneNo:</strong> (e.g., 6012345678).</li>
                        <li><strong>SST / TTX:</strong> Enter 'NA' if not applicable.</li>
                        <li><strong>LHDN Validation:</strong> The system will automatically verify TIN, RegTypeCode, and RegNo with the LHDN server upon upload.</li>
                    </ul>
                </div>

                <!-- Upload dropzone -->
                <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mt-3">
                    <label for="UploadFile" class="d-block border border-2 border-dashed rounded-3 p-4 text-center mb-3" style="border-color: var(--einv-border) !important; cursor: pointer;" id="einvDropzone">
                        <i class="ri-upload-cloud-2-line fs-24 d-block mb-2 text-primary"></i>
                        <span class="fw-semibold d-block">Click to choose a CSV file, or drag it here</span>
                        <span class="text-muted small" id="einvDropzoneFile">No file selected</span>
                        <input type="file" asp-for="UploadFile" class="d-none" accept=".csv" required
                               onchange="document.getElementById('einvDropzoneFile').textContent = this.files.length ? this.files[0].name : 'No file selected';" />
                    </label>
                    <span asp-validation-for="UploadFile" class="text-danger"></span>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary">
                            <i class="ri-refresh-line align-bottom me-1"></i> Preview &amp; Validate
                        </button>
                        <a href="~/samplecsv/ImportSample.csv" class="btn btn-outline-secondary" download>
                            <i class="ri-download-cloud-2-line align-bottom me-1"></i> Download Sample CSV
                        </a>
                        <a href="@backUrl" class="btn btn-link text-muted">Cancel</a>
                    </div>
                    <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (showPreview)
{
    var validCount = Model.PreviewRecords.Count(r => r.IsValid);
    var invalidCount = Model.PreviewRecords.Count(r => !r.IsValid);

    <div class="row mt-3" id="previewSection">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="card-title mb-0">Step 2: Validation Results</h5>
                    <div class="d-flex gap-2">
                        <span class="einv-badge einv-badge-success"><i class="ri-checkbox-circle-line"></i> @validCount Valid</span>
                        <span class="einv-badge einv-badge-danger"><i class="ri-error-warning-line"></i> @invalidCount Invalid</span>
                    </div>
                </div>
                <div class="card-body">

                    <div class="table-responsive" style="max-height: 420px;">
                        <table class="table align-middle mb-0" id="buyerImportTable">
                            <thead class="einv-table-head" style="position: sticky; top: 0; z-index: 10;">
                                <tr>
                                    <th style="width: 5%">Row</th>
                                    <th style="width: 20%">Company Name</th>
                                    <th style="width: 15%">TIN</th>
                                    <th style="width: 15%">Reg No</th>
                                    <th style="width: 10%">Status</th>
                                    <th style="width: 35%">Details / Errors</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.PreviewRecords)
                                {
                                    <tr class="@(record.IsValid ? "" : "table-danger bg-opacity-10")">
                                        <td data-label="Row">@record.RowNumber</td>
                                        <td data-label="Company Name">@record.CompanyName</td>
                                        <td data-label="TIN">@record.TIN</td>
                                        <td data-label="Reg No">@record.RegNo</td>
                                        <td data-label="Status">
                                            @if (record.IsValid)
                                            {
                                                <span class="einv-badge einv-badge-success"><i class="ri-check-line"></i> Valid</span>
                                            }
                                            else
                                            {
                                                <span class="einv-badge einv-badge-danger"><i class="ri-close-line"></i> Invalid</span>
                                            }
                                        </td>
                                        <td data-label="Details / Errors">
                                            @if (!record.IsValid)
                                            {
                                                <ul class="text-danger mb-0 ps-3 small">
                                                    @foreach (var error in record.Errors)
                                                    {
                                                        <li>@error</li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Ready to import</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            @if (invalidCount > 0)
                            {
                                <p class="text-muted mb-0"><i class="ri-information-line text-info"></i> Invalid records will be skipped.</p>
                            }
                        </div>

                        <form method="post" asp-page-handler="Confirm">
                            <input type="hidden" asp-for="ValidRecordsJson" />
                            @if (validCount > 0)
                            {
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="ri-save-3-line align-bottom me-1"></i> Import @validCount Valid Records
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-success btn-lg" disabled>
                                    <i class="ri-save-3-line align-bottom me-1"></i> No Valid Records to Import
                                </button>
                            }
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Auto-scroll to preview section if it exists
        document.addEventListener("DOMContentLoaded", function () {
            var previewBlock = document.getElementById("previewSection");
            if (previewBlock) {
                previewBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            var dropzone = document.getElementById("einvDropzone");
            if (dropzone) {
                dropzone.addEventListener("dragover", function (e) { e.preventDefault(); dropzone.classList.add("border-primary"); });
                dropzone.addEventListener("dragleave", function () { dropzone.classList.remove("border-primary"); });
                dropzone.addEventListener("drop", function () { dropzone.classList.remove("border-primary"); });
            }
        });
    </script>
}
