@page "{handler?}"
@model eInvWorld.Pages.PublicCustomer.ListModel

@{
    ViewData["Title"] = "Manage Buyers";
    bool isAdmin = User.IsInRole("Admin");

    // ✅ Updated to include CurrentPage
    string GetSortUrl(string column)
    {
        string newSortOrder = (Model.SortBy == column && Model.SortOrder == "asc") ? "desc" : "asc";
        return Url.Page("./List", new { SortBy = column, SortOrder = newSortOrder, SearchTerm = Model.SearchTerm, CurrentPage = Model.CurrentPage }) ?? "#";
    }

    Microsoft.AspNetCore.Html.IHtmlContent GetSortIcon(string column)
    {
        if (Model.SortBy == column)
        {
            return Html.Raw(Model.SortOrder == "asc" ? "<i class='ri-arrow-up-s-fill ms-1'></i>" : "<i class='ri-arrow-down-s-fill ms-1'></i>");
        }
        return Html.Raw("");
    }
}

<form method="post" id="__afForm">@Html.AntiForgeryToken()</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Buyer Directory</h1>
                <p class="text-muted mb-0">Manage the buyers you issue e-Invoices to.</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" asp-page="Import"><i class="ri-upload-cloud-2-fill align-bottom me-1"></i> Import CSV</a>
                <a class="btn btn-primary" asp-page="/PublicCustomer/Create" asp-route-from="@(isAdmin ? "admin" : null)">
                    <i class="ri-add-line align-bottom me-1"></i> Add Buyer
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 h-100 border-0 shadow-sm">
            <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total Buyers</p>
            <h3 class="fw-bold mb-0">@Model.TotalBuyersCount</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 border-0 shadow-sm">
            <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Active</p>
            <h3 class="fw-bold mb-0 text-success">@Model.ActiveBuyersCount</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 border-0 shadow-sm">
            <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Added This Month</p>
            <h3 class="fw-bold mb-0">@Model.AddedThisMonthCount</h3>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">

        <form method="get" class="mb-4">
            <input type="hidden" name="SortBy" value="@Model.SortBy" />
            <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <input type="text" asp-for="SearchTerm" class="form-control" placeholder="Search buyers..." />
                </div>
                <div class="col-md-5">
                    <button type="submit" class="btn btn-primary"><i class="ri-search-line align-bottom me-1"></i> Filter</button>
                    <a asp-page="./List" class="btn btn-outline-secondary">Clear</a>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table align-middle mb-0" id="customerTable">
                <thead class="table-light text-muted" style="font-size: 0.75rem; text-transform: uppercase;">
                    <tr>
                        <th scope="col">
                            <a href="@GetSortUrl("name")" class="text-dark text-decoration-none">
                                Buyer @GetSortIcon("name")
                            </a>
                        </th>
                        <th scope="col">
                            <a href="@GetSortUrl("tin")" class="text-dark text-decoration-none">
                                TIN / Registration @GetSortIcon("tin")
                            </a>
                        </th>
                        <th scope="col">Contact</th>
                        <th scope="col">Location</th>
                        <th scope="col">Invoices</th>

                        @if (isAdmin)
                        {
                            <th scope="col">Status</th>
                        }
                        else
                        {
                            <th scope="col">Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.CustomerViewModels.Any())
                    {
                        @foreach (var wrapper in Model.CustomerViewModels)
                        {
                            var item = wrapper.Customer;
                            var isAssignedToCurrentUser = Model.AssignedBuyerKeys.Contains($"{item.CreatedByCompanyId}_{item.PublicCustomerId}");
                            var isAssignedByAnySupplier = Model.AssignedPublicCustomerIds.Contains(item.PublicCustomerId);
                            var invoiceCount = Model.InvoiceCountByBuyer.TryGetValue(item.PublicCustomerId, out var c) ? c : 0;
                            <tr>
                                <td>
                                    <span class="fw-semibold">@item.CompanyName</span>
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary ms-1">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <span class="d-block">@item.TIN</span>
                                    <span class="text-muted small">@item.RegTypeCode @item.RegNo</span>
                                </td>
                                <td>
                                    <span class="d-block text-truncate" style="max-width: 200px;">@item.Email</span>
                                    <span class="text-muted small">@item.PhoneNo</span>
                                </td>
                                <td>@item.CityName, @(item.State?.State ?? item.StateCode)</td>
                                <td>@invoiceCount</td>

                                @if (isAdmin)
                                {
                                    <td>
                                        <strong>@wrapper.CreatorCompanyName</strong><br />
                                        <small class="text-muted">User: @(string.IsNullOrEmpty(item.UpdatedBy) ? "-" : item.UpdatedBy)</small><br />

                                        @if (item.IsAdminCreated)
                                        {
                                            <span class="badge bg-info mt-1">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary mt-1">Supplier</span>
                                        }
                                        <br />
                                        @if (isAssignedByAnySupplier)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success mt-1">Assigned</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-warning-subtle text-warning mt-1">Not Assigned</span>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <div class="dropdown d-inline-block">
                                            <button class="btn @(isAssignedToCurrentUser ? "btn-outline-success" : "btn-outline-warning") btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="ri-more-fill align-middle"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    @if (isAssignedToCurrentUser)
                                                    {
                                                        <form method="post" asp-page-handler="RemoveFromBuyers" asp-route-publicCustomerId="@item.PublicCustomerId" onsubmit="return confirm('Remove this buyer from your active list?');">
                                                            <button type="submit" class="dropdown-item text-warning" title="Remove from My Buyers">
                                                                <i class="ri-user-unfollow-line align-bottom me-2"></i> Remove from My Buyers List
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form method="post" asp-page-handler="AddToBuyers" asp-route-publicCustomerId="@item.PublicCustomerId">
                                                            <button type="submit" class="dropdown-item text-success" title="Add to My Buyers List">
                                                                <i class="ri-user-add-line align-bottom me-2"></i> Add to My Buyers List
                                                            </button>
                                                        </form>
                                                    }
                                                </li>
                                                <li>
                                                    <a asp-page="./Details" asp-route-id="@item.PublicCustomerId" class="dropdown-item">
                                                        <i class="ri-eye-fill align-bottom me-2 text-muted"></i> View
                                                    </a>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="Delete" asp-route-buyerId="@item.PublicCustomerId" onsubmit="return confirm('Are you sure you want to delete this buyer?');">
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="ri-delete-bin-fill align-bottom me-2"></i> Delete
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="ri-group-line fs-24 d-block mb-2"></i>
                                No buyers found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="row mt-3 align-items-center">
                        <div class="col-sm">
                            <div class="text-muted">
                                Showing <span class="fw-semibold">@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</span> to
                                <span class="fw-semibold">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</span> of
                                <span class="fw-semibold">@Model.TotalRecords</span> entries
                            </div>
                        </div>
                        <div class="col-sm-auto">
                            <ul class="pagination pagination-separated pagination-sm justify-content-center justify-content-sm-start mb-0">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Page("./List", new { CurrentPage = Model.CurrentPage - 1, SortBy = Model.SortBy, SortOrder = Model.SortOrder, SearchTerm = Model.SearchTerm })">Previous</a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Page("./List", new { CurrentPage = i, SortBy = Model.SortBy, SortOrder = Model.SortOrder, SearchTerm = Model.SearchTerm })">@i</a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Page("./List", new { CurrentPage = Model.CurrentPage + 1, SortBy = Model.SortBy, SortOrder = Model.SortOrder, SearchTerm = Model.SearchTerm })">Next</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>