@page
@model eInvWorld.Pages.RecurringInvoices.CreateModel
@{
    ViewData["Title"] = "Create Recurring Profile";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Create Recurring Profile</h1>
                <p class="text-muted mb-0">Set up automated invoice generation based on the template: <strong>@Model.BaseTemplateName</strong>.</p>
            </div>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="ri-arrow-left-line align-bottom me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Input.InvoiceTemplateId" />
                    <input type="hidden" asp-for="Input.SupplierId" />
                    <input type="hidden" asp-for="Input.CustomerId" />
                    <input type="hidden" asp-for="Input.PublicCustomerId" />

                    <div class="mb-4">
                        <label asp-for="Input.ProfileName" class="form-label fw-semibold">Profile Name <span class="text-danger">*</span></label>
                        <input asp-for="Input.ProfileName" class="form-control" placeholder="e.g. Monthly Retainer - Acme Corp" required />
                        <span asp-validation-for="Input.ProfileName" class="text-danger"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Company (Locked to Template)</label>
                            <input type="text" class="form-control bg-light" value="@Model.SupplierName" readonly />
                        </div>
                        <div class="col-md-6 mt-3 mt-md-0">
                            <label class="form-label text-muted">Buyer (Locked to Template)</label>
                            <input type="text" class="form-control bg-light" value="@Model.BuyerName" readonly />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Frequency" class="form-label fw-semibold">Frequency <span class="text-danger">*</span></label>
                            <select asp-for="Input.Frequency" class="form-select" required>
                                <option value="Daily">Daily</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Monthly" selected>Monthly</option>
                                <option value="Annually">Annually</option>
                            </select>
                        </div>
                        <div class="col-md-6 mt-3 mt-md-0">
                            <label asp-for="Input.NextRunDate" class="form-label fw-semibold">Next Run Date <span class="text-danger">*</span></label>
                            <input asp-for="Input.NextRunDate" type="date" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-check form-switch form-switch-lg mb-4" dir="ltr">
                        <input type="checkbox" class="form-check-input" id="autoSubmitSwitch" asp-for="Input.AutoSubmitToMyInvois">
                        <label class="form-check-label fw-semibold ms-2" for="autoSubmitSwitch">Auto-submit to MyInvois after generation</label>
                    </div>

                    <div class="text-end">
                        <a asp-page="./Index" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create Profile</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header-clean" style="background: #0c5434; border-radius: 12px 12px 0 0; padding: 1rem 1.25rem;">
                <p class="text-uppercase mb-0 text-white-50" style="font-size: 0.7rem; letter-spacing: 0.05em;">Template Preview</p>
                <h5 class="mb-0 text-white fw-bold">@Model.BaseTemplateName</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-1" style="font-size: 0.8rem;">@Model.SupplierName &rarr; @Model.BuyerName</p>
                <div class="d-flex gap-2 mb-3">
                    <span class="badge bg-light text-body border">@Model.TemplateItemCount item@(Model.TemplateItemCount == 1 ? "" : "s")</span>
                    <span class="badge bg-light text-body border">@Model.TemplateCurrency</span>
                </div>
                <hr />
                <p class="text-muted mb-0" style="font-size: 0.75rem;">Template Total</p>
                <h3 class="fw-bold mb-0">@Model.TemplateCurrency @(Model.TemplateTotalAmount?.ToString("N2") ?? "0.00")</h3>
                <p class="text-muted small mt-3 mb-0">Each generated invoice copies this template's items and amounts as of its run date. Edit the base template to change future runs.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}