@* _Favicons.cshtml: Centralized favicon and manifest links *@
<link rel="icon" href="~/favicon-dark.ico" type="image/x-icon" media="(prefers-color-scheme: light)">
<link rel="icon" href="~/favicon-light.ico" type="image/x-icon" media="(prefers-color-scheme: dark)">

<!-- Modern PNG Favicons -->
<link rel="icon" type="image/png" sizes="16x16" href="~/favicon/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="~/favicon/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="48x48" href="~/favicon/favicon-48x48.png">
<link rel="icon" type="image/png" sizes="64x64" href="~/favicon/favicon-64x64.png">
<link rel="icon" type="image/png" sizes="96x96" href="~/favicon/favicon-96x96.png">
<link rel="icon" type="image/png" sizes="128x128" href="~/favicon/favicon-128x128.png">
<link rel="icon" type="image/png" sizes="192x192" href="~/favicon/favicon-192x192.png">
<link rel="icon" type="image/png" sizes="256x256" href="~/favicon/favicon-256x256.png">
<link rel="icon" type="image/png" sizes="512x512" href="~/favicon/favicon-512x512.png">

<!-- Apple Touch Icon -->
<link rel="apple-touch-icon" sizes="180x180" href="~/favicon/apple-touch-icon.png">

<!-- PWA Manifest -->
<link rel="manifest" href="~/favicon/manifest.json">


@{
    // Browser/status-bar colour: brand green in light mode, the dark page canvas in dark mode.
    // _LayoutTabler passes the user's saved choice (einv-theme cookie, already allowlisted there) so
    // the bar matches the in-app theme, not the OS setting; with no saved choice the OS decides.
    // einvworld-ui.js reads data-light/data-dark to repaint the bar when the topbar toggle is used.
    var themeColorLight = "#006948";
    var themeColorDark = "#0c1411";
    var savedTheme = ViewData["EinvTheme"] as string;
}
@if (savedTheme == "dark" || savedTheme == "light")
{
    <meta name="theme-color" content="@(savedTheme == "dark" ? themeColorDark : themeColorLight)" data-light="@themeColorLight" data-dark="@themeColorDark">
}
else
{
    <meta name="theme-color" content="@themeColorLight" media="(prefers-color-scheme: light)" data-light="@themeColorLight" data-dark="@themeColorDark">
    <meta name="theme-color" content="@themeColorDark" media="(prefers-color-scheme: dark)" data-light="@themeColorLight" data-dark="@themeColorDark">
}

<!-- Installed-app (standalone) mode on Android/iOS; no service worker, so pages are never cached -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="EinvWorld">
<meta name="apple-mobile-web-app-status-bar-style" content="default">

<!-- Optional Windows Tile Support -->
<meta name="msapplication-TileColor" content="#006948">
<meta name="msapplication-TileImage" content="~/favicon/favicon-192x192.png">


