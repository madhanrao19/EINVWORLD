@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inject eInvWorld.Data.ApplicationDbContext DbContext
@*
    Supplier role navigation (Tabler). Mirrors the Admin navigation's collapsible dropdown-group
    pattern and module naming exactly (Invoice Management, Item Management, Buyers Management,
    Company Management) so the sidebar UX and labels are consistent across roles. Unique ids per
    submenu (no duplicate DOM ids). Resolves the caller's own company id (same query as before) for
    the "My Company" link. Cosmetic only — authorization is enforced server-side and unchanged.
*@
@{
    string? companyId = null;
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (!string.IsNullOrEmpty(userId))
    {
        companyId = DbContext.UserCompanies
            .Where(uc => uc.UserId == userId)
            .Select(uc => uc.PartyInfoId.ToString())
            .FirstOrDefault();
    }
}
