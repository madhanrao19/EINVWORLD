<!-- ✅ Shared Turnstile Partial View: Pages/Shared/_TurnstilePartial.cshtml-->
@inject IConfiguration _config
<input type="text" name="Website" style="display:none;" /> <!-- Honeypot -->
@* Widget theme matches the page: the saved einv-theme choice, else "auto" (OS), like the layout. *@
<div class="cf-turnstile mt-3" data-sitekey="@_config["Turnstile:SiteKey"]" data-theme="@(eInvWorld.Helpers.ThemePreference.Read(Context) ?? "auto")"></div>