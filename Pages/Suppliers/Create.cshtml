@page
@model eInvWorld.Pages.Suppliers.CreateModel

@{
    ViewData["Title"] = "Create New Company";
    Layout = "_LayoutTabler";
    var isAdmin = User.IsInRole("Admin");
}
<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-pretitle">Company Management</div>
            <h2 class="page-title">Create New Company</h2>
            <p class="text-muted mt-1 mb-0">Register a new company's legal, tax, and fiscal identity for e-invoicing compliance.</p>
        </div>
    </div>
</div>
<form method="post" enctype="multipart/form-data" onsubmit="return checkValidationBeforeSubmit();">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="PartyInfo.CreatedBy" value="@User.Identity?.Name ?? \" System\"" />
    <input type="hidden" name="from" value="@Model.From" />

    <div class="card">
        <div class="card-header p-0">
            <ul class="nav nav-pills custom-nav nav-justified w-100 m-0 p-3" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" id="step1-tab" data-bs-toggle="pill" data-bs-target="#step1" type="button">Step 1: Company &amp; Tax Details</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="step2-tab" data-bs-toggle="pill" data-bs-target="#step2" type="button">Step 2: Address &amp; Contact</button>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="step1" role="tabpanel">

                    <div class="text-center mb-4">
                        <div class="avatar avatar-xl rounded mb-3 mx-auto" style="width:140px;height:140px;">
                            <img id="companylogo-img"
                                 class="rounded w-100 h-100 object-fit-cover"
                                 src="@(string.IsNullOrEmpty(Model.PartyInfo.LogoPath) ? Url.Content("~/assets/images/users/multi-user.jpg") : Url.Content(Model.PartyInfo.LogoPath))"
                                 data-saved="@(string.IsNullOrEmpty(Model.PartyInfo.LogoPath) ? "" : Url.Content(Model.PartyInfo.LogoPath))" />
                        </div>
                        <div class="text-muted small mb-3">Company Logo — PNG, JPG or GIF. Square images look best.</div>
                        <label for="company-logo-input" class="btn btn-outline-primary btn-sm">
                            <i class="ri-upload-2-line me-1"></i> Upload
                        </label>
                        <input class="d-none" name="LogoFile" id="company-logo-input" type="file" accept="image/png, image/gif, image/jpeg">
                    </div>

                    <div class="card mb-3 bg-light-subtle">
                        <div class="card-header">
                            <h3 class="card-title">Legal Details</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.CompanyName" class="form-label"></label>
                                    <input asp-for="PartyInfo.CompanyName" class="form-control" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.TIN" class="form-label"></label>
                                    <input asp-for="PartyInfo.TIN" class="form-control" placeholder="eg: C123456789" list="tinOptions" required />

                                    <datalist id="tinOptions">
                                        <option value="EI00000000010">General Public</option>
                                        <option value="EI00000000020">Foreign Buyer</option>
                                        <option value="EI00000000030">Foreign Supplier</option>
                                        <option value="EI00000000040">Government</option>
                                    </datalist>

                                    <span asp-validation-for="PartyInfo.TIN" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.RegNo" class="form-label"></label>
                                    <input asp-for="PartyInfo.RegNo" class="form-control" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.RegTypeCode" class="form-label">Registration Type</label>
                                    <select asp-for="PartyInfo.RegTypeCode" class="form-select select2" asp-items="Model.IdTypesOptions" required>
                                        <option value="">-- Select ID Type --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-0">
                                <label asp-for="PartyInfo.OldRegNo" class="form-label">Old Registration Number</label>
                                <input asp-for="PartyInfo.OldRegNo" class="form-control" placeholder="Previous business registration number" />
                                <span asp-validation-for="PartyInfo.OldRegNo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3 bg-light-subtle">
                        <div class="card-header">
                            <h3 class="card-title">Tax &amp; Industry</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.SST" class="form-label"></label>
                                    <input asp-for="PartyInfo.SST" class="form-control" placeholder="e.g. W10-1808-99999999 or NA" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.TTX" class="form-label"></label>
                                    <input asp-for="PartyInfo.TTX" class="form-control" placeholder="e.g. TTX-XXXXXXX or NA" required />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.IndustryClassificationCode" class="form-label">MSIC Code</label>
                                    <select asp-for="PartyInfo.IndustryClassificationCode" class="form-select select2" id="msicSelect" required>
                                        <option value="">-- Select MSIC Code --</option>
                                        @foreach (var msic in Model.MSICOptions)
                                        {
                                            <option value="@msic.Value" data-description="@msic.Text">@msic.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-0" id="bizDescriptionContainer">
                                    <label class="control-label">Business Description (auto-filled from MSIC)</label>
                                    <div class="form-control-plaintext border bg-body p-2" style="white-space: pre-wrap; min-height: 40px;" id="bizDescPreview">
                                    </div>
                                    <input type="hidden" asp-for="PartyInfo.BizDescription" id="PartyInfo_BizDescription" />
                                    <span asp-validation-for="PartyInfo.BizDescription" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button class="btn btn-outline-info me-2 btn-validate" type="button" onclick="validateLHDN()">
                            <i class="ri-shield-check-line me-1"></i> Validate with LHDN
                        </button>
                        <button class="btn btn-primary" type="button" onclick="nextTab('step2-tab')">
                            Next <i class="ri-arrow-right-line ms-1"></i>
                        </button>
                    </div>
                </div>

                <div class="tab-pane fade" id="step2" role="tabpanel">

                    <div class="card mb-3 bg-light-subtle">
                        <div class="card-header">
                            <h3 class="card-title">Contact Details</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.Email" class="form-label"></label>
                                    <input asp-for="PartyInfo.Email"
                                           class="form-control"
                                           type="email"
                                           placeholder="e.g. yourname@example.com"
                                           required />
                                    <span asp-validation-for="PartyInfo.Email" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.PhoneNo" class="form-label"></label>
                                    <input asp-for="PartyInfo.PhoneNo" class="form-control"
                                           placeholder="e.g. +60376602222"
                                           pattern="^\+[0-9]{8,14}$"
                                           title="Enter a valid phone number starting with '+' and numbers only (e.g. +60376602222)"
                                           required />
                                    <span asp-validation-for="PartyInfo.PhoneNo" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-0">
                                <label asp-for="PartyInfo.FaxNo" class="form-label"></label>
                                <input asp-for="PartyInfo.FaxNo" class="form-control"
                                       maxlength="20"
                                       placeholder="e.g. (603) 7660-2323" />
                                <span asp-validation-for="PartyInfo.FaxNo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3 bg-light-subtle">
                        <div class="card-header">
                            <h3 class="card-title">Registered Address</h3>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="PartyInfo.Addr1" class="form-label">Full Address</label>
                                <textarea asp-for="PartyInfo.Addr1" class="form-control" rows="3" placeholder="Enter full address..."></textarea>
                                <span asp-validation-for="PartyInfo.Addr1" class="text-danger"></span>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="PartyInfo.PostalCode" class="form-label"></label>
                                    <input asp-for="PartyInfo.PostalCode" class="form-control" required />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="PartyInfo.CityName" class="form-label"></label>
                                    <input asp-for="PartyInfo.CityName" class="form-control" required />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="PartyInfo.StateCode" class="form-label"></label>
                                    <select asp-for="PartyInfo.StateCode" class="form-select select2" asp-items="Model.StateOptions" required>
                                        <option value="">-- Select State --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-0">
                                <label asp-for="PartyInfo.CountryCode" class="form-label"></label>
                                <select asp-for="PartyInfo.CountryCode" class="form-select select2" asp-items="Model.CountryOptions" required>
                                    <option value="">-- Select Country --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3 bg-light-subtle">
                        <div class="card-header">
                            <h3 class="card-title">Banking &amp; Payment</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.BankAccountNo" class="form-label">Bank Account Number</label>
                                    <input asp-for="PartyInfo.BankAccountNo" class="form-control" placeholder="Bank account number for payments" />
                                    <span asp-validation-for="PartyInfo.BankAccountNo" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.BankName" class="form-label">Bank Name</label>
                                    <input asp-for="PartyInfo.BankName" class="form-control" placeholder="Name of the bank" />
                                    <span asp-validation-for="PartyInfo.BankName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PartyInfo.PaymentTerms" class="form-label">Default Payment Terms</label>
                                    <input asp-for="PartyInfo.PaymentTerms" class="form-control" placeholder="e.g. 30 days, Immediate, COD" maxlength="100" />
                                    <span asp-validation-for="PartyInfo.PaymentTerms" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-0">
                                    <label asp-for="PartyInfo.Attention" class="form-label">Attention To</label>
                                    <input asp-for="PartyInfo.Attention" class="form-control" placeholder="Person to whom invoices should be addressed" />
                                    <span asp-validation-for="PartyInfo.Attention" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3 bg-light-subtle">
                        <div class="card-header">
                            <h3 class="card-title">Remarks</h3>
                        </div>
                        <div class="card-body">
                            <textarea asp-for="PartyInfo.Remarks" class="form-control"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <button class="btn btn-light" type="button" onclick="prevTab('step1-tab')">
                            <i class="ri-arrow-left-line me-1"></i> Back
                        </button>
                        <div class="d-flex">
                            <button class="btn btn-outline-info me-2 btn-validate" type="button" onclick="validateLHDN()">
                                <i class="ri-shield-check-line me-1"></i> Validate with LHDN
                            </button>
                            <button type="submit" class="btn btn-success">
                                <i class="ri-save-line me-1"></i> Save New Company
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<script src="/assets/libs/jquery/dist/jquery.min.js"></script>
<script src="/assets/libs/select2/js/select2.min.js"></script>
<script src="~/js/create-company.js"></script>

@section Scripts {
    <script>
        let isLhdnValidated = false;

        // Reset validation state if user edits TIN, RegNo, or ID Type
        function resetValidation() {
            isLhdnValidated = false;
            document.querySelectorAll('.btn-validate').forEach(btn => {
                btn.classList.remove('btn-success', 'btn-danger');
                btn.classList.add('btn-outline-info');
                btn.innerHTML = '<i class="ri-shield-check-line me-1"></i> Validate with LHDN';
            });
        }

        async function validateLHDN() {
            const tin = document.getElementById('PartyInfo_TIN').value;
            const regType = document.getElementById('PartyInfo_RegTypeCode').value;
            const regNo = document.getElementById('PartyInfo_RegNo').value;

            if (!tin || !regType || !regNo) {
                markAsFailed("Missing Info - Retry");
                return;
            }

            const generalTins = ["EI00000000010", "EI00000000020", "EI00000000030", "EI00000000040"];
            if (generalTins.includes(tin)) {
                isLhdnValidated = true;
                markAsValidated();
                return;
            }

            const btns = document.querySelectorAll('.btn-validate');
            btns.forEach(btn => {
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Validating...';
                btn.disabled = true;
                btn.classList.remove('btn-danger', 'btn-success', 'btn-outline-info');
                btn.classList.add('btn-outline-info');
            });

            try {
                const response = await fetch(`?handler=ValidateTIN&tin=${encodeURIComponent(tin)}&idType=${encodeURIComponent(regType)}&idNo=${encodeURIComponent(regNo)}`);
                const data = await response.json();

                if (data.success) {
                    isLhdnValidated = true;
                    markAsValidated();
                } else {
                    isLhdnValidated = false;
                    markAsFailed("Failed - Retry");
                    console.warn(data.message);
                }
            } catch (error) {
                console.error("Validation Error:", error);
                isLhdnValidated = false;
                markAsFailed("Error - Retry");
            } finally {
                btns.forEach(btn => btn.disabled = false);
            }
        }

        function markAsValidated() {
            document.querySelectorAll('.btn-validate').forEach(btn => {
                btn.classList.remove('btn-outline-info', 'btn-danger');
                btn.classList.add('btn-success');
                btn.innerHTML = '<i class="ri-check-line me-1"></i> Validated';
            });
        }

        function markAsFailed(text) {
            document.querySelectorAll('.btn-validate').forEach(btn => {
                btn.classList.remove('btn-outline-info', 'btn-success');
                btn.classList.add('btn-danger');
                btn.innerHTML = `<i class="ri-close-line me-1"></i> ${text}`;
            });
        }

        // Form Submission Gatekeeper
        function checkValidationBeforeSubmit() {
            const tin = document.getElementById('PartyInfo_TIN').value;
            const generalTins = ["EI00000000010", "EI00000000020", "EI00000000030", "EI00000000040"];

            if (generalTins.includes(tin)) {
                isLhdnValidated = true;
            }

            if (!isLhdnValidated) {
                alert("Please validate the Company Info (TIN, Reg No, ID Type) before saving.");
                return false;
            }
            return true;
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById('PartyInfo_TIN').addEventListener('input', resetValidation);
            document.getElementById('PartyInfo_RegTypeCode').addEventListener('change', resetValidation);
            document.getElementById('PartyInfo_RegNo').addEventListener('input', resetValidation);

            const successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                const toastElement = document.getElementById('toast-success');
                const messageContainer = document.getElementById('toast-success-message');
                if (toastElement && messageContainer) {
                    messageContainer.innerText = successMessage;
                    const toast = new bootstrap.Toast(toastElement, { delay: 5000 });
                    toast.show();
                }
            }

            const errorMessage = '@TempData["ErrorMessage"]';
            if (errorMessage) {
                alert(errorMessage);
            }
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
