@page
@model eInvWorld.Pages.Suppliers.DetailsModel

@{
    ViewData["Title"] = (Model.From == "lead") ? "Lead Details" : "Company Details";
}

<!-- Start Page Title -->
<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">@Model.PartyInfo.CompanyName</h1>
                <p class="text-muted mb-0">
                    @(Model.PartyInfo.IsActive ? "Active" : "Inactive") &middot; @Model.CountryName &middot;
                    @((Model.From == "lead") ? "Lead Details" : "Company Details")
                </p>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <a class="btn btn-outline-secondary" asp-page="@(Model.From == "lead" ? "/Lead/List" : "./Index")">
                    <i class="ri-arrow-left-line align-bottom me-1"></i> Back to List
                </a>
            }
        </div>
    </div>
</div>
<!-- End Page Title -->

@if (Model.From != "lead")
{
    var workspaceTabsModel = new CompanyWorkspaceTabsModel { PartyInfoId = Model.PartyInfo.PartyInfoId, Active = "overview", From = Model.From };
    <partial name="_CompanyWorkspaceTabs" model="workspaceTabsModel" />
}

@{
    var kpis = new[]
    {
        (Label: "Users", Value: (Model.AssignedUsers.Count + 1).ToString(), Note: "Members of this company", Icon: "ri-user-3-line", Tone: "primary"),
        (Label: "Buyers", Value: Model.AssignedBuyers.Count.ToString(), Note: "Buyers you invoice", Icon: "ri-team-line", Tone: "info"),
        (Label: "Suppliers", Value: Model.AssignedSuppliers.Count.ToString(), Note: "Suppliers linked to you", Icon: "ri-truck-line", Tone: "orange"),
        (Label: "Verification", Value: Model.PartyInfo.IsApproved ? "Verified" : "Pending", Note: "Company status", Icon: Model.PartyInfo.IsApproved ? "ri-shield-check-line" : "ri-time-line", Tone: Model.PartyInfo.IsApproved ? "success" : "warning"),
    };

    var addressParts = new[]
    {
        Model.PartyInfo.Addr1, Model.PartyInfo.Addr2, Model.PartyInfo.Addr3,
        Model.PartyInfo.PostalCode, Model.PartyInfo.CityName, Model.StateName, Model.CountryName
    }.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
    var googleMapsUrl = $"https://www.google.com/maps/search/?q={Uri.EscapeDataString(string.Join(" ", addressParts))}";

    string Show(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
}

<div class="row g-3 mb-3">
    @foreach (var k in kpis)
    {
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-2 gap-sm-3 p-2 p-sm-3">
                    <span class="avatar bg-@(k.Tone)-lt flex-shrink-0" aria-hidden="true"><i class="@k.Icon fs-3"></i></span>
                    <div class="min-w-0">
                        <div class="text-muted small text-truncate">@k.Label</div>
                        <div class="fs-3 fw-bold lh-sm text-truncate @(k.Label == "Verification" ? $"text-{k.Tone}" : "")">@k.Value</div>
                        <div class="text-muted small d-none d-sm-block text-truncate">@k.Note</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Company details: summary row, then two panels that collapse to tap-to-open sections on phones. -->
<div class="card border-0 shadow-sm mb-3" id="company-view-detail">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="card-title mb-0">Company Details</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="/Suppliers/Edit" asp-route-id="@Model.PartyInfo.PartyInfoId" asp-route-from="@(Model.From == "lead" ? "lead" : null)" class="btn btn-primary btn-sm">
                <i class="ri-pencil-line align-bottom me-1"></i> Edit Company
            </a>
        }
    </div>
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="avatar avatar-xl rounded-3 bg-white border flex-shrink-0 overflow-hidden">
                <img src="@Url.Content(EINVWORLD.Helpers.LogoUrl.For(Model.PartyInfo.LogoPath))"
                     alt="@Model.PartyInfo.CompanyName logo" class="w-100 h-100 object-fit-contain p-1" />
            </span>
            <div class="min-w-0">
                <h3 class="mb-1 text-break">@Model.PartyInfo.CompanyName</h3>
                <div class="text-muted small text-break mb-2">@Model.PartyInfo.Email</div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="einv-badge @(Model.PartyInfo.IsApproved ? "einv-badge-success" : "einv-badge-warning")">
                        <i class="ri-verified-badge-line" aria-hidden="true"></i> @(Model.PartyInfo.IsApproved ? "Verified" : "Unverified")
                    </span>
                    <span class="einv-badge @(Model.PartyInfo.IsActive ? "einv-badge-success" : "einv-badge-neutral")">
                        <i class="ri-checkbox-circle-line" aria-hidden="true"></i> @(Model.PartyInfo.IsActive ? "Active" : "Inactive")
                    </span>
                    <span class="einv-badge einv-badge-neutral"><i class="ri-building-line" aria-hidden="true"></i> Supplier</span>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="border rounded-3 h-100">
                    <button class="btn btn-link w-100 d-flex align-items-center justify-content-between text-reset text-decoration-none px-3 py-2 border-bottom" type="button"
                            data-bs-toggle="collapse" data-bs-target="#companyLegal" aria-expanded="false" aria-controls="companyLegal">
                        <span class="fw-semibold"><i class="ri-file-list-3-line me-2" aria-hidden="true"></i>Legal &amp; Registration</span>
                        <i class="ri-arrow-down-s-line d-md-none" aria-hidden="true"></i>
                    </button>
                    @* Closed on phones (tap to open); d-md-block keeps it open on tablet/desktop. *@
                    <div class="collapse d-md-block" id="companyLegal">
                        <dl class="row mb-0 px-3 py-2 small">
                            <dt class="col-5 fw-normal text-muted">Registration Type</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.RegTypeCode)</dd>
                            <dt class="col-5 fw-normal text-muted">Tax ID (TIN)</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.TIN)</dd>
                            <dt class="col-5 fw-normal text-muted">Registration Number</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.RegNo)</dd>
                            <dt class="col-5 fw-normal text-muted">Old Registration Number</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.OldRegNo)</dd>
                            <dt class="col-5 fw-normal text-muted">Industry (MSIC)</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.IndustryClassificationCode)</dd>
                            <dt class="col-5 fw-normal text-muted">Business Description</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.BizDescription)</dd>
                            <dt class="col-5 fw-normal text-muted">SST Registration</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.SST)</dd>
                            <dt class="col-5 fw-normal text-muted">Tourism Tax (TTx)</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.TTX)</dd>
                            <dt class="col-5 fw-normal text-muted">Remarks</dt><dd class="col-7 mb-0 text-break">@Show(Model.PartyInfo.Remarks)</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="border rounded-3 h-100">
                    <button class="btn btn-link w-100 d-flex align-items-center justify-content-between text-reset text-decoration-none px-3 py-2 border-bottom" type="button"
                            data-bs-toggle="collapse" data-bs-target="#companyContact" aria-expanded="false" aria-controls="companyContact">
                        <span class="fw-semibold"><i class="ri-bank-card-line me-2" aria-hidden="true"></i>Contact &amp; Finance</span>
                        <i class="ri-arrow-down-s-line d-md-none" aria-hidden="true"></i>
                    </button>
                    <div class="collapse d-md-block" id="companyContact">
                        <dl class="row mb-0 px-3 py-2 small">
                            <dt class="col-5 fw-normal text-muted">Phone Number</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.PhoneNo)</dd>
                            <dt class="col-5 fw-normal text-muted">Fax Number</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.FaxNo)</dd>
                            <dt class="col-5 fw-normal text-muted">Default Bank Account</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.BankAccountNo)</dd>
                            <dt class="col-5 fw-normal text-muted">Bank Name</dt>
                            <dd class="col-7 mb-2 text-break">
                                @Show(Model.PartyInfo.BankName)
                                <a asp-page="/Profile/BankAccounts" asp-route-companyId="@Model.PartyInfo.PartyInfoId" class="d-block small">All bank accounts</a>
                            </dd>
                            <dt class="col-5 fw-normal text-muted">Attention</dt><dd class="col-7 mb-2 text-break">@Show(Model.PartyInfo.Attention)</dd>
                            <dt class="col-5 fw-normal text-muted">Location</dt>
                            <dd class="col-7 mb-0 text-break">
                                @Show(string.Join(", ", addressParts))
                                @if (addressParts.Any())
                                {
                                    <a href="@googleMapsUrl" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm mt-2 d-inline-flex align-items-center gap-1">
                                        <i class="ri-map-pin-line" aria-hidden="true"></i> View on Map
                                    </a>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.From != "lead")
{
    <div class="row g-3">
        <!-- Assigned Users -->
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <h2 class="card-title mb-0">Assigned Users</h2>
                        <div class="text-muted small">@Model.AssignedUsers.Count user@(Model.AssignedUsers.Count == 1 ? "" : "s") assigned</div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-page="/Suppliers/Users" asp-route-id="@Model.PartyInfo.PartyInfoId" class="btn btn-primary btn-sm">
                            <i class="ri-mail-send-line me-1 align-bottom"></i> Invite User
                        </a>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#assignUsersModal">
                            <i class="ri-share-line me-1 align-bottom"></i> Assign Existing
                        </button>
                    </div>
                </div>
                <div class="table-responsive einv-table-scroll-x">
                    <table data-einv-table="company-detail-users" class="table table-hover align-middle mb-0 einv-mobile-stack">
                        <thead class="einv-table-head">
                            <tr>
                                <th scope="col">Name</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th class="text-center">Primary</th>
                                }
                                else
                                {
                                    <th class="text-center">Company Access</th>
                                    <th class="text-center">View Only</th>
                                }
                                <th class="text-center">Role</th>
                                <th class="col-action text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AssignedUsers.Any())
                            {
                                @foreach (var user in Model.AssignedUsers)
                                {
                                    var userCompany = Model.AssignedUserCompanies.FirstOrDefault(uc => uc.UserId == user.Id);
                                    var userRole = Model.UserRoles.GetValueOrDefault(user.Id, "User");

                                    <tr>
                                        <td data-label="Name" style="max-width: 220px;">
                                            <div class="d-flex flex-column min-w-0">
                                                <span class="fw-medium text-truncate" title="@user.FullName">@user.FullName</span>
                                                <small class="text-muted text-truncate" title="@user.Email">@user.Email</small>
                                            </div>
                                        </td>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <td class="text-center" data-label="Primary">
                                                @if (userRole == "Supplier")
                                                {
                                                    <input type="checkbox" class="primary-checkbox form-check-input"
                                                           data-userid="@user.Id"
                                                           data-companyid="@Model.PartyInfo.PartyInfoId"
                                                           aria-label="Primary company for @user.FullName"
                                                           @(userCompany?.IsPrimaryCompany == true ? "checked" : "") />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            @if (userRole == "Supplier")
                                            {
                                                <td class="text-center" data-label="Company Access">
                                                    <input type="radio" class="form-check-input permission-radio"
                                                           name="permission_@user.Id"
                                                           data-userid="@user.Id"
                                                           data-type="access"
                                                           aria-label="Company access for @user.FullName"
                                                           @(userCompany?.HasCompanyAccess == true ? "checked" : "")
                                                           onchange="updatePermission('@user.Id', 'access', true)">
                                                </td>
                                                <td class="text-center" data-label="View Only">
                                                    <input type="radio" class="form-check-input permission-radio"
                                                           name="permission_@user.Id"
                                                           data-userid="@user.Id"
                                                           data-type="view"
                                                           aria-label="View only for @user.FullName"
                                                           @(userCompany?.IsViewOnly == true ? "checked" : "")
                                                           onchange="updatePermission('@user.Id', 'view', true)">
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="text-center text-muted" data-label="Company Access">—</td>
                                                <td class="text-center text-muted" data-label="View Only">—</td>
                                            }
                                        }
                                        <td class="text-center" data-label="Role">
                                            <span class="einv-badge @(userRole == "Admin" ? "einv-badge-danger" : userRole == "Supplier" ? "einv-badge-success" : "einv-badge-neutral")">@userRole</span>
                                            <button type="button" class="btn btn-sm btn-link text-decoration-none shadow-none p-0 ms-1"
                                                    data-user-id="@user.Id" data-user-name="@user.FullName" onclick="openChangeRoleModal(this.dataset.userId, this.dataset.userName)" title="Change Role" aria-label="Change role for @user.FullName">
                                                <i class="ri-edit-line fs-14" aria-hidden="true"></i>
                                            </button>
                                        </td>
                                        <td class="col-action text-center" data-label="Actions">
                                            <div class="dropdown d-inline-block">
                                                <button class="btn btn-sm einv-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                                    <i class="ri-more-fill align-middle"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><button type="button" class="dropdown-item text-danger" onclick="unassignUser('@Model.PartyInfo.PartyInfoId', '@user.Id')"><i class="ri-user-unfollow-line align-bottom me-2"></i> Unassign</button></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(User.IsInRole("Admin") ? "4" : "5")" class="text-center text-muted py-4">
                                        No users assigned yet. Invite someone to start working together.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Assigned Buyers -->
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <h2 class="card-title mb-0">Assigned Buyers</h2>
                        <div class="text-muted small">@Model.AssignedBuyers.Count buyer@(Model.AssignedBuyers.Count == 1 ? "" : "s") managed</div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#assignBuyersModal">
                                <i class="ri-building-line me-1 align-bottom"></i> From Company List
                            </button>
                        }
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#assignPublicBuyersModal">
                            <i class="ri-user-add-line me-1 align-bottom"></i> Add from Suppliers
                        </button>
                    </div>
                </div>
                @if (Model.AssignedBuyers.Any())
                {
                    <div class="table-responsive einv-table-scroll-x">
                        <table data-einv-table="company-detail-buyers" class="table table-hover align-middle mb-0 einv-mobile-stack">
                            <thead class="einv-table-head">
                                <tr>
                                    <th>Buyer</th>
                                    <th>TIN / Registration</th>
                                    <th>Industry</th>
                                    <th class="col-action text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var buyer in Model.AssignedBuyers)
                                {
                                    var isPublic = buyer.CompanyName.EndsWith("(Buyers) ");

                                    <tr>
                                        <td data-label="Buyer">
                                            <div class="d-flex flex-column min-w-0">
                                                <span class="fw-medium">@buyer.CompanyName</span>
                                                <small class="text-muted text-break">@buyer.Email</small>
                                            </div>
                                        </td>
                                        <td data-label="TIN / Registration">@buyer.TIN</td>
                                        <td data-label="Industry">@buyer.IndustryClassificationCode</td>
                                        <td class="col-action text-end" data-label="Actions">
                                            <div class="dropdown d-inline-block">
                                                <button class="btn btn-sm einv-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                                    <i class="ri-more-fill align-middle"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    @if (!string.IsNullOrEmpty(buyer.Email))
                                                    {
                                                        <li><a href="mailto:@buyer.Email" class="dropdown-item"><i class="ri-mail-line align-bottom me-2 text-muted"></i> Email Buyer</a></li>
                                                    }
                                                    <li><button type="button" class="dropdown-item text-danger" onclick="unassignBuyer(@Model.PartyInfo.PartyInfoId, @buyer.PartyInfoId, '@(isPublic ? "PC" : "PI")')"><i class="ri-user-unfollow-line align-bottom me-2"></i> Unassign</button></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card-body text-center text-muted py-4">No buyers assigned yet. Add one from your suppliers' buyers.</div>
                }
            </div>
        </div>
    </div>
}

<!-- Assign User Modal -->
<div class="modal fade" id="assignUsersModal" tabindex="-1" aria-labelledby="assignUsersLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignUsersLabel">Assign User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="AssignUser">
                    <input type="hidden" name="supplierId" value="@Model.PartyInfo.PartyInfoId" />
                    @Html.AntiForgeryToken()

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mb-3">
                            <label class="form-label">Select User</label>
                            <select class="form-select" name="SelectedUserId" id="SelectedUserId">
                                <option value="">-- Select User --</option>
                                @foreach (var user in Model.AvailableUsers)
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">User Email Address</label>
                            <input type="email" class="form-control" name="UserEmail" id="UserEmail" placeholder="Enter existing user's email" required />
                            <div class="form-text text-muted">Enter the email address of the user you want to assign. The user must already exist in the system.</div>
                        </div>
                    }

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Assign</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



<!-- Assign Buyer Modal -->
<div class="modal fade" id="assignBuyersModal" tabindex="-1" aria-labelledby="assignBuyersLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignBuyersLabel">Assign Buyer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="AssignBuyer">
                    <input type="hidden" name="supplierId" value="@Model.PartyInfo.PartyInfoId" />

                    <div class="mb-3">
                        <label class="form-label">Select Buyers</label>
                        <div class="border rounded p-2" style="max-height: 250px; overflow-y: auto;">
                            @foreach (var buyer in Model.AvailableBuyers.Where(b => b.TIN.StartsWith("EI0000000000")))
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedBuyerIds" value="@buyer.PartyInfoId" id="cb_@buyer.PartyInfoId">
                                    <label class="form-check-label" for="cb_@buyer.PartyInfoId">
                                        @buyer.CompanyName (@buyer.TIN)
                                    </label>
                                </div>
                            }

                            @foreach (var buyer in Model.AvailableBuyers.Where(b => !b.TIN.StartsWith("EI0000000000")))
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedBuyerIds" value="@buyer.PartyInfoId" id="cb_@buyer.PartyInfoId">
                                    <label class="form-check-label" for="cb_@buyer.PartyInfoId">
                                        @buyer.CompanyName
                                    </label>
                                </div>
                            }
                            @if (!Model.AvailableBuyers.Any())
                            {
                                <div class="text-muted small">No available buyers found.</div>
                            }
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Assign</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- NEW Create User -->
<div class="modal fade" id="assignPublicBuyersModal" tabindex="-1" aria-labelledby="assignPublicBuyersLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignPublicBuyersLabel">Assign From My Buyers</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="AssignPublicBuyer">
                    <input type="hidden" name="supplierId" value="@Model.PartyInfo.PartyInfoId" />

                    <div class="mb-3">
                        <label class="form-label">Select Buyers (Created by Company)</label>
                        <div class="border rounded p-2" style="max-height: 250px; overflow-y: auto;">
                            @foreach (var buyer in Model.AvailablePublicBuyers)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="SelectedPublicBuyerIds" value="@buyer.PublicCustomerId" id="pub_@buyer.PublicCustomerId">
                                    <label class="form-check-label" for="pub_@buyer.PublicCustomerId">
                                        @buyer.CompanyName (@buyer.TIN)
                                    </label>
                                </div>
                            }
                            @if (!Model.AvailablePublicBuyers.Any())
                            {
                                <div class="text-muted small">No available buyers found.</div>
                            }
                        </div>
                        <div class="form-text text-muted mt-2">
                            Only buyers created by this company account are shown here.
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success">Assign</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="changeRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Change User Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="changeRoleModalLabel" class="text-muted mb-4 small"></p>
                <form id="changeRoleForm" method="post" asp-page-handler="ChangeUserRole">
                    <input type="hidden" name="userId" id="changeRoleUserId" />
                    @Html.AntiForgeryToken()
                    <div class="list-group list-group-flush border-top">
                        <button type="button" onclick="submitRoleChange('Supplier')" class="list-group-item list-group-item-action py-3 d-flex justify-content-between">
                            Supplier <i class="ri-briefcase-line text-primary"></i>
                        </button>
                        <button type="button" onclick="submitRoleChange('Buyer')" class="list-group-item list-group-item-action py-3 d-flex justify-content-between">
                            Buyer <i class="ri-shopping-cart-line text-success"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>

    function updatePermission(userId, type, isChecked) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const companyId = '@Model.PartyInfo.PartyInfoId';

        fetch(`./Details?handler=SetSupplierPermission`, {
            method: "POST",
            headers: {
                "RequestVerificationToken": token,
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: `userId=${encodeURIComponent(userId)}&companyId=${companyId}&type=${type}&isChecked=true`
        })
        .then(response => response.json())
        .then(data => {
            if (!data.success) {
                Swal.fire("Error", data.message, "error").then(() => location.reload());
            }
        })
        .catch(() => {
            Swal.fire("Error", "Failed to update permission.", "error").then(() => location.reload());
        });
    }

    function toggleViewOnly(userId, isViewOnly) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const companyId = '@Model.PartyInfo.PartyInfoId';

        fetch(`/Suppliers/Details?handler=ToggleViewOnly`, {
            method: "POST",
            headers: {
                "RequestVerificationToken": token,
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: `userId=${userId}&companyId=${companyId}&isViewOnly=${isViewOnly}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire({ title: "Updated!", icon: "success", timer: 1000, showConfirmButton: false });
            } else {
                Swal.fire("Error!", data.message || "Failed to update.", "error");
            }
        })
        .catch(error => Swal.fire("Error!", "Unexpected error occurred.", "error"));
    }

    document.querySelectorAll('.primary-checkbox').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
            var userId = this.getAttribute('data-userid');
            var companyId = this.getAttribute('data-companyid');
            var isPrimary = this.checked;

            fetch(`/Suppliers/Details?handler=SetPrimaryCompany`, {
                method: "POST",
                headers: {
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value,
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `userId=${userId}&companyId=${companyId}&isPrimary=${isPrimary}`
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire("Updated!", "Primary company has been updated.", "success")
                            .then(() => location.reload()); // Reload to reflect the change
                    } else {
                        Swal.fire("Error!", data.message, "error");
                    }
                })
                .catch(error => Swal.fire("Error!", "Unexpected error occurred.", "error"));
        });
    });

    document.querySelector("#assignBuyersModal form").addEventListener("submit", function (event) {
        event.preventDefault(); // Prevent default form submission

        var formData = new FormData(this);

        fetch(this.action, {
            method: "POST",
            body: formData
        })
            .then(response => {
                if (response.ok) {
                    Swal.fire({
                        icon: "success",
                        title: "Buyer Assigned!",
                        text: "The buyer has been successfully assigned.",
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error!",
                        text: "Failed to assign buyer.",
                        showConfirmButton: true
                    });
                }
            })
            .catch(error => {
                console.error("Error:", error);
                Swal.fire({
                    icon: "error",
                    title: "Error!",
                    text: "An unexpected error occurred.",
                    showConfirmButton: true
                });
            });
    });

    function unassignBuyer(supplierId, buyerId, buyerType) {
        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to remove this buyer?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, remove",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/Suppliers/Details?handler=UnassignBuyer`, {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value,
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: `supplierId=${supplierId}&buyerId=${buyerId}&buyerType=${buyerType}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire("Success", "Buyer removed successfully.", "success")
                            .then(() => location.reload());
                    } else {
                        Swal.fire("Error", data.message, "error");
                    }
                })
                .catch(() => Swal.fire("Error", "Unexpected error occurred.", "error"));
            }
        });
    }
    document.querySelector("#assignUsersModal form").addEventListener("submit", function (event) {
        event.preventDefault(); // Prevent default form submission

        var formData = new FormData(this);

        console.log("🚀 DEBUG: Form Data Sent to Server:");
        for (var pair of formData.entries()) {
            console.log(pair[0] + ": " + pair[1]);  // ✅ Print form values in Console
        }

        fetch(this.action, {
            method: "POST",
            body: formData
        })
            .then(response => {
                return response.text(); // ✅ Ensure response is properly parsed
            })
            .then(text => {
                try {
                    const data = JSON.parse(text);
                    console.log("🔄 DEBUG: Response from Server:", data);

                    if (data.success) {
                        Swal.fire("Success!", "User assigned successfully!", "success").then(() => location.reload());
                    } else {
                        Swal.fire("Error!", data.message, "error");
                    }
                } catch (error) {
                    console.error("❌ ERROR: Invalid JSON response:", text);
                    Swal.fire("Error!", "Unexpected server response.", "error");
                }
            })
            .catch(error => console.error("❌ ERROR:", error));
    });

    function unassignUser(supplierId, userId) {
        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to remove this user?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, remove",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/Suppliers/Details?handler=UnassignUser`, {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value,
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: `supplierId=${supplierId}&userId=${userId}`
                })
                    .then(response => response.text())  // ✅ Handle plain text response
                    .then(text => {
                        try {
                            const data = JSON.parse(text); // ✅ Ensure response is parsed correctly
                            console.log("DEBUG: Server Response:", data);

                            if (data.success) {
                                Swal.fire("Success!", "User removed successfully.", "success")
                                    .then(() => location.reload());
                            } else {
                                Swal.fire("Error!", data.message || "Failed to unassign user.", "error");
                            }
                        } catch (error) {
                            console.error("❌ ERROR: Invalid JSON response:", text);
                            Swal.fire("Error!", "Unexpected server response.", "error");
                        }
                    })
                    .catch(error => {
                        console.error("❌ ERROR:", error);
                        Swal.fire("Error!", "Unexpected error occurred while communicating with the server.", "error");
                    });
            }
        });
    }
    
    document.querySelector("#assignPublicBuyersModal form").addEventListener("submit", function (event) {
        event.preventDefault(); 

        var formData = new FormData(this);

        fetch(this.action, {
            method: "POST",
            body: formData
        })
        .then(response => response.json()) // The new handler returns JSON
        .then(data => {
            if (data.success) {
                Swal.fire({
                    icon: "success",
                    title: "Buyer Assigned!",
                    text: data.message,
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: "error",
                    title: "Error!",
                    text: data.message || "Failed to assign buyer.",
                    showConfirmButton: true
                });
            }
        })
        .catch(error => {
            console.error("Error:", error);
            Swal.fire({
                icon: "error",
                title: "Error!",
                text: "An unexpected error occurred.",
                showConfirmButton: true
            });
        });
    });
    function openChangeRoleModal(id, name) {
        document.getElementById('changeRoleUserId').value = id;
        document.getElementById('changeRoleModalLabel').innerText = "Select a new role for " + name;
        new bootstrap.Modal(document.getElementById('changeRoleModal')).show();
    }

    function submitRoleChange(roleName) {
        var form = document.getElementById("changeRoleForm");
        var formData = new FormData(form);
        formData.append("roleName", roleName); // Pass the selected role

        fetch(form.action, {
            method: "POST",
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire({ icon: "success", title: "Role Updated!", text: data.message, timer: 1500, showConfirmButton: false })
                .then(() => location.reload());
            } else {
                Swal.fire("Error!", data.message, "error");
            }
        })
        .catch(error => Swal.fire("Error!", "Unexpected error occurred.", "error"));
    }
</script>

