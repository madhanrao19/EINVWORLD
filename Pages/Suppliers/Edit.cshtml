@page
@model eInvWorld.Pages.Suppliers.EditModel

@{
    ViewData["Title"] = "Edit Company";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-pretitle">Company Management</div>
            <h2 class="page-title">@((Model.From == "lead") ? "Edit Lead Info" : "Company Profile")</h2>
            <p class="text-muted mt-1 mb-0">Manage this company's legal, tax, and fiscal identity for e-invoicing compliance.</p>
        </div>
    </div>
</div>

@if (Model.From != "lead")
{
    var workspaceTabsModel = new CompanyWorkspaceTabsModel { PartyInfoId = Model.PartyInfo.PartyInfoId, Active = "profile", From = Model.From };
    <partial name="_CompanyWorkspaceTabs" model="workspaceTabsModel" />
}

<form method="post" enctype="multipart/form-data" onsubmit="return checkValidationBeforeSubmit();">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div id="saved-data-notice" class="alert alert-warning d-none" role="alert">
        <i class="ri-error-warning-line align-bottom me-1"></i>
        Some saved details don't meet the current rules. Please correct the highlighted fields before saving: <strong class="saved-data-fields"></strong>
    </div>
    <input type="hidden" asp-for="PartyInfo.PartyInfoId" />
    <input type="hidden" asp-for="PartyInfo.CreatedBy" />

    <div class="row row-cards">
        <div class="col-12 col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Organization Logo</h3>
                </div>
                <div class="card-body text-center">
                    <div class="position-relative d-inline-block">
                        <div class="avatar avatar-xl rounded mb-3" style="width:140px;height:140px;">
                            <img id="companylogo-img"
                                 class="rounded w-100 h-100 object-fit-cover"
                                 src="@Url.Content(EINVWORLD.Helpers.LogoUrl.For(Model.PartyInfo.LogoPath))"
                                 data-saved="@(string.IsNullOrEmpty(Model.PartyInfo.LogoPath) ? "" : Url.Content(EINVWORLD.Helpers.LogoUrl.For(Model.PartyInfo.LogoPath)))" />
                        </div>
                    </div>
                    <div class="text-muted small mb-3">PNG or JPG, shown on invoices. Square images look best.</div>
                    <span asp-validation-for="LogoFile" class="text-danger d-block mb-2"></span>
                    <label for="company-logo-input" class="btn btn-outline-primary w-100">
                        <i class="ri-upload-2-line me-1"></i> Upload
                    </label>
                    <input class="d-none" name="LogoFile" id="company-logo-input" type="file" accept="image/png, image/jpeg">
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Legal Details</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.CompanyName" class="form-label">Company Name (Legal Entity)</label>
                            <input asp-for="PartyInfo.CompanyName" class="form-control" placeholder="e.g. Acme Sdn Bhd" required />
                            <span asp-validation-for="PartyInfo.CompanyName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.TIN" class="form-label">Tax Identification Number (TIN)</label>
                            <div class="input-group">
                                <input asp-for="PartyInfo.TIN" class="form-control" placeholder="eg: C123456789" list="tinOptions" required readonly="@Model.TinLocked" />
                                <button class="btn btn-info btn-validate" type="button" onclick="validateLHDN()">Validate with LHDN</button>
                                <datalist id="tinOptions">
                                    <option value="EI00000000010">General Public</option>
                                    <option value="EI00000000020">Foreign Buyer</option>
                                    <option value="EI00000000030">Foreign Supplier</option>
                                    <option value="EI00000000040">Government</option>
                                </datalist>
                            </div>
                            @if (Model.TinLocked)
                            {
                                <div class="form-text text-warning">Locked — the TIN identifies this company on every invoice. Ask an administrator to change it.</div>
                            }
                            <span asp-validation-for="PartyInfo.TIN" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.RegTypeCode" class="form-label">Registration Type</label>
                            <select asp-for="PartyInfo.RegTypeCode" class="form-select select2" asp-items="Model.IdTypesOptions" required>
                                <option value="">-- Select ID Type --</option>
                            </select>
                            <span asp-validation-for="PartyInfo.RegTypeCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.RegNo" class="form-label">Registration Number</label>
                            <input asp-for="PartyInfo.RegNo" class="form-control" placeholder="e.g. 202301012345" required />
                            <span asp-validation-for="PartyInfo.RegNo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PartyInfo.IndustryClassificationCode" class="form-label">Industry (MSIC Code)</label>
                        <select asp-for="PartyInfo.IndustryClassificationCode" class="form-select select2" id="msicSelect" required>
                            <option value="">-- Select MSIC Code --</option>
                            @foreach (var msic in Model.MSICOptions)
                            {
                                <option value="@msic.Value" data-description="@msic.Text">
                                    @msic.Text
                                </option>
                            }
                        </select>
                        <span asp-validation-for="PartyInfo.IndustryClassificationCode" class="text-danger"></span>
                    </div>
                    <div class="mb-0" id="bizDescriptionContainer">
                        <label asp-for="PartyInfo.BizDescription" class="form-label"></label>
                        <textarea asp-for="PartyInfo.BizDescription" class="form-control" rows="3" id="PartyInfo_BizDescription"></textarea>
                        <span asp-validation-for="PartyInfo.BizDescription" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Tax Information</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.SST" class="form-label">Sales &amp; Service Tax (SST) No.</label>
                            <input asp-for="PartyInfo.SST" class="form-control" placeholder="e.g. W10-1808-99999999 or NA" required />
                            <span asp-validation-for="PartyInfo.SST" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.TTX" class="form-label">Tourism Tax (TTx) No.</label>
                            <input asp-for="PartyInfo.TTX" class="form-control" placeholder="e.g. TTX-XXXXXXX or NA" required />
                            <span asp-validation-for="PartyInfo.TTX" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.OldRegNo" class="form-label">Old Registration Number</label>
                            <input asp-for="PartyInfo.OldRegNo" class="form-control" placeholder="Previous business registration number" />
                            <span asp-validation-for="PartyInfo.OldRegNo" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Registered Address</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="PartyInfo.Addr1" class="form-label">Street Address</label>
                        <textarea asp-for="PartyInfo.Addr1" class="form-control" rows="3" placeholder="Enter full street address..."></textarea>
                        <span asp-validation-for="PartyInfo.Addr1" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="PartyInfo.PostalCode" class="form-label">Postal Code</label>
                            <input asp-for="PartyInfo.PostalCode" class="form-control" required />
                            <span asp-validation-for="PartyInfo.PostalCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PartyInfo.CityName" class="form-label">City</label>
                            <input asp-for="PartyInfo.CityName" class="form-control" required />
                            <span asp-validation-for="PartyInfo.CityName" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="stateSelect" class="form-label">State / Province</label>
                            <select asp-for="PartyInfo.StateCode" class="form-select select2" asp-items="Model.StateOptions" id="stateSelect">
                                <option value="">-- Select State --</option>
                            </select>
                            <input type="text" id="PartyInfo_StateCode_Text" name="PartyInfo.StateCode" aria-label="State / Province"
                                   value="@Model.PartyInfo.StateCode"
                                   class="form-control d-none" disabled maxlength="100"
                                   placeholder="Enter state / province" />
                            <span asp-validation-for="PartyInfo.StateCode" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="countrySelect" class="form-label">Country</label>
                            <select asp-for="PartyInfo.CountryCode" class="form-select select2" asp-items="Model.CountryOptions" id="countrySelect" required>
                                <option value="">-- Select Country --</option>
                            </select>
                            <span asp-validation-for="PartyInfo.CountryCode" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Contact Details</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.Email" class="form-label">Primary Email</label>
                            <input asp-for="PartyInfo.Email" class="form-control" type="email" placeholder="e.g. billing@company.com" required />
                            <span asp-validation-for="PartyInfo.Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.PhoneNo" class="form-label">Phone Number</label>
                            <input asp-for="PartyInfo.PhoneNo" class="form-control"
                                   placeholder="e.g. +60376602222"
                                   pattern="^\+[0-9]{8,14}$"
                                   title="Enter a valid phone number starting with '+' and numbers only (e.g. +60376602222)"
                                   required />
                            <span asp-validation-for="PartyInfo.PhoneNo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.FaxNo" class="form-label">Fax Number</label>
                            <input asp-for="PartyInfo.FaxNo" class="form-control" maxlength="20" placeholder="e.g. +60376602323" pattern="^\+[0-9]{8,14}$" title="Enter a valid fax number starting with + and numbers only (e.g. +60376602323)" />
                            <span asp-validation-for="PartyInfo.FaxNo" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h3 class="card-title mb-0">Banking &amp; Payment</h3>
                    <a asp-page="/Profile/BankAccounts" asp-route-companyId="@Model.PartyInfo.PartyInfoId" class="btn btn-sm btn-outline-primary">
                        <i class="ri-bank-line align-bottom me-1"></i> All bank accounts
                    </a>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.BankAccountNo" class="form-label">Default Bank Account Number</label>
                            <input asp-for="PartyInfo.BankAccountNo" class="form-control" autocomplete="off"
                                   placeholder="@(string.IsNullOrEmpty(Model.MaskedBankAccountNo) ? "Bank account number for payments" : Model.MaskedBankAccountNo)" />
                            @if (!string.IsNullOrEmpty(Model.MaskedBankAccountNo))
                            {
                                <div class="form-text">Leave blank to keep the current bank account number unchanged.</div>
                            }
                            <span asp-validation-for="PartyInfo.BankAccountNo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PartyInfo.BankName" class="form-label">Bank Name</label>
                            <input asp-for="PartyInfo.BankName" class="form-control" placeholder="Name of the bank" />
                            <span asp-validation-for="PartyInfo.BankName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label asp-for="PartyInfo.PaymentTerms" class="form-label">Default Payment Terms</label>
                            <input asp-for="PartyInfo.PaymentTerms" class="form-control" placeholder="e.g. 30 days, Immediate, COD" maxlength="100" />
                            <span asp-validation-for="PartyInfo.PaymentTerms" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PartyInfo.Attention" class="form-label">Attention To</label>
                            <input asp-for="PartyInfo.Attention" class="form-control" placeholder="Person to whom invoices should be addressed" />
                            <span asp-validation-for="PartyInfo.Attention" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">Internal Notes</h3>
                </div>
                <div class="card-body">
                    <label asp-for="PartyInfo.Remarks" class="form-label">Notes (visible to your team only)</label>
                    <textarea asp-for="PartyInfo.Remarks" class="form-control" rows="3" placeholder="Account notes, special handling..."></textarea>
                    <span asp-validation-for="PartyInfo.Remarks" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between">
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-outline-secondary" asp-page="@(Model.From == "lead" ? "/Lead/List" : "./Index")">
                        <i class="ri-arrow-left-line me-1"></i> Back to List
                    </a>
                }
                else
                {
                    <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.PartyInfo.PartyInfoId">
                        <i class="ri-arrow-left-line me-1"></i> Back to Company
                    </a>
                }
                <button type="submit" class="btn btn-primary">
                    <i class="ri-save-line me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @* MSIC → description fill, logo preview and Select2 come from the same script as Create. *@
    <script src="~/js/create-company.js" asp-append-version="true"></script>
    <script src="~/js/state-by-country.js" asp-append-version="true"></script>
    <script src="~/js/lhdn-tin-validate.js" asp-append-version="true"></script>
    <script>
        $(function () {
            bindStateToCountry('countrySelect', 'stateSelect', 'PartyInfo_StateCode_Text');
            flagInvalidSavedFields(document.getElementById('saved-data-notice').closest('form'));
        });
        // The saved TIN/ID were validated when the company was created; saving is gated again only once they change.
        initLhdnTinValidation({ tinId: 'PartyInfo_TIN', regTypeId: 'PartyInfo_RegTypeCode', regNoId: 'PartyInfo_RegNo', url: '@Url.Page("/Suppliers/Create", "ValidateTIN")', entityLabel: 'Company', startValidated: @(HttpMethods.IsGet(ViewContext.HttpContext.Request.Method) ? "true" : "false") });
    </script>
}
