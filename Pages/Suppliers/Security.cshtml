@page
@model eInvWorld.Pages.Suppliers.SecurityModel

@{
    ViewData["Title"] = "Security";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-pretitle">Company Management</div>
            <h2 class="page-title">Security</h2>
            <p class="text-muted mt-1 mb-0">Two-factor status and recent account activity for this company.</p>
        </div>
    </div>
</div>

@{
    var workspaceTabsModel = new CompanyWorkspaceTabsModel { PartyInfoId = Model.PartyInfo.PartyInfoId, Active = "security", From = Model.From };
}
<partial name="_CompanyWorkspaceTabs" model="workspaceTabsModel" />

<partial name="_TwoFactorCard" model="Model.CurrentUserTwoFactorEnabled" />

@if (Model.CanViewTeamSecurity)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header">
            <h3 class="card-title">Team Security Status</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive einv-table-scroll-x">
                <table class="table align-middle mb-0">
                    <thead class="einv-table-head">
                        <tr>
                            <th scope="col">Member</th>
                            <th scope="col">Two-Factor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.TeamSecurityStatus)
                        {
                            <tr>
                                <td data-label="Member">
                                    <span class="fw-semibold d-block">@m.FullName</span>
                                    <span class="text-muted small">@m.Email</span>
                                </td>
                                <td data-label="Two-Factor">
                                    <span class="einv-badge @(m.TwoFactorEnabled ? "einv-badge-success" : "einv-badge-neutral")">
                                        @(m.TwoFactorEnabled ? "Enabled" : "Not Enabled")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header">
            <h3 class="card-title">Recent Company Activity</h3>
        </div>
        <div class="card-body">
            @if (Model.RecentActivity.Any())
            {
                <div class="table-responsive einv-table-scroll-x">
                    <table data-einv-table="company-security-activity" class="table align-middle mb-0 einv-mobile-stack" id="securityActivityTable">
                        <thead class="einv-table-head">
                            <tr>
                                <th scope="col">When</th>
                                <th scope="col" data-col-data>Action</th>
                                <th scope="col">By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.RecentActivity)
                            {
                                <tr>
                                    <td data-label="When">@entry.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td data-label="Action"><span class="einv-badge einv-badge-neutral">@entry.Action</span></td>
                                    <td data-label="By">@(entry.UserName ?? "System")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No recent activity recorded for this company yet.</p>
            }
        </div>
    </div>
}
