@page
@model eInvWorld.Pages.Templates.TemplateListsModel
@inject eInvWorld.Helpers.DropdownHelper DropdownHelper

@{
    ViewData["Title"] = "Invoice Templates";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="einv-page-title mb-1">Invoice Templates</h1>
                <p class="text-muted mb-0">Create invoices faster using saved supplier, buyer, item, tax and payment details.</p>
            </div>
            <button type="button" class="btn btn-danger" id="remove-actions" onClick="deleteMultiple()" data-bs-toggle="tooltip"
                    data-bs-placement="top" title="Select at least one template to enable">
                <i class="ri-delete-bin-6-line align-bottom me-1"></i> Delete Selected
            </button>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 h-100 border-0 shadow-sm">
            <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total Templates</p>
            <h3 class="fw-bold mb-0">@Model.InvoiceTemplate.Count</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 border-0 shadow-sm">
            <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Favourites</p>
            <h3 class="fw-bold mb-0 text-warning">@Model.FavoriteCount</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100 border-0 shadow-sm">
            <p class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Recurring Linked</p>
            <h3 class="fw-bold mb-0">@Model.RecurringLinkCountByTemplate.Values.Sum()</h3>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm" id="customerList">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="templateTable">
                <thead class="einv-table-head">
                        <tr>
                            <th scope="col" class="col-checkbox">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                </div>
                            </th>
                            <th class="sort col-template-name" data-sort="template_name">Template</th>
                            <th class="sort" data-sort="doc_type">Doc Type</th>
                            <th class="sort" data-sort="customer_name">Buyer</th>
                            <th>Items</th>
                            <th>Estimated Total</th>
                            <th>Recurring</th>
                            <th class="sort" data-sort="action">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="list form-check-all">
                        @foreach (var item in Model.InvoiceTemplate) {
                            var recurringCount = Model.RecurringLinkCountByTemplate.TryGetValue(item.Id, out var rc) ? rc : 0;
                        <tr>
                            <td class="col-checkbox">
                                <div class="form-check">
                                    <input class="form-check-input template-checkbox" type="checkbox" name="SelectedTemplateIds" value="@item.Id">
                                </div>
                            </td>

                            <td class="template_name col-template-name">
                                <form method="post" asp-page-handler="ToggleFavorite" asp-route-templateId="@item.Id" class="d-inline">
                                    <button type="submit" class="btn btn-link p-0 border-0" title="Toggle Favorite">
                                        @if (item.IsFavorite)
                                        {
                                            <i class="ri-star-fill text-warning fs-16"></i>
                                        }
                                        else
                                        {
                                            <i class="ri-star-line text-muted fs-16"></i>
                                        }
                                    </button>
                                </form>
                                <span class="ms-2 fw-semibold">@item.TemplateName</span>
                                <span class="text-muted small d-block ms-4">@item.Supplier?.CompanyName</span>
                            </td>
                            <td class="doc_type">
                                <span class="badge bg-light text-body border">@DropdownHelper.GetEInvoiceTypeDescription(item.DocTypeCode)</span>
                            </td>
                            <td class="customer_name">@(item.Customer != null ? item.Customer.CompanyName : item.PublicCustomer?.CompanyName)</td>
                            <td>@item.InvoiceLines.Count item@(item.InvoiceLines.Count == 1 ? "" : "s")</td>
                            <td class="fw-semibold">@item.Currency @(item.TotalAmountIncTax?.ToString("N2") ?? "0.00")</td>
                            <td>
                                @if (recurringCount > 0)
                                {
                                    <span class="badge rounded-pill bg-primary-soft text-primary"><i class="ri-repeat-2-line align-bottom"></i> @recurringCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td>
                                <ul class="list-inline hstack gap-2 mb-0">
                                    <li class="list-inline-item" title="Use Template">
                                        <a href="/Invoices/CreateInvoice?templateId=@item.Id" class="text-success d-inline-block">
                                            <i class="ri-play-circle-fill fs-16"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item edit" data-bs-toggle="tooltip" data-bs-trigger="hover" data-bs-placement="top" title="Edit">
                                        <a href="/Invoices/InvoiceEdit?templateId=@item.Id" class="text-primary d-inline-block">
                                             <i class="ri-pencil-fill fs-16"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete">
                                        <a href="javascript:void(0);" class="text-danger d-inline-block remove-item-btn"
                                           data-template-id="@item.Id" onclick="confirmDeleteSingle(@item.Id)">
                                           <i class="ri-delete-bin-5-fill fs-16"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item" data-bs-toggle="tooltip" data-bs-trigger="hover" data-bs-placement="top" title="Set Recurring">
                                        <a href="/RecurringInvoices/Create?templateId=@item.Id" class="text-info d-inline-block">
                                           <i class="ri-calendar-todo-line fs-16"></i>
                                        </a>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                        }
                        @if (!Model.InvoiceTemplate.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="ri-file-list-3-line fs-24 d-block mb-2"></i>
                                    No templates yet. Save one from Create e-Invoice.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
        </div>

        <!-- Delete Confirmation Modal -->
        <div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" id="deleteForm">
                        <input type="hidden" name="DeleteTemplateId" id="deleteTemplateId" />
                        <input type="hidden" name="SelectedTemplateIdsRaw" id="bulkIds" />

                        <div class="modal-header border-0">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body">
                            <div class="mt-2 text-center">
                                <i class="ri-error-warning-line text-warning" style="font-size: 4rem;" aria-hidden="true"></i>
                                <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                                    <h4>Are you sure?</h4>
                                    <p class="text-muted mx-4 mb-0">
                                        Do you really want to delete the selected template(s)?<br />
                                        This action cannot be undone.
                                    </p>
                                </div>
                            </div>

                            <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                                <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn w-sm btn-danger" id="delete-confirm-btn">Yes, Delete It!</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>
<!-- list.js min js -->
<script src="~/assets/libs/list.js/list.min.js"></script>
<script src="~/assets/libs/list.pagination.js/list.pagination.min.js"></script>


<script>

    document.getElementById("checkAll").addEventListener("change", function () {
        const checkboxes = document.querySelectorAll(".template-checkbox");
        checkboxes.forEach(cb => cb.checked = this.checked);
    });

    function confirmDeleteSingle(templateId) {
        document.getElementById("deleteForm").action = "?handler=DeleteSingle";
        document.getElementById("deleteTemplateId").value = templateId;
        document.getElementById("bulkIds").value = "";
        new bootstrap.Modal(document.getElementById("deleteRecordModal")).show();
    }

    function deleteMultiple() {
        const selected = Array.from(document.querySelectorAll('.template-checkbox:checked'))
            .map(cb => cb.value);

        if (selected.length === 0) {
            Swal.fire({ icon: "warning", title: "No templates selected", text: "Please select at least one template to delete." });
            return;
        }

        document.getElementById("deleteForm").action = "?handler=DeleteMultiple";
        document.getElementById("deleteTemplateId").value = "";
        document.getElementById("bulkIds").value = selected.join(",");
        new bootstrap.Modal(document.getElementById("deleteRecordModal")).show();
    }

</script>

@if (TempData["StatusMessage"] != null)
{
    <script>
        window.addEventListener("DOMContentLoaded", () => {
            const toast = document.createElement("div");
            toast.className = "toast align-items-center text-white bg-success border-0 position-fixed bottom-0 end-0 m-3 show";
            toast.setAttribute("role", "alert");
            toast.innerHTML = `
                        <div class="d-flex">
                            <div class="toast-body">
        @TempData["StatusMessage"]
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>`;
            document.body.appendChild(toast);
            new bootstrap.Toast(toast).show();
        });
    </script>
}
