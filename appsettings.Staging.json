{
  "AppInfo": {
    "Environment": "Staging"
  },

  // Off for Staging: same network-hang mitigation as appsettings.Development.json — on networks that
  // can't reach googletagmanager.com the connection doesn't fail fast, it hangs 20-60s per page load
  // (confirmed via HAR 2026-08-01). QA/staging traffic shouldn't pollute real GTM analytics either way.
  // Production is unaffected — this override applies to Staging only.
  "GoogleAnalytics": {
    "MeasurementId": ""
  },

  "EmailConfiguration": {
    "EmailBaseUrls": {
      "BaseUrl": "https://staging.einvworld.com/"
    },
    "CustomerSubmission": {
      "Subject": "Staging | 📩 New Customer Registration Submitted | {{CompanyName}}"
    },
    "RegisterAccountEmailSettings": {
      "Subject": "Staging | eInvWorld | Confirm Your Account"
    },
    "ContactUsEmailSettings": {
      "AdminSubject": "Staging | eInvWorld | New Contact Form Submission",
      "UserSubject": "Staging | eInvWorld | Thank You for Contacting Us"
    },
    "ValidatedEmailSettings": {
      "Subject": "Staging | eInvWorld | EInvoice Validated"
    },
    "NewInvoiceReceivedEmailSettings": {
      "Subject": "Staging | eInvWorld | New e-Invoice Received"
    },
    "RequestRejectEmailSettings": {
      "Subject": "Staging | eInvWorld | Request Reject"
    },
    "RequestCancelEmailSettings": {
      "Subject": "Staging | eInvWorld | Cancelled Invoice"
    }
  },
  "PDFGenerationSettings": {
    "BaseUrl": "https://staging.einvworld.com"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Args": {
          "path": "E:\\EINVWORLD_STAGING\\Logs\\log.txt"
        }
      }
    ]
  },
  "FilePathConfig": {
    "BasePath": "E:\\EINVWORLD\\Documents",
    "DraftFolder": "E:\\EINVWORLD\\Documents\\Draft",
    "SubmittedFolder": "E:\\EINVWORLD\\Documents\\Submitted",
    "ValidFolder": "E:\\EINVWORLD\\Documents\\Valid",
    "InvalidFolder": "E:\\EINVWORLD\\Documents\\Invalid",
    "CancelledFolder": "E:\\EINVWORLD\\Documents\\Cancelled",
    "InvoiceCounterFilePath": "E:\\EINVWORLD\\Documents\\Counters",
    "JsonGeneratedFolder": "E:\\EINVWORLD\\Documents\\JsonGenerated",
    "GeneratedPdfFolder": "E:\\EINVWORLD\\Documents\\GeneratedPdf",
    "ResourceImagesFolder": "E:\\EINVWORLD\\Documents\\Resources\\Images",
    "EditorUploadsFolder": "E:\\EINVWORLD\\Documents\\Resources\\EditorUploads",
    "CompanyLogosFolder": "E:\\EINVWORLD\\Documents\\Companies\\Logos"
  }
}