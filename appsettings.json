{
  "AppInfo": {
    "Name": "eInvWorld",
    "Version": "v1.26.0",
    "Environment": "Staging"
  },
  // Encryption key ring location. MUST point OUTSIDE the App folder on the server (e.g. D:\\EINVWORLD\\Keys)
  // so a redeploy that clears App\ does not wipe the keys (which would log out all users and break sessions).
  // Set on the server via this value or the env var DataProtection__KeyRingPath. Empty = in-app fallback.
  "DataProtection": {
    "KeyRingPath": ""
  },
  // Security toggles. EnforceAdminMfa (default true) redirects any Admin without 2FA enabled to the
  // authenticator-setup page until they enroll (block-until-enrolled). Set false only as an emergency
  // escape hatch — admins can always self-enroll, so there is no hard lockout.
  // Default demo users (admin@/supplier@/buyer@einvworld.com). Seeded on startup ONLY when
  // SeedDefaultUsers=true. They have well-known passwords, so this is forced to FALSE in
  // appsettings.Production.json. Override the passwords via Seeding:DefaultAdminPassword etc. (env/secrets).
  "Seeding": {
    "SeedDefaultUsers": true
  },
  "Security": {
    "EnforceAdminMfa": false
    // HttpsRedirectPort (HTTP->HTTPS redirect) is intentionally NOT set here so the smart default applies:
    //   • ForwardedHeaders enabled (behind a TLS-terminating proxy / Cloudflare Tunnel) -> redirect OFF
    //     (the edge enforces HTTPS, e.g. Cloudflare "Always Use HTTPS"); an in-app redirect would loop.
    //   • Direct IIS HTTPS binding (ForwardedHeaders disabled) -> redirect ON, port 443.
    // To force it, add "HttpsRedirectPort": <port> (e.g. 443) to turn it on, or 0 to turn it off.
  },
  // Reverse-proxy / tunnel forwarded-header handling. Enable when TLS is terminated upstream and the app
  // is reached over plain HTTP (e.g. Cloudflare Tunnel -> http://localhost). The app then trusts
  // X-Forwarded-Proto (original scheme = https: correct cookies/redirects/HSTS) and X-Forwarded-For (real
  // client IP: correct per-IP rate limiting + audit/log IPs). Only headers from KnownProxies are honoured.
  // cloudflared on the same host = loopback (always trusted). Add KnownProxies if it runs elsewhere.
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  // Import REST API. SECRET — set Api__Key via env var / user-secrets on the server to enable
  // POST /api/import/validate for an external ERP (header X-Api-Key). Empty = API disabled.
  "Api": {
    "Key": ""
  },
  // Inbound per-IP rate limiting (a generous DoS backstop; health probes are exempt). Increase
  // PermitsPerMinute if many users share one office NAT IP, or set Enabled=false to turn it off.
  "RateLimiting": {
    "Enabled": true,
    "PermitsPerMinute": 1200,
    // Stricter per-user cap on /Admin/InvoiceSync (each post enqueues background work).
    "AdminSyncPerMinute": 10
  },
  // Optional email alert when background sync jobs pile up in the Failed (dead-letter) state. OFF by
  // default; set Enabled=true and a RecipientEmail to use it. Throttled (re-alerts only on growth or after
  // CooldownHours) so it never spams.
  "SyncFailureAlerts": {
    "Enabled": false,
    "RecipientEmail": "",
    "Threshold": 1,
    "CheckMinutes": 15,
    "CooldownHours": 6
  },
  // Optional email alert as the LHDN XAdES signing certificate (LHDNApiConfig:CertPath) nears expiry.
  // OFF by default; only relevant once LHDNApiConfig:SigningEnabled=true. Set Enabled=true and a
  // RecipientEmail to use it. Throttled (re-alerts only after CooldownHours) so it never spams.
  "CertExpiryAlerts": {
    "Enabled": false,
    "RecipientEmail": "",
    "WarnDays": 30,
    "CheckHours": 24,
    "CooldownHours": 24
  },
  // Daily additive sync of the LHDN code tables (unit/currency/country/state/tax/payment/
  // classification/MSIC/e-invoice types) from the official SDK JSON files. Inserts new codes and
  // updates renamed descriptions; NEVER deletes or deactivates rows, and admin IsActive choices
  // are preserved. Set Enabled=false to manage code tables manually via Admin -> Codes only.
  "CodeTableSync": {
    "Enabled": true,
    "BaseUrl": "https://sdk.myinvois.hasil.gov.my/files/",
    "IntervalHours": 24,
    "StartupDelayMinutes": 5
  },
  // Outbound webhooks to customer ERPs when an invoice reaches a terminal LHDN status (Valid/Cancelled/
  // Rejected/Invalid). OFF by default. Set Enabled=true and register a subscription in Admin -> Webhooks.
  // Deliveries run on the durable job queue (retry/backoff/dead-letter) and are HMAC-SHA256 signed.
  "Webhooks": {
    "Enabled": false,
    "DeliveryTimeoutSeconds": 15,
    "BlockPrivateNetworks": true,
    "RequireHttps": true
  },
  "Turnstile": {
    "SiteKey": "1x00000000000000000000AA",
    "_SecretKey_comment": "SECRET — set via user-secrets (dev) or env var Turnstile__SecretKey (server). See SECRETS-SETUP.md",
    "SecretKey": "",
    "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  },
  "_ConnectionStrings_comment": "SECRETS — set via user-secrets (dev) or env vars ConnectionStrings__DefaultConnection / ConnectionStrings__WebsiteDb (server). Include Encrypt=True explicitly in production strings (see SECRETS-SETUP.md).",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "WebsiteDb": ""
  },
  "GoogleAnalytics": {
    "MeasurementId": "GTM-W2S2NPH7"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "E:\\EINVWORLD_STAGING\\Logs\\log.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 365,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "_comment": "Writes app logs to the SystemLogs DB table (shown on Admin > System Logs). This sink OWNS the table and auto-creates it (autoCreateSqlTable=true); EF does NOT manage it. The columnOptionsSection below defines the schema — the admin Logs page reads it via Database.SqlQueryRaw<SystemLog> (DTO: Models/SystemLog.cs). Keep the two in sync.",
        "Args": {
          "connectionString": "DefaultConnection",
          "tableName": "SystemLogs",
          "autoCreateSqlTable": true,
          "columnOptionsSection": {
            "removeStandardColumns": [ "MessageTemplate", "Properties" ],
            "addStandardColumns": [ "LogEvent" ],
            "additionalColumns": [
              {
                "ColumnName": "IPAddress",
                "DataType": "nvarchar",
                "DataLength": 50
              },
              {
                "ColumnName": "UserName",
                "DataType": "nvarchar",
                "DataLength": 256
              }
            ]
          }
        }
      }
    ],

    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "CodeFilePaths": {
    "ClassificationCodes": "codes/ClassificationCodes.json",
    "CountryCodes": "codes/CountryCodes.json",
    "CurrencyCodes": "codes/CurrencyCodes.json",
    "EInvoiceTypes": "codes/EInvoiceTypes.json",
    "MSICSubCategoryCodes": "codes/MSICSubCategoryCodes.json",
    "PaymentMethods": "codes/PaymentMethods.json",
    "StateCodes": "codes/StateCodes.json",
    "TaxTypes": "codes/TaxTypes.json",
    "UnitTypes": "codes/UnitTypes.json"
  },
  "EmailConfiguration": {
    "Default": {
      "SmtpServer": "dgrpmail.datamationgroup.com",
      "SmtpPort": "587",
      // SmtpUsername/SmtpPassword and GlobalBccEmail are environment-specific — set them per server via
      // env vars (EmailConfiguration__Default__SmtpUsername, __SmtpPassword, __GlobalBccEmail) or
      // user-secrets, never committed here. Left blank so a real value is a deliberate deploy step.
      "SmtpUsername": "no-reply@einvworld.com",
      "SmtpPassword": "",
      "FromEmailName": "eInvWorld Staging",
      "DisallowedEmailDomains": "gmail.com, yahoo.com, hotmail.com",
      "GlobalBccEmail": "dm_it@datamationgroup.com"

    },
    "EmailBaseUrls": {
      "BaseUrl": "https://staging.einvworld.com/",
      "InvoiceBaseUrl": "Invoices/InvoiceDetails2/",
      "AccountBaseUrl": "login",
      "RegisterAccBaseUrl": "register",
      "ContactBaseUrl": "contact"
    },
    "CustomerSubmission": {
      "ReceiverEmail": "dm_it@datamationgroup.com",
      "Subject": "Staging | 📩 New Customer Registration Submitted | {{CompanyName}}"
    },
    "RegisterAccountEmailSettings": {
      "Subject": "Staging | eInvWorld | Confirm Your Account"
    },
    "ContactUsEmailSettings": {
      "ReceiverEmail": "test@einvworld.com", //Admin email
      "AdminSubject": "Staging | eInvWorld | New Contact Form Submission",
      "UserSubject": "Staging | eInvWorld | Thank You for Contacting Us"
    },
    "ValidatedEmailSettings": {
      "Subject": "Staging | eInvWorld | EInvoice Validated"
    },
    "NewInvoiceReceivedEmailSettings": {
      "Subject": "Staging | eInvWorld | New e-Invoice Received",
      // Only notify for an invoice this recent (by IssueDate/DateTimeReceived) — avoids emailing
      // buyers about old invoices that just happen to be new to EINVWORLD's database (e.g. a large
      // historical Admin "Import All" backfill).
      "MaxAgeDaysForNotification": 7
    },
    "RequestRejectEmailSettings": {
      "Subject": "Staging | eInvWorld | Request Reject"
    },
    "RequestCancelEmailSettings": {
      "Subject": "Staging | eInvWorld | Cancelled Invoice"
    },
    "Notifications": {
      "EnableRejectionEmails": true,
      "EnableCancellationEmails": true,
      "EnableValidatedEmails": true,
      "EnableCustomerInfoEmails": true,
      "EnableNewInvoiceReceivedEmails": true
    }
  },
  "InvoiceStatusUpdaterSettings": {
    "Enabled": true,
    "PollingIntervalSeconds": 600,
    "UiRefreshIntervalSeconds": 30,
    "UiLhdnCooldownSeconds": 60,
    "BackgroundImportLookbackDays": 7
  },
  "PDFGenerationSettings": {
    "BaseUrl": "https://staging.einvworld.com",
    "PlaywrightRenderDelayMs": 1000,
    // Max seconds to wait for a DinkToPdf (wkhtmltopdf) render before abandoning it (so a hung render
    // can't block the request forever). Default 60.
    "TimeoutSeconds": 60,
    // PDF engine: "DinkToPdf" (default) or "Puppeteer" (headless Chromium, maintained, no native DLL).
    // Switch to "Puppeteer" to evaluate its output; set ChromiumExecutablePath on an offline server.
    "Engine": "DinkToPdf",
    "ChromiumExecutablePath": ""
  },
  "LHDNApiConfig": {
    "BaseUrl": "https://preprod-api.myinvois.hasil.gov.my/",
    "ValidationBaseUrl": "https://preprod.myinvois.hasil.gov.my/",
    "TokenEndpoint": "/connect/token",
    "ClientId": "e45926d3-bb2a-4173-b659-a56c52f29466",
    "_secrets_comment": "ClientSecret / ClientSecret2 / CertPass are SECRETS — set via user-secrets (dev) or env vars LHDNApiConfig__ClientSecret etc (server). See SECRETS-SETUP.md",
    "ClientSecret": "",
    "ClientSecret2": "",
    "Scope": "InvoicingAPI",
    "OnBehalfOf": "C1865315040",
    // ── v1.1 digital signing switch ──────────────────────────────────────────────
    // Leave SigningEnabled=false to submit unsigned documents (current behaviour): version 1.0
    // normally, or 1.2 when SvdpEnabled and an invoice is flagged as SVDP.
    // When the signing certificate is purchased: set SigningEnabled=true, DocVersion="1.1",
    // CertPath to the .p12, and CertPass via user-secrets/env var. Validate against PREPROD first.
    // Once enabled, invoices are automatically submitted as the signed version — 1.1 normally, or
    // 1.3 for SVDP-flagged invoices (InvoiceMapper picks this up via IDocumentSigningService).
    "SigningEnabled": false,
    "DocVersion": "1.0",
    // e-Invoice Special Voluntary Disclosure Programme (LHDN SDK 8 Jul 2026, runs until 31 Dec 2027).
    // When true, invoice Create/Edit show an "SVDP e-Invoice" switch; flagged invoices are submitted
    // as document version 1.2 (unsigned) or 1.3 (signed, once SigningEnabled is turned on). Set false
    // to hide the option after the programme ends.
    "SvdpEnabled": true,
    "SyncRetentionDays": 60, // 60 days for invoice sync retention sandbox
    "CertPath": "Cert/DATAMATION_TECHNOLOGY_(M)_SDN._BHD..p12",
    "CertPass": "",
    // Client-side rate-limit ceilings (LhdnRateLimitHandler), one bucket per LHDN endpoint class.
    // These are requests-per-minute PACED evenly, not bursted. Defaults below match the current
    // SDK's preprod limits; override per environment if production limits are confirmed to differ
    // (the SDK enforces separate sandbox/production tiers — see appsettings.Production.json).
    "RateLimits": {
      "TokenPerMinute": 10,
      "ValidatePerMinute": 50,
      "SubmitPerMinute": 60,
      "PollPerMinute": 200,
      "SearchPerMinute": 10,
      "GetDocPerMinute": 50,
      "StatePerMinute": 10,
      "GeneralPerMinute": 20
    }
  },
  "TaxpayerValidationSettings": {
    "DefaultTIN": "C1865315040", // Also used as default TIN for token caching and system identification
    "DefaultIdType": "BRN",
    "DefaultIdValue": "199601004511"
  },
  "FilePathConfig": {
    "BasePath": "E:\\EINVWORLD_STAGING\\Documents",
    "DraftFolder": "E:\\EINVWORLD_STAGING\\Documents\\Draft",
    "SubmittedFolder": "E:\\EINVWORLD_STAGING\\Documents\\Submitted",
    "ValidFolder": "E:\\EINVWORLD_STAGING\\Documents\\Valid",
    "InvalidFolder": "E:\\EINVWORLD_STAGING\\Documents\\Invalid",
    "CancelledFolder": "E:\\EINVWORLD_STAGING\\Documents\\Cancelled",
    "InvoiceCounterFilePath": "E:\\EINVWORLD_STAGING\\Documents\\Counters",
    "JsonGeneratedFolder": "E:\\EINVWORLD_STAGING\\Documents\\JsonGenerated",
    "GeneratedPdfFolder": "E:\\EINVWORLD_STAGING\\Documents\\GeneratedPdf",
    "ResourceImagesFolder": "E:\\EINVWORLD_STAGING\\Documents\\Resources\\Images",
    "EditorUploadsFolder": "E:\\EINVWORLD_STAGING\\Documents\\Resources\\EditorUploads",
    "CompanyLogosFolder": "E:\\EINVWORLD_STAGING\\Documents\\Companies\\Logos",
    "SmartCaptureFolder": "E:\\EINVWORLD_STAGING\\Documents\\SmartCapture"

  },

  "DatabaseSettings": {
    "CommandTimeoutSeconds": 180,
    // true (default): apply EF migrations on startup. Set false in production to run migrations
    // as a controlled deploy step (`dotnet ef database update`) instead.
    "AutoMigrateOnStartup": false
  },
  "InvoiceSettings": {
    "BackdateSeconds": 60
  },
  "IdentityLockout": { //Identity lockout settings
    "AllowedForNewUsers": true,
    "DefaultLockoutMinutes": 15,
    "MaxFailedAccessAttempts": 5
  },
  "SessionSettings": {
    "IdleTimeoutMinutes": 60,
    "CookieName": ".eInvWorld.Session"
  },
  "LogCleanupSettings": {
    "RetentionDays": 365,
    // Rows deleted per batch by LogCleanupService (looped until caught up). Keeps each DELETE small so it
    // never holds a table lock or hits the command timeout on a large SystemLogs table.
    "BatchSize": 5000
  },
  // Provider-agnostic AI — local, FOSS, on-prem LLM via Ollama (https://ollama.com) by default.
  // OFF by default and never required for normal invoice operations; if AI fails, invoicing still works.
  // To enable: install Ollama on the server, run `ollama pull gemma3:12b`, then set Enabled=true. No
  // invoice data leaves the server. "Provider" is future-proofed for OpenAI/AzureOpenAI/Claude/Gemini;
  // only "Ollama" is implemented today. Any cloud "ApiKey" must be set via env var / user-secrets
  // (AI__ApiKey), never here.
  // Model note: recommended models are gemma3:12b (default, ~8 GB), gemma3:27b and qwen3:32b — larger
  // models need proportionally more RAM/VRAM. On a modest server a smaller model (e.g. llama3.2:3b ~2 GB)
  // still works; oversized models can fail to allocate memory and time out. Models are NOT bundled — pull
  // them separately with Ollama.
  "AI": {
    "Enabled": true,
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:1.5b",
    // 12B params: a cold load (Ollama loading the model into memory for the first request after it
    // was idle-unloaded) can take a while depending on hardware — 120s was cutting it close on
    // Staging. KeepAliveMinutes below keeps it loaded between requests so this only matters for the
    // first question after a genuinely long gap; raise TimeoutSeconds further per-environment via
    // AI__TimeoutSeconds if cold loads still don't finish in time on a given server.
    "TimeoutSeconds": 180,
    "KeepAliveMinutes": 30,
    "Temperature": 0.2,
    "MaxTokens": 4096
  },

  // AI Document Capture: upload an invoice PDF, extract its text, and turn it into a reviewed invoice
  // suggestion via the local LLM (draft-only). Requires AI:Enabled=true as well.
  // OCR (scanned PDFs): set OcrEnabled=true AND TessdataPath to a folder holding eng.traineddata (and
  // msa.traineddata for Malay). Needs the native Tesseract/PDFium runtimes deployed — see the deploy guide.
  // Leave OcrEnabled=false (default) for digital-text PDFs only; the native libraries then never load.
  "DocumentCapture": {
    "Enabled": true,
    "MaxFileSizeMb": 10,
    "MaxPages": 15,
    "OcrEnabled": true,
    "TessdataPath": "E:\\EINVWORLD_STAGING\\tessdata",
    "OcrLanguage": "eng",
    "OcrDpi": 300
  },

  // Keeps DocumentCapture:TessdataPath's <lang>.traineddata files (eng, msa, ...; derived from
  // DocumentCapture:OcrLanguage) current from the official tesseract-ocr/tessdata GitHub repo, instead
  // of an operator copying them in by hand (still the required fallback if this is off). Only runs at
  // all when DocumentCapture:OcrEnabled=true. Set Enabled=false here on a server with restricted/no
  // outbound internet access — OCR keeps working off manually staged files either way.
  "TessdataSync": {
    "Enabled": true,
    "BaseUrl": "https://raw.githubusercontent.com/tesseract-ocr/tessdata/main/",
    "IntervalHours": 24,
    "StartupDelayMinutes": 2
  },

  // Smart Capture (Stage 1): persisted/async upload -> extract -> human-review -> draft pipeline built on
  // top of DocumentCapture above. OFF by default — Staging/Production must explicitly opt in once a
  // verified Ollama model is confirmed reachable. No application-level malware scanning (deliberate
  // trade-off) — upload security instead relies on the extension/magic-byte checks below, size/page/quota
  // limits, tenant-scoped storage outside wwwroot, safe random filenames, and normal OS/endpoint-level
  // protection on the server. See IIS-DEPLOYMENT-GUIDE.md PART 17d.
  "SmartCapture": {
    "Enabled": true,
    "AllowedExtensions": [ "pdf", "jpg", "jpeg", "png" ],
    "MaxFileSizeMb": 10,
    "MaxPages": 15,
    "RetentionDaysFailed": 14,
    "RetentionDaysAbandonedReview": 30,
    "RetentionDaysDraftLinked": 180,
    "RetentionDaysSubmittedLinked": 2555,
    "MonthlyProcessedPageQuota": 500
  },

  // Watched-folder importer: validates CSV/XLSX dropped into InboxPath and moves them to
  // Processed/ or Rejected/ with a .report.json. Validation-only; never creates invoices.
  "WatchedFolderImport": {
    "Enabled": false,
    "InboxPath": "",
    "PollSeconds": 30
  }

}
